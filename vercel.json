{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "cd pdi-astro && npm install && npm run build",
  "outputDirectory": "pdi-astro/dist",
  "redirects": [
    {
      "source": "/",
      "destination": "/dashboard.html",
      "permanent": false
    },
    {
      "source": "/index.html",
      "destination": "/dashboard.html",
      "permanent": false
    }
  ]
}

