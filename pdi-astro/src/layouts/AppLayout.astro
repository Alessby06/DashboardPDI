---
import { ClientRouter } from 'astro:transitions';
import Sidebar from '../components/Sidebar.astro';
import Topbar from '../components/Topbar.astro';
import GlobalModals from '../components/GlobalModals.astro';
import LoadingSkeleton from '../components/LoadingSkeleton.astro';

import '../styles/variables.css';
import '../styles/base.css';
import '../styles/components.css';
import '../styles/loading.css';
import '../styles/views-comun.css';
import '../styles/views-filters.css';
import '../styles/views-filters-pc.css';

interface Props {
  title: string;
  currentPage: string;
  pageCss?: string;
}

const { title, currentPage, pageCss } = Astro.props;

const pdiAppSectionTransition = {
  forwards: {
    old: {
      name: "pdiAppSectionOut",
      duration: "0.2s",
      easing: "cubic-bezier(0.4, 0, 1, 1)",
      fillMode: "both",
    },
    new: {
      name: "pdiAppSectionIn",
      duration: "0.24s",
      easing: "cubic-bezier(0.16, 1, 0.3, 1)",
      fillMode: "both",
    },
  },
  backwards: {
    old: {
      name: "pdiAppSectionOut",
      duration: "0.2s",
      easing: "cubic-bezier(0.4, 0, 1, 1)",
      fillMode: "both",
    },
    new: {
      name: "pdiAppSectionIn",
      duration: "0.24s",
      easing: "cubic-bezier(0.16, 1, 0.3, 1)",
      fillMode: "both",
    },
  },
};
// Edicion visual en vivo de impeccable (opcional). Por defecto queda habilitada.
// Para desactivarla por completo: PUBLIC_IMPECCABLE_LIVE=false en el archivo .env
const impeccableLive =
  String(import.meta.env.PUBLIC_IMPECCABLE_LIVE ?? 'true').toLowerCase() !== 'false';
---

<!DOCTYPE html>
<html lang="es" data-impeccable-live={impeccableLive ? 'on' : 'off'}>
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=5.0" />
  <meta name="description" content="Sistema PDI - Programa de Infancia Saludable de la Asociación Cultural Johannes Gutenberg. Gestión integral de usuarios, salud, educación y voluntariado." />
  <meta name="theme-color" id="metaThemeColor" content="#ffffff" />
  <title>{title} | Sistema PDI (Astro)</title>
  <link rel="icon" type="image/png" href="/assets/jg-icon.png" />
  <link rel="apple-touch-icon" href="/assets/jg-icon.png" />

  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link
    href="https://fonts.googleapis.com/css2?family=Manrope:wght@300..800&display=swap"
    rel="stylesheet"
  />

  <script is:inline>
    (function () {
      // 0. Seguridad inmediata: si no hay sesión activa o expiró, redirigir al login antes de renderizar
      try {
        var sesionActiva = localStorage.getItem("pdi_sesion_activa");
        var expStr = localStorage.getItem("pdi_session_exp");
        var token = localStorage.getItem("pdi_session_token");
        var exp = expStr ? parseInt(expStr, 10) : 0;
        var ahora = Date.now();

        if (sesionActiva !== "1" || !token || !exp || ahora > exp) {
          localStorage.removeItem("pdi_sesion_activa");
          localStorage.removeItem("pdi_active_role");
          localStorage.removeItem("pdi_usuario_nombre");
          localStorage.removeItem("pdi_session_token");
          localStorage.removeItem("pdi_session_exp");
          window.location.replace("/login");
          return;
        }
      } catch (e) {
        window.location.replace("/login");
        return;
      }

      function aplicarTema(doc) {
        try {
          var saved = localStorage.getItem("pdi_theme") || "system";
          var usaSistema = saved === "system";
          var oscuro = usaSistema
            ? !!(window.matchMedia && window.matchMedia("(prefers-color-scheme: dark)").matches)
            : saved === "dark";
          var targetDoc = doc || document;
          targetDoc.documentElement.setAttribute("data-theme", oscuro ? "dark" : "light");

          var metaTema = targetDoc.getElementById("metaThemeColor");
          if (metaTema) metaTema.setAttribute("content", oscuro ? "#0d0d0f" : "#ffffff");

          var esMovil = typeof window !== "undefined" && window.innerWidth <= 900;
          if (esMovil) {
            targetDoc.documentElement.setAttribute("data-menu-cajon", "si");
          } else {
            targetDoc.documentElement.removeAttribute("data-menu-cajon");
          }
          var rolActivo = localStorage.getItem("pdi_active_role") || "coord";
          targetDoc.documentElement.setAttribute("data-user-role", rolActivo);
        } catch (e) {}
      }

      // 1. Antiflash síncrono inmediato en carga inicial de la página
      aplicarTema(document);

      // 2. ClientRouter: transferir atributos y preparar subvistas ANTES de que Astro reemplace el documento
      document.addEventListener("astro:before-swap", function (ev) {
        if (ev.newDocument) {
          aplicarTema(ev.newDocument);

          // La capa de datos ya hidrato en esta sesion: la pagina nueva no debe
          // ensenar el esqueleto. El <html> se reemplaza en la transicion, asi
          // que la marca se copia al documento nuevo antes del swap.
          try {
            if (window.PDI && window.PDI.__pdiDatosListos) {
              ev.newDocument.documentElement.setAttribute("data-pdi-ready", "1");
            }
          } catch (e) {}

          try {
            var url = ev.to ? new URL(ev.to) : null;
            if (url && url.pathname.includes("/social")) {
              var tab = url.searchParams.get("tab");
              var rol = localStorage.getItem("pdi_active_role") || "coord";
              var activeTab = "kanban";
              if (tab === "autorizaciones" && (rol === "coord" || rol === "admin")) {
                activeTab = "autorizaciones";
              } else if (tab === "mis-solicitudes" && rol === "social") {
                activeTab = "mis-solicitudes";
              }

              var k = ev.newDocument.getElementById("viewSocialKanban");
              var a = ev.newDocument.getElementById("viewSocialAutorizaciones");
              var m = ev.newDocument.getElementById("viewSocialMisSolicitudes");
              if (k) k.classList.toggle("active", activeTab === "kanban");
              if (a) a.classList.toggle("active", activeTab === "autorizaciones");
              if (m) m.classList.toggle("active", activeTab === "mis-solicitudes");

              // Sincronizar botones en el sidebar persistente
              var btnSocial = document.querySelector('#sidebarNav .nav-btn[data-page="social"]');
              var btnAut = document.querySelector('#sidebarNav .nav-btn[data-subview="autorizaciones"]');
              var btnMisSol = document.querySelector('#sidebarNav .nav-btn[data-subview="mis-solicitudes"]');
              var otrosBtns = document.querySelectorAll('#sidebarNav .nav-btn:not([data-page="social"]):not([data-subview])');
              otrosBtns.forEach(function(b) { b.classList.remove("active"); });

              if (btnSocial) btnSocial.classList.toggle("active", activeTab === "kanban");
              if (btnAut) btnAut.classList.toggle("active", activeTab === "autorizaciones");
              if (btnMisSol) btnMisSol.classList.toggle("active", activeTab === "mis-solicitudes");
            }
          } catch (e) {}
        }
      });

      // 3. ClientRouter: re-asegurar atributos inmediatamente tras el intercambio
      document.addEventListener("astro:after-swap", function () {
        aplicarTema(document);
        try {
          if (window.PDI && window.PDI.__pdiDatosListos) {
            document.documentElement.setAttribute("data-pdi-ready", "1");
          }
        } catch (e) {}
      });
    })();
  </script>

  {pageCss && <link rel="stylesheet" href={pageCss} />}
  <ClientRouter />
</head>

<body data-page={currentPage}>
  <!-- Toast Notification Stack persistente entre páginas -->
  <div class="toast-container" id="toastContainer" transition:persist></div>

  <div class="app-shell">
    <!-- Mobile Sidebar Backdrop Overlay persistente -->
    <div
      class="sidebar-backdrop"
      id="sidebarBackdrop"
      onclick="window.closeSidebar ? window.closeSidebar(event) : null"
      transition:persist
    ></div>

    <!-- Sidebar Navigation persistente (evita el tirón de re-renderizado de GPU) -->
    <Sidebar currentPage={currentPage} transition:persist />

    <!-- Main Content Container -->
    <div class="main-wrapper">
      <!-- Topbar persistente -->
      <Topbar transition:persist />

      <!-- Viewport Body -->
      <main class="content-viewport" id="mainContent" transition:animate={pdiAppSectionTransition}>
        <div class="pdi-view-shell" id="pdiViewShell">
          <div class="pdi-view-content" id="pdiViewContent">
            <div id="smoothContent" class="smooth-content">
              <slot />
            </div>
          </div>
          <LoadingSkeleton variant={currentPage} />
        </div>
      </main>
    </div>
  </div>

  <!-- Modales Globales Compartidos -->
  <GlobalModals transition:persist />


  <slot name="scripts" />

  <script>
    import { navigate } from 'astro:transitions/client';
    window.PDI = window.PDI || {};
    window.PDI.navigate = navigate;
  </script>
  <script>
    import '../scripts/core/SmoothScroll.js';
  </script>

  <script>
    import '../scripts/utils/SheetController.js';
  </script>
<!-- impeccable-live-start -->
<script is:inline src="http://localhost:8400/live.js?token=e86a0507-0b51-4053-b1b1-45fdd847eee9"></script>
<!-- impeccable-live-end -->
</body>
</html>
