---
import Icon from './Icon.astro';
import { parsearLlamada } from '../scripts/core/inlineCall.js';
// ===========================================================================
//  PANEL DE FILTROS (esqueleto común)
// ===========================================================================
//  Siete páginas repetían el mismo contenedor, botón, cabecera y pie con
//  pequeñas diferencias de id y de handler. Este componente los dibuja una vez;
//  cada faceta va en el slot, normalmente como un <FilterField>.
//
//  Los ids siguen siendo los mismos: las vistas y sus scripts no cambian.
//
//  Sin pie. El filtrado ocurre en vivo, así que el botón «Ver resultados» no
//  aplicaba nada: solo cerraba. Y sin X: en escritorio se cierra con clic
//  fuera, Escape o el propio disparador, y en el teléfono con el asa o el velo.
// ===========================================================================
interface Props {
  /** id del contenedor .audit-filters-dropdown */
  id: string;
  /** id del botón que abre */
  buttonId: string;
  /** id del menú (opcional) */
  menuId?: string;
  /** id del contador de filtros activos */
  countId?: string;
  /** Título del encabezado */
  title: string;
  /** Expresión JS del botón Restablecer (sin comillas) */
  reset: string;
  /** Texto del botón principal */
  buttonLabel?: string;
}

const {
  id,
  buttonId,
  menuId,
  countId,
  title,
  reset,
  buttonLabel = "Filtros",
} = Astro.props;

const toggle = `window.toggleCustomDropdown ? window.toggleCustomDropdown('${id}') : null`;
const llamadaToggle = parsearLlamada(toggle);
const llamadaReset = reset ? parsearLlamada(reset) : null;
---

<div class="audit-filter-panel-wrap">
  <div class="custom-dropdown audit-filters-dropdown" id={id}>
    <button
      type="button"
      class="btn-action audit-filter-btn"
      id={buttonId}
      data-pdi-call={llamadaToggle?.nombre}
      data-pdi-args={JSON.stringify(llamadaToggle?.args ?? [])}
      aria-controls={menuId}
      aria-haspopup="dialog"
      aria-expanded="false"
    >
      <Icon name="accion.filtrar" size={16} />
      <span>{buttonLabel}</span>
      {countId && (
        <span class="filter-active-count" id={countId} style="display:none;">0</span>
      )}
      <Icon name="nav.desplegar" size={12} class="filter-caret" />
    </button>
    <div class="custom-dropdown-menu audit-filters-menu" id={menuId}>
      <div class="audit-filters-header">
        <div class="audit-sheet-handle-row" aria-hidden="true">
          <span class="audit-sheet-handle"></span>
        </div>
        <div class="audit-filters-header-title">
          <Icon name="accion.filtrar" size={14} />
          <span>{title}</span>
        </div>
        <div class="audit-filters-header-actions">
          <!-- Aparece solo cuando hay algo que restablecer; lo gobierna
               FilterPanel.js mirando el contador de filtros activos. -->
          <button type="button" class="btn-text-subtle" data-pdi-call={llamadaReset?.nombre}
            data-pdi-args={JSON.stringify(llamadaReset?.args ?? [])} data-fil-restablecer hidden>
            Restablecer
          </button>
        </div>
      </div>

      <div class="audit-filters-body">
        <slot />
      </div>
    </div>
  </div>
</div>
