  <div class="modal-backdrop drawer" id="modalAuditDetail">
    <div class="modal-box drawer-box drawer-read" style="display: flex; flex-direction: column; overflow: hidden;">
      <div class="sheet-grab" aria-hidden="true"><span class="sheet-pill"></span></div>
      <div class="modal-header">
        <div style="display: flex; align-items: center; gap: 10px;">
          <div
            style="width: 36px; height: 36px; border-radius: var(--radius-md); background: var(--surface-2); border: 1px solid var(--border-subtle); display: flex; align-items: center; justify-content: center; color: var(--text-brand);">
            <svg width="20" height="20" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round"
                d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z" />
            </svg>
          </div>
          <div>
            <div style="display: flex; align-items: center; gap: 8px;">
              <h3 style="margin: 0; font-size: 16px;">Detalle de Registro de Auditoría</h3>
              <code
                style="font-family: var(--mono-font); font-size: 12px; color: var(--text-dim); background: var(--surface-2); padding: 2px 6px; border-radius: 4px;"
                id="auditDetailId">LOG-2026-001</code>
            </div>
          </div>
        </div>
        <button type="button" class="btn-close-modal" onclick="closeModalAuditDetail()" aria-label="Cerrar detalle de auditoría">
          <svg width="20" height="20" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" d="M6 18L18 6M6 6l12 12" />
          </svg>
        </button>
      </div>

      <div class="modal-body" style="padding: 20px; display: flex; flex-direction: column; gap: 18px;">
        <!-- Metadatos de la Operación -->
        <div class="audit-meta-grid">
          <div class="audit-meta-card">
            <span class="audit-meta-title">Fecha y Hora Precisa</span>
            <strong class="audit-meta-val" id="auditDetailTimestamp">-</strong>
          </div>
          <div class="audit-meta-card">
            <span class="audit-meta-title">Usuario Responsable</span>
            <strong class="audit-meta-val" id="auditDetailUser">-</strong>
            <span style="font-size: 11px; color: var(--text-muted);" id="auditDetailRole">-</span>
          </div>
          <div class="audit-meta-card">
            <span class="audit-meta-title">Acción / Operación</span>
            <strong class="audit-meta-val" id="auditDetailAction">-</strong>
            <span style="font-size: 11px; color: var(--text-brand); font-weight: 600;"
              id="auditDetailStatus">Válido</span>
          </div>
          <div class="audit-meta-card">
            <span class="audit-meta-title">Entidad Involucrada</span>
            <div id="auditDetailEntityLink" style="margin-top: 2px;">-</div>
          </div>
          <div class="audit-meta-card">
            <span class="audit-meta-title">Sede Operativa</span>
            <strong class="audit-meta-val" id="auditDetailSede">-</strong>
          </div>
          <div class="audit-meta-card">
            <span class="audit-meta-title">Dirección de Red / Origen</span>
            <strong class="audit-meta-val" style="font-family: var(--mono-font);" id="auditDetailIp">-</strong>
          </div>
        </div>

        <!-- Descripción General -->
        <div
          style="background: var(--surface-2); padding: 12px 16px; border-radius: var(--radius-sm); border: 1px solid var(--border-subtle);">
          <span
            style="font-size: 11.5px; font-weight: 700; color: var(--text-dim); text-transform: uppercase;">Descripción
            de la Operación:</span>
          <p style="margin: 4px 0 0 0; font-size: 13px; color: var(--text-main);" id="auditDetailDetail">-</p>
        </div>

        <!-- Comparador Visual de Cambios (Diff) -->
        <div>
          <div style="display: flex; align-items: center; justify-content: space-between; margin-bottom: 8px;">
            <span style="font-size: 13px; font-weight: 700; color: var(--text-main);">Comparativa de Cambios
              Registrados</span>
          </div>
          <div id="auditDetailDiffContainer">
            <!-- Renderizado dinámicamente con clase .audit-diff-table -->
          </div>
        </div>
      </div>

      <div class="modal-footer"
        style="padding: 14px 20px; border-top: 1px solid var(--border-subtle); display: flex; justify-content: space-between; align-items: center; background: var(--surface-1);">
        <span style="font-size: 11.5px; color: var(--text-dim); display: flex; align-items: center; gap: 6px;">
          <svg width="12" height="12" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round"
              d="M16.5 10.5V6.75a4.5 4.5 0 10-9 0v3.75m-.75 11.25h10.5a2.25 2.25 0 002.25-2.25v-6.75a2.25 2.25 0 00-2.25-2.25H6.75a2.25 2.25 0 00-2.25 2.25v6.75a2.25 2.25 0 002.25 2.25z" />
          </svg>
          Información verificada
        </span>
        <button type="button" class="btn-action" onclick="closeModalAuditDetail()">Cerrar Detalle</button>
      </div>
    </div>
  </div>

