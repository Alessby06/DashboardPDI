  .req {
    color: var(--text-danger, #dc2626);
    font-weight: 700;
    margin-left: 2px;
  }

  /* Filas de formulario con cuadrícula consistente y sin espacios en blanco.
     minmax(0, 1fr): los selects tienen un min-content amplio (el texto de su
     opción más larga) y un 1fr normal no puede encogerse por debajo, lo que
     desbordaba el body del drawer en 56 px y metia una barra horizontal. */
  .ficha-form-row {
    display: grid;
    gap: 12px;
    width: 100%;
    /* Alineacion por la base: aunque una etiqueta ocupe dos lineas (p. ej.
       "Centro de Salud (Referencia)"), su campo queda en la misma raya que
       el de la columna hermana y la fila no se rompe. */
    align-items: end;
  }

  .ficha-form-row > * {
    min-width: 0;
  }

  .ficha-form-row--2col {
    grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
  }

  .ficha-form-row--3col {
    grid-template-columns: minmax(0, 1fr) minmax(0, 1fr) minmax(0, 1fr);
  }

  .ficha-form-row--dir {
    grid-template-columns: minmax(0, 2fr) minmax(0, 1fr);
  }

  /* Identidad: Columna de foto y campos alineados */
