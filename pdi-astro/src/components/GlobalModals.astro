              <div class="ficha-signature-header">
                <label for="canvasSignature" class="ficha-signature-label">Firma del Apoderado Titular <span class="req">*</span></label>
                <div class="ficha-signature-actions">
                  <label for="inputUploadFirma" class="btn-action btn-upload-firma" data-caja-archivo="inputUploadFirma" role="button"
