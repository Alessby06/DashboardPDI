---
import {
  SEDES,
  SEDES_OPERATIVAS,
  MODALIDADES,
  EXONERACIONES,
  SEGUROS,
  NIVELES_EDUCATIVOS,
  PARENTESCOS,
  OPCIONES_VOLUNTARIADO,
  TIPOS_DOCUMENTO,
  TIPOS_ALERGIA,
  SEVERIDADES_ALERGIA,
  TIPOS_ATENCION,
  gradosDeNivel,
} from '../data/opcionesBeneficiario.js';
import { SEDES_POR_DISTRITO } from '../scripts/core/catalogos.js';
import EstrategiaMultiSelect from './EstrategiaMultiSelect.astro';
---

<!-- ==========================================
     MODALES GLOBALES COMPARTIDOS
     ========================================== -->
  <!-- Cerrada queda inert: si no, sus 49 controles siguen en el orden de
       tabulación y se puede escribir en un formulario que no se ve. -->
  <div class="modal-backdrop drawer" id="modalNuevoUsuario" inert aria-hidden="true">
    <div class="modal-box drawer-box" role="dialog" aria-modal="true" aria-labelledby="fichaInscripcionTitulo" tabindex="-1"
      style="display: flex; flex-direction: column; overflow: hidden; overscroll-behavior: contain;">
      <div class="sheet-grab" aria-hidden="true"><span class="sheet-pill"></span></div>
      <div class="modal-header">
        <div class="modal-title-stack">
          <h3 id="fichaInscripcionTitulo">Ficha de Inscripción de Usuario</h3>
          <p class="modal-title-desc">Matrícula consolidada. Los campos con asterisco (<span class="req">*</span>) son obligatorios para guardar la ficha.</p>
        </div>
        <button type="button" class="btn-close-modal" onclick="closeModalNuevoUsuario()" aria-label="Cerrar modal de inscripción">
          <svg width="20" height="20" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24" aria-hidden="true">
            <path stroke-linecap="round" stroke-linejoin="round" d="M6 18L18 6M6 6l12 12" />
          </svg>
        </button>
      </div>

      <div class="modal-body">
        <form id="formNuevoUsuario" onsubmit="guardarNuevoUsuario(event)">

          <!-- ========================================================
               SECCIÓN 1: DATOS BIOGRÁFICOS Y DOMICILIO DEL USUARIO
               ======================================================== -->
          <div class="ficha-seccion">
            <div class="ficha-seccion-header">
              <h4 class="ficha-seccion-titulo">1. Datos del Usuario y Domicilio</h4>
              <p class="ficha-seccion-sub">Identidad del usuario y localización domiciliaria para el seguimiento sociofamiliar.</p>
            </div>

            <!-- Identidad: Foto al costado integrada naturalmente a los 8 campos -->
            <div class="ficha-identidad-row">
              <div class="ficha-photo-column">
                <div class="photo-uploader-box ficha-photo ficha-photo--profile" data-caja-archivo="regFotoUsuarioInput" role="button" tabindex="0"
                  aria-label="Subir foto del usuario"
                  onclick="document.getElementById('regFotoUsuarioInput').click()"
                  title="Haga clic para subir foto del usuario">
                  <div id="regFotoUsuarioPreview" class="ficha-photo-preview">
                    <div class="ficha-photo-icon-wrap">
                      <svg width="20" height="20" fill="none" stroke="currentColor" stroke-width="1.8" viewBox="0 0 24 24" aria-hidden="true">
                        <path stroke-linecap="round" stroke-linejoin="round"
                          d="M6.827 6.175A2.31 2.31 0 015.186 7.23c-.38.054-.757.112-1.134.175C2.999 7.58 2.25 8.507 2.25 9.574V18a2.25 2.25 0 002.25 2.25h15A2.25 2.25 0 0021.75 18V9.574c0-1.067-.75-1.994-1.802-2.169a47.865 47.865 0 00-1.134-.175 2.31 2.31 0 01-1.64-1.055l-.822-1.316a2.192 2.192 0 00-1.736-1.039 48.774 48.774 0 00-5.232 0 2.192 2.192 0 00-1.736 1.039l-.821 1.316z" />
                        <path stroke-linecap="round" stroke-linejoin="round"
                          d="M16.5 12.75a4.5 4.5 0 11-9 0 4.5 4.5 0 019 0zM18.75 10.5h.008v.008h-.008V10.5z" />
                      </svg>
                    </div>
                    <span class="ficha-photo-title">Foto del Usuario</span>
                    <span class="ficha-photo-hint">Subir imagen</span>
                  </div>
                  <input type="file" id="regFotoUsuarioInput" accept="image/*" style="display:none;"
                    onchange="handleFotoUpload(this, 'regFotoUsuarioPreview', 'usuario')">
                </div>
              </div>

              <div class="ficha-identidad-fields">
                <!-- Fila 1: Nombres y Apellidos completando el ancho -->
                <div class="ficha-form-row ficha-form-row--2col">
                  <div class="form-group">
                    <label for="regNombres">Nombres del Usuario <span class="req">*</span></label>
                    <input type="text" id="regNombres" name="nombres" autocomplete="given-name" data-tipo="nombre" class="form-control" maxlength="60" placeholder="Ej. Josué David" required>
                  </div>
                  <div class="form-group">
                    <label for="regApellidos">Apellidos del Usuario <span class="req">*</span></label>
                    <input type="text" id="regApellidos" name="apellidos" autocomplete="family-name" data-tipo="nombre" class="form-control" maxlength="60" placeholder="Ej. Quispe Torres" required>
                  </div>
                </div>

                <!-- Fila 2: Documento y Nacimiento -->
                <div class="ficha-form-row ficha-form-row--3col">
                  <div class="form-group">
                    <label for="regTipoDocumento">Tipo de Documento</label>
                    <select id="regTipoDocumento" name="tipo_documento" class="form-control">
                      {TIPOS_DOCUMENTO.map((opcion) => (
                        <option value={opcion.valor}>{opcion.etiqueta}</option>
                      ))}
                    </select>
                  </div>
                  <div class="form-group">
                    <label for="regDni">N° de Documento <span class="req" id="regDniReq">*</span></label>
                    <input type="text" id="regDni" name="dni" inputmode="numeric" autocomplete="off" class="form-control" maxlength="20"
                      placeholder="DNI de 8 dígitos o doc.">
                  </div>
                  <div class="form-group">
                    <label for="regSexo">Sexo</label>
                    <select id="regSexo" name="sexo" class="form-control">
                      <option value="M">Masculino (M)</option>
                      <option value="F">Femenino (F)</option>
                    </select>
                  </div>
                </div>

                <!-- Fila 3: Fechas y Edad calculada -->
                <div class="ficha-form-row ficha-form-row--2col">
                  <div class="form-group">
                    <label for="regFechaNacimiento">Fecha de Nacimiento <span class="req">*</span></label>
                    <input type="date" id="regFechaNacimiento" name="fecha_nacimiento" autocomplete="bday" class="form-control" required
                      onchange="calcularEdadAutomatica()">
                  </div>
                  <div class="form-group">
                    <label for="regEdad">Edad</label>
                    <input type="text" id="regEdad" name="edad" class="form-control" placeholder="Se calcula sola al ingresar fecha" readonly tabindex="-1"
                      title="La edad la calcula el sistema a partir de la fecha de nacimiento">
                  </div>
                </div>
              </div>
            </div>

            <!-- Domicilio y Georreferenciación -->
            <div class="ficha-subsection">
              <div class="ficha-subsection-title">
                Domicilio y Referencia
              </div>
              <div class="ficha-form-row ficha-form-row--dir">
                <div class="form-group">
                  <label for="regDireccion">Dirección Actual Domiciliaria <span class="req">*</span></label>
                  <input type="text" id="regDireccion" name="direccion" autocomplete="street-address" class="form-control" maxlength="180"
                    placeholder="Ej. Mz. 4W Lt. 30, Comité 12, San Benito" required
                    oninput="window.handleAddressInputDebounce ? window.handleAddressInputDebounce('reg') : null">
                </div>
                <div class="form-group">
                  <label for="regReferencia">Referencia de Ubicación</label>
                  <input type="text" id="regReferencia" name="referencia" class="form-control" maxlength="120"
                    placeholder="Ej. Frente al Comedor San Benito">
                </div>
              </div>

              <!-- Croquis y Mapa Asistido -->
              <div class="croquis-panel-container">
                <div class="croquis-box-header">
                  <div class="croquis-box-title">
                    <span>Croquis de Campo y Georreferenciación</span>
                  </div>
                  <div class="croquis-box-actions">
                    <button type="button" class="btn-action btn-gps-capture"
                      onclick="window.capturarGpsCampo ? window.capturarGpsCampo('reg') : null"
                      title="Obtener coordenadas GPS del dispositivo">
                      <svg width="13" height="13" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24" aria-hidden="true">
                        <path stroke-linecap="round" stroke-linejoin="round" d="M12 21a9 9 0 100-18 9 9 0 000 18z" />
                        <path stroke-linecap="round" stroke-linejoin="round" d="M12 8v8m-4-4h8" />
                      </svg>
                      <span>Usar GPS del dispositivo</span>
                    </button>
                  </div>
                </div>

                <div class="croquis-embed-grid">
                  <div class="croquis-map-wrap">
                    <iframe id="regGoogleMapIframe" class="croquis-map-iframe"
                      title="Mapa interactivo de ubicación de domicilio del usuario"
                      data-src="https://maps.google.com/maps?q=Comas,Lima,Peru&t=&z=15&ie=UTF8&iwloc=&output=embed"
                      loading="lazy" allowfullscreen></iframe>
                    <div class="croquis-map-activar" id="regMapaActivar">
                      <button type="button" class="btn-action" id="btnCargarCroquis">
                        <svg width="14" height="14" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24" aria-hidden="true">
                          <path stroke-linecap="round" stroke-linejoin="round" d="M9 20.25l-5.25 2.25V6.75L9 4.5m0 15.75l6-2.25m-6 2.25V4.5m6 13.5l5.25 2.25V6.75L15 4.5m0 13.5V4.5m0 0L9 6.75" />
                        </svg>
                        <span>Cargar mapa en pantalla</span>
                      </button>
                      <span class="croquis-map-activar-nota">Se activa bajo demanda para privacidad y rapidez.</span>
                    </div>
                    <div id="regMapLoadingIndicator" class="croquis-map-loading" style="display:none;">
                      <span>Actualizando croquis…</span>
                    </div>
                  </div>

                  <div class="croquis-fachada-card">
                    <div class="croquis-fachada-header">
                      <span>Foto de la Vivienda / Fachada</span>
                    </div>
                    <div class="croquis-fachada-preview-box" id="regFachadaPreview"
                      data-caja-archivo="regFotoFachadaInput" role="button" tabindex="0"
                      aria-label="Subir foto de la vivienda o fachada"
                      onclick="document.getElementById('regFotoFachadaInput').click()"
                      title="Haga clic para subir foto real de la vivienda">
                      <div class="croquis-fachada-placeholder ficha-photo-preview">
                        <div class="ficha-photo-icon-wrap">
                          <svg width="20" height="20" fill="none" stroke="currentColor" stroke-width="1.8" viewBox="0 0 24 24" aria-hidden="true">
                            <path stroke-linecap="round" stroke-linejoin="round"
                              d="M2.25 12l8.954-8.955c.44-.439 1.152-.439 1.591 0L21.75 12M4.5 9.75v10.125c0 .621.504 1.125 1.125 1.125H9.75v-4.875c0-.621.504-1.125 1.125-1.125h2.25c.621 0 1.125.504 1.125 1.125V21h4.125c.621 0 1.125-.504 1.125-1.125V9.75M8.25 21h8.25" />
                          </svg>
                        </div>
                        <span class="ficha-photo-title">Foto Fachada</span>
                        <span class="ficha-photo-hint">Opcional en visita</span>
                      </div>
                    </div>
                    <input type="file" id="regFotoFachadaInput" accept="image/*" style="display:none;"
                      onchange="window.handleFotoUpload ? window.handleFotoUpload(this, 'regFachadaPreview', 'fachada') : null">
                  </div>
                </div>
              </div>
            </div>
          </div>

          <!-- ========================================================
               SECCIÓN 2: PROGRAMA PDI, SALUD BASE Y ESCOLARIDAD
               ======================================================== -->
          <div class="ficha-seccion">
            <div class="ficha-seccion-header">
              <h4 class="ficha-seccion-titulo">2. Ámbito, Salud Base y Educación</h4>
              <p class="ficha-seccion-sub">Sede pastoral asignada, cobertura de salud y grado educativo del usuario.</p>
            </div>

            <!-- Asignación en el Programa PDI -->
            <div class="ficha-fieldset">
              <legend class="ficha-legend">Asignación en el Programa</legend>
              <div class="ficha-form-row ficha-form-row--2col">
                <div class="form-group">
                  <label for="regDistritoSede">Distrito y Sede / Iglesia Aliada</label>
                  <select id="regDistritoSede" name="distrito_sede" class="form-control">
                    {SEDES.map((opcion) => (
                      <option value={opcion.valor}>{opcion.etiqueta}</option>
                    ))}
                  </select>
                </div>
                <div class="form-group">
                  <label for="regModalidad">Modalidad de Intervención</label>
                  <select id="regModalidad" name="modalidad" class="form-control">
                    {MODALIDADES.map((opcion) => (
                      <option value={opcion.valor}>{opcion.etiqueta}</option>
                    ))}
                  </select>
                </div>
              </div>

              <!-- Estrategia y sus derivaciones inmediatas -->
              <div class="form-group" style="margin-top: 10px;">
                <EstrategiaMultiSelect id="regEstrategia" label="Estrategia(s) Asignada(s)" />
              </div>

              <div class="ficha-form-row ficha-form-row--2col" style="margin-top: 10px;">
                <div class="form-group">
                  <label for="regTipoAtencion">Atención en Casita (solo si aplica Casita del Saber)</label>
                  <select id="regTipoAtencion" name="tipo_atencion" class="form-control" disabled
                    title="Se habilita automáticamente al seleccionar la estrategia Casita del Saber">
                    {TIPOS_ATENCION.map((opcion) => (
                      <option value={opcion.valor}>{opcion.etiqueta}</option>
                    ))}
                  </select>
                </div>
                <div class="form-group">
                  <label for="regExoneracion">Exoneración de Aporte Simbólico</label>
                  <select id="regExoneracion" name="exoneracion" class="form-control">
                    {EXONERACIONES.map((opcion) => (
                      <option value={opcion.valor}>{opcion.etiqueta}</option>
                    ))}
                  </select>
                </div>
              </div>
            </div>

            <!-- Fila Dual: Salud Base a la izquierda, Educación a la derecha -->
            <div class="ficha-dual-blocks">
              <!-- Bloque Salud -->
              <div class="ficha-fieldset">
                <legend class="ficha-legend">Salud Base y Alergias</legend>
                <div class="ficha-form-row ficha-form-row--2col">
                  <div class="form-group">
                    <label for="regSeguro">Seguro de Salud</label>
                    <select id="regSeguro" name="seguro" class="form-control">
                      {SEGUROS.map((opcion) => (
                        <option value={opcion.valor}>{opcion.etiqueta}</option>
                      ))}
                    </select>
                  </div>
                  <div class="form-group">
                    <label for="regCentroSalud" title="Centro de Salud de referencia (hospital o posta de cabecera)">Centro de Salud (Ref.) <span class="req">*</span></label>
                    <input type="text" id="regCentroSalud" name="centro_salud" class="form-control" maxlength="80"
                      placeholder="Ej. C.S. Año Nuevo / C.S. El Progreso" required>
                  </div>
                </div>
              </div>

              <!-- Bloque Educación -->
              <div class="ficha-fieldset">
                <legend class="ficha-legend">Escolaridad</legend>
                <div class="ficha-form-row ficha-form-row--2col">
                  <div class="form-group">
                    <label for="regNivelEducativo">Nivel Educativo</label>
                    <select id="regNivelEducativo" name="nivel_educativo" class="form-control">
                      {NIVELES_EDUCATIVOS.map((opcion) => (
                        <option value={opcion.valor}>{opcion.etiqueta}</option>
                      ))}
                    </select>
                  </div>
                  <div class="form-group">
                    <label for="regGrado">Grado Escolar <span class="req">*</span></label>
                    <select id="regGrado" name="grado" class="form-control" required>
                      <option value="">Seleccione…</option>
                      {gradosDeNivel(NIVELES_EDUCATIVOS[0].valor).map((grado) => (
                        <option value={grado.valor}>{grado.etiqueta}</option>
                      ))}
                    </select>
                  </div>
                </div>
                <div class="form-group" style="margin-top: 10px;">
                  <label for="regColegio">Nombre de la I.E. de Origen <span class="req">*</span></label>
                  <input type="text" id="regColegio" name="colegio" class="form-control" maxlength="80" placeholder="Ej. I.E. 3054 / I.E. San Martín"
                    required>
                </div>
              </div>
            </div>

            <!-- Control Condicional de Alergias (a ancho completo: antes estaba
                 dentro del bloque Salud y su altura descompensaba la fila dual) -->
            <div class="alergia-control-block ficha-alergia-fullwidth">
              <div class="alergia-toggle-row">
                <div class="alergia-toggle-info">
                  <span class="alergia-toggle-title">¿Presenta alergias o restricciones médicas?</span>
                  <span class="alergia-toggle-sub">Alimentos, medicamentos o condiciones especiales</span>
                </div>
                <div class="alergia-segmented" role="group" aria-label="Alergias o restricciones">
                  <button type="button" class="alergia-seg-btn is-active" id="btnAlergiaNo">
                    No (Ninguna)
                  </button>
                  <button type="button" class="alergia-seg-btn" id="btnAlergiaSi">
                    Sí presenta
                  </button>
                </div>
                <input type="hidden" id="checkAlergiaPresencia" value="no">
              </div>

              <!-- Campos condicionales: se abren solo si marca Sí; ahora en
                   una sola hilera de tres columnas porque el bloque va a todo
                   el ancho de la ficha -->
              <div id="alergiaCamposDetalle" class="alergia-campos-detalle" style="display: none;">
                <div class="ficha-form-row ficha-form-row--3col ficha-alergia-detalle-row">
                  <div class="form-group">
                    <label for="regAlergiaDescripcion">Alergias o Restricciones <span class="req">*</span></label>
                    <input type="text" id="regAlergiaDescripcion" name="alergia_descripcion" class="form-control" maxlength="120"
                      placeholder="Especifique: ej. Penicilina, Intolerancia a la lactosa, Asma" disabled value="Ninguna">
                  </div>
                  <div class="form-group">
                    <label for="regAlergiaTipo">Tipo de Alergia <span class="req">*</span></label>
                    <select id="regAlergiaTipo" name="alergia_tipo" class="form-control" disabled>
                      {TIPOS_ALERGIA.map((opcion) => (
                        <option value={opcion.valor}>{opcion.etiqueta}</option>
                      ))}
                    </select>
                  </div>
                  <div class="form-group">
                    <label for="regAlergiaSeveridad">Gravedad / Severidad <span class="req">*</span></label>
                    <select id="regAlergiaSeveridad" name="alergia_severidad" class="form-control" disabled>
                      <option value="">Selecciona gravedad…</option>
                      {SEVERIDADES_ALERGIA.map((opcion) => (
                        <option value={opcion.valor}>{opcion.etiqueta}</option>
                      ))}
                    </select>
                  </div>
                </div>
              </div>
            </div>
          </div>

          <!-- ========================================================
               SECCIÓN 3: APODERADO PRINCIPAL Y PERSONAS DE RETIRO
               ======================================================== -->
          <div class="ficha-seccion">
            <div class="ficha-seccion-header">
              <h4 class="ficha-seccion-titulo">3. Red Familiar y Autorización de Salida</h4>
              <p class="ficha-seccion-sub">Apoderado titular responsable y personas acreditadas para recoger al usuario en sede.</p>
            </div>

            <!-- Apoderado Titular: Foto alineada a la izquierda o al costado con campos completos -->
            <div class="ficha-guardian-row">
              <div class="ficha-photo-column">
                <div class="photo-uploader-box ficha-photo ficha-photo--guardian" data-caja-archivo="regFotoApoderadoInput" role="button" tabindex="0"
                  aria-label="Subir foto del apoderado titular"
                  onclick="document.getElementById('regFotoApoderadoInput').click()"
                  title="Haga clic para subir foto del apoderado titular">
                  <div id="regFotoApoderadoPreview" class="ficha-photo-preview">
                    <div class="ficha-photo-icon-wrap">
                      <svg width="20" height="20" fill="none" stroke="currentColor" stroke-width="1.8" viewBox="0 0 24 24" aria-hidden="true">
                        <path stroke-linecap="round" stroke-linejoin="round"
                          d="M6.827 6.175A2.31 2.31 0 015.186 7.23c-.38.054-.757.112-1.134.175C2.999 7.58 2.25 8.507 2.25 9.574V18a2.25 2.25 0 002.25 2.25h15A2.25 2.25 0 0021.75 18V9.574c0-1.067-.75-1.994-1.802-2.169a47.865 47.865 0 00-1.134-.175 2.31 2.31 0 01-1.64-1.055l-.822-1.316a2.192 2.192 0 00-1.736-1.039 48.774 48.774 0 00-5.232 0 2.192 2.192 0 00-1.736 1.039l-.821 1.316z" />
                        <path stroke-linecap="round" stroke-linejoin="round"
                          d="M16.5 12.75a4.5 4.5 0 11-9 0 4.5 4.5 0 019 0zM18.75 10.5h.008v.008h-.008V10.5z" />
                      </svg>
                    </div>
                    <span class="ficha-photo-title">Foto Apoderado</span>
                    <span class="ficha-photo-hint">Subir imagen</span>
                  </div>
                  <input type="file" id="regFotoApoderadoInput" accept="image/*" style="display:none;"
                    onchange="handleFotoUpload(this, 'regFotoApoderadoPreview', 'apoderado')">
                </div>
              </div>

              <div class="ficha-guardian-fields">
                <div class="ficha-guardian-title-row">
                  <span class="ficha-guardian-label">Apoderado Titular / Cuidador Principal</span>
                  <span class="ficha-guardian-hint">Responsable legal y firmante</span>
                </div>

                <div class="ficha-form-row ficha-form-row--2col">
                  <div class="form-group">
                    <label for="regApoderado">Apellidos y Nombres <span class="req">*</span></label>
                    <input type="text" id="regApoderado" name="apoderado_nombre" autocomplete="name" data-tipo="nombre" class="form-control" maxlength="80" placeholder="Ej. Rosa Quispe Huamán"
                      required>
                  </div>
                  <div class="form-group">
                    <label for="regApoderadoDni">DNI del Apoderado (8 dígitos) <span class="req">*</span></label>
                    <input type="text" id="regApoderadoDni" name="apoderado_dni" autocomplete="off" inputmode="numeric" data-tipo="dni" class="form-control" maxlength="8" pattern="[0-9]{8}"
                      placeholder="41982341" required>
                  </div>
                </div>

                <div class="ficha-form-row ficha-form-row--2col">
                  <div class="form-group">
                    <label for="regParentesco">Parentesco</label>
                    <select id="regParentesco" name="apoderado_parentesco" class="form-control">
                      {PARENTESCOS.map((parentesco) => (
                        <option value={parentesco}>{parentesco}</option>
                      ))}
                    </select>
                  </div>
                  <div class="form-group">
