                </label>
                <label class="ficha-consent-row">
                  <input type="checkbox" id="checkFotoVideo" checked>
                  <span class="ficha-consent-desc">
                    <strong>Fotografía y registro audiovisual:</strong> Difusión institucional y educativa en plataformas oficiales (Art. 13 Ley 29733).
                  </span>
                </label>
                <label class="ficha-consent-row">
                  <input type="checkbox" id="checkDonaciones" checked>
                  <span class="ficha-consent-desc">
                    <strong>Gestión y rendición a donantes:</strong> Reportes para la sostenibilidad de Casitas y Desayunos (Art. 13 Ley 29733).
                  </span>
                </label>
                <label class="ficha-consent-row">
                  <input type="checkbox" id="checkTransfronterizo" checked>
                  <span class="ficha-consent-desc">
                    <strong>Transferencia internacional:</strong> Reportes protegidos a la entidad cooperante Kinderwerk Lima e.V. (Alemania).
                  </span>
                </label>
              </div>
            </div>

            <!-- Canvas de Firma Digital -->
