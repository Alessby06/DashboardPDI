---
import {
  SEDES,
  SEDES_OPERATIVAS,
  MODALIDADES,
  EXONERACIONES,
  SEGUROS,
  NIVELES_EDUCATIVOS,
  PARENTESCOS,
  OPCIONES_VOLUNTARIADO,
  TIPOS_DOCUMENTO,
  TIPOS_ALERGIA,
  SEVERIDADES_ALERGIA,
  gradosDeNivel,
} from '../data/opcionesBeneficiario.js';
import { SEDES_POR_DISTRITO } from '../scripts/core/catalogos.js';
import EstrategiaMultiSelect from './EstrategiaMultiSelect.astro';
---

<!-- ==========================================
     MODALES GLOBALES COMPARTIDOS
     ========================================== -->
  <!-- Cerrada queda inert: si no, sus 49 controles siguen en el orden de
       tabulación y se puede escribir en un formulario que no se ve. -->
  <div class="modal-backdrop" id="modalNuevoMenor" inert aria-hidden="true">
    <div class="modal-box" role="dialog" aria-modal="true" aria-labelledby="fichaInscripcionTitulo" tabindex="-1"
      style="max-width: 960px; max-height: 90vh; overflow-y: auto;">
      <div class="modal-header">
        <div>
          <h3 id="fichaInscripcionTitulo" style="margin:0; font-size:16px;">Ficha de Inscripción 2026</h3>
          <span style="font-size:12px; color:var(--text-dim);">Registro Integral de Usuarios</span>
        </div>
        <button type="button" class="btn-close-modal" onclick="closeModalNuevoMenor()" aria-label="Cerrar modal de inscripción">
          <svg width="20" height="20" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" d="M6 18L18 6M6 6l12 12" />
          </svg>
        </button>
      </div>

      <div class="modal-body">
        <form id="formNuevoMenor" onsubmit="guardarNuevoMenor(event)">

          <!-- SECCIÓN 1: DATOS GENERALES DEL MENOR -->
          <div class="ficha-seccion">
            <div class="ficha-head">
              <h4 class="ficha-seccion-titulo">
                1. Datos del Usuario
              </h4>
              <div class="photo-uploader-box ficha-photo" data-caja-archivo="regFotoMenorInput" role="button" tabindex="0"
                aria-label="Subir foto del usuario"
                onclick="document.getElementById('regFotoMenorInput').click()"
                title="Haga clic para subir foto del usuario">
                <div id="regFotoMenorPreview" class="ficha-photo-preview">
                  <svg width="24" height="24" fill="none" stroke="currentColor" stroke-width="1.8" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round"
                      d="M6.827 6.175A2.31 2.31 0 015.186 7.23c-.38.054-.757.112-1.134.175C2.999 7.58 2.25 8.507 2.25 9.574V18a2.25 2.25 0 002.25 2.25h15A2.25 2.25 0 0021.75 18V9.574c0-1.067-.75-1.994-1.802-2.169a47.865 47.865 0 00-1.134-.175 2.31 2.31 0 01-1.64-1.055l-.822-1.316a2.192 2.192 0 00-1.736-1.039 48.774 48.774 0 00-5.232 0 2.192 2.192 0 00-1.736 1.039l-.821 1.316z" />
                    <path stroke-linecap="round" stroke-linejoin="round"
                      d="M16.5 12.75a4.5 4.5 0 11-9 0 4.5 4.5 0 019 0zM18.75 10.5h.008v.008h-.008V10.5z" />
                  </svg>
                  <span>Foto Usuario</span>
                </div>
                <input type="file" id="regFotoMenorInput" accept="image/*" style="display:none;"
                  onchange="handleFotoUpload(this, 'regFotoMenorPreview', 'menor')">
              </div>
            </div>
            <div class="ficha-grid">
                  <div class="form-group">
                    <label for="regNombres">Nombres</label>
                    <input type="text" id="regNombres" data-tipo="nombre" class="form-control" maxlength="60" placeholder="Ej. Josué David" required>
                  </div>
                  <div class="form-group">
                    <label for="regApellidos">Apellidos</label>
                    <input type="text" id="regApellidos" data-tipo="nombre" class="form-control" maxlength="60" placeholder="Ej. Quispe Torres" required>
                  </div>
                  <div class="form-group">
                    <label for="regTipoDocumento">Tipo de Documento</label>
                    <select id="regTipoDocumento" class="form-control">
                      {TIPOS_DOCUMENTO.map((opcion) => (
                        <option value={opcion.valor}>{opcion.etiqueta}</option>
                      ))}
                    </select>
                  </div>
                  <div class="form-group">
                    <label for="regDni">N° de Documento</label>
                    <input type="text" id="regDni" class="form-control" maxlength="20"
                      placeholder="DNI de 8 dígitos o número de documento">
                  </div>
                  <div class="form-group">
                    <label for="regFechaNacimiento">Fecha de Nacimiento</label>
                    <input type="date" id="regFechaNacimiento" class="form-control" required
                      onchange="calcularEdadAutomatica()">
                  </div>
                  <div class="form-group">
                    <label for="regEdad">Edad (calculada)</label>
                    <input type="text" id="regEdad" class="form-control" placeholder="Se calcula sola al poner la fecha" readonly
                      title="La edad la calcula el sistema a partir de la fecha de nacimiento">
                  </div>
                  <div class="form-group">
                    <label for="regSexo">Sexo</label>
                    <select id="regSexo" class="form-control">
                      <option value="M">Masculino (M)</option>
                      <option value="F">Femenino (F)</option>
                    </select>
                  </div>
                  <div class="form-group ficha-col-2">
                    <label for="regDireccion">Dirección Actual Domiciliaria</label>
                    <input type="text" id="regDireccion" class="form-control" maxlength="180"
                      placeholder="Ej. Mz. 4W Lt. 30, Comité 12, San Benito" required
                      oninput="window.handleAddressInputDebounce ? window.handleAddressInputDebounce('reg') : null">
                  </div>
                  <div class="form-group ficha-ref">
                    <label for="regReferencia">Referencia de Ubicación</label>
                    <input type="text" id="regReferencia" class="form-control" maxlength="120"
                      placeholder="Ej. Frente al Comedor San Benito">
                  </div>

                  <!-- Bloque de Croquis Dinámico y Captura de GPS / Fachada Opcional -->
                  <div class="form-group ficha-col-full">
                    <div class="croquis-box-header">
                      <div class="croquis-box-title">
                        <svg width="15" height="15" fill="none" stroke="currentColor" stroke-width="2"
                          viewBox="0 0 24 24">
                          <path stroke-linecap="round" stroke-linejoin="round" d="M15 10.5a3 3 0 11-6 0 3 3 0 016 0z" />
                          <path stroke-linecap="round" stroke-linejoin="round"
                            d="M19.5 10.5c0 7.142-7.5 11.25-7.5 11.25S4.5 17.642 4.5 10.5a7.5 7.5 0 1115 0z" />
                        </svg>
                        <span>Croquis y Georreferenciación del Hogar (Google Maps)</span>
                      </div>
                      <div class="croquis-box-actions">
                        <button type="button" class="btn-action btn-gps-capture"
                          onclick="window.capturarGpsCampo ? window.capturarGpsCampo('reg') : null"
                          title="Obtener coordenadas GPS del dispositivo">
                          <svg width="14" height="14" fill="none" stroke="currentColor" stroke-width="2"
                            viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round"
                              d="M12 21a9 9 0 100-18 9 9 0 000 18z" />
                            <path stroke-linecap="round" stroke-linejoin="round" d="M12 8v8m-4-4h8" />
                          </svg>
                          <span>Usar mi GPS en campo</span>
                        </button>
                      </div>
                    </div>

                    <div class="croquis-embed-grid">
                      <!-- Visor Google Maps Embed (Carga bajo demanda para optimizar privacidad y cookies) -->
                      <div class="croquis-map-wrap">
                        <iframe id="regGoogleMapIframe" class="croquis-map-iframe"
                          title="Mapa interactivo de ubicación de domicilio del usuario"
                          data-src="https://maps.google.com/maps?q=Comas,Lima,Peru&t=&z=15&ie=UTF8&iwloc=&output=embed"
                          loading="lazy" allowfullscreen></iframe>
                        <!-- El croquis se pide a Google solo cuando alguien lo
                             pide: al abrir la ficha se enviaria el domicilio del
                             usuario a un tercero sin que nadie lo haya decidido. -->
                        <div class="croquis-map-activar" id="regMapaActivar">
                          <button type="button" class="btn-action" id="btnCargarCroquis">
                            <svg width="14" height="14" fill="none" stroke="currentColor" stroke-width="2"
                              viewBox="0 0 24 24" aria-hidden="true">
                              <path stroke-linecap="round" stroke-linejoin="round"
                                d="M9 20.25l-5.25 2.25V6.75L9 4.5m0 15.75l6-2.25m-6 2.25V4.5m6 13.5l5.25 2.25V6.75L15 4.5m0 13.5V4.5m0 0L9 6.75" />
                            </svg>
                            <span>Ver croquis en el mapa</span>
                          </button>
                          <span class="croquis-map-activar-nota">Se carga desde Google Maps solo cuando lo pides.</span>
                        </div>
                        <div id="regMapLoadingIndicator" class="croquis-map-loading" style="display:none;">
                          <span>Actualizando croquis...</span>
                        </div>
                      </div>

                      <!-- Subida Opcional de Fachada del Hogar -->
                      <div class="croquis-fachada-card">
                        <div class="croquis-fachada-header">
                          <span>Foto de Fachada (Opcional)</span>
                        </div>
                        <div class="croquis-fachada-preview-box" id="regFachadaPreview"
                          data-caja-archivo="regFotoFachadaInput" role="button" tabindex="0"
                          aria-label="Subir foto de fachada de la vivienda"
                          onclick="document.getElementById('regFotoFachadaInput').click()"
                          title="Haga clic para subir foto real de la vivienda">
                          <div class="croquis-fachada-placeholder">
                            <svg width="24" height="24" fill="none" stroke="currentColor" stroke-width="1.8"
                              viewBox="0 0 24 24">
                              <path stroke-linecap="round" stroke-linejoin="round"
                                d="M2.25 12l8.954-8.955c.44-.439 1.152-.439 1.591 0L21.75 12M4.5 9.75v10.125c0 .621.504 1.125 1.125 1.125H9.75v-4.875c0-.621.504-1.125 1.125-1.125h2.25c.621 0 1.125.504 1.125 1.125V21h4.125c.621 0 1.125-.504 1.125-1.125V9.75M8.25 21h8.25" />
                            </svg>
                            <span>Subir foto de vivienda</span>
                          </div>
                        </div>
                        <input type="file" id="regFotoFachadaInput" accept="image/*" style="display:none;"
                          onchange="window.handleFotoUpload ? window.handleFotoUpload(this, 'regFachadaPreview', 'fachada') : null">
                        <div style="font-size:12.5px; color:var(--text-dim); line-height:1.35; margin-top:6px;">
                          Tomada durante visita social.
                        </div>
                      </div>
                    </div>
                  </div>
                </div>
          </div>

          <!-- SECCIÓN 2: ÁMBITO Y ESTRATEGIA OPERATIVA -->
          <div class="ficha-seccion">
            <h4 class="ficha-seccion-titulo">
              2. Ámbito Territorial y Estrategia Operativa
            </h4>
            <div class="ficha-grid ficha-grid--territorio">
              <div class="form-group">
                <label for="regDistritoSede">Distrito y Sede / Lugar</label>
                <select id="regDistritoSede" class="form-control">
                  {SEDES.map((opcion) => (
                    <option value={opcion.valor}>{opcion.etiqueta}</option>
                  ))}
                </select>
              </div>
              <div class="form-group">
                <label for="regModalidad">Modalidad de Intervención</label>
                <select id="regModalidad" class="form-control">
                  {MODALIDADES.map((opcion) => (
                    <option value={opcion.valor}>{opcion.etiqueta}</option>
                  ))}
                </select>
              </div>
              <div class="form-group ficha-col-full">
                <label for="regExoneracion">Exoneración de Aporte Simbólico</label>
                <select id="regExoneracion" class="form-control">
                  {EXONERACIONES.map((opcion) => (
                    <option value={opcion.valor}>{opcion.etiqueta}</option>
                  ))}
                </select>
              </div>
              <div class="form-group ficha-col-full">
                <EstrategiaMultiSelect id="regEstrategia" label="Estrategia Asignada" />
              </div>
            </div>
          </div>

          <!-- SECCIÓN 3: SALUD Y EDUCACIÓN -->
          <div class="ficha-seccion">
            <h4 class="ficha-seccion-titulo">
              3. Datos de Salud Base y Educación
            </h4>
            <div class="ficha-grid">
              <div class="form-group">
                <label for="regSeguro">Tipo de Seguro</label>
                <select id="regSeguro" class="form-control">
                  {SEGUROS.map((opcion) => (
                    <option value={opcion.valor}>{opcion.etiqueta}</option>
                  ))}
                </select>
              </div>
              <div class="form-group">
                <label for="regCentroSalud">Centro de Salud de Referencia</label>
                <input type="text" id="regCentroSalud" class="form-control" maxlength="80"
                  placeholder="Ej. C.S. Año Nuevo / C.S. El Progreso" required>
              </div>
              <div class="form-group">
                <label for="regAlergiaDescripcion">Alergia</label>
                <input type="text" id="regAlergiaDescripcion" class="form-control" maxlength="120" placeholder="Ej. Ninguna o Penicilina"
                  required>
              </div>
              <div class="form-group">
                <label for="regAlergiaTipo">Tipo de alergia</label>
                <select id="regAlergiaTipo" class="form-control">
                  {TIPOS_ALERGIA.map((opcion) => (
                    <option value={opcion.valor}>{opcion.etiqueta}</option>
                  ))}
                </select>
              </div>
              <div class="form-group">
                <label for="regAlergiaSeveridad">Gravedad</label>
                <select id="regAlergiaSeveridad" class="form-control" disabled>
                  {SEVERIDADES_ALERGIA.map((opcion) => (
                    <option value={opcion.valor}>{opcion.etiqueta}</option>
                  ))}
                </select>
              </div>
              <div class="form-group">
                <label for="regNivelEducativo">Nivel Educativo</label>
                <select id="regNivelEducativo" class="form-control">
                  {NIVELES_EDUCATIVOS.map((opcion) => (
                    <option value={opcion.valor}>{opcion.etiqueta}</option>
                  ))}
                </select>
              </div>
              <div class="form-group">
                <label for="regGrado">Grado Escolar</label>
                <select id="regGrado" class="form-control" required>
                  <option value="">Seleccione…</option>
                  {gradosDeNivel(NIVELES_EDUCATIVOS[0].valor).map((grado) => (
                    <option value={grado.valor}>{grado.etiqueta}</option>
                  ))}
                </select>
              </div>
              <div class="form-group">
                <label for="regColegio">Nombre de la I.E. de Origen</label>
                <input type="text" id="regColegio" class="form-control" maxlength="80" placeholder="Ej. I.E. 3054 / I.E. San Martín"
                  required>
              </div>
            </div>
          </div>

          <!-- SECCIÓN 4: APODERADO / CUIDADOR PRINCIPAL -->
          <div class="ficha-seccion">
            <div class="ficha-head">
              <h4 class="ficha-seccion-titulo">
                4. Datos del Apoderado / Cuidador Principal
              </h4>
              <div class="photo-uploader-box ficha-photo" data-caja-archivo="regFotoApoderadoInput" role="button" tabindex="0"
                aria-label="Subir foto del apoderado"
                onclick="document.getElementById('regFotoApoderadoInput').click()"
                title="Haga clic para subir foto del apoderado">
                <div id="regFotoApoderadoPreview" class="ficha-photo-preview">
                  <svg width="24" height="24" fill="none" stroke="currentColor" stroke-width="1.8" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round"
                      d="M6.827 6.175A2.31 2.31 0 015.186 7.23c-.38.054-.757.112-1.134.175C2.999 7.58 2.25 8.507 2.25 9.574V18a2.25 2.25 0 002.25 2.25h15A2.25 2.25 0 0021.75 18V9.574c0-1.067-.75-1.994-1.802-2.169a47.865 47.865 0 00-1.134-.175 2.31 2.31 0 01-1.64-1.055l-.822-1.316a2.192 2.192 0 00-1.736-1.039 48.774 48.774 0 00-5.232 0 2.192 2.192 0 00-1.736 1.039l-.821 1.316z" />
                    <path stroke-linecap="round" stroke-linejoin="round"
                      d="M16.5 12.75a4.5 4.5 0 11-9 0 4.5 4.5 0 019 0zM18.75 10.5h.008v.008h-.008V10.5z" />
                  </svg>
                  <span>Foto Apoderado</span>
                </div>
                <input type="file" id="regFotoApoderadoInput" accept="image/*" style="display:none;"
                  onchange="handleFotoUpload(this, 'regFotoApoderadoPreview', 'apoderado')">
              </div>
            </div>
            <div class="ficha-grid">
              <div class="form-group ficha-col-2">
                <label for="regApoderado">Apellidos y Nombres</label>
                <input type="text" id="regApoderado" data-tipo="nombre" class="form-control" maxlength="80" placeholder="Ej. Rosa Quispe Huamán"
                  required>
              </div>
              <div class="form-group">
                <label for="regApoderadoDni">DNI del Apoderado (8 dígitos)</label>
                <input type="text" id="regApoderadoDni" data-tipo="dni" class="form-control" maxlength="8" pattern="[0-9]{8}"
                  placeholder="41982341" required>
              </div>
              <div class="form-group">
                <label for="regParentesco">Parentesco</label>
                <select id="regParentesco" class="form-control">
                  {PARENTESCOS.map((parentesco) => (
                    <option value={parentesco}>{parentesco}</option>
                  ))}
                </select>
              </div>
              <div class="form-group">
                <label for="regSexoApoderado">Sexo del Apoderado</label>
                <select id="regSexoApoderado" class="form-control" required>
                  <option value="">Selecciona...</option>
                  <option value="F">Femenino (F)</option>
                  <option value="M">Masculino (M)</option>
                </select>
              </div>
              <div class="form-group">
                <label for="regTelefono">Teléfono / Celular Principal</label>
                <input type="text" id="regTelefono" data-tipo="telefono" class="form-control" maxlength="15" inputmode="tel" placeholder="987-654-321" required>
              </div>
              <div class="form-group">
                <label for="regTelefonoAlt">Teléfono de Emergencia / Respaldo</label>
                <input type="text" id="regTelefonoAlt" data-tipo="telefono" class="form-control" maxlength="15" inputmode="tel"
                  placeholder="Ej. 912-345-678 (Tía / Vecina)">
              </div>
            </div>
          </div>

          <!-- SECCIÓN 5: AUTORIZACIÓN DE SALIDA Y PERSONAS DE RETIRO -->
          <div class="ficha-seccion">
            <h4 class="ficha-seccion-titulo">
              5. Autorización de Salida y Personas de Retiro
            </h4>

            <!-- Persona Autorizada 1 -->
            <div class="section-retirador-card">
              <div class="ficha-retiro-head">
                <div class="ficha-retiro-title">
                  <span class="ficha-retiro-nombre">Persona Autorizada 1 (Titular / Principal)</span>
                  <label class="check-apoderado-label">
                    <input type="checkbox" id="checkMismoApoderado1" onchange="toggleMismoApoderado(this.checked)"
                      style="cursor:pointer; accent-color:var(--gt-green);">
                    <span>Mismos datos del Apoderado Principal</span>
                  </label>
                </div>
                <div class="photo-uploader-box ficha-photo ficha-photo--sm" id="boxFotoRetiro1"
                  data-caja-archivo="regFotoRetiro1Input" role="button" tabindex="0"
                  aria-label="Subir foto de la Persona Autorizada 1"
                  onclick="document.getElementById('regFotoRetiro1Input').click()" title="Haga clic para subir foto">
                  <div id="regFotoRetiro1Preview" class="ficha-photo-preview">
                    <svg width="22" height="22" fill="none" stroke="currentColor" stroke-width="1.8" viewBox="0 0 24 24">
                      <path stroke-linecap="round" stroke-linejoin="round"
                        d="M6.827 6.175A2.31 2.31 0 015.186 7.23c-.38.054-.757.112-1.134.175C2.999 7.58 2.25 8.507 2.25 9.574V18a2.25 2.25 0 002.25 2.25h15A2.25 2.25 0 0021.75 18V9.574c0-1.067-.75-1.994-1.802-2.169a47.865 47.865 0 00-1.134-.175 2.31 2.31 0 01-1.64-1.055l-.822-1.316a2.192 2.192 0 00-1.736-1.039 48.774 48.774 0 00-5.232 0 2.192 2.192 0 00-1.736 1.039l-.821 1.316z" />
                      <path stroke-linecap="round" stroke-linejoin="round"
                        d="M16.5 12.75a4.5 4.5 0 11-9 0 4.5 4.5 0 019 0zM18.75 10.5h.008v.008h-.008V10.5z" />
                    </svg>
                    <span>Foto P1</span>
                  </div>
                  <input type="file" id="regFotoRetiro1Input" accept="image/*" style="display:none;"
                    onchange="handleFotoUpload(this, 'regFotoRetiro1Preview', 'retiro1')">
                </div>
              </div>
              <div class="ficha-grid">
                <div class="form-group ficha-col-2">
                  <label for="regRetiroNombre1">Nombres y Apellidos</label>
                  <input type="text" id="regRetiroNombre1" data-tipo="nombre" class="form-control" maxlength="80" placeholder="Ej. Rosa Quispe Huamán"
                    required>
                </div>
                <div class="form-group">
                  <label for="regRetiroDni1">DNI (8 dígitos)</label>
                  <input type="text" id="regRetiroDni1" data-tipo="dni" class="form-control" maxlength="8" pattern="[0-9]{8}"
                    placeholder="41982341" required>
                </div>
                <div class="form-group">
                  <label for="regRetiroParentesco1">Parentesco</label>
                  <select id="regRetiroParentesco1" class="form-control">
                    {PARENTESCOS.map((parentesco) => (
                      <option value={parentesco}>{parentesco}</option>
                    ))}
                  </select>
                </div>
                <div class="form-group ficha-col-2">
                  <label for="regRetiroTel1">Teléfono / Celular de Contacto</label>
                  <input type="text" id="regRetiroTel1" data-tipo="telefono" class="form-control" maxlength="15" inputmode="tel" placeholder="987-654-321" required>
                </div>
              </div>
            </div>

            <!-- Persona Autorizada 2 (Opcional): va plegada, ocupa el mismo espacio que la titular -->
            <div class="section-retirador-card">
              <div class="ficha-retiro-head">
                <button type="button" class="btn-panel-plegable" id="btnToggleRetiro2"
                  aria-expanded="false" aria-controls="cuerpoRetiro2">
                  <svg class="caret" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24" aria-hidden="true">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M19.5 8.25l-7.5 7.5-7.5-7.5" />
                  </svg>
                  <span>Persona Autorizada 2 (Opcional / Respaldo)</span>
