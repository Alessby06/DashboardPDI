  .canvas-signature-wrap {
    position: relative;
    height: 110px;
    border: 1px solid var(--border-medium);
    border-radius: var(--radius-sm, 6px);
    background: #ffffff;
    overflow: hidden;
  }

  .canvas-signature-wrap::after {
    content: "X ──────────────────────────────────────────";
    position: absolute;
    bottom: 18px;
    left: 20px;
    right: 20px;
    /* Centro la marca de agua (X + guia) en vez de dejarla pegada a la
       izquierda: es la referencia visual de "firme aqui". */
    text-align: center;
    display: flex;
    justify-content: center;
    align-items: flex-end;
    font-size: 11px;
    color: #cbd5e1;
    letter-spacing: 2px;
    pointer-events: none;
    user-select: none;
    white-space: nowrap;
    overflow: hidden;
