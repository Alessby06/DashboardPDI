<style>
  /* La ficha reparte los campos en tres columnas y lleva cada foto al
     encabezado de su seccion: antes la foto abria una columna fija de 88 px
     que dejaba cientos de pixeles vacios debajo. */
  .ficha-seccion {
    border-bottom: 1px solid var(--border-subtle);
    padding-bottom: 18px;
    margin-bottom: 18px;
  }

  .ficha-seccion--last {
    border-bottom: 0;
    padding-bottom: 0;
    margin-bottom: 0;
  }

  .ficha-head {
    display: flex;
    align-items: flex-start;
    justify-content: space-between;
    gap: 12px;
    margin-bottom: 12px;
  }

  .ficha-head .ficha-seccion-titulo {
    margin: 0;
    padding-top: 4px;
  }

  .ficha-photo {
    width: 86px;
    height: 86px;
    min-width: 86px;
    border-radius: 10px;
    border: 1.5px dashed var(--border-medium);
    background: var(--surface-2);
    display: flex;
    align-items: center;
    justify-content: center;
    position: relative;
    overflow: hidden;
    cursor: pointer;
    transition: border-color var(--dur-fast) var(--ease-smooth),
                background-color var(--dur-fast) var(--ease-smooth);
  }

  .ficha-photo:hover,
  .ficha-photo:focus-visible {
    border-color: var(--gt-green);
    background: var(--surface-hover);
  }

  .ficha-photo-preview {
    width: 100%;
    height: 100%;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 3px;
    padding: 4px;
    text-align: center;
    font-size: 10.5px;
    line-height: 1.1;
    font-weight: 600;
    color: var(--text-muted);
  }

  .ficha-photo-preview svg {
    width: 24px;
    height: 24px;
  }

  .ficha-photo-preview img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    border-radius: 6px;
  }

  /* La foto de P1/P2 vive en la cabecera de su tarjeta: asi no deja una
     columna vacia al lado de los campos. */
  .ficha-photo--sm {
    width: 56px;
    height: 56px;
    min-width: 56px;
    border-radius: 8px;
  }

  .ficha-photo--sm .ficha-photo-preview {
    font-size: 9.5px;
  }

  .ficha-retiro-head {
    display: flex;
    align-items: flex-start;
    justify-content: space-between;
    gap: 12px;
    margin-bottom: 8px;
  }

  .ficha-retiro-title {
    display: flex;
    align-items: center;
    gap: 10px;
    flex-wrap: wrap;
    min-width: 0;
  }

  .ficha-retiro-nombre {
    font-size: 12.5px;
    font-weight: 700;
    color: var(--text-brand);
  }

  /* Las cuatro autorizaciones legales se leen en dos columnas: a todo el
     ancho de la ficha cada linea pasaba de 100 caracteres. */
  .ficha-consent-grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 10px 18px;
  }

  .ficha-retiro-head .btn-panel-plegable {
    flex: 1;
    width: auto;
    margin-bottom: 0;
  }

  .ficha-grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 12px;
  }

  .ficha-grid > * {
    min-width: 0;
  }

  /* En territorio, los dos selectores cortos comparten fila y la exoneracion
     usa todo el ancho: su etiqueta no cabe en un tercio. */
  .ficha-grid--territorio {
    grid-template-columns: repeat(2, minmax(0, 1fr));
  }

  .ficha-col-2 {
    grid-column: span 2;
  }

  .ficha-col-full {
    grid-column: 1 / -1;
  }

  @media (max-width: 900px) {
    .ficha-grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }

    /* A dos columnas, los campos largos y el croquis usan toda la fila. */
    .ficha-col-2,
    .ficha-col-full,
    .ficha-ref {
      grid-column: 1 / -1;
    }
  }

  @media (max-width: 640px) {
    .ficha-grid {
      grid-template-columns: 1fr;
    }

    .ficha-consent-grid {
      grid-template-columns: 1fr;
    }

    .ficha-head {
      align-items: center;
    }

    .ficha-photo {
      width: 64px;
      height: 64px;
      min-width: 64px;
    }

    #modalNuevoMenor .modal-footer {
      flex-wrap: wrap;
      gap: 8px;
    }

    #modalNuevoMenor .ficha-estado {
      flex: 1 0 100%;
      max-width: none;
      text-align: left;
    }

    #modalNuevoMenor .ficha-acciones {
      flex: 1 0 100%;
      display: grid;
      grid-template-columns: minmax(96px, 0.8fr) 1.35fr;
      gap: 8px;
      margin-left: 0;
    }

    #modalNuevoMenor .ficha-acciones .btn-action {
      width: 100%;
    }
  }

  /* Ficha de inscripcion: el boton de guardar y el estado de lo que falta. */
  .ficha-footer {
    justify-content: space-between;
  }

  .ficha-acciones {
    display: flex;
    align-items: center;
    gap: 10px;
    flex-wrap: wrap;
    justify-content: flex-end;
  }

  .ficha-estado {
    flex: 1;
    min-width: 220px;
    font-size: 12.5px;
    line-height: 1.35;
    color: var(--text-muted);
    max-width: none;
    text-align: left;
  }

  /* Un solo acento y un solo tamano para los seis encabezados: antes cada
     seccion traia su color (ambar, azul, rojo, texto y marca) y el formulario
     parecia seis formularios distintos. */
  .ficha-seccion-titulo {
    font-size: 14px;
    text-transform: uppercase;
    color: var(--text-brand);
    letter-spacing: 0.4px;
    margin: 0 0 10px 0;
    font-weight: 700;
  }

  .ficha-estado--faltan {
    color: var(--text-warning, #b45309);
  }

  .ficha-estado--listo {
    color: var(--text-success, #15803d);
    font-weight: 600;
  }

  /* Panel plegable de la Persona Autorizada 2. El padding replica el ritmo de
     la tarjeta de la titular: el titulo queda a la misma altura y los campos
     arrancan a la misma distancia. */
  .btn-panel-plegable {
    display: flex;
    align-items: center;
    gap: 8px;
    width: 100%;
    padding: 4px 0;
    margin-bottom: 8px;
    background: transparent;
    border: 0;
    color: var(--text-muted);
    font-family: var(--ui-font);
    font-size: 12px;
    font-weight: 700;
    text-align: left;
    cursor: pointer;
  }

  .btn-panel-plegable .caret {
    width: 14px;
    height: 14px;
    flex-shrink: 0;
    transition: transform var(--dur-fast) var(--ease-smooth);
  }

  .btn-panel-plegable[aria-expanded='true'] .caret {
    transform: rotate(180deg);
  }

  .btn-panel-plegable:hover {
    color: var(--text-main);
  }

  .btn-panel-plegable-nota {
    font-weight: 500;
    color: var(--text-dim);
    font-size: 11.5px;
  }

  /* Texto para lectores de pantalla que no debe ocupar lugar en pantalla. */
  .sr-only {
    position: absolute;
    width: 1px;
    height: 1px;
    padding: 0;
    margin: -1px;
    overflow: hidden;
    clip: rect(0 0 0 0);
    white-space: nowrap;
    border: 0;
  }

  /* El boton de guardar deshabilitado tiene que parecer deshabilitado: antes
     media igual que el habilitado y se pulsaba sin efecto. El degradado
     habilitado usa tonos mas hondos para que el texto blanco llegue a 4.5:1
     (el verde claro daba 2.6:1 y el azul 4.1:1). */
  #btnGuardarFicha:not(:disabled) {
    background: linear-gradient(135deg, #00806b, #0369a1);
  }

  #btnGuardarFicha:disabled {
    background: var(--surface-2);
    color: var(--text-dim);
    border-color: var(--border-subtle);
    cursor: not-allowed;
    opacity: 1;
    transform: none;
  }

  #btnGuardarFicha:disabled:hover {
    background: var(--surface-2);
    opacity: 1;
    transform: none;
  }

  /* Los encabezados de seccion usan los tokens de info y marca, que en claro
     quedaban en 4.1:1 y 4.5:1. Solo en claro: en oscuro esos mismos tokens
     ya pasan y oscurecerlos los hundiria. El :global es necesario: Astro
     colgaria el atributo de ambito del html, que no lo lleva. */
  :global([data-theme='light']) #modalNuevoMenor {
    --text-info: #0369a1;
    --text-brand: #006b59;
  }

  /* El croquis arranca apagado: el iframe de Google no recibe el domicilio
     hasta que alguien pulsa el boton. */
  .croquis-map-activar {
    position: absolute;
    inset: 0;
    z-index: 2;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 8px;
    padding: 12px;
    text-align: center;
    background: var(--surface-1);
  }

  .croquis-map-activar[hidden] {
    display: none;
  }

  .croquis-map-activar .btn-action {
    min-height: 36px;
  }

  .croquis-map-activar-nota {
    font-size: 12.5px;
    line-height: 1.35;
    color: var(--text-dim);
    max-width: 230px;
  }

  #formNuevoMenor .form-control::placeholder {
    color: var(--text-dim);
    opacity: 1;
  }

  #formNuevoMenor .form-control[aria-invalid='true'] {
    border-color: var(--gt-red, #dc2626);
  }

  #formNuevoMenor .form-control[aria-invalid='true']:focus {
    outline-color: var(--gt-red, #dc2626);
  }

  /* En pantalla tactil los controles se pulsan con el dedo: 44 px minimos. */
  @media (max-width: 768px), (pointer: coarse) {
    #modalNuevoMenor .btn-close-modal {
      min-width: 44px;
      min-height: 44px;
      display: inline-flex;
      align-items: center;
      justify-content: center;
    }

    #modalNuevoMenor .btn-gps-capture,
    #modalNuevoMenor .btn-panel-plegable,
    #modalNuevoMenor .btn-action,
    #modalNuevoMenor .modal-footer .btn-action {
      min-height: 44px;
    }

    /* Los campos median 39 px y "Limpiar Firma" 25: el pulgar falla el
       objetivo aunque el texto se lea. */
    #modalNuevoMenor .form-control {
      min-height: 44px;
    }

    /* La estrategia viene de su propio componente y no lleva el ambito de
       este: hay que declararla global dentro de la ficha. */
    #modalNuevoMenor :global(.estr-chip) {
      min-height: 44px;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    #modalNuevoMenor .modal-box {
      transition: none;
    }
  }
</style>

<script>
  import { iniciarFicha, iniciarCroquis } from '../scripts/ui/fichaInscripcion.js';
  import { iniciarTiposCampo } from '../scripts/ui/tiposCampo.js';
  import { conectarGrado } from '../scripts/ui/gradoEscolar.js';
  import { iniciarCajasArchivo } from '../scripts/ui/archivos.js';

  function prepararFicha() {
    iniciarTiposCampo();
    iniciarFicha();
    iniciarCajasArchivo();
    iniciarCroquis();
    // El grado se elige de la lista del nivel educativo; no se escribe.
    conectarGrado(
      document.getElementById('regNivelEducativo'),
      document.getElementById('regGrado'),
    );
  }

  prepararFicha();
  // Con las transiciones de Astro el documento se vuelve a pintar y los
  // escuchas se pierden: hay que reconectar sobre el marcado nuevo.
  document.addEventListener('astro:page-load', prepararFicha);
</script>