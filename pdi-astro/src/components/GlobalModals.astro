<script>
  import { iniciarFicha, iniciarCroquis } from '../scripts/ui/fichaInscripcion.js';
  import { iniciarTiposCampo } from '../scripts/ui/tiposCampo.js';
  import { conectarGrado } from '../scripts/ui/gradoEscolar.js';
  import { iniciarCajasArchivo } from '../scripts/ui/archivos.js';

  function prepararFicha() {
    iniciarTiposCampo();
    iniciarFicha();
    iniciarCajasArchivo();
    iniciarCroquis();
    // El grado se elige de la lista del nivel educativo; no se escribe.
    conectarGrado(
      document.getElementById('regNivelEducativo'),
      document.getElementById('regGrado'),
    );
  }

  prepararFicha();
  // Con las transiciones de Astro el documento se vuelve a pintar y los
  // escuchas se pierden: hay que reconectar sobre el marcado nuevo.
  document.addEventListener('astro:page-load', prepararFicha);
</script>