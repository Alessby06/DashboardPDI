---
interface Props {
  currentPage: string;
}

const { currentPage } = Astro.props;

const navItems = [
  { section: 'General' },
  { href: '/dashboard', page: 'dashboard', view: 'view-dashboard', label: 'Dashboard', roles: 'coord,facilitadora,promotora,social,admin', icon: 'dashboard' },
  { section: 'Módulos Operativos (PDI)' },
  { href: '/padron', page: 'padron', view: 'view-beneficiarios', label: 'Padrón de Usuarios', roles: 'coord,facilitadora,promotora,social,admin', icon: 'padron', badgeId: 'badgeTotalBeneficiarios', badgeVal: '28' },
  { href: '/salud', page: 'salud', view: 'view-salud', label: 'Servicio Alimentario Nutricional', roles: 'coord,facilitadora,admin', icon: 'salud' },
  { href: '/educativo', page: 'educativo', view: 'view-educativo', label: 'Casita del Saber', roles: 'coord,promotora,admin', icon: 'educativo' },
  { href: '/social', page: 'social', view: 'view-social', label: 'Área Social Pastoral', roles: 'coord,social,admin', icon: 'social', badgeId: 'badgeCasosCriticos', badgeVal: '4', badgeDanger: true },
  { href: '/sedes', page: 'sedes', view: 'view-sedes', label: 'Sedes e Iglesias', roles: 'coord,facilitadora,promotora,admin', icon: 'sedes' },
  { href: '/voluntariados', page: 'voluntariados', view: 'view-voluntarios', label: 'Voluntariados', roles: 'coord,facilitadora,promotora,social,admin', icon: 'voluntariados', badgeId: 'badgeTotalVoluntarios', badgeVal: '8' },
  { section: 'Auditoría' },
  { href: '/auditoria', page: 'auditoria', view: 'view-auditoria', label: 'Historial de Cambios', roles: 'coord,admin', icon: 'auditoria' },
  { section: 'Configuración' },
  { href: '/ajustes', page: 'ajustes', view: 'view-ajustes', label: 'Ajustes', roles: 'coord,facilitadora,promotora,social,admin', icon: 'ajustes' },
];
---

<aside class="sidebar" id="appSidebar">
  <div>
    <div class="sidebar-header">
      <div style="display:flex; align-items:center; gap:12px; flex:1; min-width:0;">
        <img
          src="/assets/jg-icon.png"
          alt="Isotipo Johannes Gutenberg"
          class="logo-official-icon"
          width="38"
          height="38"
          style="width:38px; height:38px; object-fit:contain; border-radius:6px; background:var(--surface-2); padding:3px; border:1px solid var(--border-subtle); flex-shrink:0;"
        />
        <div class="logo-text">
          <h1>Johannes Gutenberg</h1>
          <span>Programa Infancia Saludable</span>
        </div>
      </div>
    </div>

    <nav class="nav-sections" id="sidebarNav">
      <!-- Botón de cerrar sesión — encima de todo el menú -->
      <button
        type="button"
        id="btnSidebarLogout"
        class="nav-btn nav-btn-logout"
        data-tooltip="Cerrar sesión"
        aria-label="Cerrar sesión"
        onclick="try { localStorage.removeItem('pdi_sesion_activa'); localStorage.removeItem('pdi_active_role'); localStorage.removeItem('pdi_usuario_nombre'); localStorage.removeItem('pdi_session_token'); localStorage.removeItem('pdi_session_exp'); sessionStorage.clear(); } catch(e){} window.location.replace('/login');"
      >
        <svg fill="none" stroke-width="2" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" d="M15.75 9V5.25A2.25 2.25 0 0013.5 3h-6a2.25 2.25 0 00-2.25 2.25v13.5A2.25 2.25 0 007.5 21h6a2.25 2.25 0 002.25-2.25V15M12 9l-3 3m0 0l3 3m-3-3h12.75" />
        </svg>
        <span>Cerrar sesión</span>
      </button>
      {navItems.map((item) => {
        if (item.section) {
          return <div class="nav-label">{item.section}</div>;
        }

        const isActive = currentPage === item.page;
        return (
          <a
            href={item.href}
            class={`nav-btn ${isActive ? 'active' : ''}`}
            data-view={item.view}
            data-page={item.page}
            data-tooltip={item.label}
            data-roles={item.roles}
            data-astro-prefetch
          >
            {item.icon === 'dashboard' && (
              <svg fill="none" stroke-width="2" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" d="M3.75 6A2.25 2.25 0 016 3.75h2.25A2.25 2.25 0 0110.5 6v2.25a2.25 2.25 0 01-2.25 2.25H6a2.25 2.25 0 01-2.25-2.25V6zM3.75 15.75A2.25 2.25 0 016 13.5h2.25a2.25 2.25 0 012.25 2.25V18a2.25 2.25 0 01-2.25 2.25H6A2.25 2.25 0 013.75 18v-2.25zM13.5 6a2.25 2.25 0 012.25-2.25H18A2.25 2.25 0 0120.25 6v2.25A2.25 2.25 0 0118 10.5h-2.25a2.25 2.25 0 01-2.25-2.25V6zM13.5 15.75a2.25 2.25 0 012.25-2.25H18a2.25 2.25 0 012.25 2.25V18A2.25 2.25 0 0118 20.25h-2.25A2.25 2.25 0 0113.5 18v-2.25z" />
              </svg>
            )}
            {item.icon === 'padron' && (
              <svg fill="none" stroke-width="2" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" d="M15 19.128a9.38 9.38 0 002.625.372 9.337 9.337 0 004.121-.952 4.125 4.125 0 00-7.533-2.493M15 19.128v-.003c0-1.113-.285-2.16-.786-3.07M15 19.128v.106A12.318 12.318 0 018.624 21c-2.331 0-4.512-.645-6.374-1.766l-.001-.109a6.375 6.375 0 0111.964-3.07M12 6.375a3.375 3.375 0 11-6.75 0 3.375 3.375 0 016.75 0zm8.25 2.25a2.625 2.625 0 11-5.25 0 2.625 2.625 0 015.25 0z" />
              </svg>
            )}
            {item.icon === 'salud' && (
              <svg fill="none" stroke-width="2" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" d="M2.5 11.5h19a9.5 9.5 0 0 1-19 0z" />
                <path stroke-linecap="round" stroke-linejoin="round" d="M7.5 10c0-1.5 1.5-1.5 1.5-3s-1.5-1.5-1.5-3" />
                <path stroke-linecap="round" stroke-linejoin="round" d="M11.25 10c0-1.5 1.5-1.5 1.5-3s-1.5-1.5-1.5-3" />
                <path stroke-linecap="round" stroke-linejoin="round" d="M15 10c0-1.5 1.5-1.5 1.5-3s-1.5-1.5-1.5-3" />
              </svg>
            )}
            {item.icon === 'educativo' && (
              <svg fill="none" stroke-width="2" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" d="M4.26 10.147a60.436 60.436 0 00-.491 6.347A48.627 48.627 0 0112 20.904a48.627 48.627 0 018.232-4.41 60.46 60.46 0 00-.491-6.347m-15.482 0a50.57 50.57 0 00-2.658-.813A59.905 59.905 0 0112 3.493a59.902 59.902 0 0110.399 5.84c-.896.248-1.783.52-2.658.814m-15.482 0A50.697 50.697 0 0112 13.489a50.702 50.702 0 017.74-3.342" />
              </svg>
            )}
            {item.icon === 'social' && (
              <svg fill="none" stroke-width="2" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" d="M9 12.75L11.25 15 15 9.75m-3-7.036A11.959 11.959 0 013.598 6 11.99 11.99 0 003 9.749c0 5.592 3.824 10.29 9 11.623 5.176-1.332 9-6.03 9-11.622 0-1.31-.21-2.571-.598-3.751h-.152c-3.196 0-6.1-1.248-8.25-3.285z" />
              </svg>
            )}
            {item.icon === 'sedes' && (
              <svg fill="none" stroke-width="2" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" d="M15 10.5a3 3 0 11-6 0 3 3 0 016 0z" />
                <path stroke-linecap="round" stroke-linejoin="round" d="M19.5 10.5c0 7.142-7.5 11.25-7.5 11.25S4.5 17.642 4.5 10.5a7.5 7.5 0 1115 0z" />
              </svg>
            )}
            {item.icon === 'voluntariados' && (
              <svg fill="none" stroke-width="2" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" d="M18 18.72a9.094 9.094 0 003.741-.479 3 3 0 00-4.682-2.72m.94 3.198l.001.031c0 .225-.012.447-.037.666A11.944 11.944 0 0112 21c-2.17 0-4.207-.576-5.963-1.584A6.062 6.062 0 016 18.719m12 0a5.971 5.971 0 00-.941-3.197m0 0A5.995 5.995 0 0012 12.75a5.995 5.995 0 00-5.058 2.772m0 0a3 3 0 00-4.681 2.72 8.986 8.986 0 003.74.477m.94-3.197a5.971 5.971 0 00-.94 3.197M15 6.75a3 3 0 11-6 0 3 3 0 016 0zm6 3a2.25 2.25 0 11-4.5 0 2.25 2.25 0 014.5 0zm-13.5 0a2.25 2.25 0 11-4.5 0 2.25 2.25 0 014.5 0z" />
              </svg>
            )}
            {item.icon === 'auditoria' && (
              <svg fill="none" stroke-width="2" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" d="M19.5 14.25v-2.625a3.375 3.375 0 00-3.375-3.375h-1.5A1.125 1.125 0 0113.5 7.125v-1.5a3.375 3.375 0 00-3.375-3.375H8.25m0 12.75h7.5m-7.5 3H12M10.5 2.25H5.625c-.621 0-1.125.504-1.125 1.125v17.25c0 .621.504 1.125 1.125 1.125h12.75c.621 0 1.125-.504 1.125-1.125V11.25a9 9 0 00-9-9z" />
              </svg>
            )}
            {item.icon === 'ajustes' && (
              <svg fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
                <circle cx="12" cy="12" r="3" />
                <path stroke-linecap="round" stroke-linejoin="round" d="M19.4 15a1.65 1.65 0 00.33 1.82l.06.06a2 2 0 0 1 0 2.83 2 2 0 0 1-2.83 0l-.06-.06a1.65 1.65 0 00-1.82-.33 1.65 1.65 0 00-1 1.51V21a2 2 0 0 1-2 2 2 2 0 0 1-2-2v-.09A1.65 1.65 0 009 19.4a1.65 1.65 0 00-1.82.33l-.06.06a2 2 0 0 1-2.83 0 2 2 0 0 1 0-2.83l.06-.06a1.65 1.65 0 00.33-1.82 1.65 1.65 0 00-1.51-1H3a2 2 0 0 1-2-2 2 2 0 0 1 2-2h.09A1.65 1.65 0 004.6 9a1.65 1.65 0 00-.33-1.82l-.06-.06a2 2 0 0 1 0-2.83 2 2 0 0 1 2.83 0l.06.06a1.65 1.65 0 001.82.33H9a1.65 1.65 0 001-1.51V3a2 2 0 0 1 2-2 2 2 0 0 1 2 2v.09a1.65 1.65 0 001 1.51 1.65 1.65 0 001.82-.33l.06-.06a2 2 0 0 1 2.83 0 2 2 0 0 1 0 2.83l-.06.06a1.65 1.65 0 00-.33 1.82V9a1.65 1.65 0 001.51 1H21a2 2 0 0 1 2 2 2 2 0 0 1-2 2h-.09a1.65 1.65 0 00-1.51 1z" />
              </svg>
            )}
            <span>{item.label}</span>
            {item.badgeId && (
              <span
                class="nav-badge"
                id={item.badgeId}
                style={item.badgeDanger ? 'background: var(--gt-red-bg); color: var(--text-danger); border-color: var(--gt-red-border);' : undefined}
              >
                {item.badgeVal}
              </span>
            )}
          </a>
        );
      })}
    </nav>
  </div>
</aside>

<style>
  /* Botón de cerrar sesión — mismo layout que nav-btn, color rojo sutil */
  .nav-btn-logout {
    color: var(--text-danger, #dc2626) !important;
    margin-bottom: 6px;
    border-color: transparent !important;
  }

  .nav-btn-logout svg {
    stroke: var(--text-danger, #dc2626) !important;
  }

  .nav-btn-logout:hover {
    background: var(--gt-red-bg, rgba(239, 68, 68, 0.10)) !important;
    border-color: var(--gt-red-border, rgba(239, 68, 68, 0.3)) !important;
    color: var(--text-danger, #dc2626) !important;
    transform: translateX(2px);
  }

  .nav-btn-logout:active {
    transform: scale(0.98);
  }
</style>

<script is:inline>
  (function () {
    try {
      var rol = localStorage.getItem("pdi_active_role") || "coord";
      var btns = document.querySelectorAll("#sidebarNav .nav-btn[data-roles]");
      btns.forEach(function (btn) {
        var rolesStr = btn.getAttribute("data-roles") || "";
        var rolesList = rolesStr.split(",").map(function (r) { return r.trim(); });
        if (rolesList.length > 0 && rolesList.indexOf(rol) === -1) {
          btn.classList.add("role-restricted");
          btn.setAttribute("aria-disabled", "true");
          btn.onclick = function (e) {
            e.preventDefault();
            e.stopPropagation();
          };
        }
      });
    } catch (e) {}
  })();
</script>

<script>
  import { cerrarSesion } from '../scripts/auth/usuarios.js';

  function bindLogout() {
    const btn = document.getElementById('btnSidebarLogout');
    if (btn && !btn._logoutBound) {
      btn._logoutBound = true;
      btn.addEventListener('click', () => {
        cerrarSesion();
        window.location.replace('/login');
      });
    }
  }

  bindLogout();
  document.addEventListener('astro:page-load', bindLogout);
</script>
