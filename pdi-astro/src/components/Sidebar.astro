---
interface Props {
  currentPage: string;
}

import Icon from './Icon.astro';

const { currentPage } = Astro.props;

// Semántica del menú → alias del registro de iconos. Un solo mapa evita
// repetir condicionales con SVG por cada entrada.
const ICONO_DE_NAV = {
  dashboard: 'nav.panel',
  padron: 'nav.usuarios',
  colaboradores: 'nav.grupo',
  voluntariados: 'nav.voluntarios',
  salud: 'salud.medico',
  educativo: 'educacion.grado',
  social: 'salud.escudo',
  autorizaciones: 'estado.ok',
  solicitudes: 'estado.pendiente',
  sedes: 'lugar.ubicacion',
  auditoria: 'archivo.documento',
  ajustes: 'nav.ajustes',
};

const navItems = [
  { section: 'General' },
  { href: '/dashboard', page: 'dashboard', view: 'view-dashboard', label: 'Dashboard General', roles: 'coord,facilitadora,promotora,social,admin', icon: 'dashboard' },
  { section: 'Módulos Operativos (PDI)' },
  { href: '/padron', page: 'padron', view: 'view-beneficiarios', label: 'Padrón de Usuarios', roles: 'coord,facilitadora,promotora,social,admin', icon: 'padron', badgeId: 'badgeTotalBeneficiarios', badgeVal: '28' },
  // Modulo pedido en el menu, pero sin implementacion todavia: se deja en su
  // lugar para fijar el orden. No navega a ninguna parte.
  { placeholder: true, label: 'Padrón de Colaboradores', icon: 'colaboradores', roles: 'coord,facilitadora,promotora,social,admin' },
  { href: '/voluntariados', page: 'voluntariados', view: 'view-voluntarios', label: 'Padrón de Voluntarios', roles: 'coord,facilitadora,promotora,social,admin', icon: 'voluntariados', badgeId: 'badgeTotalVoluntarios', badgeVal: '8' },
  { href: '/salud', page: 'salud', view: 'view-salud', label: 'Servicio Alimentario Nutricional', roles: 'coord,facilitadora,admin', icon: 'salud' },
  { href: '/educativo', page: 'educativo', view: 'view-educativo', label: 'Servicio de Acompañamiento Educativo', roles: 'coord,promotora,admin', icon: 'educativo' },
  { href: '/social', page: 'social', view: 'view-social', label: 'Servicio Social Pastoral (ASP)', roles: 'coord,social,admin', icon: 'social', badgeId: 'badgeCasosCriticos', badgeVal: '4', badgeDanger: true },
  { href: '/social?tab=autorizaciones', page: 'social-autorizaciones', view: 'view-social-autorizaciones', label: 'Autorizaciones ASP', roles: 'coord,admin', icon: 'autorizaciones', badgeId: 'badgeSolicitudesPendientes', badgeVal: '0', badgeAmber: true, hideUnauthorized: true, subview: 'autorizaciones' },
  { href: '/social?tab=mis-solicitudes', page: 'social-solicitudes', view: 'view-social-solicitudes', label: 'Mis Solicitudes ASP', roles: 'social', icon: 'solicitudes', badgeId: 'badgeMisSolicitudesTotal', badgeVal: '0', hideUnauthorized: true, subview: 'mis-solicitudes' },
  { href: '/sedes', page: 'sedes', view: 'view-sedes', label: 'Sedes e Iglesias Aliadas', roles: 'coord,facilitadora,promotora,admin', icon: 'sedes' },
  { section: 'Auditoría' },
  { href: '/auditoria', page: 'auditoria', view: 'view-auditoria', label: 'Historial de Cambios', roles: 'coord,admin', icon: 'auditoria' },
  { section: 'Configuración' },
  { href: '/ajustes', page: 'ajustes', view: 'view-ajustes', label: 'Ajustes', roles: 'coord,facilitadora,promotora,social,admin', icon: 'ajustes' },
];
---

<aside class="sidebar" id="appSidebar">
  <div class="sidebar-main">
    <div class="sidebar-header">
      <div style="display:flex; align-items:center; gap:12px; flex:1; min-width:0;">
        <img
          src="/assets/jg-icon.png"
          alt="Isotipo Johannes Gutenberg"
          class="logo-official-icon"
          width="38"
          height="38"
          fetchpriority="high"
          decoding="async"
          style="width:38px; height:38px; object-fit:contain; border-radius:6px; background:var(--surface-2); padding:3px; border:1px solid var(--border-subtle); flex-shrink:0;"
        />
        <div class="logo-text">
          <h1>Johannes Gutenberg</h1>
          <span>Programa Infancia Saludable</span>
        </div>
      </div>
    </div>

    <div class="project-switcher" role="group" aria-label="Proyecto activo">
      <div class="project-option active" aria-current="true">
        <span class="project-name">Infancia Saludable</span>
        <span class="project-state">Activo</span>
      </div>
      <button type="button" class="project-option" disabled title="Proyecto Mamitas: en desarrollo">
        <span class="project-name">Mamitas</span>
        <span class="project-state">En desarrollo</span>
      </button>
    </div>

    <nav class="nav-sections" id="sidebarNav">
      <div class="nav-sections-inner" data-scroll-content>
      {navItems.map((item) => {
        if (item.section) {
          return <div class="nav-label">{item.section}</div>;
        }

        // Modulo todavia sin ruta nipantalla: se pinta como una entrada mas del
        // menu para fijar el orden, pero no lleva a ninguna parte.
        if (item.placeholder) {
          return (
            <span
              class="nav-btn nav-btn-placeholder"
              role="link"
              aria-disabled="true"
              title="Padrón de Colaboradores: en desarrollo"
            >
              {item.icon === 'colaboradores' && (
                <Icon name="nav.grupo" />
              )}
              <span>{item.label}</span>
            </span>
          );
        }

        const isActive = currentPage === item.page;
        return (
          <a
            href={item.href}
            class={`nav-btn ${isActive ? 'active' : ''}`}
            data-view={item.view}
            data-page={item.page}
            data-subview={item.subview}
            data-hide-unauthorized={item.hideUnauthorized ? 'true' : undefined}
            data-tooltip={item.label}
            data-roles={item.roles}
            data-astro-prefetch
          >
            <Icon name={ICONO_DE_NAV[item.icon]} />
            <span>{item.label}</span>
            {item.badgeId && (
              <span
                class={`nav-badge ${item.badgeAmber ? 'badge-amber' : ''}`}
                id={item.badgeId}
                style={item.badgeDanger ? 'background: var(--gt-red-bg); color: var(--text-danger); border-color: var(--gt-red-border);' : (item.badgeAmber ? 'display: none; background: var(--gt-amber-bg, rgba(245, 158, 11, 0.12)); color: var(--text-warning, #f59e0b); border-color: var(--gt-amber-border, rgba(245, 158, 11, 0.3));' : (item.page === 'social-solicitudes' ? 'display: none;' : undefined))}
              >
                {item.badgeVal}
              </span>
            )}
          </a>
        );
      })}
      </div>
    </nav>
  </div>

  <div class="sidebar-footer" style="padding:10px 14px 14px 14px; border-top:1px solid var(--border-subtle); background:var(--surface-1); margin-top:auto;">
    <button
      type="button"
      id="btnSidebarLogout"
      class="nav-btn nav-btn-logout"
      data-tooltip="Cerrar sesión"
      aria-label="Cerrar sesión"
      onclick="try { localStorage.removeItem('pdi_sesion_activa'); localStorage.removeItem('pdi_active_role'); localStorage.removeItem('pdi_usuario_nombre'); localStorage.removeItem('pdi_session_token'); localStorage.removeItem('pdi_session_exp'); sessionStorage.clear(); } catch(e){} window.location.replace('/login');"
    >
      <Icon name="nav.salir" />
      <span>Cerrar sesión</span>
    </button>
  </div>
</aside>

<style>
  /* Botón de cerrar sesión — mismo layout que nav-btn, color rojo sutil */
  .nav-btn-logout {
    color: var(--text-danger, #dc2626) !important;
    margin-bottom: 0;
    width: 100%;
    border-color: transparent !important;
  }

  /* El SVG vive en Icon.astro: el selector debe ser global para alcanzarlo. */
  :global(.nav-btn-logout svg) {
    stroke: var(--text-danger, #dc2626) !important;
  }

  .nav-btn-logout:hover {
    background: var(--gt-red-bg, rgba(239, 68, 68, 0.10)) !important;
    border-color: var(--gt-red-border, rgba(239, 68, 68, 0.3)) !important;
    color: var(--text-danger, #dc2626) !important;
    transform: translateX(2px);
  }

  .nav-btn-logout:active {
    transform: scale(0.98);
  }

  /* Badge ámbar para solicitudes pendientes */
  .nav-badge.badge-amber {
    background: var(--gt-amber-bg, rgba(245, 158, 11, 0.12)) !important;
    color: var(--text-warning, #f59e0b) !important;
    border-color: var(--gt-amber-border, rgba(245, 158, 11, 0.3)) !important;
  }

  /* Entrada sin modulo todavia (Padrón de Colaboradores): se ve en el menu,
     pero atenuada y sin destino. */
  .nav-btn-placeholder {
    cursor: not-allowed;
    opacity: 0.42;
    filter: grayscale(1);
    color: var(--text-dim);
  }

  .nav-btn-placeholder:hover {
    background: transparent;
    color: var(--text-muted);
    border-color: transparent;
    transform: none;
  }
</style>

<script is:inline>
  (function () {
    try {
      var rol = localStorage.getItem("pdi_active_role") || "coord";
      var btns = document.querySelectorAll("#sidebarNav [data-roles]");

      btns.forEach(function (btn) {
        var rolesStr = btn.getAttribute("data-roles") || "";
        var rolesList = rolesStr.split(",").map(function (r) { return r.trim(); });
        var permitido = rolesList.length === 0 || rolesList.indexOf(rol) !== -1;

        if (btn.hasAttribute("data-hide-unauthorized")) {
          btn.style.display = permitido ? "flex" : "none";
        } else {
          if (!permitido) {
            btn.classList.add("role-restricted");
            btn.setAttribute("aria-disabled", "true");
            btn.onclick = function (e) {
              e.preventDefault();
              e.stopPropagation();
            };
          }
        }
      });

      // Sincronización instantánea de active state para subrutas por parámetro (?tab=)
      if (window.location.pathname.indexOf("/social") !== -1) {
        var params = new URLSearchParams(window.location.search);
        var tab = params.get("tab");
        var btnSocial = document.querySelector('#sidebarNav .nav-btn[data-page="social"]');
        var btnAut = document.querySelector('#sidebarNav .nav-btn[data-subview="autorizaciones"]');
        var btnMisSol = document.querySelector('#sidebarNav .nav-btn[data-subview="mis-solicitudes"]');

        if (tab === "autorizaciones" && btnAut) {
          if (btnSocial) btnSocial.classList.remove("active");
          if (btnMisSol) btnMisSol.classList.remove("active");
          btnAut.classList.add("active");
        } else if (tab === "mis-solicitudes" && btnMisSol) {
          if (btnSocial) btnSocial.classList.remove("active");
          if (btnAut) btnAut.classList.remove("active");
          btnMisSol.classList.add("active");
        } else if (btnSocial) {
          if (btnAut) btnAut.classList.remove("active");
          if (btnMisSol) btnMisSol.classList.remove("active");
          btnSocial.classList.add("active");
        }
      }
    } catch (e) {}
  })();
</script>

<script>
  import { cerrarSesion } from '../scripts/auth/usuarios.js';

  function bindLogout() {
    const btn = document.getElementById('btnSidebarLogout');
    if (btn && !btn._logoutBound) {
      btn._logoutBound = true;
      btn.addEventListener('click', () => {
        cerrarSesion();
        window.location.replace('/login');
      });
    }
  }

  function bindSocialNavInteractions() {
    const navBtns = document.querySelectorAll('#sidebarNav .nav-btn[data-subview], #sidebarNav .nav-btn[data-page="social"]');
    navBtns.forEach((btn) => {
      if (btn._socialNavBound) return;
      btn._socialNavBound = true;
      btn.addEventListener('click', (e) => {
        if (btn.classList.contains('role-restricted')) return;
        if (window.location.pathname.includes('/social')) {
          e.preventDefault();
          const subview = btn.getAttribute('data-subview') || 'kanban';
          if (window.PDI?.SocialKanbanView) {
            window.PDI.SocialKanbanView.switchSocialTab(subview);
          }
          if (window.innerWidth <= 900 && window.closeSidebar) {
            window.closeSidebar();
          }
        }
      });
    });
  }

  bindLogout();
  bindSocialNavInteractions();
  document.addEventListener('astro:page-load', () => {
    bindLogout();
    bindSocialNavInteractions();
  });
</script>
