---
import Icon from './Icon.astro';
// Topbar: navegación y acceso al perfil. El logo institucional vive en el
// sidebar; aquí no se duplica. El nombre y el rol se leen en el encabezado,
// junto al avatar; el desplegable solo contiene acciones.
---

<header class="topbar" transition:persist="appTopbar">
  <div class="topbar-left">
    <button
      type="button"
      class="btn-menu-toggle"
      id="btnSidebarToggle"
      aria-label="Alternar menú lateral de navegación"
    >
      <Icon name="nav.menu" size={20} />
    </button>
  </div>

  <div class="topbar-right" id="topbarRight">
    <div class="topbar-identidad">
      <strong id="topbarUsuarioNombre">Sesión</strong>
      <span id="topbarUsuarioRol">Perfil</span>
    </div>
    <div class="topbar-perfil" id="topbarPerfil">
      <button
        type="button"
        class="topbar-avatar"
        id="btnPerfilMenu"
        aria-expanded="false"
        aria-controls="perfilMenu"
        aria-label="Abrir menú de la cuenta"
        title="Cuenta"
      >
        <img id="topbarAvatarFoto" alt="" src="data:image/svg+xml,%3Csvg xmlns='http://www.w3.org/2000/svg'/%3E" hidden />
        <span id="topbarAvatarIniciales" aria-hidden="true">?</span>
      </button>

      <!-- Popover de enlaces: se recorre con Tab y se cierra con Escape o al
           salir del foco. El foco vuelve al avatar al cerrar con Escape. -->
      <div class="topbar-menu" id="perfilMenu" aria-labelledby="btnPerfilMenu" hidden>
        <a href="/perfil" class="topbar-menu-item">
          <Icon name="nav.usuarios" size={16} />
          <span>Mi perfil</span>
        </a>
        <a href="/ajustes" class="topbar-menu-item">
          <Icon name="nav.ajustes" size={16} />
          <span>Ajustes</span>
        </a>
        <button type="button" class="topbar-menu-item topbar-menu-salir" id="btnPerfilSalir">
          <Icon name="nav.salir" size={16} />
          <span>Cerrar sesión</span>
        </button>
      </div>
    </div>
  </div>
</header>

<script is:inline>
  (function () {
    try {
      var nombre = localStorage.getItem("pdi_usuario_nombre") || "";
      var foto = localStorage.getItem("pdi_usuario_foto") || "";
      var rol = localStorage.getItem("pdi_active_role") || "";
      var roles = {
        coord: "Coordinación",
        facilitadora: "Facilitadora",
        promotora: "Promotora",
        social: "Trabajo Social",
        admin: "Administración TI"
      };
      var iniciales = nombre
        .split(/\s+/)
        .filter(Boolean)
        .slice(0, 2)
        .map(function (parte) { return parte.charAt(0).toUpperCase(); })
        .join("") || "?";
      var inicialesEl = document.getElementById("topbarAvatarIniciales");
      var fotoEl = document.getElementById("topbarAvatarFoto");
      var nombreEl = document.getElementById("topbarUsuarioNombre");
      var rolEl = document.getElementById("topbarUsuarioRol");
      if (inicialesEl) inicialesEl.textContent = iniciales;
      if (nombreEl && nombre) nombreEl.textContent = nombre;
      if (rolEl) rolEl.textContent = roles[rol] || "Perfil";
      if (fotoEl && foto) {
        fotoEl.src = foto;
        fotoEl.hidden = false;
        if (inicialesEl) inicialesEl.style.display = "none";
      }
    } catch (e) {}
  })();
</script>

<script>
  import { sincronizarSesion } from '../scripts/auth/usuarios.js';

  const ROLES = {
    coord: 'Coordinación',
    facilitadora: 'Facilitadora',
    promotora: 'Promotora',
    social: 'Trabajo Social',
    admin: 'Administración TI',
  };

  function inicialesDe(nombre) {
    return String(nombre || '')
      .split(/\s+/)
      .filter(Boolean)
      .slice(0, 2)
      .map((parte) => parte.charAt(0).toUpperCase())
      .join('') || '?';
  }

  function pintar(cuenta) {
    const iniciales = document.getElementById('topbarAvatarIniciales');
    const foto = document.getElementById('topbarAvatarFoto');
    const nombre = document.getElementById('topbarUsuarioNombre');
    const rol = document.getElementById('topbarUsuarioRol');
    const nombreTexto = cuenta?.nombre || localStorage.getItem('pdi_usuario_nombre') || '';
    const fotoTexto = cuenta?.foto || localStorage.getItem('pdi_usuario_foto') || '';
    const rolTexto = cuenta?.rol || localStorage.getItem('pdi_active_role') || '';

    if (iniciales) {
      iniciales.textContent = inicialesDe(nombreTexto);
      iniciales.style.display = fotoTexto ? 'none' : '';
    }
    if (foto) {
      if (fotoTexto) {
        foto.src = fotoTexto;
        foto.hidden = false;
      } else {
        foto.removeAttribute('src');
        foto.hidden = true;
      }
    }
    if (nombre) nombre.textContent = nombreTexto || 'Sesión';
    if (rol) rol.textContent = ROLES[rolTexto] || 'Perfil';
  }

  let temporizadorMenu = null;

  function abrirMenu() {
    const menu = document.getElementById('perfilMenu');
    const boton = document.getElementById('btnPerfilMenu');
    if (!menu || !boton) return;
    clearTimeout(temporizadorMenu);
    menu.hidden = false;
    // Forzar el estilo inicial antes de añadir la clase: así la transición
    // se ve incluso si la pestaña no está pintando frames (headless/segundo
    // plano), donde requestAnimationFrame puede no ejecutarse.
    void menu.offsetWidth;
    menu.classList.add('is-open');
    boton.setAttribute('aria-expanded', 'true');
    const primero = menu.querySelector('.topbar-menu-item');
    primero?.focus?.({ preventScroll: true });
  }

  function cerrarMenu(devolverFoco = false) {
    const menu = document.getElementById('perfilMenu');
    const boton = document.getElementById('btnPerfilMenu');
    if (!menu || menu.hidden) return;
    menu.classList.remove('is-open');
    if (boton) boton.setAttribute('aria-expanded', 'false');
    clearTimeout(temporizadorMenu);
    // Se oculta después de la transición; si se reabre antes, el timer se
    // cancela y el menú no parpadea.
    temporizadorMenu = setTimeout(() => {
      if (!menu.classList.contains('is-open')) menu.hidden = true;
    }, 230);
    if (devolverFoco) boton?.focus?.({ preventScroll: true });
  }

  function alternarMenu() {
    const menu = document.getElementById('perfilMenu');
    const boton = document.getElementById('btnPerfilMenu');
    if (!menu || !boton) return;
    if (!menu.hidden && menu.classList.contains('is-open')) {
      cerrarMenu(true);
      return;
    }
    abrirMenu();
  }

  function conectar() {
    const boton = document.getElementById('btnPerfilMenu');
    const salir = document.getElementById('btnPerfilSalir');
    if (boton && !boton.dataset.listener) {
      boton.dataset.listener = '1';
      boton.addEventListener('click', (e) => {
        e.preventDefault();
        e.stopPropagation();
        alternarMenu();
      });
    }
    if (salir && !salir.dataset.listener) {
      salir.dataset.listener = '1';
      salir.addEventListener('click', () => {
        window.PDI?.Auth?.cerrarSesion?.();
        window.location.replace('/login');
      });
    }
    const contenedor = document.getElementById('topbarPerfil');
    if (contenedor && !contenedor.dataset.listener) {
      contenedor.dataset.listener = '1';
      // Tab fuera del popover: se cierra y el foco sigue su camino natural.
      contenedor.addEventListener('focusout', (e) => {
        if (!contenedor.contains(e.relatedTarget)) cerrarMenu(false);
      });
    }
    if (!window.__pdiPerfilMenuGlobal) {
      window.__pdiPerfilMenuGlobal = true;
      document.addEventListener('click', (e) => {
        if (!e.target.closest?.('#topbarPerfil')) cerrarMenu(false);
      });
      document.addEventListener('keydown', (e) => {
        if (e.key !== 'Escape') return;
        const menu = document.getElementById('perfilMenu');
        if (menu && !menu.hidden) {
          e.preventDefault();
          cerrarMenu(true);
        }
      });
    }
  }

  async function actualizar() {
    // Primero las marcas locales: el topbar del documento nuevo se pinta al
    // instante y no queda un hueco mientras se confirma la sesión.
    pintar({});
    conectar();
    // Al cambiar de documento el avatar persiste; el menú no debe quedarse
    // abierto sobre la página nueva.
    cerrarMenu(false);
    try {
      const cuenta = await sincronizarSesion();
      if (cuenta) pintar(cuenta);
    } catch (e) {
      // Caída o error del servidor: se conserva lo último pintado. La sesión
      // no se cierra; el perfil muestra el aviso y permite reintentar.
    }
  }

  document.addEventListener('astro:page-load', actualizar);
  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', actualizar, { once: true });
  } else {
    actualizar();
  }
</script>

<style>
  .topbar-right {
    display: flex;
    align-items: center;
    gap: 8px;
  }

  .topbar-perfil {
    position: relative;
  }

  .topbar-avatar {
    position: relative;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 40px;
    height: 40px;
    padding: 0;
    border-radius: 50%;
    border: 1px solid var(--border-subtle);
    background: var(--surface-2);
    color: var(--text-muted);
    font-size: 12.5px;
    font-weight: 800;
    letter-spacing: 0.02em;
    cursor: pointer;
    overflow: hidden;
    transition: border-color var(--dur-fast) var(--ease-smooth),
      background-color var(--dur-fast) var(--ease-smooth);
  }

  @media (hover: hover) and (pointer: fine) {
    .topbar-avatar:hover {
      border-color: var(--border-bright);
      background: var(--surface-hover);
    }
  }

  .topbar-avatar:active {
    transform: scale(0.97);
  }

  .topbar-avatar:focus-visible {
    outline: 2px solid var(--gt-green);
    outline-offset: 2px;
  }

  .topbar-avatar img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }

  .topbar-avatar img[hidden] {
    display: none;
  }

  .topbar-menu {
    position: absolute;
    top: calc(100% + 8px);
    right: 0;
    width: 232px;
    padding: 6px;
    border-radius: var(--radius-md);
    border: 1px solid var(--border-subtle);
    background: var(--surface-1);
    box-shadow: var(--shadow-overlay);
    z-index: 1200;
    display: flex;
    flex-direction: column;
    gap: 2px;
    opacity: 0;
    transform: translateY(-6px) scale(0.98);
    transform-origin: top right;
    pointer-events: none;
    transition: opacity var(--dur-fast) var(--ease-smooth),
      transform var(--dur-norm) var(--ease-drawer);
  }

  .topbar-menu.is-open {
    opacity: 1;
    transform: none;
    pointer-events: auto;
  }

  .topbar-menu[hidden] {
    display: none;
  }

  /* Identidad en el encabezado: nombre y rol, un paso por encima del menú. */
  .topbar-identidad {
    display: flex;
    flex-direction: column;
    align-items: flex-end;
    gap: 1px;
    min-width: 0;
    margin-right: 4px;
    text-align: right;
  }

  .topbar-identidad strong {
    max-width: 220px;
    font-size: 14px;
    font-weight: 700;
    line-height: 1.2;
    color: var(--text-main);
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }

  .topbar-identidad span {
    max-width: 220px;
    font-size: 11.5px;
    font-weight: 600;
    line-height: 1.2;
    color: var(--text-muted);
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }

  @media (max-width: 520px) {
    .topbar-identidad strong {
      max-width: 148px;
      font-size: 13px;
    }

    .topbar-identidad span {
      max-width: 148px;
      font-size: 11px;
    }
  }

  .topbar-menu-item {
    display: flex;
    align-items: center;
    gap: 9px;
    width: 100%;
    padding: 9px 10px;
    border: 0;
    border-radius: 7px;
    background: transparent;
    color: var(--text-muted);
    font-family: var(--ui-font);
    font-size: 12.5px;
    font-weight: 600;
    text-align: left;
    text-decoration: none;
    cursor: pointer;
  }

  @media (hover: hover) and (pointer: fine) {
    .topbar-menu-item:hover {
      background: var(--surface-hover);
      color: var(--text-main);
    }
  }

  .topbar-menu-item:active {
    transform: scale(0.98);
  }

  .topbar-menu-item svg {
    flex-shrink: 0;
    stroke: currentColor;
  }

  .topbar-menu-salir {
    color: var(--text-danger, #dc2626);
  }

  @media (hover: hover) and (pointer: fine) {
    .topbar-menu-salir:hover {
      background: var(--gt-red-bg, rgba(239, 68, 68, 0.1));
      color: var(--text-danger, #dc2626);
    }
  }
</style>
