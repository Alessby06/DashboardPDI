---
import AppLayout from '../layouts/AppLayout.astro';
import '../styles/views-dashboard.css';
---

<AppLayout title="Dashboard General" currentPage="dashboard">
  <section class="app-view active" id="view-dashboard">
    <!-- Header Operativo Sobrio -->
    <div class="view-header dash-header-clean">
      <div class="view-title-group">
        <div class="dash-title-row">
          <h2>Dashboard General</h2>
        </div>
        <p class="dash-subtitle">
          Supervisión integral de cobertura nutricional, tamizaje de salud y acompañamiento en casitas.
        </p>
      </div>
      <div class="dash-header-actions">
        <button type="button" class="btn-action-icon btn-audit-export-icon" id="btnExportDashboardCSV"
          onclick="window.openModalExportDashboard ? window.openModalExportDashboard() : window.exportDataCSV()"
          aria-label="Descargar Informe CSV" title="Descargar Informe Consolidado CSV">
          <svg width="18" height="18" fill="none" stroke="currentColor" stroke-width="2.2" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round"
              d="M3 16.5v2.25A2.25 2.25 0 005.25 21h13.5A2.25 2.25 0 0021 18.75V16.5M16.5 12L12 16.5m0 0L7.5 12m4.5 4.5V3" />
          </svg>
        </button>
      </div>
    </div>

    <!-- Tira de Métricas Operativas Clave (Placas) -->
    <div class="dash-kpi-strip" id="kpiDashboardContainer" data-snap>
      <div class="dash-kpi-plate">
        <span class="dash-kpi-label">Usuarios Activos</span>
        <div class="dash-kpi-value" id="dashKpiBeneficiarios">—</div>
        <div class="dash-kpi-context">100% inscritos en el programa</div>
      </div>
      <div class="dash-kpi-plate">
        <span class="dash-kpi-label">Atención CRED</span>
        <div class="dash-kpi-value" id="dashKpiTamizados">—</div>
        <div class="dash-kpi-context">Control vigente con dosaje Hb</div>
      </div>
      <div class="dash-kpi-plate">
        <span class="dash-kpi-label">Asistencia en Casitas</span>
        <div class="dash-kpi-value" id="dashKpiAsistencia">—</div>
        <div class="dash-kpi-context">Promedio territorial consolidado</div>
      </div>
      <div class="dash-kpi-plate is-alert">
        <span class="dash-kpi-label">Casos en Alerta</span>
        <div class="dash-kpi-value" id="dashKpiCasosSociales">—</div>
        <div class="dash-kpi-context">Seguimiento clínico o social activo</div>
      </div>
    </div>

    <!-- Rejilla Principal: Semáforo Clínico y Cobertura Territorial -->
    <div class="dash-charts-grid" data-snap>

      <div class="panel dash-anemia-panel stagger-item" id="widgetAnemiaStatus">
        <div class="panel-head dash-anemia-panel-head">
          <div class="panel-title dash-anemia-panel-title">
            <svg width="16" height="16" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" d="M10.5 6a7.5 7.5 0 107.5 7.5h-7.5V6z"></path><path stroke-linecap="round" stroke-linejoin="round" d="M13.5 10.5H21A7.5 7.5 0 0013.5 3v7.5z"></path></svg>
            <span>Estado Nutricional y Anemia</span>
          </div>
          <a href="/salud" class="panel-link dash-anemia-panel-link" title="Abrir módulo de salud">Ver Servicio Alimentario<svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" d="M8.25 4.5l7.5 7.5-7.5 7.5"></path></svg></a>
        </div>
        <div class="dash-anemia-panel-table" id="dashAnemiaTable">
          <div class="dash-anemia-line" data-band="normal">
            <span class="dash-anemia-line-dot"></span>
            <div>
              <span class="dash-anemia-line-name">Normal</span>
              <span class="dash-anemia-line-note">Control vigente · dosaje anual</span>
            </div>
            <span class="dash-anemia-line-range">≥ 11.0 g/dL</span>
            <div>
              <span class="dash-anemia-line-pct" id="anemiaPctNormal">—</span>
              <span class="dash-anemia-line-cases"><span id="anemiaLegendNormal">—</span> casos</span>
            </div>
            <span class="dash-anemia-line-track"><span class="dash-anemia-line-fill" id="segAnemiaNormal" style="width: 0%"></span></span>
          </div>
          <div class="dash-anemia-line" data-band="leve">
            <span class="dash-anemia-line-dot"></span>
            <div>
              <span class="dash-anemia-line-name">Anemia Leve</span>
              <span class="dash-anemia-line-note">Seguimiento trimestral en casita</span>
            </div>
            <span class="dash-anemia-line-range">10.0 – 10.9 g/dL</span>
            <div>
              <span class="dash-anemia-line-pct" id="anemiaPctLeve">—</span>
              <span class="dash-anemia-line-cases"><span id="anemiaLegendLeve">—</span> casos</span>
            </div>
            <span class="dash-anemia-line-track"><span class="dash-anemia-line-fill" id="segAnemiaLeve" style="width: 0%"></span></span>
          </div>
          <div class="dash-anemia-line" data-band="mod">
            <span class="dash-anemia-line-dot"></span>
            <div>
              <span class="dash-anemia-line-name">Anemia Mod/Sev</span>
              <span class="dash-anemia-line-note">Derivación prioritaria a salud</span>
            </div>
            <span class="dash-anemia-line-range">&lt; 10.0 g/dL</span>
            <div>
              <span class="dash-anemia-line-pct" id="anemiaPctMod">—</span>
              <span class="dash-anemia-line-cases"><span id="anemiaLegendMod">—</span> casos</span>
            </div>
            <span class="dash-anemia-line-track"><span class="dash-anemia-line-fill" id="segAnemiaMod" style="width: 0%"></span></span>
          </div>
        </div>
      </div>


      <div class="panel dash-coverage-panel stagger-item" id="widgetCoverageStatus">
        <div class="panel-head dash-coverage-head">
          <div class="panel-title dash-coverage-title">
            <svg width="16" height="16" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" d="M15 10.5a3 3 0 11-6 0 3 3 0 016 0z"></path><path stroke-linecap="round" stroke-linejoin="round" d="M19.5 10.5c0 7.142-7.5 11.25-7.5 11.25S4.5 17.642 4.5 10.5a7.5 7.5 0 1115 0z"></path></svg>
            <span>Cobertura Territorial por Distrito</span>
          </div>
          <a href="/sedes" class="panel-link dash-coverage-link" title="Abrir directorio de sedes">Ver Sedes e Iglesias<svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" d="M8.25 4.5l7.5 7.5-7.5 7.5"></path></svg></a>
        </div>
        <div class="dash-territory-list" id="dashDistrictCoverage">
          <div class="dash-territory-row" data-dist="comas">
            <div class="dash-territory-share-info">
              <strong>Distrito de Comas</strong>
              <span class="dash-territory-share-sub">Año Nuevo, La Libertad, Carmen Alto</span>
            </div>
            <div class="dash-territory-share">
              <span class="dash-territory-share-pct" id="pctDistrict_comas">—</span>
              <span class="dash-territory-share-badge" id="badgeDistrict_comas">—</span>
            </div>
            <div class="dash-territory-track"><div class="dash-territory-bar green" style="width: 0%;" data-target-width="0%" id="barDistrict_comas"></div></div>
          </div>
          <div class="dash-territory-row" data-dist="carabayllo">
            <div class="dash-territory-share-info">
              <strong>Distrito de Carabayllo</strong>
              <span class="dash-territory-share-sub">El Progreso, San Pedro, Los Bendecidos, Santa Rosa</span>
            </div>
            <div class="dash-territory-share">
              <span class="dash-territory-share-pct" id="pctDistrict_carabayllo">—</span>
              <span class="dash-territory-share-badge" id="badgeDistrict_carabayllo">—</span>
            </div>
            <div class="dash-territory-track"><div class="dash-territory-bar blue" style="width: 0%;" data-target-width="0%" id="barDistrict_carabayllo"></div></div>
          </div>
        </div>
        <div class="dash-territory-sede-pills" id="dashDistrictSedePills">
          <div class="dash-territory-sede-pill-row">
            <span class="dash-sede-pill dash-sede-pill--comas" data-count="4" title="Año Nuevo: 4 usuarios">Año Nuevo</span>
            <span class="dash-sede-pill dash-sede-pill--comas" data-count="2" title="La Libertad: 2 usuarios">La Libertad</span>
            <span class="dash-sede-pill dash-sede-pill--comas" data-count="1" title="Carmen Alto: 1 usuarios">Carmen Alto</span>
          </div>
          <div class="dash-territory-sede-pill-row">
            <span class="dash-sede-pill dash-sede-pill--carabayllo" data-count="1" title="El Progreso: 1 usuarios">El Progreso</span>
            <span class="dash-sede-pill dash-sede-pill--carabayllo" data-count="3" title="San Pedro: 3 usuarios">San Pedro</span>
            <span class="dash-sede-pill dash-sede-pill--carabayllo" data-count="1" title="Los Bendecidos: 1 usuarios">Los Bendecidos</span>
            <span class="dash-sede-pill dash-sede-pill--carabayllo" data-count="1" title="Santa Rosa: 1 usuarios">Santa Rosa</span>
          </div>
        </div>
      </div>
    </div>

    <!-- Foco Operativo Inferior: Casos Prioritarios y Bitácora -->
    <div class="dash-operational-grid" data-snap>
      <!-- Casos Prioritarios -->
      <div class="card" id="widgetPriorityCases">
        <div class="card-header">
          <div class="dash-card-header-flex">
            <div class="card-title">
              <svg width="18" height="18" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24" aria-hidden="true" style="color: var(--gt-red);"><path stroke-linecap="round" stroke-linejoin="round" d="M12 9v3.75m9-.75a9 9 0 11-18 0 9 9 0 0118 0zm-9 3.75h.008v.008H12v-.008z"></path></svg>
              <span>Usuarios con Atención Prioritaria</span>
            </div>
          </div>
        </div>
        <div class="dash-priority-list" id="dashPriorityCasesList">
          <!-- Inyectado dinámicamente vía DashboardView.renderPriorityCases -->
        </div>
      </div>

      <!-- Bitácora Reciente -->
      <div class="card stagger-item stagger-animate" id="widgetRecentActivity" style="animation-delay: 90ms;">
        <div class="card-header">
          <div class="dash-card-header-flex">
            <div class="card-title">
              <svg width="18" height="18" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24" aria-hidden="true" style="color: var(--gt-green);"><path stroke-linecap="round" stroke-linejoin="round" d="M12 6v6h4.5m4.5 0a9 9 0 11-18 0 9 9 0 0118 0z"></path></svg>
              <span>Actividad Reciente del Programa</span>
            </div>
            <a href="/auditoria" class="dash-card-action" title="Abrir bitácora completa">
              <span>Ver Historial de Cambios</span>
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" d="M8.25 4.5l7.5 7.5-7.5 7.5"></path></svg>
            </a>
          </div>
        </div>
        <div class="dash-timeline-list" id="dashRecentActivityList">
          <!-- Inyectado dinámicamente vía DashboardView.renderRecentActivity -->
        </div>
      </div>
    </div>
  </section>

  <!-- Script del cliente -->
  <script>
    import '../scripts/pages/dashboard.js';
  </script>
</AppLayout>
