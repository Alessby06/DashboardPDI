---
import AppLayout from '../layouts/AppLayout.astro';
import '../styles/views-dashboard.css';
---

<AppLayout title="Dashboard General" currentPage="dashboard">
  <section class="app-view active" id="view-dashboard">
    <!-- Header Operativo Sobrio -->
    <div class="view-header dash-header-clean">
      <div class="view-title-group">
        <div class="dash-title-row">
          <h2>Dashboard General</h2>
        </div>
        <p class="dash-subtitle">
          Supervisión integral de cobertura nutricional, tamizaje de salud y acompañamiento en casitas.
        </p>
      </div>
      <div class="dash-header-actions">
        <button type="button" class="btn-action-icon btn-audit-export-icon" id="btnExportDashboardCSV"
          onclick="window.openModalExportDashboard ? window.openModalExportDashboard() : window.exportDataCSV()"
          aria-label="Descargar Informe CSV" title="Descargar Informe Consolidado CSV">
          <svg width="18" height="18" fill="none" stroke="currentColor" stroke-width="2.2" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round"
              d="M3 16.5v2.25A2.25 2.25 0 005.25 21h13.5A2.25 2.25 0 0021 18.75V16.5M16.5 12L12 16.5m0 0L7.5 12m4.5 4.5V3" />
          </svg>
        </button>
      </div>
    </div>

    <!-- Tira de Métricas Operativas Clave (Placas) -->
    <div class="plq-grid" id="kpiDashboardContainer">
      <div class="plq-card">
        <div class="plq-top">
          <span class="plq-label">Beneficiarios Activos</span>
        </div>
        <div class="plq-val" id="dashKpiBeneficiarios">15</div>
        <div class="plq-meta">100% matriculados en el programa</div>
      </div>
      <div class="plq-card">
        <div class="plq-top">
          <span class="plq-label">Tamizados CRED</span>
        </div>
        <div class="plq-val" id="dashKpiTamizados">15/15</div>
        <div class="plq-meta">Control vigente con dosaje Hb</div>
      </div>
      <div class="plq-card">
        <div class="plq-top">
          <span class="plq-label">Asistencia en Casitas</span>
        </div>
        <div class="plq-val" id="dashKpiAsistencia">92.4%</div>
        <div class="plq-meta">Promedio territorial consolidado</div>
      </div>
      <div class="plq-card">
        <div class="plq-top">
          <span class="plq-label">Casos en Alerta</span>
        </div>
        <div class="plq-val alert" id="dashKpiCasosSociales">0</div>
        <div class="plq-meta">Seguimiento clínico o social activo</div>
      </div>
    </div>

    <!-- Rejilla Principal: Semáforo Clínico y Cobertura Territorial -->
    <div class="dash-charts-grid">
      <div class="card stagger-item dash-anemia-table-card" id="widgetAnemiaStatus">
        <div class="card-header">
          <div class="dash-card-header-flex">
            <div class="card-title">
              <svg width="18" height="18" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24" aria-hidden="true" style="color: var(--gt-yellow);"><path stroke-linecap="round" stroke-linejoin="round" d="M10.5 6a7.5 7.5 0 107.5 7.5h-7.5V6z"></path><path stroke-linecap="round" stroke-linejoin="round" d="M13.5 10.5H21A7.5 7.5 0 0013.5 3v7.5z"></path></svg>
              <span>Estado Nutricional y Anemia</span>
            </div>
            <a href="/salud" class="dash-card-action" title="Abrir módulo de salud">
              <span>Ver Servicio Alimentario</span>
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" d="M8.25 4.5l7.5 7.5-7.5 7.5"></path></svg>
            </a>
          </div>
        </div>
        <div class="dash-anemia-rows" id="dashAnemiaTable">
          <div class="dash-anemia-row" data-band="normal">
          <div class="dash-anemia-row-topline">
            <span class="dash-anemia-row-count" id="anemiaLegendNormal">7</span>
            <span class="dash-anemia-row-name">Normal</span>
            <span class="dash-anemia-row-range">≥ 11.0 g/dL</span>
            <span class="dash-anemia-row-pct" id="anemiaPctNormal">47%</span>
          </div>
          <div class="dash-anemia-row-track"><span class="dash-anemia-fill normal dash-anemia-row-fill" id="segAnemiaNormal" style="width: 0%;"></span></div>
          <p class="dash-anemia-row-note">Control vigente · dosaje anual</p>
        </div>
          <div class="dash-anemia-row" data-band="leve">
          <div class="dash-anemia-row-topline">
            <span class="dash-anemia-row-count" id="anemiaLegendLeve">6</span>
            <span class="dash-anemia-row-name">Anemia Leve</span>
            <span class="dash-anemia-row-range">10.0 – 10.9 g/dL</span>
            <span class="dash-anemia-row-pct" id="anemiaPctLeve">40%</span>
          </div>
          <div class="dash-anemia-row-track"><span class="dash-anemia-fill leve dash-anemia-row-fill" id="segAnemiaLeve" style="width: 0%;"></span></div>
          <p class="dash-anemia-row-note">Seguimiento trimestral en casita</p>
        </div>
          <div class="dash-anemia-row" data-band="mod">
          <div class="dash-anemia-row-topline">
            <span class="dash-anemia-row-count" id="anemiaLegendMod">2</span>
            <span class="dash-anemia-row-name">Anemia Mod/Sev</span>
            <span class="dash-anemia-row-range">&lt; 10.0 g/dL</span>
            <span class="dash-anemia-row-pct" id="anemiaPctMod">13%</span>
          </div>
          <div class="dash-anemia-row-track"><span class="dash-anemia-fill mod dash-anemia-row-fill" id="segAnemiaMod" style="width: 0%;"></span></div>
          <p class="dash-anemia-row-note">Derivación prioritaria a salud</p>
        </div>
        </div>
      </div>

      <div class="card stagger-item" id="widgetCoverageStatus">
        <div class="card-header">
          <div class="dash-card-header-flex">
            <div class="card-title">
              <svg width="18" height="18" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24" aria-hidden="true" style="color: var(--gt-blue);"><path stroke-linecap="round" stroke-linejoin="round" d="M15 10.5a3 3 0 11-6 0 3 3 0 016 0z"></path><path stroke-linecap="round" stroke-linejoin="round" d="M19.5 10.5c0 7.142-7.5 11.25-7.5 11.25S4.5 17.642 4.5 10.5a7.5 7.5 0 1115 0z"></path></svg>
              <span>Cobertura Territorial por Distrito</span>
            </div>
            <a href="/sedes" class="dash-card-action" title="Abrir directorio de sedes">
              <span>Ver Sedes e Iglesias</span>
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" d="M8.25 4.5l7.5 7.5-7.5 7.5"></path></svg>
            </a>
          </div>
        </div>
        <div class="dash-territory-list dash-territory-list--hierarchy" id="dashDistrictCoverage">
          <div class="dash-territory-row dash-territory-row--share" data-dist="comas">
            <div class="dash-territory-share">
              <span class="dash-territory-share-pct" id="pctDistrict_comas">53%</span>
              <span class="dash-territory-share-badge" id="badgeDistrict_comas">8 menores</span>
            </div>
            <div class="dash-territory-share-info">
              <strong>Distrito de Comas</strong>
              <span class="dash-territory-share-sub">Sedes (3): Año Nuevo, La Libertad, Carmen Alto</span>
            </div>
            <div class="dash-territory-track"><div class="dash-territory-bar green" style="width: 0%;" data-target-width="53%" id="barDistrict_comas"></div></div>
          </div>
          <div class="dash-territory-row dash-territory-row--share" data-dist="carabayllo">
            <div class="dash-territory-share">
              <span class="dash-territory-share-pct" id="pctDistrict_carabayllo">47%</span>
              <span class="dash-territory-share-badge" id="badgeDistrict_carabayllo">7 menores</span>
            </div>
            <div class="dash-territory-share-info">
              <strong>Distrito de Carabayllo</strong>
              <span class="dash-territory-share-sub">Sedes (4): El Progreso, San Pedro, Los Bendecidos, Santa Rosa</span>
            </div>
            <div class="dash-territory-track"><div class="dash-territory-bar blue" style="width: 0%;" data-target-width="47%" id="barDistrict_carabayllo"></div></div>
          </div>
        </div>
        <div class="dash-territory-sede-pills" id="dashDistrictSedePills"></div>
      </div>
    </div>

    <!-- Foco Operativo Inferior: Casos Prioritarios y Bitácora -->
    <div class="dash-operational-grid">
      <!-- Casos Prioritarios -->
      <div class="card" id="widgetPriorityCases">
        <div class="card-header">
          <div class="dash-card-header-flex">
            <div class="card-title">
              <svg width="18" height="18" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24" aria-hidden="true" style="color: var(--gt-red);"><path stroke-linecap="round" stroke-linejoin="round" d="M12 9v3.75m9-.75a9 9 0 11-18 0 9 9 0 0118 0zm-9 3.75h.008v.008H12v-.008z"></path></svg>
              <span>Menores con Atención Prioritaria</span>
            </div>
          </div>
        </div>
        <div class="dash-priority-list" id="dashPriorityCasesList">
          <!-- Inyectado dinámicamente vía DashboardView.renderPriorityCases -->
        </div>
      </div>

      <!-- Bitácora Reciente -->
      <div class="card stagger-item stagger-animate" id="widgetRecentActivity" style="animation-delay: 90ms;">
        <div class="card-header">
          <div class="dash-card-header-flex">
            <div class="card-title">
              <svg width="18" height="18" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24" aria-hidden="true" style="color: var(--gt-green);"><path stroke-linecap="round" stroke-linejoin="round" d="M12 6v6h4.5m4.5 0a9 9 0 11-18 0 9 9 0 0118 0z"></path></svg>
              <span>Actividad Reciente del Programa</span>
            </div>
            <a href="/auditoria" class="dash-card-action" title="Abrir bitácora completa">
              <span>Ver Historial de Cambios</span>
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" d="M8.25 4.5l7.5 7.5-7.5 7.5"></path></svg>
            </a>
          </div>
        </div>
        <div class="dash-timeline-list" id="dashRecentActivityList">
          <!-- Inyectado dinámicamente vía DashboardView.renderRecentActivity -->
        </div>
      </div>
    </div>
  </section>

  <!-- Script del cliente -->
  <script>
    import '../scripts/pages/dashboard.js';
  </script>
</AppLayout>
