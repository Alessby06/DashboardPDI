---
import AppLayout from '../layouts/AppLayout.astro';
import '../styles/views-dashboard.css';
import Icon from '../components/Icon.astro';
---

<AppLayout title="Dashboard General" currentPage="dashboard">
  <section class="app-view active" id="view-dashboard">
    <div class="dash-page">
      <header class="dash-cabecera">
        <div class="dash-cabecera-texto">
          <p class="dash-eyebrow">Infancia Saludable · Comas y Carabayllo</p>
          <h1 class="dash-titulo"><time id="dashFolioFecha">hoy</time></h1>
          <p class="dash-subtitulo">
            <span><strong id="kpiSedesActivas">—</strong> sedes activas</span>
            <span class="dash-punto-vivo" id="dashEstado" role="status" aria-label="Estado de conexión">
              <span class="dash-estado-dot" aria-hidden="true"></span>
              <span id="dashEstadoTexto">Cargando…</span>
              <span id="dashEstadoHace" hidden></span>
            </span>
          </p>
        </div>
        <div class="dash-acciones">
          <div class="dash-selector-wrap">
            <label for="dashSelectSede" class="dash-sr-only">Filtrar por sede o distrito</label>
            <select id="dashSelectSede" class="dash-select" aria-label="Filtrar por sede o distrito">
              <option value="all">Todas las sedes</option>
              <optgroup label="Ámbito por Distrito">
                <option value="Comas">Distrito Comas</option>
                <option value="Carabayllo">Distrito Carabayllo</option>
              </optgroup>
              <optgroup label="Sedes Parroquiales">
                <option value="San Pedro">Sede San Pedro</option>
                <option value="El Progreso">Sede El Progreso</option>
                <option value="Año Nuevo">Sede Año Nuevo</option>
                <option value="Santa Rosa">Sede Santa Rosa</option>
                <option value="Los Bendecidos">Sede Los Bendecidos</option>
                <option value="La Libertad">Sede La Libertad</option>
              </optgroup>
            </select>
          </div>
          <button type="button" class="dash-boton" id="btnExportarParte" title="Exportar consolidado territorial en CSV" aria-busy="false">
            <Icon name="accion.descargar" size={14} />
            <span id="btnExportarParteLabel">Exportar</span>
          </button>
        </div>
      </header>

      <section class="dash-hero dash-superficie" aria-label="Indicadores principales">
        <div class="dash-kpi">
          <span class="dash-rotulo">Niños acompañados</span>
          <strong class="dash-cifra" id="kpiTotalPadron">—</strong>
          <p class="dash-kpi-sub" id="kpiTotalPadronSub">Cargando padrón…</p>
          <span class="dash-mini-barra" aria-hidden="true">
            <span class="dash-seg-comas" id="dashBarraComas"></span>
            <span class="dash-seg-cara" id="dashBarraCarabayllo"></span>
            <span class="dash-seg-otras" id="dashBarraOtras"></span>
          </span>
        </div>
        <div class="dash-kpi">
          <span class="dash-rotulo">Cobertura de tamizaje</span>
          <strong class="dash-cifra" id="kpiCoberturaTamizaje">—</strong>
          <p class="dash-kpi-sub" id="kpiCoberturaTamizajeSub">Cargando tamizajes…</p>
          <span class="dash-barra-cobertura" aria-hidden="true">
            <i id="dashBarraCobertura"></i>
          </span>
          <span class="dash-alerta-hero" id="dashAlertaSinTamizaje" hidden></span>
        </div>
        <div class="dash-kpi">
          <span class="dash-rotulo">Casos ASP activos</span>
          <strong class="dash-cifra" id="kpiCasosAsp">—</strong>
          <p class="dash-kpi-sub" id="kpiCasosAspSub">Cargando seguimiento…</p>
          <p class="dash-kpi-nota">Seguimiento social pastoral</p>
        </div>
      </section>

      <div class="dash-grid-clinica">
        <section class="dash-clinica dash-superficie" aria-labelledby="dashClinicaTitle">
          <header class="dash-clinica-cab">
            <div>
              <h2 id="dashClinicaTitle">Anemia infantil (Hb)</h2>
              <p>
                <span id="dashTamizados">Cargando tamizajes…</span>
                <span id="dashSinTamizaje" hidden></span>
              </p>
            </div>
            <a href="/salud">Ver salud</a>
          </header>

          <div class="dash-clinica-resumen">
            <div class="dash-prevalencia">
              <strong id="kpiTasaAnemia">—</strong>
              <p id="kpiTasaAnemiaSub">En población tamizada</p>
            </div>
            <div class="dash-barra-clinica" id="dashAnemiaBarra" aria-hidden="true">
              <span class="dash-seg-normal" id="segAnemiaNormal"></span>
              <span class="dash-seg-riesgo" id="segAnemiaRiesgo"></span>
              <span class="dash-seg-leve" id="segAnemiaLeve"></span>
              <span class="dash-seg-mod" id="segAnemiaMod"></span>
            </div>
          </div>

          <ul class="dash-bandas" id="dashAnemiaTable">
            <li class="dash-banda" data-banda="normal">
              <span class="dash-punto" aria-hidden="true"></span>
              <span class="dash-banda-texto"><strong>Sin anemia</strong><span>≥ 11,5 g/dL</span></span>
              <strong class="dash-banda-pct" id="anemiaPctNormal">—</strong>
              <span class="dash-banda-casos" id="anemiaCasosNormal">—</span>
            </li>
            <li class="dash-banda" data-banda="riesgo">
              <span class="dash-punto" aria-hidden="true"></span>
              <span class="dash-banda-texto"><strong>En riesgo</strong><span>11,0 – 11,4 g/dL</span></span>
              <strong class="dash-banda-pct" id="anemiaPctRiesgo">—</strong>
              <span class="dash-banda-casos" id="anemiaCasosRiesgo">—</span>
            </li>
            <li class="dash-banda" data-banda="leve">
              <span class="dash-punto" aria-hidden="true"></span>
              <span class="dash-banda-texto"><strong>Anemia leve</strong><span>10,0 – 10,9 g/dL</span></span>
              <strong class="dash-banda-pct" id="anemiaPctLeve">—</strong>
              <span class="dash-banda-casos" id="anemiaCasosLeve">—</span>
            </li>
            <li class="dash-banda" data-banda="mod">
              <span class="dash-punto" aria-hidden="true"></span>
              <span class="dash-banda-texto"><strong>Moderada / severa</strong><span>&lt; 10,0 g/dL</span></span>
              <strong class="dash-banda-pct" id="anemiaPctMod">—</strong>
              <span class="dash-banda-casos" id="anemiaCasosMod">—</span>
            </li>
          </ul>

          <p class="dash-clinica-pie">Porcentajes calculados sobre niños tamizados, no sobre el padrón completo.</p>
        </section>

        <aside class="dash-atencion dash-superficie" aria-labelledby="dashAtencionTitle">
          <header class="dash-atencion-cab">
            <h2 id="dashAtencionTitle">Requiere atención</h2>
            <span id="atencionFrentes">—</span>
          </header>
          <ul class="dash-atencion-lista">
            <li id="atencionFilaAnemia" hidden>
              <a class="dash-atencion-fila" href="/salud">
                <span class="dash-punto is-rojo" aria-hidden="true"></span>
                <span class="dash-atencion-texto">
                  <strong id="atencionAnemiaTexto">—</strong>
                  <span>Derivación y seguimiento clínico.</span>
                </span>
                <Icon name="accion.abrir" size={15} />
              </a>
            </li>
            <li id="atencionFilaSinTamizaje" hidden>
              <a class="dash-atencion-fila" href="/salud">
                <span class="dash-punto is-ambar" aria-hidden="true"></span>
                <span class="dash-atencion-texto">
                  <strong id="atencionSinTamizajeTexto">—</strong>
                  <span>Cobertura de tamizaje pendiente.</span>
                </span>
                <Icon name="accion.abrir" size={15} />
              </a>
            </li>
            <li id="atencionFilaVoluntarios" hidden>
              <a class="dash-atencion-fila" href="/voluntariados">
                <span class="dash-punto is-naranja" aria-hidden="true"></span>
                <span class="dash-atencion-texto">
                  <strong id="atencionVoluntariosTexto">—</strong>
                  <span>Servicios con usuarios pero sin equipo activo.</span>
                </span>
                <Icon name="accion.abrir" size={15} />
              </a>
            </li>
          </ul>
          <p class="dash-atencion-vacio" id="atencionVacio" hidden></p>
          <p class="dash-atencion-pie">Se actualiza con la hidratación clínica y el padrón de voluntariado.</p>
        </aside>
      </div>

      <section class="dash-servicios-seccion" aria-labelledby="dashServiciosTitle">
        <div class="dash-seccion-cab">
          <h2 id="dashServiciosTitle">Tríada de servicios</h2>
          <span>Cobertura del padrón por programa</span>
        </div>
        <div class="dash-servicios">
          <article class="dash-servicio dash-superficie">
            <header class="dash-servicio-cab">
              <Icon name="nav.alimentario" size={18} />
              <h3>Alimentación</h3>
              <a href="/salud">Ver</a>
            </header>
            <div class="dash-servicio-principal">
              <strong id="dashAlimUsuarios">—</strong>
              <span>niños con ración</span>
            </div>
            <dl class="dash-filas">
              <div><dt>Desayuno infantil</dt><dd id="dashAlimDesayuno">—</dd></div>
              <div><dt>Lonchera infantil</dt><dd id="dashAlimLonchera">—</dd></div>
              <div><dt>Tamizajes CRED</dt><dd id="dashAlimCred">—</dd></div>
            </dl>
          </article>

          <article class="dash-servicio dash-superficie">
            <header class="dash-servicio-cab">
              <Icon name="educacion.libro" size={18} />
              <h3>Acompañamiento educativo</h3>
              <a href="/educativo">Ver</a>
            </header>
            <div class="dash-servicio-principal">
              <strong id="dashEduActivos">—</strong>
              <span>niños acompañados</span>
            </div>
            <dl class="dash-filas">
              <div><dt>Casita del Saber</dt><dd id="dashEduCasita">—</dd></div>
              <div><dt>Biblioteca comunitaria</dt><dd id="dashEduBiblioteca">—</dd></div>
            </dl>
            <p class="dash-servicio-nota" id="dashEduNota"></p>
          </article>

          <article class="dash-servicio dash-superficie">
            <header class="dash-servicio-cab">
              <Icon name="modulo.social" size={18} />
              <h3>Social pastoral (ASP)</h3>
              <a href="/social">Ver</a>
            </header>
            <div class="dash-servicio-principal">
              <strong id="dashAspUsuarios">—</strong>
              <span>niños en seguimiento</span>
            </div>
            <p class="dash-servicio-extra"><span id="dashAspCasosMicro">—</span></p>
            <dl class="dash-filas">
              <div><dt>Con caso en desayuno</dt><dd id="dashAspDesayuno">—</dd></div>
              <div><dt>Con caso en lonchera</dt><dd id="dashAspLonchera">—</dd></div>
              <div><dt>Con caso en Casita</dt><dd id="dashAspCasita">—</dd></div>
            </dl>
          </article>
        </div>
      </section>

      <div class="dash-grid-territorio">
        <section class="dash-panel dash-superficie" aria-labelledby="dashTerritorioTitle">
          <header class="dash-panel-cab">
            <div>
              <h2 id="dashTerritorioTitle">Cobertura por distrito</h2>
              <p id="dashMatrixNote">Cargando territorio…</p>
            </div>
            <a href="/sedes">Ver sedes</a>
          </header>
          <div class="dash-matrix-host" id="dashTerritoryMatrix">
            <p class="dash-cargando">Cargando territorio…</p>
          </div>
        </section>

        <aside class="dash-panel dash-voluntarios dash-superficie" aria-labelledby="dashVolTitle">
          <header class="dash-panel-cab">
            <div>
              <h2 id="dashVolTitle">Equipo en campo</h2>
              <p>Dotación activa por servicio</p>
            </div>
            <a href="/voluntariados">Ver</a>
          </header>
          <div class="dash-vol-total">
            <strong id="dashVolTotal">—</strong>
            <span>voluntarias activas</span>
          </div>
          <ul class="dash-vol-lista" id="dashVoluntariosList">
            <li class="dash-cargando">Cargando equipo…</li>
          </ul>
        </aside>
      </div>

      <p class="dash-conciliacion" id="dashReconcile" aria-live="polite"></p>
    </div>

    <script is:inline>
      (function () {
        try {
          var fechaEl = document.getElementById("dashFolioFecha");
          var ahora = new Date();
          if (fechaEl) {
            try {
              fechaEl.textContent = new Intl.DateTimeFormat("es-PE", { day: "numeric", month: "long", year: "numeric" }).format(ahora);
              fechaEl.dateTime = new Intl.DateTimeFormat("en-CA", { year: "numeric", month: "2-digit", day: "2-digit" }).format(ahora);
            } catch (e) {
              fechaEl.textContent = "hoy";
            }
          }

          var rawSnap = localStorage.getItem("pdi_snapshot_v1") || sessionStorage.getItem("pdi_snapshot_v1");
          if (!rawSnap) return;
          var snap = JSON.parse(rawSnap);
          if (!snap || !snap.datos) return;

          var bList = snap.datos.beneficiarios || [];
          var casos = snap.datos.casos || [];
          var sedes = snap.datos.sedes || [];
          var voluntarios = snap.datos.voluntarios || [];

          var params = new URLSearchParams(window.location.search);
          var filtroSede = params.get("sede") || params.get("distrito") || "all";
          if (filtroSede !== "all") {
            var q = filtroSede.toLowerCase();
            bList = bList.filter(function (b) {
              return (b.sede && b.sede.toLowerCase().indexOf(q) !== -1) || (b.distrito && b.distrito.toLowerCase().indexOf(q) !== -1);
            });
            var sel = document.getElementById("dashSelectSede");
            if (sel) sel.value = filtroSede;
          }

          var total = bList.length;
          var tamizados = 0;
          var normales = 0;
          var riesgo = 0;
          var leves = 0;
          var moderadas = 0;
          var comas = 0;
          var carabayllo = 0;

          for (var i = 0; i < total; i++) {
            var b = bList[i];
            var distrito = String(b.distrito || "").toLowerCase();
            var sede = String(b.sede || "").toLowerCase();
            if (distrito.indexOf("comas") !== -1 || sede.indexOf("comas") !== -1) comas++;
            if (distrito.indexOf("carabayllo") !== -1 || sede.indexOf("carabayllo") !== -1) carabayllo++;
            if (b.hb !== null && b.hb !== undefined && b.hb !== "") {
              tamizados++;
              var anemia = String(b.anemia || "").toLowerCase();
              if (anemia.indexOf("normal") !== -1 || anemia.indexOf("sin") !== -1) normales++;
              else if (anemia.indexOf("riesgo") !== -1) riesgo++;
              else if (anemia.indexOf("leve") !== -1) leves++;
              else if (anemia.indexOf("mod") !== -1 || anemia.indexOf("sev") !== -1) moderadas++;
              else normales++;
            }
          }

          var otras = Math.max(0, total - comas - carabayllo);
          var sinTamizaje = Math.max(0, total - tamizados);
          var pctNormal = tamizados > 0 ? Math.round((normales / tamizados) * 100) : 0;
          var pctRiesgo = tamizados > 0 ? Math.round((riesgo / tamizados) * 100) : 0;
          var pctLeve = tamizados > 0 ? Math.round((leves / tamizados) * 100) : 0;
          var pctMod = tamizados > 0 ? Math.round((moderadas / tamizados) * 100) : 0;
          var pctAnemia = tamizados > 0 ? Math.round(((leves + moderadas) / tamizados) * 100) : 0;
          var cobertura = total > 0 ? Math.round((tamizados / total) * 100) : 0;
          var casosActivos = casos.filter(function (c) { return c && c.etapa !== "cerrado"; }).length;

          var setTxt = function (id, valor) {
            var el = document.getElementById(id);
            if (el) el.textContent = valor;
          };
          var setHtml = function (id, valor) {
            var el = document.getElementById(id);
            if (el) el.innerHTML = valor;
          };
          var setFlex = function (id, valor) {
            var el = document.getElementById(id);
            if (el) el.style.flexGrow = String(Math.max(0, valor));
          };

          setTxt("kpiTotalPadron", String(total));
          setTxt("kpiCoberturaTamizaje", cobertura + " %");
          setTxt("kpiCasosAsp", String(casosActivos));
          setTxt("kpiSedesActivas", String(sedes.length));
          setHtml("kpiTotalPadronSub", "<strong>" + comas + "</strong> en Comas · <strong>" + carabayllo + "</strong> en Carabayllo · <strong>" + otras + "</strong> en otras sedes");
          setHtml("kpiCoberturaTamizajeSub", "<strong>" + tamizados + " de " + total + "</strong> niños con hemoglobina registrada");
          setTxt("kpiTasaAnemia", pctAnemia + " %");
          setTxt("kpiTasaAnemiaSub", (leves + moderadas) + " de " + tamizados + " tamizados con anemia");
          setTxt("kpiCasosAspSub", (casosActivos > 0 ? "Casos abiertos en el programa" : "Sin casos abiertos"));

          var alerta = document.getElementById("dashAlertaSinTamizaje");
          if (alerta) {
            alerta.hidden = sinTamizaje <= 0;
            alerta.textContent = sinTamizaje > 0 ? sinTamizaje + " sin tamizaje" : "";
          }
          var barraCob = document.getElementById("dashBarraCobertura");
          if (barraCob) barraCob.style.transform = "scaleX(" + (cobertura / 100) + ")";

          setTxt("dashTamizados", tamizados + " de " + total + " tamizados");
          var sinEl = document.getElementById("dashSinTamizaje");
          if (sinEl) {
            sinEl.hidden = sinTamizaje <= 0;
            sinEl.textContent = sinTamizaje > 0 ? "Sin tamizaje: " + sinTamizaje : "";
          }

          setTxt("anemiaPctNormal", pctNormal + " %");
          setTxt("anemiaCasosNormal", normales + " " + (normales === 1 ? "caso" : "casos"));
          setTxt("anemiaPctRiesgo", pctRiesgo + " %");
          setTxt("anemiaCasosRiesgo", riesgo + " " + (riesgo === 1 ? "caso" : "casos"));
          setTxt("anemiaPctLeve", pctLeve + " %");
          setTxt("anemiaCasosLeve", leves + " " + (leves === 1 ? "caso" : "casos"));
          setTxt("anemiaPctMod", pctMod + " %");
          setTxt("anemiaCasosMod", moderadas + " " + (moderadas === 1 ? "caso" : "casos"));

          setFlex("segAnemiaNormal", pctNormal);
          setFlex("segAnemiaRiesgo", pctRiesgo);
          setFlex("segAnemiaLeve", pctLeve);
          setFlex("segAnemiaMod", pctMod);
          var barraClinica = document.getElementById("dashAnemiaBarra");
          if (barraClinica) barraClinica.style.transform = "scaleX(1)";

          setFlex("dashBarraComas", comas);
          setFlex("dashBarraCarabayllo", carabayllo);
          setFlex("dashBarraOtras", otras);

          setTxt("dashVolTotal", String(voluntarios.length));

          setTxt("atencionAnemiaTexto", moderadas + " " + (moderadas === 1 ? "anemia moderada/severa" : "anemias moderadas/severas"));
          setTxt("atencionSinTamizajeTexto", sinTamizaje + " " + (sinTamizaje === 1 ? "niño sin tamizaje" : "niños sin tamizaje"));
          var filaA = document.getElementById("atencionFilaAnemia");
          var filaS = document.getElementById("atencionFilaSinTamizaje");
          if (filaA) filaA.hidden = moderadas <= 0;
          if (filaS) filaS.hidden = sinTamizaje <= 0;
        } catch (e) {
          // Pre-hidratación silenciosa.
        }
      })();
    </script>
  </section>

  <script>
    import '../scripts/pages/dashboard.js';
  </script>
</AppLayout>
