---
import AppLayout from '../layouts/AppLayout.astro';
import '../styles/views-dashboard.css';
import Icon from '../components/Icon.astro';
---

<AppLayout title="Dashboard General" currentPage="dashboard">
  <section class="app-view active" id="view-dashboard">
    <div class="dash-page">
      <div class="dash-sheet">
        <header class="dash-folio">
          <div class="dash-folio-main">
            <p class="dash-folio-line">
              Parte al <time id="dashFolioFecha">…</time>
            </p>
            <h1>Panel de Infancia Saludable</h1>
            <p class="dash-folio-sub">
              Cobertura, servicios y hemoglobina infantil del programa.
            </p>
            <p class="dash-folio-meta">
              <span>Responsable: <strong id="dashFolioResponsable">…</strong></span>
              <span>Ámbito: todas las sedes</span>
            </p>
          </div>
          <div class="dash-folio-actions">
            <span class="dash-meta-chip is-loading" id="dashEstado" role="status" aria-live="polite">
              <span class="dash-estado-dot" aria-hidden="true"></span>
              <span id="dashEstadoTexto">Cargando…</span>
              <span class="dash-meta-hace" id="dashEstadoHace" aria-hidden="true"></span>
            </span>
            <a class="dash-meta-link" href="/padron">
              <span>Ver padrón completo</span>
              <Icon name="accion.abrir" size={12} />
            </a>
          </div>
        </header>

        <!-- Franja clínica: la firma del parte -->
        <section class="dash-band dash-band--clinical" aria-labelledby="dashClinicaTitle">
          <div class="dash-band-head">
            <h2 id="dashClinicaTitle">Anemia infantil (Hb)</h2>
            <div class="dash-band-meta">
              <span class="dash-band-note" id="dashTamizados">…</span>
              <span class="dash-band-note" id="dashSinTamizaje" hidden></span>
              <span class="dash-band-note">Porcentajes redondeados</span>
              <a class="dash-band-link" href="/salud">Ver salud</a>
            </div>
          </div>

          <ul class="dash-strip-cells" id="dashAnemiaTable">
            <li class="dash-strip-cell" data-band="normal">
              <span class="dash-strip-dot" aria-hidden="true"></span>
              <span class="dash-strip-name">Sin anemia</span>
              <strong class="dash-strip-pct" id="anemiaPctNormal">…</strong>
              <span class="dash-strip-cases" id="anemiaCasosNormal">…</span>
              <span class="dash-strip-range">≥ 11,0 g/dL</span>
              <span class="dash-strip-track" aria-hidden="true">
                <span class="dash-strip-fill" id="segAnemiaNormal"></span>
              </span>
            </li>

            <li class="dash-strip-cell" data-band="leve">
              <span class="dash-strip-dot" aria-hidden="true"></span>
              <span class="dash-strip-name">Anemia leve</span>
              <strong class="dash-strip-pct" id="anemiaPctLeve">…</strong>
              <span class="dash-strip-cases" id="anemiaCasosLeve">…</span>
              <span class="dash-strip-range">10,0 – 10,9 g/dL</span>
              <span class="dash-strip-track" aria-hidden="true">
                <span class="dash-strip-fill" id="segAnemiaLeve"></span>
              </span>
            </li>

            <li class="dash-strip-cell" data-band="mod">
              <span class="dash-strip-dot" aria-hidden="true"></span>
              <span class="dash-strip-name">Anemia moderada / severa</span>
              <strong class="dash-strip-pct" id="anemiaPctMod">…</strong>
              <span class="dash-strip-cases" id="anemiaCasosMod">…</span>
              <span class="dash-strip-range">&lt; 10,0 g/dL</span>
              <span class="dash-strip-track" aria-hidden="true">
                <span class="dash-strip-fill" id="segAnemiaMod"></span>
              </span>
            </li>
          </ul>
        </section>

        <!-- Hoja de servicios: el cuerpo del parte -->
        <section class="dash-band" aria-labelledby="dashServiciosTitle">
          <div class="dash-band-head">
            <h2 id="dashServiciosTitle">Programas del parte</h2>
          </div>
          <div class="dash-ledger">
            <article class="dash-service">
              <header class="dash-service-head">
                <div>
                  <h3 class="dash-service-title">Alimentación y nutrición</h3>
                  <p class="dash-service-note">Desayuno, lonchera y control CRED</p>
                </div>
                <a class="dash-service-link" href="/salud">Ver alimentación</a>
              </header>
              <dl class="dash-service-rows">
                <div class="dash-service-row dash-service-row--lead">
                  <dt>Usuarios con ración</dt>
                  <dd id="dashAlimUsuarios">…</dd>
                </div>
                <div class="dash-service-row">
                  <dt>Usuarios de desayuno infantil</dt>
                  <dd id="dashAlimDesayuno">…</dd>
                </div>
                <div class="dash-service-row">
                  <dt>Usuarios de lonchera infantil</dt>
                  <dd id="dashAlimLonchera">…</dd>
                </div>
                <div class="dash-service-row">
                  <dt>Atención CRED</dt>
                  <dd id="dashAlimCred">…</dd>
                </div>
              </dl>
            </article>

            <article class="dash-service">
              <header class="dash-service-head">
                <div>
                  <h3 class="dash-service-title">Acompañamiento educativo</h3>
                  <p class="dash-service-note">Casita del Saber y biblioteca</p>
                </div>
                <a class="dash-service-link" href="/educativo">Ver educativo</a>
              </header>
              <dl class="dash-service-rows">
                <div class="dash-service-row dash-service-row--lead">
                  <dt>Usuarios con acompañamiento</dt>
                  <dd id="dashEduActivos">…</dd>
                </div>
                <div class="dash-service-row">
                  <dt>Usuarios de Casita del Saber</dt>
                  <dd id="dashEduCasita">…</dd>
                </div>
                <div class="dash-service-row">
                  <dt>Biblioteca comunitaria</dt>
                  <dd id="dashEduBiblioteca">…</dd>
                </div>
              </dl>
            </article>

            <article class="dash-service">
              <header class="dash-service-head">
                <div>
                  <h3 class="dash-service-title">Servicio social pastoral (ASP)</h3>
                  <p class="dash-service-note">Solo usuarios con caso ASP activo</p>
                </div>
                <a class="dash-service-link" href="/social">Ver social</a>
              </header>
              <dl class="dash-service-rows">
                <div class="dash-service-row dash-service-row--lead">
                  <dt>Usuarios con caso ASP activo <span class="dash-service-micro" id="dashAspCasosMicro">…</span></dt>
                  <dd id="dashAspUsuarios">…</dd>
                </div>
                <div class="dash-service-row">
                  <dt>Con caso ASP en desayuno</dt>
                  <dd id="dashAspDesayuno">…</dd>
                </div>
                <div class="dash-service-row">
                  <dt>Con caso ASP en lonchera</dt>
                  <dd id="dashAspLonchera">…</dd>
                </div>
                <div class="dash-service-row">
                  <dt>Con caso ASP en Casita del Saber</dt>
                  <dd id="dashAspCasita">…</dd>
                </div>
              </dl>
            </article>
          </div>

          <p class="dash-reconcile" id="dashReconcile" aria-live="polite"></p>
        </section>

        <!-- Cobertura territorial: la matriz -->
        <section class="dash-band" aria-labelledby="dashTerritorioTitle">
          <div class="dash-band-head">
            <h2 id="dashTerritorioTitle">Cobertura territorial por servicio</h2>
            <a class="dash-band-link" href="/sedes">Ver sedes e iglesias</a>
          </div>
          <p class="dash-matrix-note" id="dashMatrixNote"></p>
          <div class="dash-matrix-host" id="dashTerritoryMatrix"></div>
        </section>

        <!-- Voluntarios: el apoyo del parte -->
        <section class="dash-band" aria-labelledby="dashVolTitle">
          <div class="dash-band-head">
            <h2 id="dashVolTitle">Voluntarios por servicio</h2>
            <span class="dash-band-total"><strong id="dashVolTotal">…</strong> voluntarios</span>
            <a class="dash-band-link" href="/voluntariados">Ver voluntariado</a>
          </div>
          <ul class="dash-vol-list" id="dashVoluntariosList"></ul>
        </section>
      </div>
    </div>
  </section>

  <script>
    import '../scripts/pages/dashboard.js';
  </script>
</AppLayout>
