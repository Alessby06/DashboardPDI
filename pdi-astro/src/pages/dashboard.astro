---
import AppLayout from '../layouts/AppLayout.astro';
import '../styles/views-dashboard.css';
import Icon from '../components/Icon.astro';
---

<AppLayout title="Dashboard General" currentPage="dashboard">
  <section class="app-view active" id="view-dashboard">
    <!-- Script síncrono inline para pre-hidratación instantánea: 0 ms de parpadeo -->
    <script is:inline>
      (function () {
        try {
          var fechaEl = document.getElementById("dashFolioFecha");
          var ahora = new Date();
          if (fechaEl) {
            try {
              fechaEl.textContent = new Intl.DateTimeFormat("es-PE", { day: "numeric", month: "long", year: "numeric" }).format(ahora);
              fechaEl.dateTime = new Intl.DateTimeFormat("en-CA", { year: "numeric", month: "2-digit", day: "2-digit" }).format(ahora);
            } catch (e) {
              fechaEl.textContent = "hoy";
            }
          }

          var rawSnap = localStorage.getItem("pdi_snapshot_v1") || sessionStorage.getItem("pdi_snapshot_v1");
          if (!rawSnap) return;
          var snap = JSON.parse(rawSnap);
          if (!snap || !snap.datos) return;

          var bList = snap.datos.beneficiarios || [];
          var casos = snap.datos.casos || [];
          var sedes = snap.datos.sedes || [];
          var voluntarios = snap.datos.voluntarios || [];

          var params = new URLSearchParams(window.location.search);
          var filtroSede = params.get("sede") || params.get("distrito") || "all";
          if (filtroSede !== "all") {
            var q = filtroSede.toLowerCase();
            bList = bList.filter(function (b) {
              return (b.sede && b.sede.toLowerCase().indexOf(q) !== -1) || (b.distrito && b.distrito.toLowerCase().indexOf(q) !== -1);
            });
            var sel = document.getElementById("dashSelectSede");
            if (sel) sel.value = filtroSede;
            var amb = document.getElementById("dashAmbitoLabel");
            if (amb) amb.textContent = "Ámbito: " + filtroSede;
          }

          var total = bList.length;
          var tamizados = 0;
          var normales = 0;
          var riesgo = 0;
          var leves = 0;
          var moderadas = 0;

          for (var i = 0; i < total; i++) {
            var b = bList[i];
            if (b.hb !== null && b.hb !== undefined && b.hb !== "") {
              tamizados++;
              var anemia = String(b.anemia || "").toLowerCase();
              if (anemia.indexOf("normal") !== -1 || anemia.indexOf("sin") !== -1) normales++;
              else if (anemia.indexOf("riesgo") !== -1) riesgo++;
              else if (anemia.indexOf("leve") !== -1) leves++;
              else if (anemia.indexOf("mod") !== -1 || anemia.indexOf("sev") !== -1) moderadas++;
              else normales++;
            }
          }

          var pctNormal = tamizados > 0 ? Math.round((normales / tamizados) * 100) : 0;
          var pctRiesgo = tamizados > 0 ? Math.round((riesgo / tamizados) * 100) : 0;
          var pctLeve = tamizados > 0 ? Math.round((leves / tamizados) * 100) : 0;
          var pctMod = tamizados > 0 ? Math.round((moderadas / tamizados) * 100) : 0;
          var totalAnemia = leves + moderadas;
          var pctTotalAnemia = tamizados > 0 ? Math.round((totalAnemia / tamizados) * 100) : 0;

          var kPadron = document.getElementById("kpiTotalPadron");
          if (kPadron) kPadron.textContent = String(total);

          var kTasa = document.getElementById("kpiTasaAnemia");
          if (kTasa) kTasa.textContent = pctTotalAnemia + " %";

          var kCasos = document.getElementById("kpiCasosAsp");
          var casosActivos = casos.filter(function (c) { return c && c.etapa !== "cerrado"; }).length;
          if (kCasos) kCasos.textContent = String(casosActivos);

          var kSedes = document.getElementById("kpiSedesActivas");
          if (kSedes) kSedes.textContent = String(sedes.length || 7);

          var setTxt = function (id, val) {
            var el = document.getElementById(id);
            if (el) el.textContent = val;
          };
          setTxt("dashTamizados", tamizados + " de " + total + " tamizados (" + (total > 0 ? Math.round((tamizados / total) * 100) : 0) + " %)");
          setTxt("anemiaPctNormal", pctNormal + " %");
          setTxt("anemiaCasosNormal", normales + " " + (normales === 1 ? "caso" : "casos"));
          setTxt("anemiaPctRiesgo", pctRiesgo + " %");
          setTxt("anemiaCasosRiesgo", riesgo + " " + (riesgo === 1 ? "caso" : "casos"));
          setTxt("anemiaPctLeve", pctLeve + " %");
          setTxt("anemiaCasosLeve", leves + " " + (leves === 1 ? "caso" : "casos"));
          setTxt("anemiaPctMod", pctMod + " %");
          setTxt("anemiaCasosMod", moderadas + " " + (moderadas === 1 ? "caso" : "casos"));

          var setScale = function (id, pct) {
            var el = document.getElementById(id);
            if (el) el.style.transform = "scaleX(" + (pct / 100) + ")";
          };
          setScale("segAnemiaNormal", pctNormal);
          setScale("segAnemiaRiesgo", pctRiesgo);
          setScale("segAnemiaLeve", pctLeve);
          setScale("segAnemiaMod", pctMod);

          var kVol = document.getElementById("dashVolTotal");
          if (kVol) kVol.textContent = String(voluntarios.length);
        } catch (e) {
          // Pre-hidratación silenciosa
        }
      })();
    </script>
    <div class="dash-page">
      <div class="dash-sheet">
        <header class="dash-folio">
          <div class="dash-folio-main">
            <p class="dash-folio-line">
              Parte al <time id="dashFolioFecha">hoy</time>
            </p>
            <h1>Panel de Infancia Saludable</h1>
          </div>
          <div class="dash-folio-actions">
            <div class="dash-selector-wrap">
              <label for="dashSelectSede" class="dash-sr-only">Filtrar por sede o distrito</label>
              <select id="dashSelectSede" class="dash-select" aria-label="Filtrar parte por sede o distrito">
                <option value="all">Todas las sedes</option>
                <optgroup label="Ámbito por Distrito">
                  <option value="Comas">Distrito Comas</option>
                  <option value="Carabayllo">Distrito Carabayllo</option>
                </optgroup>
                <optgroup label="Sedes Parroquiales">
                  <option value="San Pedro">Sede San Pedro</option>
                  <option value="El Progreso">Sede El Progreso</option>
                  <option value="Año Nuevo">Sede Año Nuevo</option>
                  <option value="Santa Rosa">Sede Santa Rosa</option>
                  <option value="Los Bendecidos">Sede Los Bendecidos</option>
                  <option value="La Libertad">Sede La Libertad</option>
                </optgroup>
              </select>
            </div>
            <button type="button" class="dash-action-btn" id="btnExportarParte" title="Exportar consolidado territorial en CSV" aria-busy="false">
              <Icon name="accion.descargar" size={13} />
              <span id="btnExportarParteLabel">Exportar reporte</span>
            </button>
            <span class="dash-meta-chip is-loading" id="dashEstado" role="status" aria-label="Estado de conexión en tiempo real">
              <span class="dash-estado-dot" aria-hidden="true"></span>
              <span id="dashEstadoTexto">En vivo</span>
              <span class="dash-meta-hace" id="dashEstadoHace" aria-hidden="true" hidden></span>
            </span>
          </div>
        </header>

        <!-- Banda Maestra de Resumen Institucional (Ledger sobrio, reglas de 1px) -->
        <section class="dash-overview-ledger" aria-label="Resumen ejecutivo de cobertura">
          <div class="dash-kpi-col">
            <span class="dash-kpi-label">Padrón de Niños</span>
            <strong class="dash-kpi-val" id="kpiTotalPadron">—</strong>
            <span class="dash-kpi-sub" id="kpiTotalPadronSub">Matrícula general</span>
            <span class="dash-strip-track" aria-hidden="true">
              <span class="dash-strip-fill dash-strip-fill--neutral" style="transform: scaleX(1);"></span>
            </span>
          </div>
          <div class="dash-kpi-col">
            <span class="dash-kpi-label">Prevalencia de Anemia</span>
            <strong class="dash-kpi-val" id="kpiTasaAnemia">—</strong>
            <span class="dash-kpi-sub" id="kpiTasaAnemiaSub">En población tamizada</span>
            <span class="dash-strip-track" aria-hidden="true">
              <span class="dash-strip-fill dash-strip-fill--neutral" style="transform: scaleX(1);"></span>
            </span>
          </div>
          <div class="dash-kpi-col">
            <span class="dash-kpi-label">Casos Críticos <abbr title="Acompañamiento Social Pastoral">ASP</abbr></span>
            <strong class="dash-kpi-val" id="kpiCasosAsp">—</strong>
            <span class="dash-kpi-sub" id="kpiCasosAspSub">Seguimiento pastoral</span>
            <span class="dash-strip-track" aria-hidden="true">
              <span class="dash-strip-fill dash-strip-fill--neutral" style="transform: scaleX(1);"></span>
            </span>
          </div>
          <div class="dash-kpi-col">
            <span class="dash-kpi-label">Sedes Territoriales</span>
            <strong class="dash-kpi-val" id="kpiSedesActivas">—</strong>
            <span class="dash-kpi-sub" id="kpiSedesActivasSub">Red comunitaria activa</span>
            <span class="dash-strip-track" aria-hidden="true">
              <span class="dash-strip-fill dash-strip-fill--neutral" style="transform: scaleX(1);"></span>
            </span>
          </div>
        </section>

        <!-- Franja clínica: 4 niveles simétricos calibrados Ficha A6 -->
        <section class="dash-band dash-band--clinical" aria-labelledby="dashClinicaTitle">
          <div class="dash-band-head">
            <h2 id="dashClinicaTitle">Estratificación de Anemia infantil (<abbr title="Hemoglobina">Hb</abbr>)</h2>
            <div class="dash-band-meta">
              <span class="dash-band-note" id="dashTamizados">…</span>
              <span class="dash-band-note" id="dashSinTamizaje" hidden></span>
              <span class="dash-band-note">Porcentajes sobre tamizados</span>
              <a class="dash-band-link" href="/salud">Ver salud</a>
            </div>
          </div>

          <div class="dash-overview-ledger dash-overview-ledger--clinical" id="dashAnemiaTable">
            <div class="dash-kpi-col" data-band="normal">
              <div class="dash-kpi-head-row">
                <span class="dash-kpi-label">Sin anemia</span>
                <span class="dash-kpi-pill">≥ 11,5 g/dL</span>
              </div>
              <strong class="dash-kpi-val" id="anemiaPctNormal">…</strong>
              <span class="dash-kpi-sub" id="anemiaCasosNormal">…</span>
              <span class="dash-strip-track" aria-hidden="true">
                <span class="dash-strip-fill" id="segAnemiaNormal"></span>
              </span>
            </div>

            <div class="dash-kpi-col" data-band="riesgo">
              <div class="dash-kpi-head-row">
                <span class="dash-kpi-label">En riesgo</span>
                <span class="dash-kpi-pill">11,0 – 11,4</span>
              </div>
              <strong class="dash-kpi-val" id="anemiaPctRiesgo">…</strong>
              <span class="dash-kpi-sub" id="anemiaCasosRiesgo">…</span>
              <span class="dash-strip-track" aria-hidden="true">
                <span class="dash-strip-fill" id="segAnemiaRiesgo"></span>
              </span>
            </div>

            <div class="dash-kpi-col" data-band="leve">
              <div class="dash-kpi-head-row">
                <span class="dash-kpi-label">Anemia leve</span>
                <span class="dash-kpi-pill">10,0 – 10,9</span>
              </div>
              <strong class="dash-kpi-val" id="anemiaPctLeve">…</strong>
              <span class="dash-kpi-sub" id="anemiaCasosLeve">…</span>
              <span class="dash-strip-track" aria-hidden="true">
                <span class="dash-strip-fill" id="segAnemiaLeve"></span>
              </span>
            </div>

            <div class="dash-kpi-col" data-band="mod">
              <div class="dash-kpi-head-row">
                <span class="dash-kpi-label">Mod / Severa</span>
                <span class="dash-kpi-pill">&lt; 10,0</span>
              </div>
              <strong class="dash-kpi-val" id="anemiaPctMod">…</strong>
              <span class="dash-kpi-sub" id="anemiaCasosMod">…</span>
              <span class="dash-strip-track" aria-hidden="true">
                <span class="dash-strip-fill" id="segAnemiaMod"></span>
              </span>
            </div>
          </div>
        </section>

        <!-- Hoja de servicios: el cuerpo del parte -->
        <section class="dash-band" aria-labelledby="dashServiciosTitle">
          <div class="dash-band-head">
            <h2 id="dashServiciosTitle">Tríada troncal de servicios</h2>
          </div>
          <div class="dash-ledger">
            <article class="dash-service">
              <header class="dash-service-head">
                <div>
                  <h3 class="dash-service-title">Alimentación y nutrición</h3>
                  <p class="dash-service-note">Desayuno, lonchera y control <abbr title="Control de Crecimiento y Desarrollo">CRED</abbr></p>
                </div>
                <a class="dash-service-link" href="/salud">Ver alimentación</a>
              </header>
              <dl class="dash-service-rows">
                <div class="dash-service-row dash-service-row--lead">
                  <dt>Usuarios con ración</dt>
                  <dd id="dashAlimUsuarios">…</dd>
                </div>
                <div class="dash-service-row">
                  <dt>Usuarios de desayuno infantil</dt>
                  <dd id="dashAlimDesayuno">…</dd>
                </div>
                <div class="dash-service-row">
                  <dt>Usuarios de lonchera infantil</dt>
                  <dd id="dashAlimLonchera">…</dd>
                </div>
                <div class="dash-service-row">
                  <dt>Atención <abbr title="Control de Crecimiento y Desarrollo">CRED</abbr></dt>
                  <dd id="dashAlimCred">…</dd>
                </div>
              </dl>
            </article>

            <article class="dash-service">
              <header class="dash-service-head">
                <div>
                  <h3 class="dash-service-title">Acompañamiento educativo</h3>
                  <p class="dash-service-note">Casita del Saber y biblioteca</p>
                </div>
                <a class="dash-service-link" href="/educativo">Ver educativo</a>
              </header>
              <dl class="dash-service-rows">
                <div class="dash-service-row dash-service-row--lead">
                  <dt>Usuarios con acompañamiento</dt>
                  <dd id="dashEduActivos">…</dd>
                </div>
                <div class="dash-service-row">
                  <dt>Usuarios de Casita del Saber</dt>
                  <dd id="dashEduCasita">…</dd>
                </div>
                <div class="dash-service-row">
                  <dt>Biblioteca comunitaria</dt>
                  <dd id="dashEduBiblioteca">…</dd>
                </div>
              </dl>
            </article>

            <article class="dash-service">
              <header class="dash-service-head">
                <div>
                  <h3 class="dash-service-title">Servicio social pastoral (<abbr title="Acompañamiento Social Pastoral">ASP</abbr>)</h3>
                  <p class="dash-service-note">Solo usuarios con caso <abbr title="Acompañamiento Social Pastoral">ASP</abbr> activo</p>
                </div>
                <a class="dash-service-link" href="/social">Ver social</a>
              </header>
              <dl class="dash-service-rows">
                <div class="dash-service-row dash-service-row--lead">
                  <dt>Usuarios con caso <abbr title="Acompañamiento Social Pastoral">ASP</abbr> activo <span class="dash-service-micro" id="dashAspCasosMicro">…</span></dt>
                  <dd id="dashAspUsuarios">…</dd>
                </div>
                <div class="dash-service-row">
                  <dt>Con caso <abbr title="Acompañamiento Social Pastoral">ASP</abbr> en desayuno</dt>
                  <dd id="dashAspDesayuno">…</dd>
                </div>
                <div class="dash-service-row">
                  <dt>Con caso <abbr title="Acompañamiento Social Pastoral">ASP</abbr> en lonchera</dt>
                  <dd id="dashAspLonchera">…</dd>
                </div>
                <div class="dash-service-row">
                  <dt>Con caso <abbr title="Acompañamiento Social Pastoral">ASP</abbr> en Casita del Saber</dt>
                  <dd id="dashAspCasita">…</dd>
                </div>
              </dl>
            </article>
          </div>

          <p class="dash-reconcile" id="dashReconcile" aria-live="polite"></p>
        </section>

        <!-- Bloque Asimétrico: Matriz Territorial (60%) y Fuerza Comunitaria (40%) -->
        <div class="dash-split-grid">
          <!-- Cobertura territorial: la matriz -->
          <section class="dash-band dash-band--territorio" aria-labelledby="dashTerritorioTitle">
            <div class="dash-band-head">
              <h2 id="dashTerritorioTitle">Cobertura territorial por servicio</h2>
              <a class="dash-band-link" href="/sedes">Ver sedes e iglesias</a>
            </div>
            <p class="dash-matrix-note" id="dashMatrixNote">Distribución de usuarios por distrito y programas troncales</p>
            <div class="dash-matrix-host" id="dashTerritoryMatrix">
              <div class="dash-matrix-skeleton" aria-hidden="true">
                <div class="dash-skeleton-row is-head"></div>
                <div class="dash-skeleton-row"></div>
                <div class="dash-skeleton-row"></div>
                <div class="dash-skeleton-row"></div>
              </div>
            </div>
          </section>

          <!-- Voluntarios: el apoyo del parte -->
          <section class="dash-band dash-band--voluntariado" aria-labelledby="dashVolTitle">
            <div class="dash-band-head">
              <h2 id="dashVolTitle">Fuerza comunitaria en campo</h2>
              <span class="dash-band-total"><strong id="dashVolTotal">—</strong> voluntarias</span>
              <a class="dash-band-link" href="/voluntariados">Ver voluntariado</a>
            </div>
            <p class="dash-matrix-note" style="margin-top:-4px; margin-bottom:12px;">Dotación activa y alertas de cobertura</p>
            <ul class="dash-vol-list" id="dashVoluntariosList">
              <li class="dash-vol-row dash-skeleton-item" aria-hidden="true"></li>
              <li class="dash-vol-row dash-skeleton-item" aria-hidden="true"></li>
              <li class="dash-vol-row dash-skeleton-item" aria-hidden="true"></li>
              <li class="dash-vol-row dash-skeleton-item" aria-hidden="true"></li>
            </ul>
          </section>
        </div>
      </div>
    </div>
  </section>

  <script>
    import '../scripts/pages/dashboard.js';
  </script>
</AppLayout>
