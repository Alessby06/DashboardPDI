---
import AppLayout from '../layouts/AppLayout.astro';
import '../styles/views-dashboard.css';
---

<AppLayout title="Dashboard General" currentPage="dashboard">
  <section class="app-view active" id="view-dashboard">
    <!-- Header Operativo Sobrio -->
    <div class="view-header dash-header-clean">
      <div class="view-title-group">
        <div class="dash-title-row">
          <h2>Dashboard General</h2>
        </div>
        <p class="dash-subtitle">
          Supervisión integral de cobertura nutricional, tamizaje de salud y acompañamiento en casitas.
        </p>
      </div>
      <div class="dash-header-actions">
        <button type="button" class="btn-action-icon btn-audit-export-icon" id="btnExportDashboardCSV"
          onclick="window.openModalExportDashboard ? window.openModalExportDashboard() : window.exportDataCSV()"
          aria-label="Descargar Informe CSV" title="Descargar Informe Consolidado CSV">
          <svg width="18" height="18" fill="none" stroke="currentColor" stroke-width="2.2" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round"
              d="M3 16.5v2.25A2.25 2.25 0 005.25 21h13.5A2.25 2.25 0 0021 18.75V16.5M16.5 12L12 16.5m0 0L7.5 12m4.5 4.5V3" />
          </svg>
        </button>
      </div>
    </div>

    <!-- Tira de Métricas Operativas Clave (Placas) -->
    <div class="plq-grid" id="kpiDashboardContainer">
      <div class="plq-card">
        <div class="plq-top">
          <span class="plq-label">Beneficiarios Activos</span>
        </div>
        <div class="plq-val" id="dashKpiBeneficiarios">15</div>
        <div class="plq-meta">100% matriculados en el programa</div>
      </div>
      <div class="plq-card">
        <div class="plq-top">
          <span class="plq-label">Tamizados CRED</span>
        </div>
        <div class="plq-val" id="dashKpiTamizados">15 / 15</div>
        <div class="plq-meta">Control vigente con dosaje Hb</div>
      </div>
      <div class="plq-card">
        <div class="plq-top">
          <span class="plq-label">Asistencia en Casitas</span>
        </div>
        <div class="plq-val" id="dashKpiAsistencia">92.4%</div>
        <div class="plq-meta">Promedio territorial consolidado</div>
      </div>
      <div class="plq-card">
        <div class="plq-top">
          <span class="plq-label">Casos en Alerta</span>
        </div>
        <div class="plq-val alert" id="dashKpiCasosSociales">0</div>
        <div class="plq-meta">Seguimiento clínico o social activo</div>
      </div>
    </div>

    <!-- Rejilla Principal: Semáforo Clínico y Cobertura Territorial -->
        
      <div class="dash-charts-grid">
        <div class="card stagger-item dash-anemia-table-card" id="widgetAnemiaStatus">
          <div class="card-header">
            <div class="dash-card-header-flex">
              <div class="card-title">
                <svg width="18" height="18" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24" aria-hidden="true" style="color: var(--gt-yellow);"><path stroke-linecap="round" stroke-linejoin="round" d="M10.5 6a7.5 7.5 0 107.5 7.5h-7.5V6z"></path><path stroke-linecap="round" stroke-linejoin="round" d="M13.5 10.5H21A7.5 7.5 0 0013.5 3v7.5z"></path></svg>
                <span>Estado Nutricional y Anemia</span>
              </div>
              <a href="/salud" class="dash-card-action" title="Abrir módulo de salud">
                <span>Ver Servicio Alimentario</span>
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" d="M8.25 4.5l7.5 7.5-7.5 7.5"></path></svg>
              </a>
            </div>
          </div>
          <table class="dash-anemia-table" id="dashAnemiaTable">
            <tbody>
              <tr class="dash-anemia-trow">
                <td class="dash-anemia-tcount" id="anemiaLegendNormal">7</td>
                <td class="dash-anemia-band"><span class="dash-anemia-bname">Normal</span><span class="dash-anemia-brange">≥ 11.0 g/dL</span></td>
                <td><span class="dash-anemia-fill normal" id="segAnemiaNormal" style="width: 47%;"></span></td>
                <td class="dash-anemia-tpct" id="anemiaPctNormal">47%</td>
              </tr>
              <tr class="dash-anemia-trow">
                <td class="dash-anemia-tcount" id="anemiaLegendLeve">6</td>
                <td class="dash-anemia-band"><span class="dash-anemia-bname">Anemia Leve</span><span class="dash-anemia-brange">10.0 – 10.9 g/dL</span></td>
                <td><span class="dash-anemia-fill leve" id="segAnemiaLeve" style="width: 40%;"></span></td>
                <td class="dash-anemia-tpct" id="anemiaPctLeve">40%</td>
              </tr>
              <tr class="dash-anemia-trow">
                <td class="dash-anemia-tcount" id="anemiaLegendMod">2</td>
                <td class="dash-anemia-band"><span class="dash-anemia-bname">Anemia Mod/Sev</span><span class="dash-anemia-brange">&lt; 10.0 g/dL</span></td>
                <td><span class="dash-anemia-fill mod" id="segAnemiaMod" style="width: 13%;"></span></td>
                <td class="dash-anemia-tpct" id="anemiaPctMod">13%</td>
              </tr>
            </tbody>
          </table>
          <p class="dash-anemia-foot"><span id="dashAnemiaTotalEvaluados">15</span> menores tamizados · control vigente con dosaje de hemoglobina</p>
        </div>
        <div class="card stagger-item" id="widgetCoverageStatus">
          <div class="card-header">
            <div class="dash-card-header-flex">
              <div class="card-title">
                <svg width="18" height="18" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24" aria-hidden="true" style="color: var(--gt-blue);"><path stroke-linecap="round" stroke-linejoin="round" d="M15 10.5a3 3 0 11-6 0 3 3 0 016 0z"></path><path stroke-linecap="round" stroke-linejoin="round" d="M19.5 10.5c0 7.142-7.5 11.25-7.5 11.25S4.5 17.642 4.5 10.5a7.5 7.5 0 1115 0z"></path></svg>
                <span>Cobertura Territorial por Distrito</span>
              </div>
              <a href="/sedes" class="dash-card-action" title="Abrir directorio de sedes">
                <span>Ver Sedes e Iglesias</span>
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" d="M8.25 4.5l7.5 7.5-7.5 7.5"></path></svg>
              </a>
            </div>
          </div>
          <div class="dash-territory-list" id="dashDistrictCoverage">
            <div class="dash-territory-row">
              <div class="dash-territory-head">
                <div class="dash-territory-info">
                  <strong>Distrito de Comas</strong>
                  <span class="dash-territory-sub">Sedes (3): Año Nuevo, La Libertad, Carmen Alto</span>
                </div>
                <div class="dash-territory-metric">
                  <strong id="badgeDistrict_comas">8 menores</strong>
                  <span class="dash-territory-pct" id="pctDistrict_comas">(53%)</span>
                </div>
              </div>
              <div class="dash-territory-track">
                <div class="dash-territory-bar green" style="width: 53%;" data-target-width="53%" id="barDistrict_comas"></div>
              </div>
            </div>
            <div class="dash-territory-row">
              <div class="dash-territory-head">
                <div class="dash-territory-info">
                  <strong>Distrito de Carabayllo</strong>
                  <span class="dash-territory-sub">Sedes (4): El Progreso, San Pedro, Los Bendecidos, Santa Rosa</span>
                </div>
                <div class="dash-territory-metric">
                  <strong id="badgeDistrict_carabayllo">7 menores</strong>
                  <span class="dash-territory-pct" id="pctDistrict_carabayllo">(47%)</span>
                </div>
              </div>
              <div class="dash-territory-track">
                <div class="dash-territory-bar blue" style="width: 47%;" data-target-width="47%" id="barDistrict_carabayllo"></div>
              </div>
            </div>
          </div>
        </div>
      </div>

    <!-- Foco Operativo Inferior: Casos Prioritarios y Bitácora -->
    <div class="dash-operational-grid">
        <!-- Casos Prioritarios -->
        <div class="card" id="widgetPriorityCases">
          <div class="card-header">
            <div class="dash-card-header-flex">
              <div class="card-title">
                <svg width="18" height="18" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24" aria-hidden="true" style="color: var(--gt-red);"><path stroke-linecap="round" stroke-linejoin="round" d="M12 9v3.75m9-.75a9 9 0 11-18 0 9 9 0 0118 0zm-9 3.75h.008v.008H12v-.008z"></path></svg>
                <span>Menores con Atención Prioritaria</span>
              </div>
            </div>
          </div>
          <div class="dash-priority-list" id="dashPriorityCasesList">
            <!-- Inyectado dinámicamente vía DashboardView.renderPriorityCases -->
          </div>
        </div>

      <!-- Bitácora Reciente -->
      <div class="card stagger-item stagger-animate" id="widgetRecentActivity" style="animation-delay: 90ms;"><div class="card-header"><div class="dash-card-header-flex"><div class="card-title"><svg width="18" height="18" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24" aria-hidden="true" style="color: var(--gt-green);"><path stroke-linecap="round" stroke-linejoin="round" d="M12 6v6h4.5m4.5 0a9 9 0 11-18 0 9 9 0 0118 0z"></path></svg><span>Actividad Reciente del Programa</span></div><a href="/auditoria" class="dash-card-action" title="Abrir bitácora completa"><span>Ver Historial de Cambios</span><svg viewBox="0 0 24 24" fill="none" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" d="M8.25 4.5l7.5 7.5-7.5 7.5"></path></svg></a></div></div><div class="dash-timeline-list" id="dashRecentActivityList"><div class="dash-timeline-item"><div class="dash-timeline-dot "></div><div class="dash-timeline-body"><div class="dash-timeline-header"><span class="dash-timeline-user"><strong>Carmen Mendoza</strong> (Facilitadora)</span><span class="dash-timeline-time">17:30</span></div><p class="dash-timeline-action"><strong>Tamizaje CRED</strong>: Registro de control nutricional mensual y tamizaje de hemoglobina</p><div class="dash-timeline-meta"><span>Sede: Año Nuevo</span></div></div></div><div class="dash-timeline-item"><div class="dash-timeline-dot alert"></div><div class="dash-timeline-body"><div class="dash-timeline-header"><span class="dash-timeline-user"><strong>Lic. Ruth Soto</strong> (Trabajadora Social)</span><span class="dash-timeline-time">16:45</span></div><p class="dash-timeline-action"><strong>Derivación Caso</strong>: Canalización de caso social de urgencia alta a DEMUNA Carabayllo</p><div class="dash-timeline-meta"><span>Sede: El Progreso</span></div></div></div><div class="dash-timeline-item"><div class="dash-timeline-dot "></div><div class="dash-timeline-body"><div class="dash-timeline-header"><span class="dash-timeline-user"><strong>Rosa Flores</strong> (Promotora)</span><span class="dash-timeline-time">15:20</span></div><p class="dash-timeline-action"><strong>Pase Asistencia</strong>: Registro y cierre de asistencia diaria en Casita del Saber</p><div class="dash-timeline-meta"><span>Sede: Año Nuevo</span></div></div></div><div class="dash-timeline-item"><div class="dash-timeline-dot "></div><div class="dash-timeline-body"><div class="dash-timeline-header"><span class="dash-timeline-user"><strong>Dirección Gutenberg</strong> (Coordinación)</span><span class="dash-timeline-time">14:10</span></div><p class="dash-timeline-action"><strong>Aprobación Padrón</strong>: Validación de expedientes del padrón institucional 2026 conforme a Ley 29733</p><div class="dash-timeline-meta"><span>Sede: Central Lima</span></div></div></div></div></div>
    </div>
  </section>

  <!-- Script del cliente -->
  <script>
    import '../scripts/pages/dashboard.js';
  </script>
</AppLayout>
