---
import AppLayout from '../layouts/AppLayout.astro';
import '../styles/views-dashboard.css';
---

<AppLayout title="Dashboard General" currentPage="dashboard">
  <section class="app-view active" id="view-dashboard">
    <!-- Header Operativo Sobrio -->
    <div class="view-header dash-header-clean">
      <div class="view-title-group">
        <div class="dash-title-row">
          <h2>Dashboard General</h2>
        </div>
        <p class="dash-subtitle">
          Supervisión integral de cobertura nutricional, tamizaje de salud y acompañamiento en casitas.
        </p>
      </div>
      <div class="dash-header-actions">
        <button type="button" class="btn-action" onclick="exportDataCSV()">
          <svg fill="none" stroke-width="2" viewBox="0 0 24 24" aria-hidden="true">
            <path
              stroke-linecap="round"
              stroke-linejoin="round"
              d="M3 16.5v2.25A2.25 2.25 0 005.25 21h13.5A2.25 2.25 0 0021 18.75V16.5M16.5 12L12 16.5m0 0L7.5 12m4.5 4.5V3"
            ></path>
          </svg>
          <span>Exportar Informe CSV</span>
        </button>
      </div>
    </div>

    <!-- Tira de Métricas Operativas Clave (Clean Grid) -->
    <div class="dash-kpi-grid" id="kpiDashboardContainer">
      <div class="dash-kpi-item dash-kpi-green stagger-item">
        <div class="dash-kpi-top">
          <span class="dash-kpi-label">Beneficiarios Activos</span>
        </div>
        <div class="dash-kpi-num" id="dashKpiBeneficiarios">15</div>
        <div class="dash-kpi-foot">100% matriculados en el programa</div>
      </div>

      <div class="dash-kpi-item dash-kpi-yellow stagger-item">
        <div class="dash-kpi-top">
          <span class="dash-kpi-label">Tamizados CRED</span>
        </div>
        <div class="dash-kpi-num" id="dashKpiTamizados">15 / 15</div>
        <div class="dash-kpi-foot">Control vigente con dosaje Hb</div>
      </div>

      <div class="dash-kpi-item dash-kpi-blue stagger-item">
        <div class="dash-kpi-top">
          <span class="dash-kpi-label">Asistencia en Casitas</span>
        </div>
        <div class="dash-kpi-num" id="dashKpiAsistencia">92.4%</div>
        <div class="dash-kpi-foot">Promedio territorial consolidado</div>
      </div>

      <div class="dash-kpi-item dash-kpi-red stagger-item">
        <div class="dash-kpi-top">
          <span class="dash-kpi-label">Casos en Alerta</span>
        </div>
        <div class="dash-kpi-num alert" id="dashKpiCasosSociales">0</div>
        <div class="dash-kpi-foot">Seguimiento clínico o social activo</div>
      </div>
    </div>

    <!-- Rejilla Principal: Semáforo Clínico y Cobertura Territorial -->
    <div class="dash-charts-grid">
      <!-- Semáforo de Anemia MINSA (Distribución Clínica) -->
      <div class="card stagger-item" id="widgetAnemiaStatus">
        <div class="card-header">
          <div class="dash-card-header-flex">
            <div class="card-title">
              <svg width="18" height="18" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24" aria-hidden="true" style="color: var(--gt-yellow);">
                <path stroke-linecap="round" stroke-linejoin="round" d="M10.5 6a7.5 7.5 0 107.5 7.5h-7.5V6z"></path>
                <path stroke-linecap="round" stroke-linejoin="round" d="M13.5 10.5H21A7.5 7.5 0 0013.5 3v7.5z"></path>
              </svg>
              <span>Estado Nutricional y Anemia</span>
            </div>
            <a href="/salud" class="dash-card-action" title="Abrir módulo de salud">
              <span>Ver Servicio Alimentario</span>
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" aria-hidden="true">
                <path stroke-linecap="round" stroke-linejoin="round" d="M8.25 4.5l7.5 7.5-7.5 7.5"></path>
              </svg>
            </a>
          </div>
        </div>

        <div class="dash-clinical-panel" id="dashAnemiaBars">
          <!-- Stacked Clinical Progress Bar -->
          <div class="dash-anemia-bar-section">
            <div class="dash-anemia-bar-labels">
              <span class="dash-anemia-bar-caption">Distribución diagnóstica (<span id="dashAnemiaTotalEvaluados">15</span> menores tamizados)</span>
            </div>
            <div class="dash-anemia-track" role="meter" aria-label="Distribución de casos según nivel de hemoglobina" aria-valuenow="15">
              <div class="dash-anemia-seg normal" id="segAnemiaNormal" style="width: 0%;" title="Normal: 47%"></div>
              <div class="dash-anemia-seg leve" id="segAnemiaLeve" style="width: 0%;" title="Anemia Leve: 40%"></div>
              <div class="dash-anemia-seg mod" id="segAnemiaMod" style="width: 0%;" title="Anemia Moderada/Severa: 13%"></div>
            </div>
          </div>

          <!-- 3-Column Diagnostic Breakdown with Unified Thresholds -->
          <div class="dash-anemia-metrics-grid">
            <div class="dash-anemia-col normal">
              <div class="dash-anemia-col-header">
                <span class="dash-status-dot green"></span>
                <span class="dash-anemia-col-name">Normal</span>
              </div>
              <div class="dash-anemia-col-stat">
                <strong class="dash-anemia-count" id="anemiaLegendNormal">7</strong>
                <span class="dash-anemia-pct" id="anemiaPctNormal">(47%)</span>
              </div>
              <div class="dash-anemia-col-ref">&ge; 11.0 g/dL</div>
            </div>

            <div class="dash-anemia-col leve">
              <div class="dash-anemia-col-header">
                <span class="dash-status-dot yellow"></span>
                <span class="dash-anemia-col-name">Anemia Leve</span>
              </div>
              <div class="dash-anemia-col-stat">
                <strong class="dash-anemia-count" id="anemiaLegendLeve">6</strong>
                <span class="dash-anemia-pct" id="anemiaPctLeve">(40%)</span>
              </div>
              <div class="dash-anemia-col-ref">10.0 &ndash; 10.9 g/dL</div>
            </div>

            <div class="dash-anemia-col mod">
              <div class="dash-anemia-col-header">
                <span class="dash-status-dot red"></span>
                <span class="dash-anemia-col-name">Anemia Mod/Sev</span>
              </div>
              <div class="dash-anemia-col-stat">
                <strong class="dash-anemia-count" id="anemiaLegendMod">2</strong>
                <span class="dash-anemia-pct" id="anemiaPctMod">(13%)</span>
              </div>
              <div class="dash-anemia-col-ref">&lt; 10.0 g/dL</div>
            </div>
          </div>
        </div>
      </div>

      <!-- Cobertura Territorial por Casitas y Distritos -->
      <div class="card stagger-item" id="widgetCoverageStatus">
        <div class="card-header">
          <div class="dash-card-header-flex">
            <div class="card-title">
              <svg width="18" height="18" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24" aria-hidden="true" style="color: var(--gt-blue);">
                <path stroke-linecap="round" stroke-linejoin="round" d="M15 10.5a3 3 0 11-6 0 3 3 0 016 0z"></path>
                <path
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  d="M19.5 10.5c0 7.142-7.5 11.25-7.5 11.25S4.5 17.642 4.5 10.5a7.5 7.5 0 1115 0z"
                ></path>
              </svg>
              <span>Cobertura Territorial por Distrito</span>
            </div>
            <a href="/sedes" class="dash-card-action" title="Abrir directorio de sedes">
              <span>Ver Sedes e Iglesias</span>
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" aria-hidden="true">
                <path stroke-linecap="round" stroke-linejoin="round" d="M8.25 4.5l7.5 7.5-7.5 7.5"></path>
              </svg>
            </a>
          </div>
        </div>
        <div class="dash-territory-list" id="dashDistrictCoverage">
          <div class="dash-territory-row">
            <div class="dash-territory-head">
              <div class="dash-territory-info">
                <strong>Distrito de Comas</strong>
                <span class="dash-territory-sub">Sedes (3): Año Nuevo, La Libertad, Carmen Alto</span>
              </div>
              <div class="dash-territory-metric">
                <strong id="badgeDistrict_comas">8 menores</strong>
                <span class="dash-territory-pct" id="pctDistrict_comas">(53%)</span>
              </div>
            </div>
            <div class="dash-territory-track">
              <div class="dash-territory-bar green" style="width: 0%;" id="barDistrict_comas"></div>
            </div>
          </div>

          <div class="dash-territory-row">
            <div class="dash-territory-head">
              <div class="dash-territory-info">
                <strong>Distrito de Carabayllo</strong>
                <span class="dash-territory-sub">Sedes (4): El Progreso, San Pedro, Los Bendecidos, Santa Rosa</span>
              </div>
              <div class="dash-territory-metric">
                <strong id="badgeDistrict_carabayllo">7 menores</strong>
                <span class="dash-territory-pct" id="pctDistrict_carabayllo">(47%)</span>
              </div>
            </div>
            <div class="dash-territory-track">
              <div class="dash-territory-bar blue" style="width: 0%;" id="barDistrict_carabayllo"></div>
            </div>
          </div>
        </div>
      </div>
    </div>

    <!-- Foco Operativo Inferior: Casos Prioritarios y Bitácora -->
    <div class="dash-operational-grid">
      <!-- Casos Prioritarios -->
      <div class="card stagger-item" id="widgetPriorityCases">
        <div class="card-header">
          <div class="dash-card-header-flex">
            <div class="card-title">
              <svg width="18" height="18" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24" aria-hidden="true" style="color: var(--gt-red);">
                <path stroke-linecap="round" stroke-linejoin="round" d="M12 9v3.75m9-.75a9 9 0 11-18 0 9 9 0 0118 0zm-9 3.75h.008v.008H12v-.008z"></path>
              </svg>
              <span>Menores con Atención Prioritaria</span>
            </div>
          </div>
        </div>
        <div class="dash-priority-list" id="dashPriorityCasesList">
          <div class="dash-empty-state">Cargando alertas prioritarias...</div>
        </div>
      </div>

      <!-- Bitácora Reciente -->
      <div class="card stagger-item" id="widgetRecentActivity">
        <div class="card-header">
          <div class="dash-card-header-flex">
            <div class="card-title">
              <svg width="18" height="18" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24" aria-hidden="true" style="color: var(--gt-green);">
                <path stroke-linecap="round" stroke-linejoin="round" d="M12 6v6h4.5m4.5 0a9 9 0 11-18 0 9 9 0 0118 0z"></path>
              </svg>
              <span>Actividad Reciente del Programa</span>
            </div>
            <a href="/auditoria" class="dash-card-action" title="Abrir bitácora completa">
              <span>Ver Historial de Cambios</span>
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" d="M8.25 4.5l7.5 7.5-7.5 7.5"></path>
              </svg>
            </a>
          </div>
        </div>
        <div class="dash-timeline-list" id="dashRecentActivityList">
          <div class="dash-empty-state">Cargando eventos recientes...</div>
        </div>
      </div>
    </div>
  </section>

  <!-- Script del cliente -->
  <script>
    import '../scripts/pages/dashboard.js';
  </script>
</AppLayout>
