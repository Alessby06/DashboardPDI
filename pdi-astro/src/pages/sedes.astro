---
import AppLayout from '../layouts/AppLayout.astro';
import FilterPanel from '../components/FilterPanel.astro';
import FilterField from '../components/FilterField.astro';
import { PROGRAMAS } from '../data/opcionesBeneficiario.js';
import { SEDES_POR_DISTRITO } from '../scripts/core/catalogos.js';
import '../styles/views-sedes.css';

const OPCIONES_DISTRITO = Object.keys(SEDES_POR_DISTRITO).map((distrito) => ({ valor: distrito, etiqueta: distrito }));
const OPCIONES_SERVICIO = PROGRAMAS.map((programa) => ({ valor: programa.clave, etiqueta: programa.etiqueta }));
---

<AppLayout title="Sedes e Iglesias Aliadas" currentPage="sedes">
        <section class="app-view active" id="view-sedes">
          <div class="view-header">
            <div class="view-title-group">
              <h2>Directorio Territorial: Sedes e Iglesias Aliadas</h2>
              <p style="margin: 4px 0 0 0; color: var(--text-muted); font-size: 13.5px;">Mapeo operativo de locales de atención, pastores aliados y aforos en campo.</p>
            </div>
            <div class="view-actions">
              <button type="button" class="btn-action-icon btn-audit-export-icon" id="btnExportSedesCSV"
                onclick="window.openModalExportSedes ? window.openModalExportSedes() : null"
                aria-label="Descargar Directorio de Sedes CSV" title="Descargar Directorio de Sedes CSV">
                <svg width="18" height="18" fill="none" stroke="currentColor" stroke-width="2.2" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round"
                    d="M3 16.5v2.25A2.25 2.25 0 005.25 21h13.5A2.25 2.25 0 0021 18.75V16.5M16.5 12L12 16.5m0 0L7.5 12m4.5 4.5V3" />
                </svg>
              </button>
            </div>
          </div>

          <!-- Barra de Filtros y Búsqueda Rápida Unificada de Sedes -->
          <div class="card" style="margin-bottom: 6px; padding: 12px 16px; position: relative; z-index: 100;">
            <div class="audit-toolbar">
              <!-- Buscador Rápido de Sedes (Lado Izquierdo) -->
              <div class="audit-search-wrap" style="flex:1; max-width:440px;">
                <svg class="audit-search-icon" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round"
                    d="M21 21l-5.197-5.197m0 0A7.5 7.5 0 105.196 5.196a7.5 7.5 0 0010.607 10.607z" />
                </svg>
                <input type="text" id="inputSedesSearch" class="audit-search-input"
                  placeholder="Buscar sede, facilitadora o pastor..."
                  oninput="window.filterSedesSearch ? window.filterSedesSearch(this.value) : null">
                <button type="button" class="audit-search-clear" id="btnSedesSearchClear" style="display:none;"
                  onclick="window.clearSedesSearch ? window.clearSedesSearch() : null" title="Limpiar búsqueda">
                  <svg width="12" height="12" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M6 18L18 6M6 6l12 12" />
                  </svg>
                </button>
              </div>

              <!-- Botón Unificado de Filtros y Panel Desplegable (Lado Derecho) -->
              <FilterPanel
                id="dropdownSedesFilterPanel"
                buttonId="btnDropdownSedesFilterPanel"
                menuId="menuSedesFilterPanel"
                badgeId="sedesActiveFiltersCount"
                title="Filtros de Sedes"
                reset="window.PDI?.SedesView ? window.PDI.SedesView.resetFilters() : null"
              >
                      <!-- Filtro 1: Distrito territorial (seleccion unica con radio) -->
                      <FilterField
                        id="dropdownSedesDistrito"
                        menuId="menuSedesDistrito"
                        labelId="labelSedesDistritoSelect"
                        label="Distrito Territorial"
                        labelTodos="Todos los Distritos"
                        todosEtiqueta="Todos los Distritos"
                        opciones={OPCIONES_DISTRITO}
                        tipo="single"
                        countPrefix="countFacetSedesDistrito"
                        onSelect="window.filterSedesByDistrito"
                        abrir="window.toggleSedesInnerDropdown ? window.toggleSedesInnerDropdown('dropdownSedesDistrito') : null"
                      />
                      
                      <!-- Filtro 2: Servicio / programa (seleccion unica con radio) -->
                      <FilterField
                        id="dropdownSedesServicio"
                        menuId="menuSedesServicio"
                        labelId="labelSedesServicioSelect"
                        label="Servicio / Programa"
                        labelTodos="Todos los Servicios"
                        todosEtiqueta="Todos los Servicios"
                        opciones={OPCIONES_SERVICIO}
                        tipo="single"
                        countPrefix="countFacetSedesServicio"
                        onSelect="window.filterSedesByServicio"
                        abrir="window.toggleSedesInnerDropdown ? window.toggleSedesInnerDropdown('dropdownSedesServicio') : null"
                      />
                              </FilterPanel>
            </div>

            <!-- Barra de Píldoras de Filtros Activos de Sedes (Chips Descartables) -->
            <div class="padron-active-chips-bar" id="sedesActiveChipsBar">
              <span class="padron-active-chips-label">Filtros aplicados:</span>
              <div id="sedesActiveChipsList" style="display: flex; align-items: center; flex-wrap: wrap; gap: 6px;">
              </div>
              <button type="button" class="btn-text-subtle" style="margin-left: auto; font-size: 11.5px;"
                onclick="window.clearSedesFilters ? window.clearSedesFilters() : null">
                Limpiar filtros
              </button>
            </div>
          </div>

          <!-- Contenedor Master-Detail Split Panel de Sedes -->
          <div id="sedesSplitWrapper" class="sedes-split-wrapper">
            <!-- Columna Izquierda: Lista Master Escaneable -->
            <div class="sedes-master-column">
              <div class="sedes-master-header">
                <span class="sedes-master-title">Directorio de Sedes</span>
                <span class="sedes-master-count" id="sedesMasterCountBadge">—</span>
              </div>
              <div class="sedes-master-list" id="sedesMasterList">
                <!-- Inyectado por JS -->
              </div>
            </div>

            <!-- Columna Derecha: Panel Detalle (Ficha Oficial) -->
            <div class="sedes-detail-column" id="sedesDetailPanel">
              <!-- Inyectado por JS -->
            </div>
          </div>

          <!-- Overlay de la hoja inferior de la ficha (solo visible en móvil) -->
          <div class="sedes-sheet-backdrop" id="sedesSheetBackdrop"
            onclick="window.PDI?.SedesView?.cerrarDetalleMovil()"></div>
        </section>

  <script>
    import '../scripts/pages/sedes.js';
  </script>
</AppLayout>