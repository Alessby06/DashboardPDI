---
import AppLayout from '../layouts/AppLayout.astro';
import { PROGRAMAS } from '../data/opcionesBeneficiario.js';
import '../styles/views-sedes.css';
---

<AppLayout title="Sedes e Iglesias Aliadas" currentPage="sedes">
        <section class="app-view active" id="view-sedes">
          <div class="view-header">
            <div class="view-title-group">
              <h2>Directorio Territorial: Sedes e Iglesias Aliadas</h2>
              <p style="margin: 4px 0 0 0; color: var(--text-muted); font-size: 13.5px;">Mapeo operativo de locales de atención, pastores aliados y aforos en campo.</p>
            </div>
            <div class="view-actions">
              <button type="button" class="btn-action-icon btn-audit-export-icon" id="btnExportSedesCSV"
                onclick="window.openModalExportSedes ? window.openModalExportSedes() : null"
                aria-label="Descargar Directorio de Sedes CSV" title="Descargar Directorio de Sedes CSV">
                <svg width="18" height="18" fill="none" stroke="currentColor" stroke-width="2.2" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round"
                    d="M3 16.5v2.25A2.25 2.25 0 005.25 21h13.5A2.25 2.25 0 0021 18.75V16.5M16.5 12L12 16.5m0 0L7.5 12m4.5 4.5V3" />
                </svg>
              </button>
            </div>
          </div>

          <!-- Barra de Filtros y Búsqueda Rápida Unificada de Sedes -->
          <div class="card" style="margin-bottom: 6px; padding: 12px 16px; position: relative; z-index: 100;">
            <div class="audit-toolbar">
              <!-- Buscador Rápido de Sedes (Lado Izquierdo) -->
              <div class="audit-search-wrap" style="flex:1; max-width:440px;">
                <svg class="audit-search-icon" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round"
                    d="M21 21l-5.197-5.197m0 0A7.5 7.5 0 105.196 5.196a7.5 7.5 0 0010.607 10.607z" />
                </svg>
                <input type="text" id="inputSedesSearch" class="audit-search-input"
                  placeholder="Buscar sede, facilitadora o pastor..."
                  oninput="window.filterSedesSearch ? window.filterSedesSearch(this.value) : null">
                <button type="button" class="audit-search-clear" id="btnSedesSearchClear" style="display:none;"
                  onclick="window.clearSedesSearch ? window.clearSedesSearch() : null" title="Limpiar búsqueda">
                  <svg width="12" height="12" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M6 18L18 6M6 6l12 12" />
                  </svg>
                </button>
              </div>

              <!-- Botón Unificado de Filtros y Panel Desplegable (Lado Derecho) -->
              <div class="audit-filter-panel-wrap">
                <div class="custom-dropdown audit-filters-dropdown" id="dropdownSedesFilterPanel">
                  <button type="button" class="btn-action audit-filter-btn" id="btnDropdownSedesFilterPanel"
                    onclick="window.toggleCustomDropdown ? window.toggleCustomDropdown('dropdownSedesFilterPanel') : null">
                    <svg width="16" height="16" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
                      <path stroke-linecap="round" stroke-linejoin="round"
                        d="M12 3c2.755 0 5.455.232 8.083.678.533.09.917.556.917 1.096v1.044a2.25 2.25 0 01-.659 1.591l-5.432 5.432a2.25 2.25 0 00-.659 1.591v2.927a2.25 2.25 0 01-1.244 2.013L9.75 21v-6.568a2.25 2.25 0 00-.659-1.591L3.659 7.409A2.25 2.25 0 013 5.818V4.774c0-.54.384-1.006.917-1.096A48.32 48.32 0 0112 3z" />
                    </svg>
                    <span>Filtros</span>
                    <span class="audit-filter-badge" id="sedesActiveFiltersCount" style="display:none;">0</span>
                    <svg width="12" height="12" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24"
                      class="filter-caret">
                      <path stroke-linecap="round" stroke-linejoin="round" d="M19.5 8.25l-7.5 7.5-7.5-7.5" />
                    </svg>
                  </button>

                  <!-- Panel Desplegable Popover de Filtros de Sedes -->
                  <div class="custom-dropdown-menu audit-filters-menu" id="menuSedesFilterPanel">
                    <div class="audit-filters-header">
                      <div class="audit-filters-header-title">
                        <span>Filtros de Sedes</span>
                      </div>
                      <div class="audit-filters-header-actions">
                        <button type="button" class="btn-text-subtle"
                          onclick="window.clearSedesFilters ? window.clearSedesFilters() : null">Restablecer</button>
                        <button type="button" class="btn-close-sheet" aria-label="Cerrar filtros"
                          onclick="window.closeAllFilterSheets ? window.closeAllFilterSheets() : null">
                          <svg width="15" height="15" fill="none" stroke="currentColor" stroke-width="2.2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M6 18L18 6M6 6l12 12"/></svg>
                        </button>
                      </div>
                    </div>

                    <div class="audit-filters-body">
                      <!-- Filtro 1: Distrito Territorial -->
                      <div class="audit-filter-field">
                        <label class="audit-field-label">Distrito Territorial</label>
                        <div class="padron-inner-dropdown" id="dropdownSedesDistrito">
                          <button type="button" class="padron-inner-dropdown-btn"
                            onclick="window.toggleSedesInnerDropdown ? window.toggleSedesInnerDropdown('dropdownSedesDistrito') : null">
                            <span id="labelSedesDistritoSelect">Todos los Distritos</span>
                            <svg class="caret" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24">
                              <path stroke-linecap="round" stroke-linejoin="round" d="M19.5 8.25l-7.5 7.5-7.5-7.5" />
                            </svg>
                          </button>
                          <div class="padron-inner-dropdown-menu" id="menuSedesDistrito">
                            <div class="padron-dropdown-item selected" data-value="all"
                              onclick="window.filterSedesByDistrito ? window.filterSedesByDistrito('all') : null">
                              <div class="padron-item-left">
                                <span class="padron-item-checkbox">
                                  <svg width="10" height="10" fill="none" stroke="currentColor" stroke-width="3"
                                    viewBox="0 0 24 24">
                                    <path stroke-linecap="round" stroke-linejoin="round" d="M4.5 12.75l6 6 9-13.5" />
                                  </svg>
                                </span>
                                <span class="padron-item-label">Todos los Distritos</span>
                              </div>
                            </div>
                            <div class="padron-dropdown-item" data-value="Comas"
                              onclick="window.filterSedesByDistrito ? window.filterSedesByDistrito('Comas') : null">
                              <div class="padron-item-left">
                                <span class="padron-item-checkbox">
                                  <svg width="10" height="10" fill="none" stroke="currentColor" stroke-width="3"
                                    viewBox="0 0 24 24">
                                    <path stroke-linecap="round" stroke-linejoin="round" d="M4.5 12.75l6 6 9-13.5" />
                                  </svg>
                                </span>
                                <span class="padron-item-label">Comas</span>
                              </div>
                            </div>
                            <div class="padron-dropdown-item" data-value="Carabayllo"
                              onclick="window.filterSedesByDistrito ? window.filterSedesByDistrito('Carabayllo') : null">
                              <div class="padron-item-left">
                                <span class="padron-item-checkbox">
                                  <svg width="10" height="10" fill="none" stroke="currentColor" stroke-width="3"
                                    viewBox="0 0 24 24">
                                    <path stroke-linecap="round" stroke-linejoin="round" d="M4.5 12.75l6 6 9-13.5" />
                                  </svg>
                                </span>
                                <span class="padron-item-label">Carabayllo</span>
                              </div>
                            </div>
                          </div>
                        </div>
                      </div>

                      <!-- Filtro 2: Servicio / Programa -->
                      <div class="audit-filter-field">
                        <label class="audit-field-label">Servicio / Programa</label>
                        <div class="padron-inner-dropdown" id="dropdownSedesServicio">
                          <button type="button" class="padron-inner-dropdown-btn"
                            onclick="window.toggleSedesInnerDropdown ? window.toggleSedesInnerDropdown('dropdownSedesServicio') : null">
                            <span id="labelSedesServicioSelect">Todos los Servicios</span>
                            <svg class="caret" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24">
                              <path stroke-linecap="round" stroke-linejoin="round" d="M19.5 8.25l-7.5 7.5-7.5-7.5" />
                            </svg>
                          </button>
                          <div class="padron-inner-dropdown-menu" id="menuSedesServicio">
                            <div class="padron-dropdown-item selected" data-value="all"
                              onclick="window.filterSedesByServicio ? window.filterSedesByServicio('all') : null">
                              <div class="padron-item-left">
                                <span class="padron-item-checkbox">
                                  <svg width="10" height="10" fill="none" stroke="currentColor" stroke-width="3"
                                    viewBox="0 0 24 24">
                                    <path stroke-linecap="round" stroke-linejoin="round" d="M4.5 12.75l6 6 9-13.5" />
                                  </svg>
                                </span>
                                <span class="padron-item-label">Todos los Servicios</span>
                              </div>
                            </div>
                            {PROGRAMAS.map((programa) => (
                              <div class="padron-dropdown-item" data-value={programa.clave}
                                onclick={`window.filterSedesByServicio ? window.filterSedesByServicio('${programa.clave}') : null`}>
                                <div class="padron-item-left">
                                  <span class="padron-item-checkbox">
                                    <svg width="10" height="10" fill="none" stroke="currentColor" stroke-width="3"
                                      viewBox="0 0 24 24">
                                      <path stroke-linecap="round" stroke-linejoin="round" d="M4.5 12.75l6 6 9-13.5" />
                                    </svg>
                                  </span>
                                  <span class="padron-item-label">{programa.etiqueta}</span>
                                </div>
                              </div>
                            ))}
                          </div>
                        </div>
                      </div>

                    </div>

                    <!-- Footer fijo móvil con botón para aplicar y cerrar el Bottom Sheet -->
                    <div class="audit-filters-footer">
                      <button type="button" class="btn-action primary btn-apply-filters"
                        onclick="window.closeAllFilterSheets ? window.closeAllFilterSheets() : null">
                        <svg width="15" height="15" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M4.5 12.75l6 6 9-13.5"/></svg>
                        <span>Aplicar Filtros</span>
                      </button>
                    </div>
                  </div>
                </div>
              </div>
            </div>

            <!-- Barra de Píldoras de Filtros Activos de Sedes (Chips Descartables) -->
            <div class="padron-active-chips-bar" id="sedesActiveChipsBar"
              style="display: none; margin-top: 10px; border-top: 1px solid var(--border-subtle); padding-top: 8px;">
              <span class="padron-active-chips-label">Filtros aplicados:</span>
              <div id="sedesActiveChipsList" style="display: flex; align-items: center; flex-wrap: wrap; gap: 6px;">
              </div>
              <button type="button" class="btn-text-subtle" style="margin-left: auto; font-size: 11.5px;"
                onclick="window.clearSedesFilters ? window.clearSedesFilters() : null">
                Borrar todos
              </button>
            </div>
          </div>

          <!-- Contenedor Master-Detail Split Panel de Sedes -->
          <div id="sedesSplitWrapper" class="sedes-split-wrapper">
            <!-- Columna Izquierda: Lista Master Escaneable -->
            <div class="sedes-master-column">
              <div class="sedes-master-header">
                <span class="sedes-master-title">Directorio de Sedes</span>
                <span class="sedes-master-count" id="sedesMasterCountBadge">—</span>
              </div>
              <div class="sedes-master-list" id="sedesMasterList">
                <!-- Inyectado por JS -->
              </div>
            </div>

            <!-- Columna Derecha: Panel Detalle (Ficha Oficial) -->
            <div class="sedes-detail-column" id="sedesDetailPanel">
              <!-- Inyectado por JS -->
            </div>
          </div>

          <!-- Overlay de la hoja inferior de la ficha (solo visible en móvil) -->
          <div class="sedes-sheet-backdrop" id="sedesSheetBackdrop"
            onclick="window.PDI?.SedesView?.cerrarDetalleMovil()"></div>
        </section>

  <script>
    import '../scripts/pages/sedes.js';
  </script>
</AppLayout>