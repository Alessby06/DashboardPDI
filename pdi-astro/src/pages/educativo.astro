---
import AppLayout from '../layouts/AppLayout.astro';
import '../styles/views-educativo.css';
---

<AppLayout title="Casita del Saber" currentPage="educativo">
        <section class="app-view active" id="view-educativo">
          <div class="view-header">
            <div class="view-title-group">
              <h2>Acompañamiento Educativo: Casita del Saber</h2>
              <p>Control de asistencia formativa rápida y padrón seguro de retiro de menores con acreditación legal .
              </p>
            </div>
            <div class="view-actions">
              <button type="button" class="btn-action-icon btn-audit-export-icon" id="btnExportEducativoCSV"
                onclick="window.openModalExportEducativo ? window.openModalExportEducativo() : null"
                aria-label="Descargar Pase de Asistencia CSV" title="Descargar Pase de Asistencia CSV">
                <svg width="18" height="18" fill="none" stroke="currentColor" stroke-width="2.2" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round"
                    d="M3 16.5v2.25A2.25 2.25 0 005.25 21h13.5A2.25 2.25 0 0021 18.75V16.5M16.5 12L12 16.5m0 0L7.5 12m4.5 4.5V3" />
                </svg>
              </button>
            </div>
          </div>

          <div class="card" id="cardAsistenciaCasita">
            <div class="card-header">
              <div>
                <div class="card-title">Pase de Asistencia Rápida y Verificación de Salida</div>
                <div style="font-size: 13px; color: var(--text-muted);">Sede: Casita del Saber: Año Nuevo (Comas)</div>
              </div>
            </div>

            <!-- Barra de Filtros y Búsqueda Rápida de Casitas (Estandarizada con padron.astro) -->
            <div class="audit-toolbar" style="margin-bottom: 16px;">
              <!-- Buscador Casitas (Lado Izquierdo) -->
              <div class="audit-search-wrap">
                <svg class="audit-search-icon" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round"
                    d="M21 21l-5.197-5.197m0 0A7.5 7.5 0 105.196 5.196a7.5 7.5 0 0010.607 10.607z" />
                </svg>
                <input type="text" class="audit-search-input" id="inputCasitasSearch"
                  placeholder="Buscar menor por nombre, código, colegio, apoderado..."
                  oninput="window.filterCasitasSearch ? window.filterCasitasSearch(this.value) : (window.PDI?.CasitasView ? window.PDI.CasitasView.filterBySearch(this.value) : null)">
                <button type="button" class="audit-search-clear" id="btnCasitasSearchClear" style="display:none;"
                  onclick="window.clearCasitasSearch ? window.clearCasitasSearch() : (window.PDI?.CasitasView ? window.PDI.CasitasView.clearSearch() : null)" title="Limpiar búsqueda">
                  <svg width="12" height="12" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M6 18L18 6M6 6l12 12" />
                  </svg>
                </button>
              </div>

              <!-- Botonera de Filtros Casitas (Lado Derecho) -->
              <div class="audit-filter-panel-wrap">
                <div class="custom-dropdown audit-filters-dropdown" id="dropdownCasitasFilterPanel">
                  <button type="button" class="btn-action audit-filter-btn" id="btnDropdownCasitasFilterPanel"
                    onclick="window.toggleCustomDropdown ? window.toggleCustomDropdown('dropdownCasitasFilterPanel') : null">
                    <svg width="16" height="16" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
                      <path stroke-linecap="round" stroke-linejoin="round"
                        d="M12 3c2.755 0 5.455.232 8.083.678.533.09.917.556.917 1.096v1.044a2.25 2.25 0 01-.659 1.591l-5.432 5.432a2.25 2.25 0 00-.659 1.591v2.927a2.25 2.25 0 01-1.244 2.013L9.75 21v-6.568a2.25 2.25 0 00-.659-1.591L3.659 7.409A2.25 2.25 0 013 5.818V4.774c0-.54.384-1.006.917-1.096A48.32 48.32 0 0112 3z" />
                    </svg>
                    <span>Filtros</span>
                    <span class="audit-filter-badge" id="casitasActiveFiltersCount" style="display:none;">0</span>
                    <svg width="12" height="12" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24"
                      class="filter-caret">
                      <path stroke-linecap="round" stroke-linejoin="round" d="M19.5 8.25l-7.5 7.5-7.5-7.5" />
                    </svg>
                  </button>

                  <div class="custom-dropdown-menu audit-filters-menu" id="menuCasitasFilterPanel">
                    <div class="audit-filters-header">
                      <div class="audit-filters-header-title">
                        <span>Filtros Casita del Saber</span>
                      </div>
                      <div class="audit-filters-header-actions">
                        <button type="button" class="btn-text-subtle"
                          onclick="window.resetCasitasFilters ? window.resetCasitasFilters() : null">Restablecer</button>
                        <button type="button" class="btn-close-sheet" aria-label="Cerrar filtros"
                          onclick="window.closeAllFilterSheets ? window.closeAllFilterSheets() : null">
                          <svg width="15" height="15" fill="none" stroke="currentColor" stroke-width="2.2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M6 18L18 6M6 6l12 12"/></svg>
                        </button>
                      </div>
                    </div>

                    <div class="audit-filters-body">
                      <!-- Filtro 1: Asistencia Hoy -->
                      <div class="audit-filter-field">
                        <label class="audit-field-label">Estado de Asistencia Hoy</label>
                        <div class="padron-inner-dropdown" id="dropdownCasitasAsistencia">
                          <button type="button" class="padron-inner-dropdown-btn"
                            onclick="window.toggleInnerFilterDropdown ? window.toggleInnerFilterDropdown('dropdownCasitasAsistencia') : (window.toggleCustomDropdown ? window.toggleCustomDropdown('dropdownCasitasAsistencia') : null)">
                            <span id="labelCasitasAsistenciaSelect">Todos los Estados</span>
                            <svg class="caret" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24">
                              <path stroke-linecap="round" stroke-linejoin="round" d="M19.5 8.25l-7.5 7.5-7.5-7.5" />
                            </svg>
                          </button>
                          <div class="padron-inner-dropdown-menu" id="menuCasitasAsistencia">
                            <div class="padron-dropdown-item selected" data-value="all"
                              onclick="window.selectCasitasAsistencia ? window.selectCasitasAsistencia('all', 'Todos los Estados') : null">
                              <div class="padron-item-left">
                                <span class="padron-item-radio"></span>
                                <span class="padron-item-label">Todos los Estados</span>
                              </div>
                            </div>
                            <div class="padron-dropdown-item" data-value="P"
                              onclick="window.selectCasitasAsistencia ? window.selectCasitasAsistencia('P', 'Presente (P)') : null">
                              <div class="padron-item-left">
                                <span class="padron-item-radio"></span>
                                <span class="padron-item-label">Presente (P)</span>
                              </div>
                            </div>
                            <div class="padron-dropdown-item" data-value="T"
                              onclick="window.selectCasitasAsistencia ? window.selectCasitasAsistencia('T', 'Tardanza (T)') : null">
                              <div class="padron-item-left">
                                <span class="padron-item-radio"></span>
                                <span class="padron-item-label">Tardanza (T)</span>
                              </div>
                            </div>
                            <div class="padron-dropdown-item" data-value="FJ"
                              onclick="window.selectCasitasAsistencia ? window.selectCasitasAsistencia('FJ', 'Falta Justificada (FJ)') : null">
                              <div class="padron-item-left">
                                <span class="padron-item-radio"></span>
                                <span class="padron-item-label">Falta Justificada (FJ)</span>
                              </div>
                            </div>
                            <div class="padron-dropdown-item" data-value="FI"
                              onclick="window.selectCasitasAsistencia ? window.selectCasitasAsistencia('FI', 'Falta Injustificada (FI)') : null">
                              <div class="padron-item-left">
                                <span class="padron-item-radio"></span>
                                <span class="padron-item-label">Falta Injustificada (FI)</span>
                              </div>
                            </div>
                          </div>
                        </div>
                      </div>

                      <!-- Filtro 2: Sede Casita -->
                      <div class="audit-filter-field">
                        <label class="audit-field-label">Sede / Casita</label>
                        <div class="padron-inner-dropdown" id="dropdownCasitasSede">
                          <button type="button" class="padron-inner-dropdown-btn"
                            onclick="window.toggleInnerFilterDropdown ? window.toggleInnerFilterDropdown('dropdownCasitasSede') : (window.toggleCustomDropdown ? window.toggleCustomDropdown('dropdownCasitasSede') : null)">
                            <span id="labelCasitasSedeSelect">Todas las Sedes</span>
                            <svg class="caret" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24">
                              <path stroke-linecap="round" stroke-linejoin="round" d="M19.5 8.25l-7.5 7.5-7.5-7.5" />
                            </svg>
                          </button>
                          <div class="padron-inner-dropdown-menu" id="menuCasitasSede">
                            <div class="padron-dropdown-item selected" data-value="all"
                              onclick="window.toggleCasitasSede ? window.toggleCasitasSede('all') : null">
                              <div class="padron-item-left">
                                <span class="padron-item-checkbox">
                                  <svg width="10" height="10" fill="none" stroke="currentColor" stroke-width="3"
                                    viewBox="0 0 24 24">
                                    <path stroke-linecap="round" stroke-linejoin="round" d="M4.5 12.75l6 6 9-13.5" />
                                  </svg>
                                </span>
                                <span class="padron-item-label">Todas las Sedes</span>
                              </div>
                            </div>
                            <div class="padron-dropdown-item" data-value="Año Nuevo"
                              onclick="window.toggleCasitasSede ? window.toggleCasitasSede('Año Nuevo') : null">
                              <div class="padron-item-left">
                                <span class="padron-item-checkbox">
                                  <svg width="10" height="10" fill="none" stroke="currentColor" stroke-width="3"
                                    viewBox="0 0 24 24">
                                    <path stroke-linecap="round" stroke-linejoin="round" d="M4.5 12.75l6 6 9-13.5" />
                                  </svg>
                                </span>
                                <span class="padron-item-label">Año Nuevo (Comas)</span>
                              </div>
                            </div>
                            <div class="padron-dropdown-item" data-value="La Libertad"
                              onclick="window.toggleCasitasSede ? window.toggleCasitasSede('La Libertad') : null">
                              <div class="padron-item-left">
                                <span class="padron-item-checkbox">
                                  <svg width="10" height="10" fill="none" stroke="currentColor" stroke-width="3"
                                    viewBox="0 0 24 24">
                                    <path stroke-linecap="round" stroke-linejoin="round" d="M4.5 12.75l6 6 9-13.5" />
                                  </svg>
                                </span>
                                <span class="padron-item-label">La Libertad (Comas)</span>
                              </div>
                            </div>
                            <div class="padron-dropdown-item" data-value="San Pedro"
                              onclick="window.toggleCasitasSede ? window.toggleCasitasSede('San Pedro') : null">
                              <div class="padron-item-left">
                                <span class="padron-item-checkbox">
                                  <svg width="10" height="10" fill="none" stroke="currentColor" stroke-width="3"
                                    viewBox="0 0 24 24">
                                    <path stroke-linecap="round" stroke-linejoin="round" d="M4.5 12.75l6 6 9-13.5" />
                                  </svg>
                                </span>
                                <span class="padron-item-label">San Pedro (Carabayllo)</span>
                              </div>
                            </div>
                            <div class="padron-dropdown-item" data-value="El Progreso"
                              onclick="window.toggleCasitasSede ? window.toggleCasitasSede('El Progreso') : null">
                              <div class="padron-item-left">
                                <span class="padron-item-checkbox">
                                  <svg width="10" height="10" fill="none" stroke="currentColor" stroke-width="3"
                                    viewBox="0 0 24 24">
                                    <path stroke-linecap="round" stroke-linejoin="round" d="M4.5 12.75l6 6 9-13.5" />
                                  </svg>
                                </span>
                                <span class="padron-item-label">El Progreso (Carabayllo)</span>
                              </div>
                            </div>
                            <div class="padron-dropdown-item" data-value="Santa Rosa"
                              onclick="window.toggleCasitasSede ? window.toggleCasitasSede('Santa Rosa') : null">
                              <div class="padron-item-left">
                                <span class="padron-item-checkbox">
                                  <svg width="10" height="10" fill="none" stroke="currentColor" stroke-width="3"
                                    viewBox="0 0 24 24">
                                    <path stroke-linecap="round" stroke-linejoin="round" d="M4.5 12.75l6 6 9-13.5" />
                                  </svg>
                                </span>
                                <span class="padron-item-label">Santa Rosa (Carabayllo)</span>
                              </div>
                            </div>
                            <div class="padron-dropdown-item" data-value="Los Bendecidos"
                              onclick="window.toggleCasitasSede ? window.toggleCasitasSede('Los Bendecidos') : null">
                              <div class="padron-item-left">
                                <span class="padron-item-checkbox">
                                  <svg width="10" height="10" fill="none" stroke="currentColor" stroke-width="3"
                                    viewBox="0 0 24 24">
                                    <path stroke-linecap="round" stroke-linejoin="round" d="M4.5 12.75l6 6 9-13.5" />
                                  </svg>
                                </span>
                                <span class="padron-item-label">Los Bendecidos (Carabayllo)</span>
                              </div>
                            </div>
                          </div>
                        </div>
                      </div>

                      <!-- Filtro 3: Grado / Nivel -->
                      <div class="audit-filter-field">
                        <label class="audit-field-label">Nivel / Grado Escolar</label>
                        <div class="padron-inner-dropdown" id="dropdownCasitasGrado">
                          <button type="button" class="padron-inner-dropdown-btn"
                            onclick="window.toggleInnerFilterDropdown ? window.toggleInnerFilterDropdown('dropdownCasitasGrado') : (window.toggleCustomDropdown ? window.toggleCustomDropdown('dropdownCasitasGrado') : null)">
                            <span id="labelCasitasGradoSelect">Todos los Grados</span>
                            <svg class="caret" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24">
                              <path stroke-linecap="round" stroke-linejoin="round" d="M19.5 8.25l-7.5 7.5-7.5-7.5" />
                            </svg>
                          </button>
                          <div class="padron-inner-dropdown-menu" id="menuCasitasGrado">
                            <div class="padron-dropdown-item selected" data-value="all"
                              onclick="window.selectCasitasGrado ? window.selectCasitasGrado('all', 'Todos los Grados') : null">
                              <div class="padron-item-left">
                                <span class="padron-item-radio"></span>
                                <span class="padron-item-label">Todos los Grados</span>
                              </div>
                            </div>
                            <div class="padron-dropdown-item" data-value="inicial"
                              onclick="window.selectCasitasGrado ? window.selectCasitasGrado('inicial', 'Inicial / Pre-escolar') : null">
                              <div class="padron-item-left">
                                <span class="padron-item-radio"></span>
                                <span class="padron-item-label">Inicial / Pre-escolar</span>
                              </div>
                            </div>
                            <div class="padron-dropdown-item" data-value="primaria"
                              onclick="window.selectCasitasGrado ? window.selectCasitasGrado('primaria', 'Primaria (1° a 6°)') : null">
                              <div class="padron-item-left">
                                <span class="padron-item-radio"></span>
                                <span class="padron-item-label">Primaria (1° a 6°)</span>
                              </div>
                            </div>
                            <div class="padron-dropdown-item" data-value="secundaria"
                              onclick="window.selectCasitasGrado ? window.selectCasitasGrado('secundaria', 'Secundaria (1° a 5°)') : null">
                              <div class="padron-item-left">
                                <span class="padron-item-radio"></span>
                                <span class="padron-item-label">Secundaria (1° a 5°)</span>
                              </div>
                            </div>
                          </div>
                        </div>
                      </div>

                    </div>

                    <!-- Footer fijo móvil con botón para aplicar y cerrar el Bottom Sheet -->
                    <div class="audit-filters-footer">
                      <button type="button" class="btn-action primary btn-apply-filters"
                        onclick="window.closeAllFilterSheets ? window.closeAllFilterSheets() : null">
                        <svg width="15" height="15" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M4.5 12.75l6 6 9-13.5"/></svg>
                        <span>Aplicar Filtros</span>
                      </button>
                    </div>
                  </div>
                </div>
              </div>
            </div>

            <!-- Barra de Filtros Aplicados Casitas -->
            <div class="padron-active-chips-bar" id="casitasActiveChipsBar" style="display: none;">
              <span class="padron-active-chips-label">Filtros aplicados:</span>
              <div id="casitasActiveChipsList" style="display: flex; align-items: center; flex-wrap: wrap; gap: 6px;">
              </div>
              <button type="button" class="btn-text-subtle" style="margin-left: auto; font-size: 11.5px;"
                onclick="window.resetCasitasFilters ? window.resetCasitasFilters() : null">Borrar todos</button>
            </div>

            <div class="table-container desktop-table-view">
              <table class="data-table">
                <thead>
                  <tr>
                    <th>Menor</th>
                    <th>Grado Escolar</th>
                    <th>Colegio de Origen</th>
                    <th>Personas Acreditadas de Salida</th>
                    <th>Estado Hoy</th>
                    <th>Marcar Asistencia</th>
                  </tr>
                </thead>
                <tbody id="tbodyAsistenciaCasita">
                  <!-- Injected via JS -->
                </tbody>
              </table>
            </div>
            <div class="mobile-accordion-list" id="mobileCardsCasita">
              <!-- Injected via JS -->
            </div>

            <!-- Controles de Paginación de Casitas del Saber (PC / Móvil) -->
            <div class="padron-pagination-bar" id="casitasPaginationBar">
              <div class="padron-pagination-left">
                <span id="casitasPaginationInfo" style="font-size:12.5px; color:var(--text-muted); font-weight:500;">
                  Mostrando 0 de 0 menores
                </span>
                <div class="padron-density-wrapper" id="casitasDensityWrapper"
                  style="display:flex; align-items:center; gap:6px;">
                  <span style="font-size:12px; color:var(--text-dim);">Mostrar:</span>
                  <select class="audit-density-select padron-density-select" id="selectCasitasPageSize"
                    onchange="window.casitasSetPageSize ? window.casitasSetPageSize(this.value) : (window.PDI?.CasitasView?.setPageSize ? window.PDI.CasitasView.setPageSize(this.value) : null)">
                    <option value="10">10 por página</option>
                    <option value="20" selected>20 por página</option>
                    <option value="50">50 por página (Máx)</option>
                  </select>
                </div>
              </div>
              <div class="padron-pagination-right">
                <button type="button" class="btn-page" id="btnCasitasPagePrev"
                  onclick="window.casitasPrevPage ? window.casitasPrevPage() : (window.PDI?.CasitasView?.prevPage ? window.PDI.CasitasView.prevPage() : null)">
                  <svg width="14" height="14" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M15.75 19.5L8.25 12l7.5-7.5" />
                  </svg>
                  <span>Anterior</span>
                </button>
                <span class="audit-page-indicator" id="casitasCurrentPageNum">Página 1</span>
                <button type="button" class="btn-page" id="btnCasitasPageNext"
                  onclick="window.casitasNextPage ? window.casitasNextPage() : (window.PDI?.CasitasView?.nextPage ? window.PDI.CasitasView.nextPage() : null)">
                  <span>Siguiente</span>
                  <svg width="14" height="14" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M8.25 4.5l7.5 7.5-7.5 7.5" />
                  </svg>
                </button>
              </div>
            </div>
          </div>
        </section>

  <script>
    import '../scripts/pages/educativo.js';
  </script>
</AppLayout>