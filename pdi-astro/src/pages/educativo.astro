---
import AppLayout from '../layouts/AppLayout.astro';
import FilterPanel from '../components/FilterPanel.astro';
import FilterField from '../components/FilterField.astro';
import SortMenu from '../components/SortMenu.astro';
import { SEDES_OPERATIVAS } from '../data/opcionesBeneficiario.js';
import '../styles/views-educativo.css';
import Icon from '../components/Icon.astro';

const OPCIONES_SEDE = SEDES_OPERATIVAS.map((sede) => ({ valor: sede.nombre, etiqueta: sede.etiqueta }));
const OPCIONES_GRADO = [
  { valor: 'inicial', etiqueta: 'Inicial / Pre-escolar' },
  { valor: 'primaria', etiqueta: 'Primaria (1° a 6°)' },
  { valor: 'secundaria', etiqueta: 'Secundaria (1° a 5°)' },
];
const OPCIONES_ORDEN_CASITAS = [
  { valor: 'apellido-asc', etiqueta: 'Apellido (A-Z)' },
  { valor: 'apellido-desc', etiqueta: 'Apellido (Z-A)' },
  { valor: 'sede-asc', etiqueta: 'Sede (A-Z)' },
  { valor: 'edad-asc', etiqueta: 'Edad (menor a mayor)' },
  { valor: 'edad-desc', etiqueta: 'Edad (mayor a menor)' },
  { valor: 'grado-asc', etiqueta: 'Grado (inicial a secundaria)' },
];
---

<AppLayout title="Servicio de Acompañamiento Educativo" currentPage="educativo">
        <section class="app-view active" id="view-educativo">
          <div class="view-header">
            <div class="view-title-group">
              <h2>Acompañamiento Educativo: Casita del Saber</h2>
              <p>Control de asistencia formativa rápida y padrón seguro de retiro de usuarios con acreditación legal.
              </p>
            </div>
          </div>

          <!-- Barra de Pestañas de Casita del Saber -->
          <div class="social-view-tabs educativo-view-tabs" role="tablist" aria-label="Secciones de Casita del Saber">
            <button type="button" class="social-tab-btn educativo-tab-btn active" id="tabBtnEducativoAsistencia" data-tab="asistencia" role="tab" aria-selected="true" aria-controls="viewEducativoAsistencia">
              <Icon name="educacion.libro" size={16} />
              <span>Jornada de Asistencia</span>
            </button>
            <button type="button" class="social-tab-btn educativo-tab-btn" id="tabBtnEducativoAcciones" data-tab="acciones" role="tab" aria-selected="false" aria-controls="viewEducativoAcciones">
              <Icon name="archivo.lista" size={16} />
              <span>Acciones Socio-Educativas & Monitoreo</span>
            </button>
          </div>

          <!-- SUBVISTA 1: Jornada de Asistencia Diaria -->
          <div class="educativo-subview-panel active" id="viewEducativoAsistencia">
            <div class="card" id="cardAsistenciaCasita">
            <div class="card-header">
              <div>
                <div class="card-title">Jornada de Asistencia · Casita del Saber</div>
                <div style="font-size: 13px; color: var(--text-muted);" id="jornadaSubtituloSede">
                  Elige una sede para abrir la jornada
                </div>
              </div>
            </div>

            <!-- Barra de Jornada: un día y una sede por pase. -->
            <div class="jornada-bar" id="jornadaBar">
              <div class="jornada-campo">
                <label class="jornada-label" for="inputJornadaFecha">Día de la jornada</label>
                <input type="date" id="inputJornadaFecha" class="jornada-input"
                  onchange="window.casitasCambiarDia ? window.casitasCambiarDia(this.value) : null">
              </div>

              <div class="jornada-campo jornada-campo-sede">
                <label class="jornada-label" for="selectJornadaSede">Casita / Sede</label>
                <select id="selectJornadaSede" class="jornada-input"
                  onchange="window.casitasCambiarSede ? window.casitasCambiarSede(this.value) : null">
                  <option value="">Elige una sede…</option>
                  {OPCIONES_SEDE.map((sede) => (
                    <option value={sede.valor}>{sede.etiqueta}</option>
                  ))}
                </select>
              </div>

              <div class="jornada-resumen" id="jornadaResumen" aria-live="polite">
                <span class="jornada-resumen-vacio">Sin sede seleccionada</span>
              </div>

              <div class="jornada-acciones">
                <span class="jornada-estado" id="jornadaEstadoGuardado">Jornada sin iniciar</span>
                <button type="button" class="btn-action" id="btnRecargarJornada"
                  onclick="window.casitasRecargarJornada ? window.casitasRecargarJornada() : null"
                  title="Volver a leer la jornada desde SurrealDB">
                  <Icon name="accion.actualizar" size={15} />
                  <span>Recargar</span>
                </button>
                <button type="button" class="btn-action primary" id="btnGuardarJornada" disabled
                  onclick="window.casitasGuardarJornada ? window.casitasGuardarJornada() : null">
                  <Icon name="accion.confirmar" size={15} />
                  <span class="btn-label">Guardar jornada</span>
                </button>
              </div>
            </div>

            <p class="jornada-solo-lectura" id="jornadaSoloLectura" hidden></p>
            <div class="jornada-avisos" id="jornadaAvisos" hidden></div>

            <!-- Barra de Filtros y Búsqueda Rápida de Casitas (Estandarizada con padron.astro) -->
            <div class="audit-toolbar table-toolbar" style="margin-bottom: 16px;">
              <!-- Buscador Casitas (Lado Izquierdo) -->
              <div class="audit-search-wrap">
                <Icon name="accion.buscar" size={2} class="audit-search-icon" />
                <input type="text" class="audit-search-input" id="inputCasitasSearch"
                  placeholder="Buscar usuario por nombre, código, colegio, apoderado..."
                  oninput="window.filterCasitasSearch ? window.filterCasitasSearch(this.value) : (window.PDI?.CasitasView ? window.PDI.CasitasView.filterBySearch(this.value) : null)">
                <button type="button" class="audit-search-clear" id="btnCasitasSearchClear" style="display:none;"
                  onclick="window.clearCasitasSearch ? window.clearCasitasSearch() : (window.PDI?.CasitasView ? window.PDI.CasitasView.clearSearch() : null)" title="Limpiar búsqueda">
                  <Icon name="accion.cerrar" size={12} />
                </button>
              </div>

              <button type="button" class="btn-action-icon btn-audit-export-icon table-export-btn" id="btnExportEducativoCSV"
                onclick="window.openModalExportEducativo ? window.openModalExportEducativo() : null"
                aria-label="Descargar la jornada de asistencia" title="Descargar la jornada">
                <Icon name="accion.descargar" size={18} />
              </button>

              <SortMenu id="CasitasSort" options={OPCIONES_ORDEN_CASITAS} selected="apellido-asc" />

              <!-- Botonera de Filtros Casitas (Lado Derecho) -->
              <FilterPanel
                id="dropdownCasitasFilterPanel"
                buttonId="btnDropdownCasitasFilterPanel"
                menuId="menuCasitasFilterPanel"
                countId="casitasActiveFiltersCount"
                title="Filtros Casita del Saber"
                reset="window.resetCasitasFilters ? window.resetCasitasFilters() : null"
              >
                      <!-- Filtro único: Nivel / Grado escolar. La sede y el día viven en la barra de jornada. -->
                      <FilterField
                        id="dropdownCasitasGrado"
                        menuId="menuCasitasGrado"
                        labelId="labelCasitasGradoSelect"
                        label="Nivel / Grado Escolar"
                        labelTodos="Todos los Grados"
                        todosEtiqueta="Todos los Grados"
                        opciones={OPCIONES_GRADO}
                        tipo="single"
                        countPrefix="countFacetCasitasGrado"
                        conEtiqueta={true}
                        onSelect="window.selectCasitasGrado"
                        abrir="window.toggleInnerFilterDropdown ? window.toggleInnerFilterDropdown('dropdownCasitasGrado') : (window.toggleCustomDropdown ? window.toggleCustomDropdown('dropdownCasitasGrado') : null)"
                      />
                              </FilterPanel>
            </div>

            <!-- Barra de Filtros Aplicados Casitas -->
            <div class="padron-active-chips-bar" id="casitasActiveChipsBar">
              <span class="padron-active-chips-label">Filtros aplicados:</span>
              <div id="casitasActiveChipsList" style="display: flex; align-items: center; flex-wrap: wrap; gap: 6px;">
              </div>
              <button type="button" class="btn-text-subtle" style="margin-left: auto; font-size: 11.5px;"
                onclick="window.resetCasitasFilters ? window.resetCasitasFilters() : null">Limpiar filtros</button>
            </div>

            <div class="table-container desktop-table-view">
              <table class="data-table">
                <thead>
                  <tr>
                    <th>Usuario</th>
                    <th>Tipo de Atención</th>
                    <th>Grado Escolar</th>
                    <th>Colegio de Origen</th>
                    <th>Personas Acreditadas de Salida</th>
                    <th>Estado del Día</th>
                    <th>Marcar Asistencia</th>
                  </tr>
                </thead>
                <tbody id="tbodyAsistenciaCasita">
                  <!-- Injected via JS -->
                </tbody>
              </table>
            </div>
            <div class="mobile-accordion-list" id="mobileCardsCasita">
              <!-- Injected via JS -->
            </div>

            <!-- Controles de Paginación de Casitas del Saber (PC / Móvil) -->
            <div class="padron-pagination-bar" id="casitasPaginationBar">
              <div class="padron-pagination-left">
                <span id="casitasPaginationInfo" style="font-size:12.5px; color:var(--text-muted); font-weight:500;">
                  Mostrando 0 de 0 usuarios
                </span>
                <div class="padron-density-wrapper" id="casitasDensityWrapper"
                  style="display:flex; align-items:center; gap:6px;">
                  <span style="font-size:12px; color:var(--text-dim);">Mostrar:</span>
                  <select class="audit-density-select padron-density-select" id="selectCasitasPageSize"
                    onchange="window.casitasSetPageSize ? window.casitasSetPageSize(this.value) : (window.PDI?.CasitasView?.setPageSize ? window.PDI.CasitasView.setPageSize(this.value) : null)">
                    <option value="10">10 por página</option>
                    <option value="20" selected>20 por página</option>
                    <option value="50">50 por página (Máx)</option>
                  </select>
                </div>
              </div>
              <div class="padron-pagination-right">
                <button type="button" class="btn-page" id="btnCasitasPagePrev"
                  onclick="window.casitasPrevPage ? window.casitasPrevPage() : (window.PDI?.CasitasView?.prevPage ? window.PDI.CasitasView.prevPage() : null)">
                  <Icon name="accion.volver" size={14} />
                  <span>Anterior</span>
                </button>
                <span class="audit-page-indicator" id="casitasCurrentPageNum">Página 1</span>
                <button type="button" class="btn-page" id="btnCasitasPageNext"
                  onclick="window.casitasNextPage ? window.casitasNextPage() : (window.PDI?.CasitasView?.nextPage ? window.PDI.CasitasView.nextPage() : null)">
                  <span>Siguiente</span>
                  <Icon name="accion.abrir" size={14} />
                </button>
              </div>
            </div>
          </div>

          <!-- Motivo obligatorio de la falta justificada. Un <dialog> nativo
               se dibuja en la capa superior: no lo recorta el contenedor con
               scroll ni queda debajo de la barra lateral. -->
          <dialog class="jornada-dialog" id="modalMotivoFJ" aria-labelledby="motivoFJTitulo">
            <div class="modal-box motivo-box" role="document" tabindex="-1">
              <div class="modal-header">
                <div class="modal-title-stack">
                  <h3 id="motivoFJTitulo">Motivo de la falta justificada</h3>
                  <p class="modal-title-desc">El motivo queda en el registro de la jornada y en el CSV.</p>
                </div>
                <button type="button" class="btn-close-modal"
                  onclick="window.casitasCerrarMotivoFJ ? window.casitasCerrarMotivoFJ() : null"
                  aria-label="Cerrar el motivo de la falta justificada">
                  <Icon name="accion.cerrar" size={18} />
                </button>
              </div>
              <div class="modal-body">
                <p class="motivo-alumno" id="motivoFJAlumno"></p>
                <div class="form-group">
                  <label for="inputMotivoFJ">Motivo <span class="req">*</span></label>
                  <textarea id="inputMotivoFJ" class="form-control" rows="3" maxlength="120"
                    placeholder="Ej. Cita médica, trámite familiar, enfermedad…"
                    oninput="window.PDI?.CasitasView?._actualizarContadorMotivo?.()"></textarea>
                  <div class="motivo-contador"><span id="motivoFJContador">0</span>/120</div>
                </div>
                <p class="motivo-error" id="motivoFJError" hidden></p>
              </div>
              <div class="modal-footer">
                <button type="button" class="btn-action"
                  onclick="window.casitasCerrarMotivoFJ ? window.casitasCerrarMotivoFJ() : null">
                  Cancelar
                </button>
                <button type="button" class="btn-action primary"
                  onclick="window.casitasConfirmarMotivoFJ ? window.casitasConfirmarMotivoFJ() : null">
                  Marcar falta justificada
                </button>
              </div>
            </div>
          </dialog>
        </div>

        <!-- SUBVISTA 2: Acciones Socio-Educativas & Monitoreo (Ficha A5) -->
        <div class="educativo-subview-panel" id="viewEducativoAcciones" style="display: none;">
          <!-- Sub-selector de instrumentos de la Ficha A5 -->
          <div class="educativo-subtabs-bar">
            <button type="button" class="educativo-subtab-btn active" id="btnSubSecColectivas">
              <Icon name="persona.grupo" size={15} />
              <span>Acciones Colectivas y Talleres (Hoja 3)</span>
            </button>
            <button type="button" class="educativo-subtab-btn" id="btnSubSecMonitoreo">
              <Icon name="salud.escudo" size={15} />
              <span>Monitoreo de Sedes / Espacios (Hoja 1)</span>
            </button>
            <button type="button" class="educativo-subtab-btn" id="btnSubSecSeguimiento">
              <Icon name="persona.usuario" size={15} />
              <span>Seguimiento Individual a Usuarios (Hoja 2)</span>
            </button>
          </div>

          <!-- SECCIÓN 1: ACCIONES SOCIO-EDUCATIVAS COLECTIVAS (Hoja 3) -->
          <div id="secEducativoColectivas">
            <div class="card" style="margin-bottom: 20px;">
              <div class="card-header">
                <div>
                  <div class="card-title">Registro de Acciones Socio-Educativas con Familias y Comunidad</div>
                  <div style="font-size: 13px; color: var(--text-muted);">
                    Talleres formativos, consejería, mediación lectora, ecología y donación de canastas alimentarias
                  </div>
                </div>
              </div>

              <form id="formAccionSocioeducativa" class="educativo-form-grid" novalidate>
                <div class="form-row form-row-3">
                  <div class="form-group">
                    <label for="aseFecha" class="form-label">Fecha de Actividad <span class="req">*</span></label>
                    <input type="date" id="aseFecha" class="form-control" required />
                  </div>
                  <div class="form-group">
                    <label for="aseSede" class="form-label">Sede / Casita <span class="req">*</span></label>
                    <select id="aseSede" class="form-control" required>
                      <option value="">Selecciona sede...</option>
                      {OPCIONES_SEDE.map((s) => (
                        <option value={s.valor}>{s.etiqueta}</option>
                      ))}
                    </select>
                  </div>
                  <div class="form-group">
                    <label for="aseDistrito" class="form-label">Distrito</label>
                    <select id="aseDistrito" class="form-control">
                      <option value="Comas">Comas</option>
                      <option value="Carabayllo">Carabayllo</option>
                    </select>
                  </div>
                </div>

                <div class="form-row form-row-3">
                  <div class="form-group">
                    <label for="aseModalidad" class="form-label">Modalidad de Intervención</label>
                    <select id="aseModalidad" class="form-control">
                      <option value="Comunitaria">Comunitaria</option>
                      <option value="Institución Educativa">Institución Educativa</option>
                    </select>
                  </div>
                  <div class="form-group">
                    <label for="aseEstrategia" class="form-label">Estrategia de Intervención</label>
                    <select id="aseEstrategia" class="form-control">
                      <option value="Atención fija">Atención fija</option>
                      <option value="Atención itinerante">Atención itinerante</option>
                    </select>
                  </div>
                  <div class="form-group">
                    <label for="aseFacilitadora" class="form-label">Facilitadora / Responsable</label>
                    <input type="text" id="aseFacilitadora" class="form-control" placeholder="Nombre de la facilitadora" />
                  </div>
                </div>

                <div class="form-group" style="margin-top: 10px;">
                  <label class="form-label">Acciones Desarrolladas (Marcación múltiple) <span class="req">*</span></label>
                  <div class="educativo-checkbox-grid">
                    <label class="educativo-check-card">
                      <input type="checkbox" name="chkAccionEducativa" value="Sesiones de consejería educativa" />
                      <span>Sesiones de consejería educativa</span>
                    </label>
                    <label class="educativo-check-card">
                      <input type="checkbox" name="chkAccionEducativa" value="Sesiones de Promoción de Derechos en las infancias" />
                      <span>Sesiones de Promoción de Derechos en infancias</span>
                    </label>
                    <label class="educativo-check-card">
                      <input type="checkbox" name="chkAccionEducativa" value="Biblioteca Comunitaria" />
                      <span>Biblioteca Comunitaria</span>
                    </label>
                    <label class="educativo-check-card">
                      <input type="checkbox" name="chkAccionEducativa" value="Mediación lectora - Cuenta Cuentos" />
                      <span>Mediación lectora - Cuenta Cuentos</span>
                    </label>
                    <label class="educativo-check-card">
                      <input type="checkbox" name="chkAccionEducativa" value="Acciones ecológicas" />
                      <span>Acciones ecológicas (bio-talleres / huertos)</span>
                    </label>
                    <label class="educativo-check-card">
                      <input type="checkbox" name="chkAccionEducativa" value="Visitas guiadas extracurriculares" />
                      <span>Visitas guiadas extracurriculares</span>
                    </label>
                  </div>
                </div>

                <div class="form-row form-row-3" style="margin-top: 14px;">
                  <div class="form-group">
                    <label for="aseAdultos" class="form-label">Participantes Adultos</label>
                    <input type="number" id="aseAdultos" class="form-control" min="0" value="0" />
                  </div>
                  <div class="form-group">
                    <label for="aseNinos" class="form-label">Participantes Niños/as</label>
                    <input type="number" id="aseNinos" class="form-control" min="0" value="0" />
                  </div>
                  <div class="form-group">
                    <label for="aseCanastas" class="form-label"># Canastas Alimentarias Donadas</label>
                    <input type="number" id="aseCanastas" class="form-control" min="0" value="0" />
                  </div>
                </div>

                <div class="form-group" style="margin-top: 10px;">
                  <label for="aseObservaciones" class="form-label">Observaciones y Resumen de la Jornada</label>
                  <textarea id="aseObservaciones" class="form-control" rows="2" maxlength="300" placeholder="Detalles de la sesión, logros pedagógicos o acuerdos tomados con las familias..."></textarea>
                </div>

                <div style="display: flex; justify-content: flex-end; margin-top: 16px;">
                  <button type="submit" class="btn-action primary">
                    <Icon name="accion.confirmar" size={16} />
                    <span>Guardar Acción Socio-Educativa</span>
                  </button>
                </div>
              </form>
            </div>

            <!-- Bitácora Histórica de Acciones Colectivas -->
            <div class="card">
              <div class="card-header" style="display: flex; justify-content: space-between; align-items: center;">
                <div>
                  <div class="card-title">Historial de Acciones Socio-Educativas Registradas</div>
                  <div style="font-size: 13px; color: var(--text-muted);">
                    Registro consolidado de actividades grupales por sede y fecha
                  </div>
                </div>
                <button type="button" class="btn-action-icon table-export-btn" id="btnExportAccionesCSV" title="Descargar reporte en CSV">
                  <Icon name="accion.descargar" size={18} />
                </button>
              </div>

              <div class="table-container desktop-table-view">
                <table class="data-table">
                  <thead>
                    <tr>
                      <th style="width: 12%;">Fecha</th>
                      <th style="width: 18%;">Sede & Distrito</th>
                      <th style="width: 32%;">Acciones Desarrolladas</th>
                      <th style="width: 10%; text-align: center;">Adultos</th>
                      <th style="width: 10%; text-align: center;">Niños/as</th>
                      <th style="width: 8%; text-align: center;">Canastas</th>
                      <th style="width: 10%;">Facilitadora</th>
                    </tr>
                  </thead>
                  <tbody id="tbodyAccionesColectivas">
                    <!-- Injected via JS -->
                  </tbody>
                </table>
              </div>
            </div>
          </div>

          <!-- SECCIÓN 2: MONITOREO DE LUGARES DE ATENCIÓN (Hoja 1) -->
          <div id="secEducativoMonitoreo" style="display: none;">
            <div class="card" style="margin-bottom: 20px;">
              <div class="card-header">
                <div>
                  <div class="card-title">Ficha de Monitoreo de Lugares de Atención</div>
                  <div style="font-size: 13px; color: var(--text-muted);">
                    Supervisión periódica de infraestructura, promotoras, usuarios y cuidadores
                  </div>
                </div>
              </div>

              <form id="formMonitoreoSede" class="educativo-form-grid" novalidate>
                <div class="form-row form-row-3">
                  <div class="form-group">
                    <label for="monFecha" class="form-label">Fecha de Monitoreo <span class="req">*</span></label>
                    <input type="date" id="monFecha" class="form-control" required />
                  </div>
                  <div class="form-group">
                    <label for="monSede" class="form-label">Sede / Lugar <span class="req">*</span></label>
                    <select id="monSede" class="form-control" required>
                      <option value="">Selecciona sede...</option>
                      {OPCIONES_SEDE.map((s) => (
                        <option value={s.valor}>{s.etiqueta}</option>
                      ))}
                    </select>
                  </div>
                  <div class="form-group">
                    <label for="monDistrito" class="form-label">Distrito</label>
                    <select id="monDistrito" class="form-control">
                      <option value="Comas">Comas</option>
                      <option value="Carabayllo">Carabayllo</option>
                    </select>
                  </div>
                </div>

                <div class="form-group" style="margin-top: 10px;">
                  <label class="form-label">Aspectos con Observación o Requieren Supervisión</label>
                  <div class="educativo-checkbox-grid">
                    <label class="educativo-check-card">
                      <input type="checkbox" id="chkMonEspacio" />
                      <span>Referente al espacio físico (limpieza, seguridad, ventilación)</span>
                    </label>
                    <label class="educativo-check-card">
                      <input type="checkbox" id="chkMonPromotora" />
                      <span>Referente a la promotora educativa (desempeño, trato, puntualidad)</span>
                    </label>
                    <label class="educativo-check-card">
                      <input type="checkbox" id="chkMonUsuarios" />
                      <span>Referente a los usuarios/as (asistencia, atención, convivencia)</span>
                    </label>
                    <label class="educativo-check-card">
                      <input type="checkbox" id="chkMonCuidadores" />
                      <span>Referente a los cuidadores (compromiso, recojo puntual)</span>
                    </label>
                  </div>
                </div>

                <div class="form-group" style="margin-top: 10px;">
                  <label for="monDetalle" class="form-label">Detalle de Observaciones y Acuerdos de Mejora</label>
                  <textarea id="monDetalle" class="form-control" rows="3" maxlength="400" placeholder="Describe los hallazgos observados en la sede y las acciones correctivas acordadas..."></textarea>
                </div>

                <div style="display: flex; justify-content: flex-end; margin-top: 16px;">
                  <button type="submit" class="btn-action primary">
                    <Icon name="accion.confirmar" size={16} />
                    <span>Guardar Monitoreo de Sede</span>
                  </button>
                </div>
              </form>
            </div>

            <!-- Bitácora de Monitoreos -->
            <div class="card">
              <div class="card-header" style="display: flex; justify-content: space-between; align-items: center;">
                <div>
                  <div class="card-title">Bitácora de Monitoreos Realizados</div>
                  <div style="font-size: 13px; color: var(--text-muted);">
                    Historial de visitas de supervisión y estado de las sedes
                  </div>
                </div>
                <button type="button" class="btn-action-icon table-export-btn" id="btnExportMonitoreoCSV" title="Descargar reporte en CSV">
                  <Icon name="accion.descargar" size={18} />
                </button>
              </div>

              <div class="table-container desktop-table-view">
                <table class="data-table">
                  <thead>
                    <tr>
                      <th style="width: 12%;">Fecha</th>
                      <th style="width: 18%;">Sede & Distrito</th>
                      <th style="width: 25%;">Aspectos Evaluados</th>
                      <th style="width: 33%;">Detalle de Observaciones</th>
                      <th style="width: 12%;">Supervisora</th>
                    </tr>
                  </thead>
                  <tbody id="tbodyMonitoreoEspacios">
                    <!-- Injected via JS -->
                  </tbody>
                </table>
              </div>
            </div>
          </div>

          <!-- SECCIÓN 3: SEGUIMIENTO INDIVIDUAL SOCIO-EDUCATIVO (Hoja 2) -->
          <div id="secEducativoSeguimiento" style="display: none;">
            <div class="card" style="margin-bottom: 20px;">
              <div class="card-header">
                <div>
                  <div class="card-title">Seguimiento Socio-Educativo a Usuarios/as</div>
                  <div style="font-size: 13px; color: var(--text-muted);">
                    Registro de visitas domiciliarias, orientación socioeducativa y enlace de derivación con Área Social Pastoral (ASP)
                  </div>
                </div>
              </div>

              <form id="formSeguimientoIndividual" class="educativo-form-grid" novalidate>
                <div class="form-row form-row-2">
                  <div class="form-group">
                    <label for="segBeneficiarioSelect" class="form-label">Usuario / Alumno de Casita del Saber <span class="req">*</span></label>
                    <select id="segBeneficiarioSelect" class="form-control" required>
                      <option value="">Cargando usuarios...</option>
                    </select>
                  </div>
                  <div class="form-group">
                    <label for="segFecha" class="form-label">Fecha de Intervención <span class="req">*</span></label>
                    <input type="date" id="segFecha" class="form-control" required />
                  </div>
                </div>

                <div class="form-row form-row-3">
                  <div class="form-group">
                    <label for="segSede" class="form-label">Sede</label>
                    <select id="segSede" class="form-control">
                      {OPCIONES_SEDE.map((s) => (
                        <option value={s.valor}>{s.etiqueta}</option>
                      ))}
                    </select>
                  </div>
                  <div class="form-group">
                    <label for="segDistrito" class="form-label">Distrito</label>
                    <select id="segDistrito" class="form-control">
                      <option value="Comas">Comas</option>
                      <option value="Carabayllo">Carabayllo</option>
                    </select>
                  </div>
                  <div class="form-group">
                    <label for="segFacilitadora" class="form-label">Facilitadora / Profesional</label>
                    <input type="text" id="segFacilitadora" class="form-control" placeholder="Nombre" />
                  </div>
                </div>

                <div class="form-group" style="margin-top: 10px;">
                  <label class="form-label">Acciones Realizadas con el Menor / Familia (Marcación múltiple) <span class="req">*</span></label>
                  <div class="educativo-checkbox-grid">
                    <label class="educativo-check-card">
                      <input type="checkbox" name="chkAccionSeguimiento" value="Aplicación de ficha socio-económica" />
                      <span>Aplicación de ficha socio-económica</span>
                    </label>
                    <label class="educativo-check-card">
                      <input type="checkbox" name="chkAccionSeguimiento" value="Visita Domiciliaria" />
                      <span>Visita Domiciliaria</span>
                    </label>
                    <label class="educativo-check-card">
                      <input type="checkbox" name="chkAccionSeguimiento" value="Orientación educativa/social" />
                      <span>Orientación educativa / social familiar</span>
                    </label>
                    <label class="educativo-check-card alert-card">
                      <input type="checkbox" name="chkAccionSeguimiento" value="Derivación ASP" />
                      <span>Derivación a Área Social Pastoral (ASP)</span>
                    </label>
                  </div>
                </div>

                <div class="form-group" style="margin-top: 10px;">
                  <label for="segNotas" class="form-label">Notas Pedagógicas y Conclusiones del Caso</label>
                  <textarea id="segNotas" class="form-control" rows="2" maxlength="300" placeholder="Anotaciones cualitativas sobre el progreso escolar, dificultades detectadas o acuerdos con el apoderado..."></textarea>
                </div>

                <div style="display: flex; justify-content: flex-end; margin-top: 16px;">
                  <button type="submit" class="btn-action primary">
                    <Icon name="accion.confirmar" size={16} />
                    <span>Guardar Seguimiento Individual</span>
                  </button>
                </div>
              </form>
            </div>

            <!-- Bitácora de Seguimientos -->
            <div class="card">
              <div class="card-header">
                <div>
                  <div class="card-title">Historial de Seguimientos Socio-Educativos</div>
                  <div style="font-size: 13px; color: var(--text-muted);">
                    Registro longitudinal de intervenciones familiares y pedagógicas
                  </div>
                </div>
              </div>

              <div class="table-container desktop-table-view">
                <table class="data-table">
                  <thead>
                    <tr>
                      <th style="width: 12%;">Fecha</th>
                      <th style="width: 24%;">Usuario / Menor</th>
                      <th style="width: 16%;">Sede & Distrito</th>
                      <th style="width: 33%;">Acciones Realizadas</th>
                      <th style="width: 15%;">Facilitadora</th>
                    </tr>
                  </thead>
                  <tbody id="tbodySeguimientoUsuarios">
                    <!-- Injected via JS -->
                  </tbody>
                </table>
              </div>
            </div>
          </div>
        </div>
      </section>

  <script>
    import '../scripts/pages/educativo.js';
  </script>
</AppLayout>