---
import AppLayout from '../layouts/AppLayout.astro';
import FilterPanel from '../components/FilterPanel.astro';
import FilterField from '../components/FilterField.astro';
import SortMenu from '../components/SortMenu.astro';
import { SEDES_OPERATIVAS } from '../data/opcionesBeneficiario.js';
import '../styles/views-educativo.css';
import Icon from '../components/Icon.astro';

const OPCIONES_SEDE = SEDES_OPERATIVAS.map((sede) => ({ valor: sede.nombre, etiqueta: sede.etiqueta }));
const OPCIONES_GRADO = [
  { valor: 'inicial', etiqueta: 'Inicial / Pre-escolar' },
  { valor: 'primaria', etiqueta: 'Primaria (1° a 6°)' },
  { valor: 'secundaria', etiqueta: 'Secundaria (1° a 5°)' },
];
const OPCIONES_ORDEN_CASITAS = [
  { valor: 'apellido-asc', etiqueta: 'Apellido (A-Z)' },
  { valor: 'apellido-desc', etiqueta: 'Apellido (Z-A)' },
  { valor: 'sede-asc', etiqueta: 'Sede (A-Z)' },
  { valor: 'edad-asc', etiqueta: 'Edad (menor a mayor)' },
  { valor: 'edad-desc', etiqueta: 'Edad (mayor a menor)' },
  { valor: 'grado-asc', etiqueta: 'Grado (inicial a secundaria)' },
];
---

<AppLayout title="Servicio de Acompañamiento Educativo" currentPage="educativo">
        <section class="app-view active" id="view-educativo">
          <div class="view-header">
            <div class="view-title-group">
              <h2>Acompañamiento Educativo: Casita del Saber</h2>
              <p>Control de asistencia formativa rápida y padrón seguro de retiro de usuarios con acreditación legal.
              </p>
            </div>
          </div>

          <div class="card" id="cardAsistenciaCasita">
            <div class="card-header">
              <div>
                <div class="card-title">Jornada de Asistencia · Casita del Saber</div>
                <div style="font-size: 13px; color: var(--text-muted);" id="jornadaSubtituloSede">
                  Elige una sede para abrir la jornada
                </div>
              </div>
            </div>

            <!-- Barra de Jornada: un día y una sede por pase. -->
            <div class="jornada-bar" id="jornadaBar">
              <div class="jornada-campo">
                <label class="jornada-label" for="inputJornadaFecha">Día de la jornada</label>
                <input type="date" id="inputJornadaFecha" class="jornada-input"
                  onchange="window.casitasCambiarDia ? window.casitasCambiarDia(this.value) : null">
              </div>

              <div class="jornada-campo jornada-campo-sede">
                <label class="jornada-label" for="selectJornadaSede">Casita / Sede</label>
                <select id="selectJornadaSede" class="jornada-input"
                  onchange="window.casitasCambiarSede ? window.casitasCambiarSede(this.value) : null">
                  <option value="">Elige una sede…</option>
                  {OPCIONES_SEDE.map((sede) => (
                    <option value={sede.valor}>{sede.etiqueta}</option>
                  ))}
                </select>
              </div>

              <div class="jornada-resumen" id="jornadaResumen" aria-live="polite">
                <span class="jornada-resumen-vacio">Sin sede seleccionada</span>
              </div>

              <div class="jornada-acciones">
                <span class="jornada-estado" id="jornadaEstadoGuardado">Jornada sin iniciar</span>
                <button type="button" class="btn-action" id="btnRecargarJornada"
                  onclick="window.casitasRecargarJornada ? window.casitasRecargarJornada() : null"
                  title="Volver a leer la jornada desde SurrealDB">
                  <Icon name="accion.actualizar" size={15} />
                  <span>Recargar</span>
                </button>
                <button type="button" class="btn-action primary" id="btnGuardarJornada" disabled
                  onclick="window.casitasGuardarJornada ? window.casitasGuardarJornada() : null">
                  <Icon name="accion.confirmar" size={15} />
                  <span class="btn-label">Guardar jornada</span>
                </button>
              </div>
            </div>

            <p class="jornada-solo-lectura" id="jornadaSoloLectura" hidden></p>
            <div class="jornada-avisos" id="jornadaAvisos" hidden></div>

            <!-- Barra de Filtros y Búsqueda Rápida de Casitas (Estandarizada con padron.astro) -->
            <div class="audit-toolbar table-toolbar" style="margin-bottom: 16px;">
              <!-- Buscador Casitas (Lado Izquierdo) -->
              <div class="audit-search-wrap">
                <Icon name="accion.buscar" size={2} class="audit-search-icon" />
                <input type="text" class="audit-search-input" id="inputCasitasSearch"
                  placeholder="Buscar usuario por nombre, código, colegio, apoderado..."
                  oninput="window.filterCasitasSearch ? window.filterCasitasSearch(this.value) : (window.PDI?.CasitasView ? window.PDI.CasitasView.filterBySearch(this.value) : null)">
                <button type="button" class="audit-search-clear" id="btnCasitasSearchClear" style="display:none;"
                  onclick="window.clearCasitasSearch ? window.clearCasitasSearch() : (window.PDI?.CasitasView ? window.PDI.CasitasView.clearSearch() : null)" title="Limpiar búsqueda">
                  <Icon name="accion.cerrar" size={12} />
                </button>
              </div>

              <button type="button" class="btn-action-icon btn-audit-export-icon table-export-btn" id="btnExportEducativoCSV"
                onclick="window.openModalExportEducativo ? window.openModalExportEducativo() : null"
                aria-label="Descargar la jornada de asistencia" title="Descargar la jornada">
                <Icon name="accion.descargar" size={18} />
              </button>

              <SortMenu id="CasitasSort" options={OPCIONES_ORDEN_CASITAS} selected="apellido-asc" />

              <!-- Botonera de Filtros Casitas (Lado Derecho) -->
              <FilterPanel
                id="dropdownCasitasFilterPanel"
                buttonId="btnDropdownCasitasFilterPanel"
                menuId="menuCasitasFilterPanel"
                badgeId="casitasActiveFiltersCount"
                title="Filtros Casita del Saber"
                reset="window.resetCasitasFilters ? window.resetCasitasFilters() : null"
              >
                      <!-- Filtro único: Nivel / Grado escolar. La sede y el día viven en la barra de jornada. -->
                      <FilterField
                        id="dropdownCasitasGrado"
                        menuId="menuCasitasGrado"
                        labelId="labelCasitasGradoSelect"
                        label="Nivel / Grado Escolar"
                        labelTodos="Todos los Grados"
                        todosEtiqueta="Todos los Grados"
                        opciones={OPCIONES_GRADO}
                        tipo="single"
                        countPrefix="countFacetCasitasGrado"
                        conEtiqueta={true}
                        onSelect="window.selectCasitasGrado"
                        abrir="window.toggleInnerFilterDropdown ? window.toggleInnerFilterDropdown('dropdownCasitasGrado') : (window.toggleCustomDropdown ? window.toggleCustomDropdown('dropdownCasitasGrado') : null)"
                      />
                              </FilterPanel>
            </div>

            <!-- Barra de Filtros Aplicados Casitas -->
            <div class="padron-active-chips-bar" id="casitasActiveChipsBar">
              <span class="padron-active-chips-label">Filtros aplicados:</span>
              <div id="casitasActiveChipsList" style="display: flex; align-items: center; flex-wrap: wrap; gap: 6px;">
              </div>
              <button type="button" class="btn-text-subtle" style="margin-left: auto; font-size: 11.5px;"
                onclick="window.resetCasitasFilters ? window.resetCasitasFilters() : null">Limpiar filtros</button>
            </div>

            <div class="table-container desktop-table-view">
              <table class="data-table">
                <thead>
                  <tr>
                    <th>Usuario</th>
                    <th>Nivel Educativo</th>
                    <th>Grado Escolar</th>
                    <th>Colegio de Origen</th>
                    <th>Personas Acreditadas de Salida</th>
                    <th>Estado del Día</th>
                    <th>Marcar Asistencia</th>
                  </tr>
                </thead>
                <tbody id="tbodyAsistenciaCasita">
                  <!-- Injected via JS -->
                </tbody>
              </table>
            </div>
            <div class="mobile-accordion-list" id="mobileCardsCasita">
              <!-- Injected via JS -->
            </div>

            <!-- Controles de Paginación de Casitas del Saber (PC / Móvil) -->
            <div class="padron-pagination-bar" id="casitasPaginationBar">
              <div class="padron-pagination-left">
                <span id="casitasPaginationInfo" style="font-size:12.5px; color:var(--text-muted); font-weight:500;">
                  Mostrando 0 de 0 usuarios
                </span>
                <div class="padron-density-wrapper" id="casitasDensityWrapper"
                  style="display:flex; align-items:center; gap:6px;">
                  <span style="font-size:12px; color:var(--text-dim);">Mostrar:</span>
                  <select class="audit-density-select padron-density-select" id="selectCasitasPageSize"
                    onchange="window.casitasSetPageSize ? window.casitasSetPageSize(this.value) : (window.PDI?.CasitasView?.setPageSize ? window.PDI.CasitasView.setPageSize(this.value) : null)">
                    <option value="10">10 por página</option>
                    <option value="20" selected>20 por página</option>
                    <option value="50">50 por página (Máx)</option>
                  </select>
                </div>
              </div>
              <div class="padron-pagination-right">
                <button type="button" class="btn-page" id="btnCasitasPagePrev"
                  onclick="window.casitasPrevPage ? window.casitasPrevPage() : (window.PDI?.CasitasView?.prevPage ? window.PDI.CasitasView.prevPage() : null)">
                  <Icon name="accion.volver" size={14} />
                  <span>Anterior</span>
                </button>
                <span class="audit-page-indicator" id="casitasCurrentPageNum">Página 1</span>
                <button type="button" class="btn-page" id="btnCasitasPageNext"
                  onclick="window.casitasNextPage ? window.casitasNextPage() : (window.PDI?.CasitasView?.nextPage ? window.PDI.CasitasView.nextPage() : null)">
                  <span>Siguiente</span>
                  <Icon name="accion.abrir" size={14} />
                </button>
              </div>
            </div>
          </div>

          <!-- Motivo obligatorio de la falta justificada. Un <dialog> nativo
               se dibuja en la capa superior: no lo recorta el contenedor con
               scroll ni queda debajo de la barra lateral. -->
          <dialog class="jornada-dialog" id="modalMotivoFJ" aria-labelledby="motivoFJTitulo">
            <div class="modal-box motivo-box" role="document" tabindex="-1">
              <div class="modal-header">
                <div class="modal-title-stack">
                  <h3 id="motivoFJTitulo">Motivo de la falta justificada</h3>
                  <p class="modal-title-desc">El motivo queda en el registro de la jornada y en el CSV.</p>
                </div>
                <button type="button" class="btn-close-modal"
                  onclick="window.casitasCerrarMotivoFJ ? window.casitasCerrarMotivoFJ() : null"
                  aria-label="Cerrar el motivo de la falta justificada">
                  <Icon name="accion.cerrar" size={18} />
                </button>
              </div>
              <div class="modal-body">
                <p class="motivo-alumno" id="motivoFJAlumno"></p>
                <div class="form-group">
                  <label for="inputMotivoFJ">Motivo <span class="req">*</span></label>
                  <textarea id="inputMotivoFJ" class="form-control" rows="3" maxlength="120"
                    placeholder="Ej. Cita médica, trámite familiar, enfermedad…"
                    oninput="window.PDI?.CasitasView?._actualizarContadorMotivo?.()"></textarea>
                  <div class="motivo-contador"><span id="motivoFJContador">0</span>/120</div>
                </div>
                <p class="motivo-error" id="motivoFJError" hidden></p>
              </div>
              <div class="modal-footer">
                <button type="button" class="btn-action"
                  onclick="window.casitasCerrarMotivoFJ ? window.casitasCerrarMotivoFJ() : null">
                  Cancelar
                </button>
                <button type="button" class="btn-action primary"
                  onclick="window.casitasConfirmarMotivoFJ ? window.casitasConfirmarMotivoFJ() : null">
                  Marcar falta justificada
                </button>
              </div>
            </div>
          </dialog>
        </section>

  <script>
    import '../scripts/pages/educativo.js';
  </script>
</AppLayout>