---
import AppLayout from '../layouts/AppLayout.astro';
import Icon from '../components/Icon.astro';
import '../styles/views-cuentas.css';
---

<AppLayout title="Cuentas del sistema" currentPage="cuentas">
  <section class="app-view active" id="view-cuentas">
    <div class="cuentas-head">
      <div>
        <h1 class="cuentas-title">Cuentas del sistema</h1>
        <p class="cuentas-sub">
          Gestiona el acceso del equipo operativo, roles y alcance territorial por sede.
        </p>
      </div>
      <button class="btn-action primary" id="btnNuevaCuenta" type="button">
        <Icon name="accion.agregar" size={16} />
        Nueva cuenta
      </button>
    </div>

    <div class="cuentas-toolbar">
      <label class="cuentas-search" for="cuentasBuscar">
        <Icon name="accion.buscar" size={15} class="cuentas-search-ico" />
        <span class="pdi-sr-only">Buscar cuentas</span>
        <input
          id="cuentasBuscar"
          type="search"
          placeholder="Buscar por nombre, usuario, correo o sede..."
          autocomplete="off"
        />
      </label>

      <select id="cuentasRol" aria-label="Filtrar por rol">
        <option value="">Todos los roles</option>
        <option value="admin">Administración</option>
        <option value="coord">Coordinación</option>
        <option value="social">Trabajo social</option>
        <option value="facilitadora">Facilitadoras</option>
        <option value="promotora">Promotoras</option>
      </select>

      <select id="cuentasEstado" aria-label="Filtrar por estado">
        <option value="">Todos los estados</option>
        <option value="activas">Solo activas</option>
        <option value="inactivas">Solo desactivadas</option>
        <option value="sospechosas">Cuentas de prueba o revisión</option>
      </select>
    </div>

    <div class="cuentas-resumen" id="cuentasResumen" aria-live="polite"></div>

    <div class="cuentas-lista-wrap" id="cuentasListaWrap">
      <div class="cuentas-lista-head" id="cuentasListaHead" hidden>
        <span class="cuentas-col-head">Cuenta</span>
        <span class="cuentas-col-head">Rol</span>
        <span class="cuentas-col-head">Sedes asignadas</span>
        <span class="cuentas-col-head cuentas-col-head--end">Estado y acciones</span>
      </div>

      <div class="cuentas-lista" id="cuentasLista" role="list" aria-live="polite"></div>

      <div class="cuentas-vacio" id="cuentasVacio" role="status" hidden></div>
    </div>

    <div class="cuentas-lote-bar" id="cuentasLoteBar" role="region" aria-label="Revisión y acciones en lote" hidden>
      <div class="cuentas-lote-info">
        <Icon name="estado.alerta" size={18} />
        <span id="cuentasLoteTexto">0 cuentas seleccionadas</span>
      </div>
      <div class="cuentas-lote-acciones">
        <button type="button" class="btn-action" id="btnLoteMarcarPruebas">
          Seleccionar cuentas de prueba
        </button>
        <button type="button" class="btn-action" id="btnLoteLimpiar" hidden>
          Deseleccionar
        </button>
        <button type="button" class="btn-action" id="btnLoteSalirRevision" hidden>
          Salir de revisión
        </button>
        <button type="button" class="btn-action cuentas-btn-lote-danger" id="btnLoteEliminar" hidden>
          <Icon name="accion.eliminar" size={15} />
          <span id="btnLoteEliminarTexto">Eliminar seleccionadas</span>
        </button>
      </div>
    </div>

    <!-- Drawer: Nueva cuenta -->
    <div
      class="modal-backdrop drawer"
      id="cuentasModal"
      data-cuentas-modal
      role="dialog"
      aria-modal="true"
      aria-labelledby="cuentasModalTitulo"
      aria-hidden="true"
      inert
    >
      <div class="modal-box drawer-box drawer-narrow">
        <div class="sheet-grab" aria-hidden="true"><span class="sheet-pill"></span></div>
        <div class="modal-header">
          <h2 id="cuentasModalTitulo">Nueva cuenta de personal</h2>
          <button
            type="button"
            class="btn-close-modal"
            data-cerrar="cuentasModal"
            aria-label="Cerrar"
          >
            <Icon name="accion.cerrar" size={18} />
          </button>
        </div>
        <form id="cuentasForm" class="cuentas-drawer-form" novalidate>
          <div class="modal-body">
            <div class="cuentas-field" data-campo="nombre">
              <label for="ctaNombre">Nombre completo <span class="req">*</span></label>
              <input
                id="ctaNombre"
                name="nombre"
                type="text"
                required
                minlength="2"
                maxlength="80"
                autocomplete="name"
                placeholder="Ej. María Mendoza Quispe"
                aria-describedby="ctaNombreError"
              />
              <p class="cuentas-field-error" id="ctaNombreError" hidden></p>
            </div>

            <div class="cuentas-row-2">
              <div class="cuentas-field" data-campo="usuario">
                <label for="ctaUsuario">Usuario de acceso <span class="req">*</span></label>
                <input
                  id="ctaUsuario"
                  name="usuario"
                  type="text"
                  required
                  minlength="3"
                  maxlength="32"
                  autocomplete="off"
                  autocapitalize="off"
                  spellcheck="false"
                  placeholder="ej. mmendoza"
                  aria-describedby="ctaUsuarioHint ctaUsuarioError"
                />
                <small id="ctaUsuarioHint">Minúsculas, números, punto o guion (3–32 caracteres).</small>
                <p class="cuentas-field-error" id="ctaUsuarioError" hidden></p>
              </div>

              <div class="cuentas-field" data-campo="rol">
                <label for="ctaRol">Rol en el sistema <span class="req">*</span></label>
                <select id="ctaRol" name="rol" required>
                  <option value="facilitadora">Facilitadora</option>
                  <option value="promotora">Promotora</option>
                  <option value="social">Trabajo social</option>
                  <option value="coord">Coordinación</option>
                  <option value="admin">Administración</option>
                </select>
              </div>
            </div>

            <div class="cuentas-row-2">
              <div class="cuentas-field" data-campo="correo">
                <label for="ctaCorreo">Correo institucional</label>
                <input
                  id="ctaCorreo"
                  name="correo"
                  type="email"
                  maxlength="120"
                  autocomplete="off"
                  placeholder="nombre@pdi.org.pe"
                  aria-describedby="ctaCorreoHint ctaCorreoError"
                />
                <small id="ctaCorreoHint">Opcional. Dominios .com, .org o .pe.</small>
                <p class="cuentas-field-error" id="ctaCorreoError" hidden></p>
              </div>

              <div class="cuentas-field" data-campo="telefono">
                <label for="ctaTelefono">Teléfono móvil</label>
                <input
                  id="ctaTelefono"
                  name="telefono"
                  type="tel"
                  inputmode="numeric"
                  maxlength="16"
                  autocomplete="off"
                  placeholder="987654321"
                  aria-describedby="ctaTelefonoHint ctaTelefonoError"
                />
                <small id="ctaTelefonoHint">Opcional. 9 dígitos sin +51 (ej. 987654321).</small>
                <p class="cuentas-field-error" id="ctaTelefonoError" hidden></p>
              </div>
            </div>

            <div class="cuentas-field" data-campo="sedes">
              <div class="cuentas-sedes-head">
                <label id="ctaSedesLabel">Sedes asignadas</label>
                <div class="cuentas-sedes-meta">
                  <span class="cuentas-sedes-count" id="ctaSedesResumen">0 seleccionadas</span>
                  <button type="button" class="cuentas-sedes-toggle" id="btnCtaMarcarTodas">
                    Marcar todas
                  </button>
                </div>
              </div>
              <div class="cuentas-sedes-grid" id="ctaSedes" role="group" aria-labelledby="ctaSedesLabel">
                <span class="cuentas-sedes-estado">Cargando sedes...</span>
              </div>
              <label class="cuentas-sede-global" id="ctaSedesGlobalWrap" for="ctaSedesGlobal">
                <input type="checkbox" id="ctaSedesGlobal" />
                <span>Acceso a todas las sedes (incluye sedes futuras)</span>
              </label>
              <small id="ctaSedesHint">
                Ley N.° 29733: asigna solo las sedes necesarias o marca acceso global de forma explícita.
              </small>
              <p class="cuentas-field-error" id="ctaSedesError" hidden></p>
            </div>

            <div class="cuentas-form-error" id="ctaError" role="alert" hidden></div>
          </div>
          <div class="modal-footer modal-caso-footer">
            <button type="button" class="btn-action" data-cerrar="cuentasModal">Cancelar</button>
            <button type="submit" class="btn-action primary" id="btnCrearCuenta">
              Crear cuenta y generar clave
            </button>
          </div>
        </form>
      </div>
    </div>

    <!-- Drawer: Editar rol y permisos por sede -->
    <div
      class="modal-backdrop drawer"
      id="cuentasPermisosModal"
      data-cuentas-modal
      role="dialog"
      aria-modal="true"
      aria-labelledby="permModalTitulo"
      aria-hidden="true"
      inert
    >
      <div class="modal-box drawer-box drawer-narrow">
        <div class="sheet-grab" aria-hidden="true"><span class="sheet-pill"></span></div>
        <div class="modal-header">
          <h2 id="permModalTitulo">Editar rol y permisos</h2>
          <button
            type="button"
            class="btn-close-modal"
            data-cerrar="cuentasPermisosModal"
            aria-label="Cerrar"
          >
            <Icon name="accion.cerrar" size={18} />
          </button>
        </div>
        <form id="permForm" class="cuentas-drawer-form" novalidate>
          <div class="modal-body">
            <p class="cuentas-modal-nota" id="permModalSub"></p>

            <div class="cuentas-field" data-campo="permRol">
              <label for="permRol">Rol en el sistema <span class="req">*</span></label>
              <select id="permRol" name="rol" required>
                <option value="facilitadora">Facilitadora</option>
                <option value="promotora">Promotora</option>
                <option value="social">Trabajo social</option>
                <option value="coord">Coordinación</option>
                <option value="admin">Administración</option>
              </select>
              <small id="permRolAviso" hidden>
                Cambiar el rol cerrará la sesión activa de esta cuenta para aplicar los nuevos permisos.
              </small>
            </div>

            <div class="cuentas-field" data-campo="permSedes">
              <div class="cuentas-sedes-head">
                <label id="permSedesLabel">Sedes asignadas</label>
                <div class="cuentas-sedes-meta">
                  <span class="cuentas-sedes-count" id="permSedesResumen">0 seleccionadas</span>
                  <button type="button" class="cuentas-sedes-toggle" id="btnPermMarcarTodas">
                    Marcar todas
                  </button>
                </div>
              </div>
              <div class="cuentas-sedes-grid" id="permSedesLista" role="group" aria-labelledby="permSedesLabel"></div>
              <label class="cuentas-sede-global" id="permSedesGlobalWrap" for="permSedesGlobal">
                <input type="checkbox" id="permSedesGlobal" />
                <span>Acceso a todas las sedes (incluye sedes futuras)</span>
              </label>
              <small id="permSedesHint">
                Ley N.° 29733: limita el alcance a las sedes que atiende esta persona, salvo autorización global.
              </small>
              <p class="cuentas-field-error" id="permSedesError" hidden></p>
            </div>

            <div class="cuentas-form-error" id="permError" role="alert" hidden></div>
          </div>
          <div class="modal-footer modal-caso-footer">
            <button type="button" class="btn-action" data-cerrar="cuentasPermisosModal">Cancelar</button>
            <button type="submit" class="btn-action primary" id="btnGuardarPermisos">
              Guardar cambios
            </button>
          </div>
        </form>
      </div>
    </div>

    <!-- Drawer: Contraseña temporal -->
    <div
      class="modal-backdrop drawer"
      id="cuentasClaveModal"
      data-cuentas-modal
      role="dialog"
      aria-modal="true"
      aria-labelledby="claveModalTitulo"
      aria-hidden="true"
      inert
    >
      <div class="modal-box drawer-box drawer-narrow">
        <div class="sheet-grab" aria-hidden="true"><span class="sheet-pill"></span></div>
        <div class="modal-header">
          <h2 id="claveModalTitulo">Contraseña temporal generada</h2>
          <button
            type="button"
            class="btn-close-modal"
            data-cerrar="cuentasClaveModal"
            aria-label="Cerrar"
          >
            <Icon name="accion.cerrar" size={18} />
          </button>
        </div>
        <div class="modal-body">
          <p class="cuentas-modal-nota">
            Entrega esta clave a <strong id="claveModalUsuario">—</strong>. Al iniciar sesión deberá
            definir una nueva contraseña y activar su verificación en dos pasos.
          </p>

          <div class="cuentas-clave-caja">
            <code id="claveModalValor">—</code>
            <button type="button" class="btn-action" id="btnCopiarClave">
              <Icon name="accion.copiar" size={14} />
              <span id="btnCopiarClaveTexto">Copiar</span>
            </button>
          </div>

          <p class="cuentas-copia-estado" id="claveCopiaEstado" role="status" aria-live="polite">
            Pendiente de copiar: no se volverá a mostrar después de cerrar.
          </p>
        </div>
        <div class="modal-footer modal-caso-footer">
          <button
            type="button"
            class="btn-action primary"
            data-cerrar="cuentasClaveModal"
            id="btnCerrarClave"
          >
            Listo, cerrar
          </button>
        </div>
      </div>
    </div>
  </section>

  <script>
    import '../scripts/pages/cuentas.js';
  </script>
</AppLayout>
