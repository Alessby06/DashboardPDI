---
import AppLayout from '../layouts/AppLayout.astro';
import Icon from '../components/Icon.astro';
import '../styles/views-cuentas.css';

const ROLES = [
  { valor: 'coord', etiqueta: 'Coordinación' },
  { valor: 'facilitadora', etiqueta: 'Facilitadora' },
  { valor: 'promotora', etiqueta: 'Promotora' },
  { valor: 'social', etiqueta: 'Trabajo Social' },
  { valor: 'admin', etiqueta: 'Administración TI' },
];
---

<AppLayout title="Cuentas y acceso" currentPage="cuentas">
  <section class="app-view active" id="view-cuentas">
    <div class="cuentas-shell">
      <header class="cuentas-header">
        <div class="view-title-group">
          <h2>Cuentas y acceso</h2>
          <p>
            Altas, roles, sedes y contraseñas del personal del programa. Cada acción queda
            registrada en la bitácora de auditoría. El segundo factor es opcional durante el
            desarrollo.
          </p>
        </div>
        <button type="button" class="cuentas-btn cuentas-btn--primary" id="btnNuevaCuenta">
          <Icon name="persona.agregar" size={16} />
          Nueva cuenta
        </button>
      </header>

      <div class="cuentas-toolbar">
        <label class="cuentas-search" for="cuentasBuscar">
          <Icon name="accion.buscar" size={16} />
          <input
            id="cuentasBuscar"
            type="search"
            placeholder="Buscar por nombre o usuario"
            autocomplete="off"
            spellcheck="false"
          />
        </label>
        <select id="cuentasRol" class="cuentas-select" aria-label="Filtrar por rol">
          <option value="">Todos los roles</option>
          {ROLES.map((rol) => <option value={rol.valor}>{rol.etiqueta}</option>)}
        </select>
        <select id="cuentasEstado" class="cuentas-select" aria-label="Filtrar por estado">
          <option value="">Todas las cuentas</option>
          <option value="activas">Solo activas</option>
          <option value="inactivas">Solo desactivadas</option>
          <option value="sospechosas">Posibles pruebas / basura</option>
        </select>
      </div>

      <div class="cuentas-lote-bar" id="cuentasLoteBar" hidden>
        <div class="cuentas-lote-info" id="cuentasLoteInfo"></div>
        <div class="cuentas-lote-acciones" id="cuentasLoteAcciones"></div>
      </div>

      <p class="cuentas-resumen" id="cuentasResumen" aria-live="polite"></p>

      <div class="cuentas-lista" id="cuentasLista" role="list" aria-label="Cuentas del personal" aria-live="polite">
        <div class="cuentas-vacio" role="status">
          <strong>Cargando cuentas…</strong>
        </div>
      </div>
    </div>
  </section>

  <!-- Alta de cuenta -->
  <div class="cuentas-modal" id="cuentasModal" inert aria-hidden="true">
    <div class="cuentas-modal-box" role="dialog" aria-modal="true" aria-labelledby="cuentasModalTitulo">
      <div class="cuentas-modal-head">
        <div>
          <h3 id="cuentasModalTitulo">Nueva cuenta</h3>
          <p>La persona recibirá una contraseña temporal y deberá cambiarla al entrar.</p>
        </div>
        <button type="button" class="cuentas-cerrar" data-cerrar="cuentasModal" aria-label="Cerrar">
          <Icon name="accion.cerrar" size={15} />
        </button>
      </div>

      <form class="cuentas-form" id="formNuevaCuenta" novalidate>
        <p class="cuentas-leyenda">* Campo obligatorio · los demás son opcionales.</p>

        <div class="cuentas-field cuentas-field--full" id="campoNombre">
          <label for="ctaNombre">Nombre completo <span aria-hidden="true">*</span></label>
          <input id="ctaNombre" name="nombre" type="text" maxlength="80" autocomplete="name" required aria-describedby="ctaNombreError" data-autofocus />
          <p class="cuentas-error-field" id="ctaNombreError" role="alert" hidden></p>
        </div>

        <div class="cuentas-field" id="campoUsuario">
          <label for="ctaUsuario">Usuario <span aria-hidden="true">*</span></label>
          <input
            id="ctaUsuario"
            name="usuario"
            type="text"
            maxlength="32"
            autocomplete="off"
            spellcheck="false"
            placeholder="nombre.apellido"
            required
            aria-describedby="ctaUsuarioAyuda ctaUsuarioError"
          />
          <span class="cuentas-hint" id="ctaUsuarioAyuda">Minúsculas, sin tildes. Se rellena solo con el nombre.</span>
          <p class="cuentas-error-field" id="ctaUsuarioError" role="alert" hidden></p>
        </div>

        <div class="cuentas-field" id="campoRol">
          <label for="ctaRol">Rol <span aria-hidden="true">*</span></label>
          <select id="ctaRol" name="rol" required>
            {ROLES.map((rol) => (
              <option value={rol.valor} selected={rol.valor === 'promotora'}>{rol.etiqueta}</option>
            ))}
          </select>
          <span class="cuentas-hint">Administración TI gestiona cuentas; Trabajo Social ve todas las sedes; el resto, sus sedes asignadas.</span>
        </div>

        <div class="cuentas-field">
          <label for="ctaCorreo">Correo (opcional)</label>
          <input id="ctaCorreo" name="correo" type="email" maxlength="120" autocomplete="email" />
        </div>

        <div class="cuentas-field">
          <label for="ctaTelefono">Teléfono (opcional)</label>
          <input id="ctaTelefono" name="telefono" type="tel" maxlength="15" autocomplete="tel" placeholder="9XXXXXXXX" aria-describedby="ctaTelefonoAyuda" />
          <span class="cuentas-hint" id="ctaTelefonoAyuda">9 dígitos. Admite formato +51….</span>
        </div>

        <fieldset class="cuentas-field cuentas-field--full cuentas-fieldset">
          <legend class="cuentas-field-label" id="etiquetaSedes">Sedes asignadas</legend>
          <div class="cuentas-sede-pick" id="ctaSedes" aria-describedby="ctaSedesAyuda">
            <span class="cuentas-hint">Cargando sedes…</span>
          </div>
          <div class="cuentas-sedes-resumen-row">
            <p class="cuentas-sedes-resumen" id="ctaSedesResumen" aria-live="polite">Cargando sedes…</p>
            <button type="button" class="cuentas-btn cuentas-btn--mini" id="btnMarcarTodasSedes">Marcar todas</button>
          </div>
          <span class="cuentas-hint" id="ctaSedesAyuda">Sin sedes marcadas, la cuenta ve todas. Marca una o varias para limitar su padrón.</span>
        </fieldset>

        <p class="cuentas-error" id="ctaError" role="alert"></p>

        <div class="cuentas-acciones-modal">
          <button type="button" class="cuentas-btn" data-cerrar="cuentasModal">Cancelar</button>
          <button type="submit" class="cuentas-btn cuentas-btn--primary" id="btnCrearCuenta" disabled>
            Crear cuenta
          </button>
        </div>
      </form>
    </div>
  </div>

  <!-- Contraseña temporal (alta y reinicio) -->
  <div class="cuentas-modal" id="cuentasClaveModal" inert aria-hidden="true">
    <div class="cuentas-modal-box" role="dialog" aria-modal="true" aria-labelledby="claveModalTitulo">
      <div class="cuentas-modal-head">
        <div>
          <h3 id="claveModalTitulo">Contraseña temporal</h3>
          <p id="claveModalTexto">Se muestra una sola vez.</p>
        </div>
        <button type="button" class="cuentas-cerrar" data-cerrar="cuentasClaveModal" aria-label="Cerrar">
          <Icon name="accion.cerrar" size={15} />
        </button>
      </div>

      <div class="cuentas-clave">
        <code id="claveModalValor"></code>
        <button type="button" class="cuentas-btn" id="btnCopiarClave" data-autofocus>
          <Icon name="archivo.documento" size={15} />
          Copiar
        </button>
      </div>

      <p class="cuentas-aviso">
        Entrégala por un canal privado. <strong>No se volverá a mostrar</strong> y la persona
        deberá cambiarla en su primer ingreso.
      </p>

      <div class="cuentas-acciones-modal">
        <button type="button" class="cuentas-btn cuentas-btn--primary" data-cerrar="cuentasClaveModal">
          Entendido
        </button>
      </div>
    </div>
  </div>

  <!-- Sedes de una cuenta -->
  <div class="cuentas-modal" id="cuentasSedesModal" inert aria-hidden="true">
    <div class="cuentas-modal-box" role="dialog" aria-modal="true" aria-labelledby="sedesModalTitulo">
      <div class="cuentas-modal-head">
        <div>
          <h3 id="sedesModalTitulo">Sedes de la cuenta</h3>
          <p id="sedesModalTexto"></p>
        </div>
        <button type="button" class="cuentas-cerrar" data-cerrar="cuentasSedesModal" aria-label="Cerrar">
          <Icon name="accion.cerrar" size={15} />
        </button>
      </div>

      <div class="cuentas-field">
        <span class="cuentas-field-label" id="etiquetaSedesModal">Sedes asignadas</span>
        <div class="cuentas-sede-pick" id="sedesModalLista" role="group" aria-labelledby="etiquetaSedesModal"></div>
      </div>

      <p class="cuentas-error" id="sedesModalError" role="alert"></p>

      <div class="cuentas-acciones-modal">
        <button type="button" class="cuentas-btn" data-cerrar="cuentasSedesModal">Cancelar</button>
        <button type="button" class="cuentas-btn cuentas-btn--primary" id="btnGuardarSedes">
          Guardar sedes
        </button>
      </div>
    </div>
  </div>

  <script>
    import '../scripts/pages/cuentas.js';
  </script>
</AppLayout>
