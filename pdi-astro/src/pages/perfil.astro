---
import AppLayout from '../layouts/AppLayout.astro';
import Icon from '../components/Icon.astro';
import '../styles/views-perfil.css';
---

<AppLayout title="Mi perfil" currentPage="perfil">
  <section class="app-view active" id="view-perfil">
    <div class="perfil-shell">
      <header class="perfil-head">
        <button
          type="button"
          class="perfil-avatar"
          id="btnCambiarFoto"
          aria-label="Cambiar foto de perfil"
          title="Cambiar foto"
        >
          <span id="perfilIniciales">?</span>
          <img id="perfilFoto" alt="" hidden />
          <span class="perfil-avatar-overlay" aria-hidden="true">
            <Icon name="accion.foto" size={14} />
            <span>Cambiar</span>
          </span>
        </button>
        <input type="file" id="perfilFotoInput" accept="image/png,image/jpeg,image/webp" hidden />

        <div class="perfil-head-text">
          <h1 class="perfil-title">Mi perfil</h1>
          <p class="perfil-meta">
            <strong id="perfilNombre">—</strong>
            <span class="perfil-dot" aria-hidden="true"></span>
            <span id="perfilIdentidadRol">—</span>
            <span class="perfil-dot" aria-hidden="true"></span>
            <span id="perfilIdentidadUsuario">@—</span>
            <span class="perfil-dot" aria-hidden="true"></span>
            <span class="perfil-estado"><i aria-hidden="true"></i><span id="perfilIdentidadEstado">Activa</span></span>
          </p>
          <p class="perfil-meta perfil-meta--dim">Alta <span id="perfilIdentidadDesde">—</span></p>
          <div class="perfil-foto-row" id="perfilFotoFila" hidden>
            <span>Foto de perfil</span>
            <button type="button" class="perfil-link" id="btnQuitarFoto" hidden>Quitar</button>
          </div>
        </div>

        <div class="perfil-head-actions">
          <button type="submit" class="perfil-btn perfil-btn--primary" id="btnGuardarPerfil" form="formPerfil" disabled>
            Guardar cambios
          </button>
        </div>
      </header>

      <div class="perfil-undo" id="perfilUndoFoto" role="status" hidden>
        <span>Foto retirada. Vuelven las iniciales.</span>
        <button type="button" id="btnDeshacerFoto">Deshacer</button>
      </div>

      <div class="perfil-banner" id="perfilAvisoTemporal" hidden>
        <Icon name="seguridad.candado" size={16} />
        <div>
          <strong>Tu contraseña es temporal</strong>
          <span>Cámbiala ahora en <a href="#seguridad">Seguridad</a>, antes de seguir usando la cuenta.</span>
        </div>
      </div>

      <div class="perfil-rows">
        <section class="perfil-row" aria-labelledby="perfilDatosTitle">
          <div class="perfil-row-label">
            <h2 id="perfilDatosTitle">Datos personales</h2>
            <p>Cómo te ven y cómo te contactamos.</p>
          </div>

          <form class="perfil-panel perfil-form" id="formPerfil" novalidate>
            <div class="perfil-fields">
              <div class="perfil-field perfil-field--full">
                <label for="perfilInputNombre">Nombre visible</label>
                <input type="text" id="perfilInputNombre" name="nombre" maxlength="80" autocomplete="name" required aria-describedby="perfilErrorNombre" />
                <span class="perfil-field-error" id="perfilErrorNombre" role="alert"></span>
              </div>
              <div class="perfil-field">
                <label for="perfilInputCorreo">Correo</label>
                <input type="email" id="perfilInputCorreo" name="correo" maxlength="120" autocomplete="email" placeholder="nombre@dominio.org" aria-describedby="perfilErrorCorreo" />
                <span class="perfil-field-error" id="perfilErrorCorreo" role="alert"></span>
              </div>
              <div class="perfil-field">
                <label for="perfilInputTelefono">Teléfono</label>
                <input type="tel" id="perfilInputTelefono" name="telefono" maxlength="20" autocomplete="tel" placeholder="Opcional" aria-describedby="perfilErrorTelefono" />
                <span class="perfil-field-error" id="perfilErrorTelefono" role="alert"></span>
              </div>
            </div>
            <p class="perfil-feedback" id="perfilDatosFeedback" role="status"></p>
          </form>
        </section>

        <section class="perfil-row" aria-labelledby="perfilAccesoTitle">
          <div class="perfil-row-label">
            <h2 id="perfilAccesoTitle">Acceso</h2>
            <p>El identificador con el que entras al sistema y la clave que lo protege.</p>
          </div>

          <form class="perfil-panel perfil-form" id="formUsuario" novalidate>
            <div class="perfil-field">
              <label for="perfilInputUsuario">Usuario</label>
              <input type="text" id="perfilInputUsuario" name="usuario" maxlength="32" autocomplete="username" spellcheck="false" />
              <span class="perfil-field-hint">Con este usuario iniciarás sesión. 3 a 32 caracteres: minúsculas, números, punto, guion o guion bajo.</span>
            </div>
            <div class="perfil-field">
              <label for="perfilInputUsuarioClave">Contraseña actual</label>
              <div class="perfil-clave-wrap">
                <input type="password" id="perfilInputUsuarioClave" name="clave" autocomplete="current-password" />
                <button type="button" class="perfil-clave-toggle" data-toggle-clave="perfilInputUsuarioClave" aria-label="Mostrar contraseña actual" aria-pressed="false">Ver</button>
              </div>
            </div>
            <div class="perfil-form-foot">
              <p class="perfil-feedback" id="perfilUsuarioFeedback" role="status"></p>
              <button type="submit" class="perfil-btn perfil-btn--soft" id="btnGuardarUsuario">Cambiar usuario</button>
            </div>
          </form>
        </section>

        <section class="perfil-row" id="seguridad" aria-labelledby="perfilClaveTitle">
          <div class="perfil-row-label">
            <h2 id="perfilClaveTitle">Contraseña</h2>
            <p>Se recomienda una frase larga, distinta de la anterior.</p>
          </div>

          <form class="perfil-panel perfil-form" id="formClave" novalidate>
            <div class="perfil-fields">
              <div class="perfil-field perfil-field--full">
                <label for="perfilInputClaveActual">Contraseña actual</label>
                <div class="perfil-clave-wrap">
                  <input type="password" id="perfilInputClaveActual" name="actual" autocomplete="current-password" />
                  <button type="button" class="perfil-clave-toggle" data-toggle-clave="perfilInputClaveActual" aria-label="Mostrar contraseña actual" aria-pressed="false">Ver</button>
                </div>
              </div>
              <div class="perfil-field">
                <label for="perfilInputClaveNueva">Nueva contraseña</label>
                <div class="perfil-clave-wrap">
                  <input type="password" id="perfilInputClaveNueva" name="nueva" autocomplete="new-password" aria-describedby="perfilFuerzaTexto" />
                  <button type="button" class="perfil-clave-toggle" data-toggle-clave="perfilInputClaveNueva" aria-label="Mostrar nueva contraseña" aria-pressed="false">Ver</button>
                </div>
                <div class="perfil-strength" aria-hidden="true">
                  <span class="perfil-strength-seg"></span>
                  <span class="perfil-strength-seg"></span>
                  <span class="perfil-strength-seg"></span>
                  <span class="perfil-strength-seg"></span>
                </div>
                <span class="perfil-field-hint" id="perfilFuerzaTexto">Mínimo 10 caracteres. Se recomienda una frase larga.</span>
              </div>
              <div class="perfil-field">
                <label for="perfilInputClaveRepetir">Repetir la nueva</label>
                <div class="perfil-clave-wrap">
                  <input type="password" id="perfilInputClaveRepetir" name="repetir" autocomplete="new-password" />
                  <button type="button" class="perfil-clave-toggle" data-toggle-clave="perfilInputClaveRepetir" aria-label="Mostrar repetición de la contraseña" aria-pressed="false">Ver</button>
                </div>
              </div>
            </div>
            <div class="perfil-form-foot">
              <p class="perfil-feedback" id="perfilClaveFeedback" role="status"></p>
              <button type="submit" class="perfil-btn perfil-btn--soft" id="btnGuardarClave">Cambiar contraseña</button>
            </div>
            <p class="perfil-note">
              Si olvidas tu contraseña, administración puede generarte una temporal. El enlace por correo se
              activará cuando el programa tenga dominio de envío.
            </p>
          </form>
        </section>

        <section class="perfil-row" id="perfilTotpFila" aria-labelledby="perfilTotpTitulo" hidden>
          <div class="perfil-row-label">
            <h2 id="perfilTotpTitulo">Verificación en dos pasos</h2>
            <p>Una segunda prueba además de la contraseña. Disponible para coordinación y administración.</p>
          </div>

          <div class="perfil-totp perfil-panel" id="perfilTotp" hidden>
            <div class="perfil-totp-head">
              <p class="perfil-field-hint">Protege tu cuenta con una aplicación de autenticación.</p>
              <span class="perfil-totp-state" id="perfilTotpEstado">Desactivada</span>
            </div>
            <div class="perfil-totp-actions">
              <button type="button" class="perfil-btn perfil-btn--soft" id="btnTotpActivar">Activar</button>
              <button type="button" class="perfil-link" id="btnTotpDesactivar" hidden>Desactivar</button>
            </div>
            <div class="perfil-totp-panel" id="perfilTotpPanel" hidden>
              <p class="perfil-field-hint">Copia este secreto en tu aplicación (Google Authenticator, Authy, 1Password) y escribe el código que genera.</p>
              <code class="perfil-totp-secreto" id="perfilTotpSecreto"></code>
              <div class="perfil-field">
                <label for="perfilTotpCodigo">Código de 6 dígitos</label>
                <input type="text" id="perfilTotpCodigo" inputmode="numeric" maxlength="6" pattern="[0-9]{6}" placeholder="123456" autocomplete="one-time-code" />
              </div>
              <div class="perfil-form-foot">
                <p class="perfil-feedback" id="perfilTotpFeedback" role="status"></p>
                <button type="button" class="perfil-btn perfil-btn--primary" id="btnTotpConfirmar">Confirmar y activar</button>
              </div>
            </div>
            <div class="perfil-totp-panel" id="perfilTotpDesactivarPanel" hidden>
              <div class="perfil-field">
                <label for="perfilTotpClave">Contraseña actual</label>
                <input type="password" id="perfilTotpClave" autocomplete="current-password" />
              </div>
              <div class="perfil-form-foot">
                <p class="perfil-feedback" id="perfilTotpDesactivarFeedback" role="status"></p>
                <button type="button" class="perfil-btn perfil-btn--soft" id="btnTotpDesactivarConfirmar">Desactivar</button>
              </div>
            </div>
          </div>
        </section>
      </div>

      <div class="perfil-savebar" id="perfilSaveBar" hidden>
        <span class="perfil-savebar-text">Cambios sin guardar</span>
        <div class="perfil-savebar-actions">
          <button type="button" class="perfil-btn perfil-btn--ghost" id="btnDescartarPerfil">Descartar</button>
          <button type="button" class="perfil-btn perfil-btn--primary" id="btnGuardarPerfilBar">Guardar</button>
        </div>
      </div>
    </div>
  </section>

  <script>
    import '../scripts/pages/perfil.js';
  </script>
</AppLayout>
