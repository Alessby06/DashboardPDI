---
import AppLayout from '../layouts/AppLayout.astro';
import Icon from '../components/Icon.astro';
import '../styles/views-ajustes.css';
---

<AppLayout title="Ajustes" currentPage="ajustes">
        <section class="app-view active" id="view-ajustes">

          <!-- Script síncrono inline: sincroniza el estado de los botones de tema y la mascota antes del primer frame -->
          <script is:inline>
            (function () {
              function sincronizarAjustesTema() {
                try {
                  var saved = localStorage.getItem("pdi_theme") || "light";
                  var usaSistema = saved === "system";
                  var oscuro = usaSistema
                    ? !!(window.matchMedia && window.matchMedia("(prefers-color-scheme: dark)").matches)
                    : saved === "dark";

                  var btnLight = document.getElementById("btnThemeLight");
                  var btnDark = document.getElementById("btnThemeDark");
                  var btnSystem = document.getElementById("btnThemeSystem");
                  var badgeLight = document.getElementById("badgeThemeLight");
                  var badgeDark = document.getElementById("badgeThemeDark");
                  var badgeSystem = document.getElementById("badgeThemeSystem");

                  if (btnLight) btnLight.classList.remove("active");
                  if (btnDark) btnDark.classList.remove("active");
                  if (btnSystem) btnSystem.classList.remove("active");
                  if (badgeLight) badgeLight.style.display = "none";
                  if (badgeDark) badgeDark.style.display = "none";
                  if (badgeSystem) badgeSystem.style.display = "none";

                  if (saved === "dark") {
                    if (btnDark) btnDark.classList.add("active");
                    if (badgeDark) badgeDark.style.display = "inline-flex";
                  } else if (saved === "system") {
                    if (btnSystem) btnSystem.classList.add("active");
                    if (badgeSystem) badgeSystem.style.display = "inline-flex";
                  } else {
                    if (btnLight) btnLight.classList.add("active");
                    if (badgeLight) badgeLight.style.display = "inline-flex";
                  }

                  var focoTrigger = document.getElementById("focoInteractiveTrigger");
                  var bubbleTitle = document.getElementById("focoBubbleTitle");
                  var bubbleMsg = document.getElementById("focoBubbleMsg");
                  var bubbleIcon = document.getElementById("focoBubbleIcon");

                  if (focoTrigger) {
                    focoTrigger.classList.remove("state-light", "state-dark", "state-system");
                    focoTrigger.classList.add("state-" + saved);
                  }

                  if (saved === "dark" || (saved === "system" && oscuro)) {
                    if (bubbleTitle) bubbleTitle.textContent = "Modo Nocturno Activo";
                    if (bubbleMsg) bubbleMsg.textContent = "Ambiente nocturno activado. El foco está encendido para iluminar tu espacio de trabajo. Haz clic sobre mí para volver al modo diurno.";
                  } else if (saved === "system") {
                    if (bubbleTitle) bubbleTitle.textContent = "Modo Sensor Inteligente";
                    if (bubbleMsg) bubbleMsg.textContent = "Sensor automático sincronizado. La iluminación se adapta en tiempo real a las preferencias del sistema operativo de tu dispositivo.";
                  } else {
                    if (bubbleTitle) bubbleTitle.textContent = "Modo Diurno Activo";
                    if (bubbleMsg) bubbleMsg.textContent = "Ambiente diurno detectado. El foco permanece en reposo para ahorrar energía. Haz clic sobre mí o usa los botones para alternar al modo noche.";
                  }
                } catch (e) {}
              }

              sincronizarAjustesTema();
              document.addEventListener("astro:after-swap", sincronizarAjustesTema);
            })();
          </script>

          <div class="view-header">
            <div class="view-title-group">
              <h2>Ajustes y Configuración del Sistema</h2>
              <p style="margin: 4px 0 0 0; color: var(--text-muted); font-size: 13.5px;">
                Gestión del tema visual (Modo Oscuro), sincronización de base de datos, preferencias de alertas y
                credenciales.
              </p>
            </div>
          </div>

          <div class="settings-grid">
            <!-- Tarjeta 1: Modo Oscuro & Tema Visual -->
            <div class="card card--compact settings-card">
              <div class="settings-card-header">
                <div class="settings-card-icon-box yellow">
                  <Icon name="tema.oscuro" size={20} />
                </div>
                <div>
                  <h3 class="settings-card-title">Apariencia & Tema Visual</h3>
                  <p class="settings-card-subtitle">Personaliza la interfaz del PDI según tus preferencias o
                    iluminación.</p>
                </div>
              </div>

              <div class="settings-card-body">
                <!-- Mascota Foco Interactivo Lumie (Vector SVG 100% puro) -->
                <div class="foco-interactive-card" id="focoInteractiveCard">
                  <div class="foco-mascot-wrap">
                    <button type="button" class="foco-trigger-btn" id="focoInteractiveTrigger"
                      onclick="window.PDI?.AjustesView?.toggleFocoMode ? window.PDI.AjustesView.toggleFocoMode(event) : (window.toggleFocoMode ? window.toggleFocoMode(event) : null)"
                      title="Haz clic sobre el foco para encender o apagar la luz">
                      <!-- SVG Foco Vectorial Interactivo - Rediseño Gordito & Limpio -->
                      <svg class="foco-svg" viewBox="0 0 160 170" fill="none" xmlns="http://www.w3.org/2000/svg">
                        <!-- Resplandor exterior (Modo Noche) -->
                        <circle class="foco-halo" cx="80" cy="62" r="64" />
                        <!-- Rayos de luz radiantes -->
                        <g class="foco-rays">
                          <line x1="80" y1="2" x2="80" y2="10" stroke-width="3.5" stroke-linecap="round" />
                          <line x1="130" y1="18" x2="124" y2="24" stroke-width="3.5" stroke-linecap="round" />
                          <line x1="152" y1="62" x2="142" y2="62" stroke-width="3.5" stroke-linecap="round" />
                          <line x1="130" y1="106" x2="124" y2="100" stroke-width="3.5" stroke-linecap="round" />
                          <line x1="30" y1="18" x2="36" y2="24" stroke-width="3.5" stroke-linecap="round" />
                          <line x1="8" y1="62" x2="18" y2="62" stroke-width="3.5" stroke-linecap="round" />
                          <line x1="30" y1="106" x2="36" y2="100" stroke-width="3.5" stroke-linecap="round" />
                        </g>
                        <!-- Cadena interruptor / tirador -->
                        <line class="foco-pull-cord" x1="104" y1="112" x2="104" y2="152" stroke-width="2.2"
                          stroke-dasharray="2 3" stroke-linecap="round" />
                        <circle class="foco-pull-knob" cx="104" cy="156" r="5.5" />
                        <!-- Casquillo y base metálica -->
                        <rect class="foco-base-thread" x="60" y="108" width="40" height="7" rx="3" />
                        <rect class="foco-base-thread" x="63" y="115" width="34" height="6" rx="3" />
                        <rect class="foco-base-thread" x="67" y="121" width="26" height="5" rx="2" />
                        <path class="foco-base-tip" d="M72 126 H88 C88 131 85 134 80 134 C75 134 72 131 72 126 Z" />
                        <!-- Cuerpo de cristal del foco (Gordito & Redondo) -->
                        <path class="foco-glass-body"
                          d="M34 62 C34 30 52 14 80 14 C108 14 126 30 126 62 C126 84 112 98 102 108 H58 C48 98 34 84 34 62 Z" />
                        <!-- Antena Sensor (Modo Automático) -->
                        <g class="foco-sensor-antenna">
                          <line x1="80" y1="14" x2="80" y2="4" stroke-width="2.5" stroke-linecap="round" />
                          <circle cx="80" cy="3" r="4" />
                        </g>
                        <!-- Expresión Facial SVG Limpia (Sin líneas interiores de filamento) -->
                        <!-- Ojos Despiertos Brillantes (Noche) -->
                        <g class="foco-eyes-awake">
                          <circle cx="66" cy="62" r="5" />
                          <circle cx="64.5" cy="60" r="1.8" fill="#ffffff" />
                          <circle cx="94" cy="62" r="5" />
                          <circle cx="92.5" cy="60" r="1.8" fill="#ffffff" />
                        </g>
                        <!-- Ojos Sonrientes de Día (Claro) -->
                        <g class="foco-eyes-happy">
                          <path d="M60 63 C63 56 70 56 73 63" stroke-width="3" stroke-linecap="round" fill="none" />
                          <path d="M87 63 C90 56 97 56 100 63" stroke-width="3" stroke-linecap="round" fill="none" />
                        </g>
                        <!-- Gafas inteligentes (Modo Auto) -->
                        <g class="foco-eyes-sensor">
                          <rect x="54" y="55" width="18" height="14" rx="4" stroke-width="2" />
                          <rect x="88" y="55" width="18" height="14" rx="4" stroke-width="2" />
                          <line x1="72" y1="62" x2="88" y2="62" stroke-width="2.5" />
                        </g>
                        <!-- Mejillas sonrosadas -->
                        <ellipse class="foco-cheek left" cx="54" cy="72" rx="4.5" ry="2.5" />
                        <ellipse class="foco-cheek right" cx="106" cy="72" rx="4.5" ry="2.5" />
                        <!-- Boca sonriente -->
                        <path class="foco-smile" d="M72 73 Q80 83 88 73" stroke-width="2.8" stroke-linecap="round"
                          fill="none" />
                      </svg>
                      <span class="foco-touch-hint">
                        <svg width="13" height="13" fill="none" stroke="currentColor" stroke-width="2"
                          viewBox="0 0 24 24">
                          <path stroke-linecap="round" stroke-linejoin="round"
                            d="M15.042 21.672L13.684 16.6m0 0l-2.51 2.225.569-9.47 5.227 7.917-3.286-.672zM12 2.25V4.5m5.834 1.416l-1.591 1.591M20.25 12h-2.25m-1.416 5.834l-1.591-1.591M4.5 12H2.25m3.666-5.834L4.325 4.575M4.325 19.425l1.591-1.591" />
                        </svg>
                        Tócame
                      </span>
                    </button>
                  </div>

                  <!-- Globo de Diálogo de Cómic -->
                  <div class="foco-speech-bubble" id="focoSpeechBubble">
                    <div class="foco-bubble-header">
                      <span class="foco-bubble-icon" id="focoBubbleIcon">
                        <Icon name="tema.claro" size={18} />
                      </span>
                      <strong id="focoBubbleTitle">Modo Diurno Activo</strong>
                    </div>
                    <p class="foco-bubble-msg" id="focoBubbleMsg">
                      Ambiente diurno detectado. El foco permanece apagado para ahorrar energía. Haz clic sobre mí o usa
                      los botones para alternar al modo noche.
                    </p>
                  </div>
                </div>

                <!-- Botones de Selección Rápida de Tema -->
                <div class="settings-theme-selector">
                  <button type="button" class="theme-option-btn" id="btnThemeLight"
                    onclick="window.PDI?.AjustesView?.setTheme ? window.PDI.AjustesView.setTheme('light', false, event) : (window.setTheme ? window.setTheme('light', false, event) : null)">
                    <div class="theme-icon-box">
                      <Icon name="tema.claro" size={22} />
                    </div>
                    <span>Tema Claro</span>
                    <span class="theme-active-indicator" id="badgeThemeLight" style="display:none;" title="Tema Activo">
                      <Icon name="accion.confirmar" size={12} />
                    </span>
                  </button>

                  <button type="button" class="theme-option-btn" id="btnThemeDark"
                    onclick="window.PDI?.AjustesView?.setTheme ? window.PDI.AjustesView.setTheme('dark', false, event) : (window.setTheme ? window.setTheme('dark', false, event) : null)">
                    <div class="theme-icon-box">
                      <Icon name="tema.oscuro" size={22} />
                    </div>
                    <span>Tema Oscuro</span>
                    <span class="theme-active-indicator" id="badgeThemeDark" style="display:none;" title="Tema Activo">
                      <Icon name="accion.confirmar" size={12} />
                    </span>
                  </button>

                  <button type="button" class="theme-option-btn" id="btnThemeSystem"
                    onclick="window.PDI?.AjustesView?.setTheme ? window.PDI.AjustesView.setTheme('system', false, event) : (window.setTheme ? window.setTheme('system', false, event) : null)">
                    <div class="theme-icon-box">
                      <Icon name="tema.sistema" size={22} />
                    </div>
                    <span>Tema Auto (SO)</span>
                    <span class="theme-active-indicator" id="badgeThemeSystem" style="display:none;"
                      title="Tema Activo">
                      <Icon name="accion.confirmar" size={12} />
                    </span>
                  </button>
                </div>

                <div class="settings-row" style="border-bottom:none; margin-top: 14px;">
                  <div class="settings-info-text" style="flex:1;">
                    <strong>Persistencia de Preferencias</strong>
                    <span>La configuración se guarda automáticamente en cookies y almacenamiento local para mantener tu
                      tema al volver a abrir la plataforma.</span>
                  </div>
                </div>
              </div>
            </div>

            <!-- Tarjeta 2: Base de Datos & Sincronización -->
            <div class="card card--compact settings-card">
              <div class="settings-card-header">
                <div class="settings-card-icon-box green">
                  <Icon name="datos.base" size={20} />
                </div>
                <div>
                  <h3 class="settings-card-title">Base de Datos & Sincronización</h3>
                  <p class="settings-card-subtitle">Estado de la conexión local/remota y réplica de datos.</p>
                </div>
              </div>

              <div class="settings-card-body">
                <div class="settings-row">
                  <div class="settings-info-text">
                    <strong>Estado del Servidor de BD</strong>
                    <span>Conexión activa con almacenamiento local</span>
                  </div>
                  <span class="badge badge-green" id="syncStatusBadge"
                    style="display:inline-flex; align-items:center; gap:5px;">
                    <span class="status-dot green"></span>
                    <span>En Línea</span>
                  </span>
                </div>

                <div class="settings-row">
                  <div class="settings-info-text">
                    <strong>Última Sincronización</strong>
                    <span id="labelLastSyncTime">Hoy a las 10:45 AM</span>
                  </div>
                  <button type="button" class="btn-action btn-secondary" id="btnTriggerSync"
                    onclick="window.PDI?.AjustesView?.triggerSync()">
                    <Icon name="accion.actualizar" size={15} />
                    <span>Sincronizar Ahora</span>
                  </button>
                </div>

                <div class="settings-row">
                  <div class="settings-info-text">
                    <strong>Limpieza de Caché & Datos Temporales</strong>
                    <span>Vaciar datos en almacenamiento local y refrescar la vista inicial</span>
                  </div>
                  <button type="button" class="btn-action btn-secondary"
                    onclick="window.PDI?.AjustesView?.clearCache()">
                    <Icon name="accion.actualizar" size={15} />
                    <span>Limpiar Caché</span>
                  </button>
                </div>

                <div class="settings-row" style="border-bottom:none;">
                  <div class="settings-info-text" style="flex:1;">
                    <strong>Endpoint de API / BD Remota</strong>
                    <input type="text" class="audit-search-input"
                      value="https://api.johannesgutenberg.edu.pe/v1/pdi/sync" readonly
                      style="margin-top:6px; font-family:monospace; font-size:12px; background:var(--surface-2); color:var(--text-muted);">
                  </div>
                </div>
              </div>
            </div>

            <!-- Tarjeta 3: Información del Sistema & Desarrollador -->
            <div class="card card--compact settings-card">
              <div class="settings-card-header">
                <div class="settings-card-icon-box amber">
                  <Icon name="estado.info" size={20} />
                </div>
                <div>
                  <h3 class="settings-card-title">Información del Sistema & Licencia</h3>
                  <p class="settings-card-subtitle">Detalles de versión y créditos de la plataforma.</p>
                </div>
              </div>

              <div class="settings-card-body">
                <div class="settings-row">
                  <div class="settings-info-text">
                    <strong>Versión del Sistema</strong>
                    <span>v2.4.0</span>
                  </div>
                </div>

                <div class="settings-row">
                  <div class="settings-info-text">
                    <strong>Organización Institucional</strong>
                    <span>Asociación Cultural Johannes Gutenberg</span>
                  </div>
                </div>

                <div class="settings-row" style="border-bottom:none;">
                  <div class="settings-info-text">
                    <strong>Derechos & Licencia</strong>
                    <span>© 2026 ACJG. Todos los derechos reservados.</span>
                  </div>
                </div>
              </div>
            </div>
          </div>
        </section>

  <script>
    import '../scripts/pages/ajustes.js';
  </script>
</AppLayout>