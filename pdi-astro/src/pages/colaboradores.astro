---
import AppLayout from '../layouts/AppLayout.astro';
import FilterPanel from '../components/FilterPanel.astro';
import FilterField from '../components/FilterField.astro';
import SortMenu from '../components/SortMenu.astro';
import Icon from '../components/Icon.astro';
import '../styles/views-colaboradores.css';

const OPCIONES_ROL = [
  { valor: 'Director(a) I.E.', etiqueta: 'Director(a) I.E.' },
  { valor: 'Docente Enlace', etiqueta: 'Docente Enlace' },
  { valor: 'Enlace Parroquial / Iglesia', etiqueta: 'Enlace Parroquial / Iglesia' },
  { valor: 'Pastor(a) / Líder Comunitario', etiqueta: 'Pastor(a) / Líder Comunitario' },
  { valor: 'Facilitador(a) Comunitario(a)', etiqueta: 'Facilitador(a) Comunitario(a)' },
  { valor: 'Promotora Social', etiqueta: 'Promotora Social' },
  { valor: 'Promotora Educativa', etiqueta: 'Promotora Educativa' },
];

const OPCIONES_DISTRITO = [
  { valor: 'Comas', etiqueta: 'Comas' },
  { valor: 'Carabayllo', etiqueta: 'Carabayllo' },
  { valor: 'El Agustino', etiqueta: 'El Agustino' },
];

const OPCIONES_ESTRATEGIA = [
  { valor: 'Desayuno Infantil', etiqueta: 'Desayuno Infantil' },
  { valor: 'Casita del Saber', etiqueta: 'Casita del Saber' },
  { valor: 'Buen Trato en Familia (BTF)', etiqueta: 'Buen Trato en Familia (BTF)' },
  { valor: 'Jóvenes en Acción Comunitaria (JAC)', etiqueta: 'Jóvenes en Acción Comunitaria (JAC)' },
  { valor: 'Repostería', etiqueta: 'Repostería' },
  { valor: 'Área Social Pastoral', etiqueta: 'Área Social Pastoral' },
];

const OPCIONES_ORDEN = [
  { valor: 'apellido-asc', etiqueta: 'Apellido / Nombre (A-Z)' },
  { valor: 'apellido-desc', etiqueta: 'Apellido / Nombre (Z-A)' },
  { valor: 'sede-asc', etiqueta: 'Institución / Sede (A-Z)' },
  { valor: 'distrito-asc', etiqueta: 'Distrito (A-Z)' },
  { valor: 'tipo-asc', etiqueta: 'Cargo / Rol (A-Z)' },
];
---

<AppLayout title="Red Territorial de Colaboradores" currentPage="colaboradores">
  <section class="app-view active" id="view-colaboradores">
    <div class="view-header">
      <div class="view-title-group">
        <h2>Red Territorial y Colaboradores Institucionales</h2>
        <p>Directorio operativo de directores escolares, docentes enlace, pastores eclesiales y facilitadoras PDI (Fichas A4 y A5).</p>
      </div>
      <div class="view-actions">
        <button type="button" class="btn-action primary" onclick="window.openNuevoColaborador ? window.openNuevoColaborador() : null" title="Registrar nuevo colaborador o institución aliada">
          <Icon name="accion.agregar" size={15} />
          <span>Nuevo Colaborador</span>
        </button>
      </div>
    </div>

    <!-- Cobertura y Reparto Operativo -->
    <section class="colab-reparto" aria-labelledby="colabRepartoTitle">
      <div class="colab-reparto-head">
        <div>
          <h3 class="colab-reparto-title" id="colabRepartoTitle">Red de Alianzas y Cobertura Territorial</h3>
          <p class="colab-reparto-sub">Puntos de intervención comunitaria, convenios escolares y equipo de campo</p>
        </div>
        <div class="colab-reparto-total" id="statColabTotal">0 activos / 0 total</div>
      </div>

      <div class="colab-reparto-grid">
        <div class="colab-stat-box">
          <span class="colab-stat-label">Colegios Aliados (I.E.)</span>
          <strong class="colab-stat-value" id="statColabColegios">0</strong>
          <span class="colab-stat-desc">Directores y docentes UGEL</span>
        </div>
        <div class="colab-stat-box">
          <span class="colab-stat-label">Iglesias y Puntos Pastorales</span>
          <strong class="colab-stat-value" id="statColabIglesias">0</strong>
          <span class="colab-stat-desc">Comedores, BTF y reparto</span>
        </div>
        <div class="colab-stat-box">
          <span class="colab-stat-label">Facilitadoras y Promotoras</span>
          <strong class="colab-stat-value" id="statColabPDI">0</strong>
          <span class="colab-stat-desc">Personal técnico PDI</span>
        </div>
        <div class="colab-stat-box">
          <span class="colab-stat-label">Comas / Carabayllo / El Agustino</span>
          <strong class="colab-stat-value">
            <span id="statColabComas">0</span> · <span id="statColabCarabayllo">0</span> · <span id="statColabAgustino">0</span>
          </strong>
          <span class="colab-stat-desc">Distribución territorial</span>
        </div>
      </div>
    </section>

    <!-- Barra de Pestañas de Red Territorial -->
    <div class="colab-view-tabs" role="tablist" aria-label="Categorías de la Red Territorial">
      <button type="button" class="colab-tab-btn active" id="tabBtnColabColegios" data-categoria="colegios" role="tab" aria-selected="true">
        <Icon name="educacion.libro" size={16} />
        <span>Colegios Aliados (I.E.)</span>
        <span class="colab-tab-badge" id="badgeCountColegios">0</span>
      </button>
      <button type="button" class="colab-tab-btn" id="tabBtnColabIglesias" data-categoria="iglesias" role="tab" aria-selected="false">
        <Icon name="modulo.social" size={16} />
        <span>Iglesias y Puntos Pastorales</span>
        <span class="colab-tab-badge" id="badgeCountIglesias">0</span>
      </button>
      <button type="button" class="colab-tab-btn" id="tabBtnColabPDI" data-categoria="pdi" role="tab" aria-selected="false">
        <Icon name="persona.grupo" size={16} />
        <span>Facilitadoras y Promotoras PDI</span>
        <span class="colab-tab-badge" id="badgeCountPDI">0</span>
      </button>
    </div>

    <!-- Directorio en Tarjeta Unificada -->
    <div class="card" id="cardColaboradores">
      <div class="card-header" style="display:flex; align-items:center; justify-content:space-between;">
        <div class="card-title" id="colaboradoresHeaderTitle">Directorio de Colegios Aliados</div>
        <span class="text-muted" id="colaboradoresCount" style="font-size:12px; font-weight:600;">—</span>
      </div>

      <!-- Barra de Filtros y Búsqueda -->
      <div class="audit-toolbar table-toolbar" style="margin-bottom: 16px;">
        <div class="audit-search-wrap">
          <Icon name="accion.buscar" size={15} class="audit-search-icon" />
          <input
            type="text"
            class="audit-search-input"
            id="inputColabSearch"
            placeholder="Buscar por nombre, I.E., iglesia, DNI, teléfono o distrito..."
            oninput="window.filterColabSearch ? window.filterColabSearch(this.value) : null"
          />
          <button
            type="button"
            class="audit-search-clear"
            id="btnColabSearchClear"
            style="display:none;"
            onclick="window.clearColabSearch ? window.clearColabSearch() : null"
            title="Limpiar búsqueda"
          >
            <Icon name="accion.cerrar" size={12} />
          </button>
        </div>

        <button
          type="button"
          class="btn-action-icon btn-audit-export-icon table-export-btn"
          id="btnExportColabCSV"
          onclick="window.exportColaboradoresCSV ? window.exportColaboradoresCSV() : null"
          aria-label="Descargar Padrón de Colaboradores en CSV"
          title="Descargar directorio en CSV"
        >
          <Icon name="accion.descargar" size={16} />
        </button>

        <SortMenu
          id="colabSort"
          options={OPCIONES_ORDEN}
          selected="apellido-asc"
          onchange="window.sortColaboradores ? window.sortColaboradores(this.value) : null"
        />

        <FilterPanel
          id="dropdownColabFilterPanel"
          buttonId="btnDropdownColabFilterPanel"
          menuId="menuColabFilterPanel"
          countId="colabActiveFiltersCount"
          title="Filtros Territoriales"
          reset="window.resetColabFilters ? window.resetColabFilters() : null"
        >
          <FilterField
            id="dropdownColabDistrito"
            menuId="menuColabDistrito"
            labelId="labelColabDistritoSelect"
            label="Distrito Asignado"
            labelTodos="Todos los Distritos"
            todosEtiqueta="Todos los Distritos"
            opciones={OPCIONES_DISTRITO}
            countPrefix="countFacetColabDistrito"
            onSelect="window.setFilterColabDistrito"
          />

          <FilterField
            id="dropdownColabEstrategia"
            menuId="menuColabEstrategia"
            labelId="labelColabEstrategiaSelect"
            label="Estrategia / Programa"
            labelTodos="Todos los Programas"
            todosEtiqueta="Todos los Programas"
            opciones={OPCIONES_ESTRATEGIA}
            countPrefix="countFacetColabEstrategia"
            onSelect="window.setFilterColabEstrategia"
          />
        </FilterPanel>
      </div>

      <!-- Barra de Chips de Filtros Activos -->
      <div class="padron-active-chips-bar" id="colabActiveChipsBar" style="display:none;">
        <span class="padron-active-chips-label">Filtros aplicados:</span>
        <div id="colabActiveChipsList" style="display:inline-flex; flex-wrap:wrap; gap:6px;"></div>
        <button type="button" class="btn-text-subtle" onclick="window.resetColabFilters ? window.resetColabFilters() : null" style="font-size:11.5px; margin-left:8px; cursor:pointer;">
          Limpiar filtros
        </button>
      </div>

      <!-- Vista de Escritorio: Tabla Normalizada -->
      <div class="table-container desktop-colab-view">
        <table class="data-table" id="tablaColaboradores">
          <thead>
            <tr>
              <th scope="col" style="width: 25%;">Entidad / Colaborador(a)</th>
              <th scope="col" style="width: 17%;">Rol Institucional</th>
              <th scope="col" style="width: 18%;">Sede & Territorio</th>
              <th scope="col" style="width: 16%;">Programas Articulados</th>
              <th scope="col" style="width: 14%;">Contacto Inmediato</th>
              <th scope="col" style="width: 10%; text-align: right;">Acciones</th>
            </tr>
          </thead>
          <tbody id="tbodyColaboradores">
            <!-- Renderizado dinámico desde ColaboradoresView.js -->
          </tbody>
        </table>
      </div>

      <!-- Vista Móvil: Tarjetas Táctiles de Contacto (< 768px) -->
      <div class="mobile-colab-view" id="mobileCardsColaboradores">
        <!-- Renderizado dinámico desde ColaboradoresView.js -->
      </div>

      <div class="empty-state" id="emptyColaboradores" style="display:none; padding: 40px 20px; text-align: center;">
        <Icon name="nav.grupo" size={32} class="text-muted" style="margin-bottom: 12px; opacity: 0.5;" />
        <h4 style="margin: 0 0 6px 0; color: var(--text-main);">No se encontraron registros</h4>
        <p style="margin: 0; font-size: 13px; color: var(--text-muted);">Prueba ajustando los filtros o registra un nuevo colaborador para esta categoría.</p>
      </div>
    </div>
  </section>

  <!-- Modal Ficha Técnica de Colaborador e Institución Aliada -->
  <div class="modal-overlay" id="modalColaborador" style="display:none;" role="dialog" aria-modal="true" aria-labelledby="modalColabTitle">
    <div class="modal-content" style="max-width: 640px; max-height: 90vh; overflow-y: auto;">
      <div class="modal-header" style="display: flex; align-items: center; justify-content: space-between; border-bottom: 1px solid var(--border-subtle); padding: 16px 20px;">
        <div>
          <h3 id="modalColabTitle" style="margin: 0; font-size: 16px; font-weight: 700; color: var(--text-main);">Ficha de Colaborador e Institución</h3>
          <p style="margin: 2px 0 0 0; font-size: 12px; color: var(--text-muted);">Registro oficial de contrapartes territoriales (Fichas A4 y A5)</p>
        </div>
        <button type="button" class="btn-action-icon" onclick="window.cerrarModalColaborador ? window.cerrarModalColaborador() : null" title="Cerrar modal">
          <Icon name="accion.cerrar" size={14} />
        </button>
      </div>

      <form id="formColaborador" style="padding: 20px; display: flex; flex-direction: column; gap: 16px;">
        <input type="hidden" id="colabEditId" value="" />

        <!-- Sección 1: Rol y Entidad -->
        <div style="background: var(--surface-2); padding: 12px; border-radius: var(--radius-sm); border: 1px solid var(--border-subtle); display: flex; flex-direction: column; gap: 12px;">
          <strong style="font-size: 12.5px; color: var(--text-main); display: flex; align-items: center; gap: 6px;">
            <Icon name="educacion.libro" size={14} /> Rol Institucional & Entidad Vinculada
          </strong>

          <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 12px;">
            <div>
              <label for="colabTipo" style="display:block; font-size: 12px; font-weight: 600; color: var(--text-main); margin-bottom: 4px;">Rol / Cargo *</label>
              <select id="colabTipo" required style="width: 100%; height: 38px; border: 1px solid var(--border-default); border-radius: var(--radius-sm); background: var(--surface-1); color: var(--text-main); padding: 0 10px;">
                <option value="Director(a) I.E.">Director(a) I.E.</option>
                <option value="Docente Enlace">Docente Enlace</option>
                <option value="Enlace Parroquial / Iglesia">Enlace Parroquial / Iglesia</option>
                <option value="Pastor(a) / Líder Comunitario">Pastor(a) / Líder Comunitario</option>
                <option value="Facilitador(a) Comunitario(a)">Facilitador(a) Comunitario(a)</option>
                <option value="Promotora Social">Promotora Social</option>
                <option value="Promotora Educativa">Promotora Educativa</option>
              </select>
            </div>
            <div>
              <label for="colabSede" style="display:block; font-size: 12px; font-weight: 600; color: var(--text-main); margin-bottom: 4px;">Nombre de la I.E., Iglesia o Sede *</label>
              <input type="text" id="colabSede" required placeholder="Ej. I.E. 3088 Los Ángeles o Iglesia Alianza" class="audit-search-input" style="width: 100%; border: 1px solid var(--border-default); border-radius: var(--radius-sm); padding: 8px 12px;" />
            </div>
          </div>

          <!-- Campos Específicos para Colegios -->
          <div id="colabCamposColegio" style="display: grid; grid-template-columns: 1fr 1fr 1fr; gap: 10px;">
            <div>
              <label for="colabCodigoModular" style="display:block; font-size: 11.5px; font-weight: 600; color: var(--text-main); margin-bottom: 4px;">Cód. Modular</label>
              <input type="text" id="colabCodigoModular" placeholder="Ej. 0584920" class="audit-search-input" style="width: 100%; border: 1px solid var(--border-default); border-radius: var(--radius-sm); padding: 6px 10px; font-size: 12px;" />
            </div>
            <div>
              <label for="colabNivel" style="display:block; font-size: 11.5px; font-weight: 600; color: var(--text-main); margin-bottom: 4px;">Nivel</label>
              <select id="colabNivel" style="width: 100%; height: 34px; border: 1px solid var(--border-default); border-radius: var(--radius-sm); background: var(--surface-1); color: var(--text-main); padding: 0 8px; font-size: 12px;">
                <option value="">-- Seleccionar --</option>
                <option value="Inicial">Inicial</option>
                <option value="Primaria">Primaria</option>
                <option value="Secundaria">Secundaria</option>
                <option value="Integrado">Integrado</option>
              </select>
            </div>
            <div>
              <label for="colabTurno" style="display:block; font-size: 11.5px; font-weight: 600; color: var(--text-main); margin-bottom: 4px;">Turno</label>
              <select id="colabTurno" style="width: 100%; height: 34px; border: 1px solid var(--border-default); border-radius: var(--radius-sm); background: var(--surface-1); color: var(--text-main); padding: 0 8px; font-size: 12px;">
                <option value="">-- Seleccionar --</option>
                <option value="Mañana">Mañana</option>
                <option value="Tarde">Tarde</option>
                <option value="Completo">Completo</option>
              </select>
            </div>
          </div>
        </div>

        <!-- Sección 2: Datos de la Persona de Contacto -->
        <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 12px;">
          <div>
            <label for="colabNombres" style="display:block; font-size: 12px; font-weight: 600; color: var(--text-main); margin-bottom: 4px;">Nombres de la Persona *</label>
            <input type="text" id="colabNombres" required class="audit-search-input" style="width: 100%; border: 1px solid var(--border-default); border-radius: var(--radius-sm); padding: 8px 12px;" />
          </div>
          <div>
            <label for="colabApellidos" style="display:block; font-size: 12px; font-weight: 600; color: var(--text-main); margin-bottom: 4px;">Apellidos de la Persona *</label>
            <input type="text" id="colabApellidos" required class="audit-search-input" style="width: 100%; border: 1px solid var(--border-default); border-radius: var(--radius-sm); padding: 8px 12px;" />
          </div>
        </div>

        <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 12px;">
          <div>
            <label for="colabDni" style="display:block; font-size: 12px; font-weight: 600; color: var(--text-main); margin-bottom: 4px;">DNI</label>
            <input type="text" id="colabDni" maxlength="8" class="audit-search-input" placeholder="8 dígitos" style="width: 100%; border: 1px solid var(--border-default); border-radius: var(--radius-sm); padding: 8px 12px;" />
          </div>
          <div>
            <label for="colabDistrito" style="display:block; font-size: 12px; font-weight: 600; color: var(--text-main); margin-bottom: 4px;">Distrito *</label>
            <select id="colabDistrito" required style="width: 100%; height: 38px; border: 1px solid var(--border-default); border-radius: var(--radius-sm); background: var(--surface-1); color: var(--text-main); padding: 0 10px;">
              <option value="Comas">Comas</option>
              <option value="Carabayllo">Carabayllo</option>
              <option value="El Agustino">El Agustino</option>
            </select>
          </div>
        </div>

        <!-- Canales de Comunicación Diferenciados -->
        <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 12px;">
          <div>
            <label for="colabCelular" style="display:block; font-size: 12px; font-weight: 600; color: var(--text-main); margin-bottom: 4px;">
              📱 Celular / WhatsApp (9 dígitos)
            </label>
            <input type="tel" id="colabCelular" maxlength="9" placeholder="Ej. 987654321" class="audit-search-input" style="width: 100%; border: 1px solid var(--border-default); border-radius: var(--radius-sm); padding: 8px 12px;" />
          </div>
          <div>
            <label for="colabTelefonoFijo" style="display:block; font-size: 12px; font-weight: 600; color: var(--text-main); margin-bottom: 4px;">
              ☎️ Teléfono Fijo de Secretaría (7 dígitos)
            </label>
            <input type="tel" id="colabTelefonoFijo" placeholder="Ej. 01-5421234" class="audit-search-input" style="width: 100%; border: 1px solid var(--border-default); border-radius: var(--radius-sm); padding: 8px 12px;" />
          </div>
        </div>

        <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 12px;">
          <div>
            <label for="colabEmail" style="display:block; font-size: 12px; font-weight: 600; color: var(--text-main); margin-bottom: 4px;">Correo Institucional / Personal</label>
            <input type="email" id="colabEmail" placeholder="contacto@colegio.edu.pe" class="audit-search-input" style="width: 100%; border: 1px solid var(--border-default); border-radius: var(--radius-sm); padding: 8px 12px;" />
          </div>
          <div>
            <label for="colabEstado" style="display:block; font-size: 12px; font-weight: 600; color: var(--text-main); margin-bottom: 4px;">Estado Operativo de la Alianza</label>
            <select id="colabEstado" style="width: 100%; height: 38px; border: 1px solid var(--border-default); border-radius: var(--radius-sm); background: var(--surface-1); color: var(--text-main); padding: 0 10px;">
              <option value="Activo">Activo (Vigente)</option>
              <option value="Inactivo">Inactivo / Rotado</option>
            </select>
          </div>
        </div>

        <!-- Programas Articulados -->
        <div>
          <label style="display:block; font-size: 12px; font-weight: 600; color: var(--text-main); margin-bottom: 6px;">Programas que articula esta institución o persona</label>
          <div style="display: flex; flex-wrap: wrap; gap: 10px; padding: 10px; background: var(--surface-2); border-radius: var(--radius-sm); border: 1px solid var(--border-subtle);">
            <label style="display: flex; align-items: center; gap: 6px; font-size: 12.5px; color: var(--text-main); cursor: pointer;">
              <input type="checkbox" name="colabEstrategias" value="Desayuno Infantil" /> Desayuno Infantil
            </label>
            <label style="display: flex; align-items: center; gap: 6px; font-size: 12.5px; color: var(--text-main); cursor: pointer;">
              <input type="checkbox" name="colabEstrategias" value="Casita del Saber" /> Casita del Saber
            </label>
            <label style="display: flex; align-items: center; gap: 6px; font-size: 12.5px; color: var(--text-main); cursor: pointer;">
              <input type="checkbox" name="colabEstrategias" value="Buen Trato en Familia (BTF)" /> BTF
            </label>
            <label style="display: flex; align-items: center; gap: 6px; font-size: 12.5px; color: var(--text-main); cursor: pointer;">
              <input type="checkbox" name="colabEstrategias" value="Jóvenes en Acción Comunitaria (JAC)" /> JAC
            </label>
            <label style="display: flex; align-items: center; gap: 6px; font-size: 12.5px; color: var(--text-main); cursor: pointer;">
              <input type="checkbox" name="colabEstrategias" value="Repostería" /> Repostería
            </label>
            <label style="display: flex; align-items: center; gap: 6px; font-size: 12.5px; color: var(--text-main); cursor: pointer;">
              <input type="checkbox" name="colabEstrategias" value="Área Social Pastoral" /> Área Social Pastoral
            </label>
          </div>
        </div>

        <div>
          <label for="colabObservaciones" style="display:block; font-size: 12px; font-weight: 600; color: var(--text-main); margin-bottom: 4px;">Observaciones y Acuerdos de Coordinación</label>
          <textarea id="colabObservaciones" rows="2" class="audit-search-input" style="width: 100%; border: 1px solid var(--border-default); border-radius: var(--radius-sm); padding: 8px 12px; resize: vertical;" placeholder="Detalles de horarios de acceso, acuerdos de uso de patio o entrega de raciones..."></textarea>
        </div>

        <div style="display: flex; justify-content: flex-end; gap: 10px; margin-top: 10px; border-top: 1px solid var(--border-subtle); padding-top: 16px;">
          <button type="button" class="btn-action secondary" onclick="window.cerrarModalColaborador ? window.cerrarModalColaborador() : null">
            Cancelar
          </button>
          <button type="submit" class="btn-action primary">
            Guardar Ficha
          </button>
        </div>
      </form>
    </div>
  </div>

  <script>
    import '../scripts/pages/colaboradores.js';
  </script>
</AppLayout>
