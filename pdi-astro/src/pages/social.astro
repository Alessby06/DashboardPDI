---
import AppLayout from '../layouts/AppLayout.astro';
import FilterPanel from '../components/FilterPanel.astro';
import FilterField from '../components/FilterField.astro';
import { SEDES_OPERATIVAS } from '../data/opcionesBeneficiario.js';
import '../styles/views-social.css';
import Icon from '../components/Icon.astro';

const OPCIONES_URGENCIA = [
  { valor: 'Alta', etiqueta: 'Alta' },
  { valor: 'Media', etiqueta: 'Media' },
  { valor: 'Baja', etiqueta: 'Baja' },
];
const OPCIONES_SEDE = SEDES_OPERATIVAS.map((sede) => ({ valor: sede.nombre, etiqueta: sede.etiqueta }));
---

<AppLayout title="Servicio Social Pastoral (ASP)" currentPage="social">
        <section class="app-view active" id="view-social">
          <script is:inline>
            (function() {
              try {
                var tab = new URLSearchParams(window.location.search).get('tab');
                var rol = localStorage.getItem('pdi_active_role') || 'coord';
                var activeTab = 'kanban';
                if (tab === 'autorizaciones' && (rol === 'coord' || rol === 'admin')) activeTab = 'autorizaciones';
                if (tab === 'mis-solicitudes' && rol === 'social') activeTab = 'mis-solicitudes';

                var k = document.getElementById('viewSocialKanban');
                var a = document.getElementById('viewSocialAutorizaciones');
                var m = document.getElementById('viewSocialMisSolicitudes');
                if (k) k.classList.toggle('active', activeTab === 'kanban');
                if (a) a.classList.toggle('active', activeTab === 'autorizaciones');
                if (m) m.classList.toggle('active', activeTab === 'mis-solicitudes');

                var btnSocial = document.querySelector('#sidebarNav .nav-btn[data-page="social"]');
                var btnAut = document.querySelector('#sidebarNav .nav-btn[data-subview="autorizaciones"]');
                var btnMisSol = document.querySelector('#sidebarNav .nav-btn[data-subview="mis-solicitudes"]');
                if (btnSocial) btnSocial.classList.toggle('active', activeTab === 'kanban');
                if (btnAut) btnAut.classList.toggle('active', activeTab === 'autorizaciones');
                if (btnMisSol) btnMisSol.classList.toggle('active', activeTab === 'mis-solicitudes');
              } catch(e) {}
            })();
          </script>

          <!-- SUBVISTA 1: Tablero Kanban y Simulador -->
          <div class="social-subview-panel active" id="viewSocialKanban">
            <div class="view-header">
              <div class="view-title-group">
                <h2>Servicio Social Pastoral (ASP): Derivaciones y Vulnerabilidad</h2>
                <p>Bandeja de casos sociales clasificados, solicitudes de cambio de estado y simulador socioeconómico paramétrico (0-100%).</p>
              </div>
              <div class="view-actions">
                <button type="button" class="btn-action-icon btn-audit-export-icon" id="btnExportSocialCSV"
                  onclick="window.openModalExportSocial ? window.openModalExportSocial() : null"
                  aria-label="Descargar Bandeja ASP CSV" title="Descargar Bandeja ASP CSV">
                  <Icon name="accion.descargar" size={18} />
                </button>
              </div>
            </div>
            <!-- Barra de Búsqueda y Filtros de Casos Sociales (Estándar Padrón) -->
            <div class="card"
              style="margin-bottom: 14px; padding: 12px 16px; position: relative; z-index: 80; overflow: visible;">
              <div class="audit-toolbar" style="margin-bottom: 0;">
                <!-- Buscador de Casos Sociales (Lado Izquierdo) -->
                <div class="audit-search-wrap">
                  <Icon name="accion.buscar" size={2} class="audit-search-icon" />
                  <input type="text" class="audit-search-input" id="inputSearchCasosSociales"
                    placeholder="Buscar caso..."
                    data-placeholder-largo="Buscar por usuario, código, situación o sede..."
                    aria-label="Buscar caso por usuario, código, situación o sede"
                    title="Buscar caso por usuario, código, situación o sede"
                    oninput="window.PDI?.SocialKanbanView ? window.PDI.SocialKanbanView.handleSearch(this.value) : null">
                </div>

                <!-- Botón de Filtros y Panel Desplegable (Lado Derecho) -->
                <FilterPanel
                  id="dropdownSocialFilterPanel"
                  buttonId="btnDropdownSocialFilterPanel"
                  menuId="menuSocialFilterPanel"
                  badgeId="socialActiveFiltersCount"
                  title="Filtros de Casos Sociales"
                  reset="window.PDI?.SocialKanbanView ? window.PDI.SocialKanbanView.clearFilters() : null"
                >
                      <!-- Filtro 1: Nivel de urgencia (seleccion unica con radio) -->
                      <FilterField
                        id="dropdownSocialUrgencia"
                        menuId="menuSocialUrgencia"
                        labelId="labelSocialUrgenciaSelect"
                        label="Nivel de Urgencia"
                        labelTodos="Todas las Urgencias"
                        todosEtiqueta="Todas las Urgencias"
                        opciones={OPCIONES_URGENCIA}
                        tipo="single"
                        countPrefix="countFacetSocialUrgencia"
                        onSelect="window.PDI?.SocialKanbanView?.filterByUrgencia"
                        abrir="window.toggleInnerFilterDropdown ? window.toggleInnerFilterDropdown('dropdownSocialUrgencia') : (window.toggleCustomDropdown ? window.toggleCustomDropdown('dropdownSocialUrgencia') : null)"
                      />
                      
                      <!-- Filtro 2: Sede territorial (seleccion unica con radio) -->
                      <FilterField
                        id="dropdownSocialSede"
                        menuId="menuSocialSede"
                        labelId="labelSocialSedeSelect"
                        label="Sede Territorial"
                        labelTodos="Todas las Sedes"
                        todosEtiqueta="Todas las Sedes"
                        opciones={OPCIONES_SEDE}
                        tipo="single"
                        countPrefix="countFacetSocialSede"
                        onSelect="window.PDI?.SocialKanbanView?.filterBySede"
                        abrir="window.toggleInnerFilterDropdown ? window.toggleInnerFilterDropdown('dropdownSocialSede') : (window.toggleCustomDropdown ? window.toggleCustomDropdown('dropdownSocialSede') : null)"
                      />
                              </FilterPanel>
            </div>

            <script is:inline>
              // En 179 px de movil el texto completo del buscador no cabe y
              // se cortaba a mitad de palabra. El campo conserva la pista
              // larga donde tiene ancho para mostrarla.
              (function () {
                var input = document.getElementById('inputSearchCasosSociales');
                if (!input) return;
                var ancho = window.matchMedia('(min-width: 769px)');
                var aplicar = function () {
                  input.placeholder = ancho.matches
                    ? input.dataset.placeholderLargo
                    : 'Buscar caso...';
                };
                aplicar();
                ancho.addEventListener('change', aplicar);
              })();
            </script>

                <!-- Barra de Píldoras de Filtros Activos de Casos Sociales (Chips Descartables) -->
                <div class="padron-active-chips-bar" id="socialActiveChipsBar">
                  <span class="padron-active-chips-label">Filtros aplicados:</span>
                  <div id="socialActiveChipsList"
                    style="display: flex; align-items: center; flex-wrap: wrap; gap: 6px;">
                  </div>
                  <button type="button" class="btn-text-subtle" style="margin-left: auto; font-size: 11.5px;"
                    onclick="window.PDI?.SocialKanbanView ? window.PDI.SocialKanbanView.clearFilters() : null">
                    Limpiar filtros
                  </button>
                </div>
              </div>

              <!-- Segmented Control Móvil (1-tap switcher táctil para pantallas pequeñas) -->
              <div class="social-mobile-stage-segmented-wrap" id="socialMobileStageSegmented" role="tablist" aria-label="Etapas del tablero kanban">
                <button type="button" class="stage-seg-btn active" data-stage="pendiente" role="tab" aria-selected="true"
                  onclick="window.PDI?.SocialKanbanView ? window.PDI.SocialKanbanView.setMobileActiveStage('pendiente') : null">
                  <span class="stage-dot" style="background: var(--gt-red);"></span>
                  <span class="stage-seg-label">Alerta</span>
                  <span class="badge badge-red" id="mobileSegCountPendientes">0</span>
                </button>
                <button type="button" class="stage-seg-btn" data-stage="evaluacion" role="tab" aria-selected="false"
                  onclick="window.PDI?.SocialKanbanView ? window.PDI.SocialKanbanView.setMobileActiveStage('evaluacion') : null">
                  <span class="stage-dot" style="background: var(--gt-yellow);"></span>
                  <span class="stage-seg-label">Evaluación</span>
                  <span class="badge badge-yellow" id="mobileSegCountEvaluacion">0</span>
                </button>
                <button type="button" class="stage-seg-btn" data-stage="canalizado" role="tab" aria-selected="false"
                  onclick="window.PDI?.SocialKanbanView ? window.PDI.SocialKanbanView.setMobileActiveStage('canalizado') : null">
                  <span class="stage-dot" style="background: var(--gt-blue);"></span>
                  <span class="stage-seg-label">Canalizados</span>
                  <span class="badge badge-blue" id="mobileSegCountCanalizados">0</span>
                </button>
                <button type="button" class="stage-seg-btn" data-stage="cerrado" role="tab" aria-selected="false"
                  onclick="window.PDI?.SocialKanbanView ? window.PDI.SocialKanbanView.setMobileActiveStage('cerrado') : null">
                  <span class="stage-dot" style="background: var(--gt-green);"></span>
                  <span class="stage-seg-label">Cerrados</span>
                  <span class="badge badge-green" id="mobileSegCountCerrados">0</span>
                </button>
              </div>

              <!-- Kanban Board -->
                <div class="kanban-board" id="kanbanCasosSociales" data-mobile-active-stage="pendiente">
                  <!-- Col 1: Pendientes -->
                  <div class="kanban-col" data-col-stage="pendiente">
                    <div class="kanban-col-header">
                      <div class="col-header-left">
                        <span class="stage-dot" style="background: var(--gt-red);"></span>
                        <span class="col-header-title">Pendientes / Alerta</span>
                      </div>
                      <span class="kanban-count-pill" id="kanbanCountPendientes">0</span>
                    </div>
                    <div class="kanban-col-body" id="kanbanColPendientes"></div>
                  </div>

                  <!-- Col 2: En Evaluación -->
                  <div class="kanban-col" data-col-stage="evaluacion">
                    <div class="kanban-col-header">
                      <div class="col-header-left">
                        <span class="stage-dot" style="background: var(--gt-yellow);"></span>
                        <span class="col-header-title">En Evaluación Social</span>
                      </div>
                      <span class="kanban-count-pill" id="kanbanCountEvaluacion">0</span>
                    </div>
                    <div class="kanban-col-body" id="kanbanColEvaluacion"></div>
                  </div>

                  <!-- Col 3: Canalizados -->
                  <div class="kanban-col" data-col-stage="canalizado">
                    <div class="kanban-col-header">
                      <div class="col-header-left">
                        <span class="stage-dot" style="background: var(--gt-blue);"></span>
                        <span class="col-header-title">Canalizados (DEMUNA / BTF)</span>
                      </div>
                      <span class="kanban-count-pill" id="kanbanCountCanalizados">0</span>
                    </div>
                    <div class="kanban-col-body" id="kanbanColCanalizados"></div>
                  </div>

                  <!-- Col 4: Cerrados -->
                  <div class="kanban-col" data-col-stage="cerrado">
                    <div class="kanban-col-header">
                      <div class="col-header-left">
                        <span class="stage-dot" style="background: var(--gt-green);"></span>
                        <span class="col-header-title">Cerrados con Informe</span>
                      </div>
                      <span class="kanban-count-pill" id="kanbanCountCerrados">0</span>
                    </div>
                    <div class="kanban-col-body" id="kanbanColCerrados"></div>
                  </div>
                </div>

              <!-- Simulador de Evaluación Socioeconómica Paramétrica (ASP) - Acordeón Desplegable -->
              <div class="cred-calc-accordion socio-calc-accordion" id="cardSimuladorVulnerabilidad"
                style="margin-top: 16px;">
                <button type="button" class="cred-calc-toggle-btn socio-calc-toggle-btn" id="btnToggleSimuladorSocio"
                  onclick="window.PDI?.SocialKanbanView?.toggleSimulador ? window.PDI.SocialKanbanView.toggleSimulador() : null">
                  <div class="cred-calc-header-left">
                    <div class="cred-calc-icon-box socio-icon-box"
                      style="background: rgba(239, 68, 68, 0.12); color: var(--text-danger); border: 1px solid rgba(239, 68, 68, 0.25);">
                      <Icon name="grafico.torta" size={20} />
                    </div>
                    <div>
                      <div class="cred-calc-title" style="display:flex; align-items:center; gap:8px;">
                        <span>Simulador de Evaluación Socioeconómica (ASP)</span>
                        <span class="badge badge-gray" style="font-size:10.5px; padding:2px 7px;">6 Dimensiones</span>
                      </div>
                      <div class="cred-calc-subtitle">Cálculo paramétrico de vulnerabilidad (0-100 pts) y recomendación
                        de exoneración</div>
                    </div>
                  </div>
                  <div class="cred-calc-header-right">
                    <Icon name="nav.desplegar" size={18} class="cred-calc-chevron socio-calc-chevron" />
                  </div>
                </button>

                <div class="cred-calc-body socio-calc-body" id="simuladorSocioBody"
                  style="display: none; padding: 18px 20px; border-top: 1px solid var(--border-subtle);">
                  <div
                    style="display:flex; align-items:center; justify-content:space-between; flex-wrap:wrap; gap:10px; margin-bottom: 16px; background: var(--surface-2); padding: 10px 14px; border-radius: var(--radius-sm); border: 1px solid var(--border-subtle);">
                    <div style="font-size:12.5px; font-weight:700; color:var(--text-main);">
                      Parámetros de Evaluación Familiar (MINSA / PDI)
                    </div>
                    <div style="display:flex; align-items:center; gap:8px; flex-wrap:wrap;">
                      <label for="selBeneficiarioSimulador"
                        style="font-size:11.5px; color:var(--text-dim); font-weight:600;">Cargar Usuario:</label>
                      <select id="selBeneficiarioSimulador" class="form-control"
                        style="font-size:12px; padding:4px 8px; max-width:240px;"
                        onchange="window.cargarCasoEnSimulador ? window.cargarCasoEnSimulador(this.value) : (window.PDI?.SocialController?.cargarCasoEnSimulador ? window.PDI.SocialController.cargarCasoEnSimulador(this.value) : null)">
                        <option value="custom">-- Calificación Manual / Libre --</option>
                        <option value="PDI-2026-003">Liam Mateo Sanchez (El Progreso)</option>
                        <option value="PDI-2026-008">Dylan Josué Quispe (San Pedro)</option>
                        <option value="PDI-2026-001">Thiago Gael Flores (Año Nuevo)</option>
                        <option value="PDI-2026-005">Mateo Sebastian Castillo (San Pedro)</option>
                        <option value="PDI-2026-006">Benjamín Elías Navarro (Santa Rosa)</option>
                        <option value="PDI-2026-010">Lucas Alejandro Torres (Los Bendecidos)</option>
                        <option value="PDI-2026-007">Camila Fernanda Rojas (Año Nuevo)</option>
                        <option value="PDI-2026-002">Mia Valentina Mendoza (La Libertad)</option>
                        <option value="PDI-2026-004">Luciana Sofia Alvarez (Año Nuevo)</option>
                      </select>
                    </div>
                  </div>

                  <!-- 6 Dimension Cards with Rubric and Score Input -->
                  <div class="socio-calc-grid">

                    <!-- 1. Balance Ingreso / Egreso -->
                    <div class="socio-dim-card">
                      <div class="socio-dim-header">
                        <div>
                          <span class="socio-dim-title">1. Balance Ingreso / Egreso Económico</span>
                          <span class="badge badge-gray" style="font-size:10px; margin-top:2px;">Máx. 28 pts</span>
                        </div>
                        <div class="socio-score-badge" id="lblScoreIngreso">24 pts</div>
                      </div>
                      <div class="socio-input-row">
                        <input type="range" min="0" max="28" value="24" id="sliderIngreso"
                          oninput="window.syncScoreSimulador('Ingreso', this.value)">
                        <input type="number" min="0" max="28" value="24" id="scoreIngreso"
                          class="form-control socio-num-input"
                          oninput="window.syncScoreSimulador('Ingreso', this.value)">
                      </div>
                      <div class="socio-guide-box">
                        <div class="socio-guide-title">
                          <Icon name="estado.info" size={12} />
                          <span>Datos a considerar para calificar:</span>
                        </div>
                        <ul class="socio-guide-list">
                          <li><strong class="text-critico">22 - 28 pts:</strong> Ingreso per cápita &lt; S/ 250/mes;
                            déficit
                            severo para alimentos básicos; ingresos informales nulos o esporádicos.</li>
                          <li><strong class="text-medio">12 - 21 pts:</strong> Ingreso per cápita S/ 250 - S/ 450/mes;
                            balance
                            justo al límite sin margen de ahorro ni contingencia.</li>
                          <li><strong class="text-favorable">0 - 11 pts:</strong> Ingreso per cápita &gt; S/ 450/mes;
                            cobertura alimentaria familiar garantizada y estabilidad.</li>
                        </ul>
                      </div>
                    </div>

                    <!-- 2. Condición y Tenencia de Vivienda -->
                    <div class="socio-dim-card">
                      <div class="socio-dim-header">
                        <div>
                          <span class="socio-dim-title">2. Condición y Tenencia de Vivienda</span>
                          <span class="badge badge-gray" style="font-size:10px; margin-top:2px;">Máx. 20 pts</span>
                        </div>
                        <div class="socio-score-badge" id="lblScoreVivienda">18 pts</div>
                      </div>
                      <div class="socio-input-row">
                        <input type="range" min="0" max="20" value="18" id="sliderVivienda"
                          oninput="window.syncScoreSimulador('Vivienda', this.value)">
                        <input type="number" min="0" max="20" value="18" id="scoreVivienda"
                          class="form-control socio-num-input"
                          oninput="window.syncScoreSimulador('Vivienda', this.value)">
                      </div>
                      <div class="socio-guide-box">
                        <div class="socio-guide-title">
                          <Icon name="estado.info" size={12} />
                          <span>Datos a considerar para calificar:</span>
                        </div>
                        <ul class="socio-guide-list">
                          <li><strong class="text-critico">15 - 20 pts:</strong> Material precario (esteras/madera, piso
                            de
                            tierra); zona de alto riesgo; sin agua ni desagüe de red pública.</li>
                          <li><strong class="text-medio">8 - 14 pts:</strong> Vivienda alquilada o prestada; paredes de
                            ladrillo sin tarrajeo; servicios básicos compartidos.</li>
                          <li><strong class="text-favorable">0 - 7 pts:</strong> Vivienda propia o adjudicada de
                            material
                            noble; conexiones domiciliarias completas e independientes.</li>
                        </ul>
                      </div>
                    </div>

                    <!-- 3. Factores de Soporte y Carga Familiar -->
                    <div class="socio-dim-card">
                      <div class="socio-dim-header">
                        <div>
                          <span class="socio-dim-title">3. Factores de Soporte y Carga Familiar</span>
                          <span class="badge badge-gray" style="font-size:10px; margin-top:2px;">Máx. 19 pts</span>
                        </div>
                        <div class="socio-score-badge" id="lblScoreSoporte">16 pts</div>
                      </div>
                      <div class="socio-input-row">
                        <input type="range" min="0" max="19" value="16" id="sliderSoporte"
                          oninput="window.syncScoreSimulador('Soporte', this.value)">
                        <input type="number" min="0" max="19" value="16" id="scoreSoporte"
                          class="form-control socio-num-input"
                          oninput="window.syncScoreSimulador('Soporte', this.value)">
                      </div>
                      <div class="socio-guide-box">
                        <div class="socio-guide-title">
                          <Icon name="estado.info" size={12} />
                          <span>Datos a considerar para calificar:</span>
                        </div>
                        <ul class="socio-guide-list">
                          <li><strong class="text-critico">14 - 19 pts:</strong> Hogar monoparental con 3+ usuarios
                            dependientes, o adulto mayor a cargo exclusivo sin red de soporte.</li>
                          <li><strong class="text-medio">7 - 13 pts:</strong> 2 dependientes a cargo; apoyo familiar
                            intermitente o progenitor no conviviente ausente.</li>
                          <li><strong class="text-favorable">0 - 6 pts:</strong> Ambos padres activos en el hogar, 1
                            usuario a
                            cargo y red familiar de apoyo extendida y solvente.</li>
                        </ul>
                      </div>
                    </div>

                    <!-- 4. Empleo y Ocupación del Cuidador -->
                    <div class="socio-dim-card">
                      <div class="socio-dim-header">
                        <div>
                          <span class="socio-dim-title">4. Empleo y Ocupación del Cuidador</span>
                          <span class="badge badge-gray" style="font-size:10px; margin-top:2px;">Máx. 16 pts</span>
                        </div>
                        <div class="socio-score-badge" id="lblScoreEmpleo">14 pts</div>
                      </div>
                      <div class="socio-input-row">
                        <input type="range" min="0" max="16" value="14" id="sliderEmpleo"
                          oninput="window.syncScoreSimulador('Empleo', this.value)">
                        <input type="number" min="0" max="16" value="14" id="scoreEmpleo"
                          class="form-control socio-num-input"
                          oninput="window.syncScoreSimulador('Empleo', this.value)">
                      </div>
                      <div class="socio-guide-box">
                        <div class="socio-guide-title">
                          <Icon name="estado.info" size={12} />
                          <span>Datos a considerar para calificar:</span>
                        </div>
                        <ul class="socio-guide-list">
                          <li><strong class="text-critico">12 - 16 pts:</strong> Desempleo prolongado; trabajo
                            ambulatorio de
                            subsistencia diaria; incapacidad laboral no pensionada.</li>
                          <li><strong class="text-medio">6 - 11 pts:</strong> Empleo informal temporal (mototaxista,
                            estiba,
                            limpieza eventual) sin contratos ni beneficios.</li>
                          <li><strong class="text-favorable">0 - 5 pts:</strong> Empleo formal en planilla o actividad
                            microempresarial formalizada y continua.</li>
                        </ul>
                      </div>
                    </div>

                    <!-- 5. Nivel de Instrucción del Hogar -->
                    <div class="socio-dim-card">
                      <div class="socio-dim-header">
                        <div>
                          <span class="socio-dim-title">5. Nivel de Instrucción del Hogar</span>
                          <span class="badge badge-gray" style="font-size:10px; margin-top:2px;">Máx. 10 pts</span>
                        </div>
                        <div class="socio-score-badge" id="lblScoreInstruccion">8 pts</div>
                      </div>
                      <div class="socio-input-row">
                        <input type="range" min="0" max="10" value="8" id="sliderInstruccion"
                          oninput="window.syncScoreSimulador('Instruccion', this.value)">
                        <input type="number" min="0" max="10" value="8" id="scoreInstruccion"
                          class="form-control socio-num-input"
                          oninput="window.syncScoreSimulador('Instruccion', this.value)">
                      </div>
                      <div class="socio-guide-box">
                        <div class="socio-guide-title">
                          <Icon name="estado.info" size={12} />
                          <span>Datos a considerar para calificar:</span>
                        </div>
                        <ul class="socio-guide-list">
                          <li><strong class="text-critico">7 - 10 pts:</strong> Primaria incompleta o analfabetismo
                            funcional
                            del apoderado titular.</li>
                          <li><strong class="text-medio">4 - 6 pts:</strong> Secundaria incompleta o primaria completa.
                          </li>
                          <li><strong class="text-favorable">0 - 3 pts:</strong> Secundaria completa, educación técnica
                            superior o universitaria.</li>
                        </ul>
                      </div>
                    </div>

                    <!-- 6. Salud y Discapacidad en Familia -->
                    <div class="socio-dim-card">
                      <div class="socio-dim-header">
                        <div>
                          <span class="socio-dim-title">6. Salud y Discapacidad en Familia</span>
                          <span class="badge badge-gray" style="font-size:10px; margin-top:2px;">Máx. 7 pts</span>
                        </div>
                        <div class="socio-score-badge" id="lblScoreSaludFam">6 pts</div>
                      </div>
                      <div class="socio-input-row">
                        <input type="range" min="0" max="7" value="6" id="sliderSaludFam"
                          oninput="window.syncScoreSimulador('SaludFam', this.value)">
                        <input type="number" min="0" max="7" value="6" id="scoreSaludFam"
                          class="form-control socio-num-input"
                          oninput="window.syncScoreSimulador('SaludFam', this.value)">
                      </div>
                      <div class="socio-guide-box">
                        <div class="socio-guide-title">
                          <Icon name="estado.info" size={12} />
                          <span>Datos a considerar para calificar:</span>
                        </div>
                        <ul class="socio-guide-list">
                          <li><strong class="text-critico">5 - 7 pts:</strong> Miembro del hogar con enfermedad crónica
                            de
                            alto costo o discapacidad severa sin cobertura.</li>
                          <li><strong class="text-medio">2 - 4 pts:</strong> Usuario con anemia recurrente o familiares
                            con
                            tratamientos médicos periódicos.</li>
                          <li><strong class="text-favorable">0 - 1 pts:</strong> Sin patologías limitantes en el núcleo;
                            aseguramiento SIS o EsSalud activo.</li>
                        </ul>
                      </div>
                    </div>

                  </div>

                  <!-- Botón de Ejecución de Cálculo -->
                  <div style="margin-top: 16px; display: flex; justify-content: flex-end;">
                    <button type="button" class="btn-action primary" id="btnCalcularSocio"
                      onclick="window.calcularEvaluacionSocioeconomica()"
                      style="padding: 10px 22px; font-size: 13.5px; font-weight: 700;">
                      <Icon name="persona.agregar" size={18} />
                      <span>Calcular Evaluación Socioeconómica</span>
                    </button>
                  </div>

                  <!-- Calculated Output Container -->
                  <div id="containerResultadoSocioeconomico" class="socio-result-card" style="margin-top: 16px;">
                    <div class="socio-result-header">
                      <div>
                        <div
                          style="font-size: 11.5px; text-transform: uppercase; font-weight: 700; color: var(--text-dim); letter-spacing: 0.5px;">
                          Resultado de Evaluación Paramétrica Oficial
                        </div>
                        <div style="display: flex; align-items: center; gap: 10px; margin-top: 4px; flex-wrap: wrap;">
                          <span class="socio-total-score" id="socioTotalScoreVal">86 / 100</span>
                          <span class="badge badge-red" id="socioCategoryBadge">Extrema Pobreza / Vulnerabilidad
                            Crítica</span>
                        </div>
                      </div>
                      <div style="text-align: right;">
                        <div style="font-size: 11.5px; color: var(--text-dim); font-weight: 600;">Exoneración de Aporte
                          Recomendada:</div>
                        <strong style="font-size: 13.5px; color: var(--text-danger);" id="socioExoneracionText">100%
                          Exoneración
                          Total (Caso Social Extremo)</strong>
                      </div>
                    </div>

                    <!-- Progress Bar -->
                    <div
                      style="width: 100%; height: 8px; background: var(--border-subtle); border-radius: var(--radius-sm); overflow: hidden; margin: 14px 0 16px 0;">
                      <div id="socioTotalScoreBar"
                        style="width: 86%; height: 100%; background: var(--gt-red); transition: width 0.3s ease, background 0.3s ease;">
                      </div>
                    </div>

                    <!-- Recommendations List -->
                    <div>
                      <div
                        style="font-size: 12.5px; font-weight: 700; color: var(--text-main); margin-bottom: 8px; display: flex; align-items: center; gap: 6px;">
                        <Icon name="accion.lista" size={16} />
                        <span>Plan de Intervención y Recomendaciones Oficiales:</span>
                      </div>
                      <ul class="socio-recommendations-list" id="listaRecomendacionesSocio">
                        <li class="socio-recommendation-item">
                          <div class="socio-rec-icon">
                            <Icon name="accion.confirmar" size={14} />
                          </div>
                          <span>Aprobación inmediata de exoneración del 100% de aporte mensual por vulnerabilidad
                            extrema.</span>
                        </li>
                        <li class="socio-recommendation-item">
                          <div class="socio-rec-icon">
                            <Icon name="accion.confirmar" size={14} />
                          </div>
                          <span>Asignación prioritaria de Canasta Nutricional complementaria (Banco de Alimentos
                            BTF).</span>
                        </li>
                        <li class="socio-recommendation-item">
                          <div class="socio-rec-icon">
                            <Icon name="accion.confirmar" size={14} />
                          </div>
                          <span>Apertura de expediente en Área Social Pastoral (ASP) y visitas domiciliarias quincenales
                            de
                            seguimiento.</span>
                        </li>
                      </ul>
                    </div> <!-- Fin recomendaciones -->
                  </div> <!-- Fin #containerResultadoSocioeconomico -->
                </div> <!-- Fin #simuladorSocioBody -->
              </div> <!-- Fin #cardSimuladorVulnerabilidad -->
            </div> <!-- Fin #viewSocialKanban -->

          <!-- ======================================================== -->
          <!-- SUBVISTA 2: Bandeja de Autorizaciones Pendientes (Coord) -->
          <!-- ======================================================== -->
          <div class="social-subview-panel" id="viewSocialAutorizaciones">
            <div class="social-subview-card">
              <div class="social-subview-header">
                <div class="social-subview-title-group">
                  <div class="social-subview-icon-box amber">
                    <Icon name="estado.alerta" size={20} />
                  </div>
                  <div>
                    <h3 style="font-size: 15px; font-weight: 700; color: var(--text-main); margin: 0;">
                      Bandeja de Autorizaciones de Transición de Fase
                    </h3>
                    <p style="font-size: 12px; color: var(--text-muted); margin: 2px 0 0 0;">
                      Solicitudes presentadas por el equipo de campo y trabajadoras sociales que requieren aprobación formal de Coordinación General.
                    </p>
                  </div>
                </div>
                <div style="display: flex; gap: 8px; flex-wrap: wrap;">
                  <button type="button" class="btn-action" onclick="window.PDI?.SocialKanbanView?.switchSocialTab('kanban')">
                    <Icon name="accion.volver" size={14} />
                    <span>Volver al Tablero</span>
                  </button>
                  <button type="button" class="btn-action" onclick="window.PDI?.SocialKanbanView?.renderVistaAutorizaciones()">
                    <Icon name="accion.actualizar" size={14} />
                    <span>Actualizar</span>
                  </button>
                </div>
              </div>

              <!-- Lista dinámica de autorizaciones pendientes -->
              <div id="containerListaAutorizacionesPendientes"></div>
            </div>
          </div>

          <!-- ======================================================== -->
          <!-- SUBVISTA 3: Estado de Solicitudes (Operativo)             -->
          <!-- ======================================================== -->
          <div class="social-subview-panel" id="viewSocialMisSolicitudes">
            <div class="social-subview-card">
              <div class="social-subview-header">
                <div class="social-subview-title-group">
                  <div class="social-subview-icon-box blue">
                    <Icon name="archivo.documento" size={20} />
                  </div>
                  <div>
                    <h3 style="font-size: 15px; font-weight: 700; color: var(--text-main); margin: 0;">
                      Historial y Estado de Solicitudes de Fase
                    </h3>
                    <p style="font-size: 12px; color: var(--text-muted); margin: 2px 0 0 0;">
                      Seguimiento de solicitudes enviadas, veredictos de Coordinación y motivos o comentarios de retroalimentación.
                    </p>
                  </div>
                </div>
                <div style="display: flex; gap: 8px; flex-wrap: wrap;">
                  <button type="button" class="btn-action" onclick="window.PDI?.SocialKanbanView?.switchSocialTab('kanban')">
                    <Icon name="accion.volver" size={14} />
                    <span>Volver al Tablero</span>
                  </button>
                  <button type="button" class="btn-action" onclick="window.PDI?.SocialKanbanView?.renderVistaMisSolicitudes()">
                    <Icon name="accion.actualizar" size={14} />
                    <span>Actualizar</span>
                  </button>
                </div>
              </div>

              <!-- Estadísticas rápidas -->
              <div class="social-stats-row">
                <div class="social-stat-card">
                  <span class="social-stat-label">Total Solicitudes</span>
                  <span class="social-stat-val" id="statMisSolicitudesTotal">0</span>
                </div>
                <div class="social-stat-card">
                  <span class="social-stat-label">Pendientes de Revisión</span>
                  <span class="social-stat-val text-medio" id="statMisSolicitudesPendientes">0</span>
                </div>
                <div class="social-stat-card">
                  <span class="social-stat-label">Aprobadas</span>
                  <span class="social-stat-val text-favorable" id="statMisSolicitudesAprobadas">0</span>
                </div>
                <div class="social-stat-card">
                  <span class="social-stat-label">Rechazadas / Observadas</span>
                  <span class="social-stat-val text-critico" id="statMisSolicitudesRechazadas">0</span>
                </div>
              </div>

              <!-- Lista dinámica del historial de solicitudes -->
              <div id="containerListaMisSolicitudes"></div>
            </div>
          </div>
        </section>

  <script>
    import '../scripts/pages/social.js';
  </script>
</AppLayout>