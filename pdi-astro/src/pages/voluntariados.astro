---
import AppLayout from '../layouts/AppLayout.astro';
import { OPCIONES_VOLUNTARIADO } from '../data/opcionesBeneficiario.js';
import '../styles/views-voluntariados.css';
---

<AppLayout title="Padrón de Voluntarios" currentPage="voluntariados">
        <section class="app-view active" id="view-voluntarios">
          <div class="view-header">
            <div class="view-title-group">
              <h2>Padrón de Voluntarios y Personal de Apoyo</h2>
              <p>Gestión de voluntarias de sede, promotoras de apoyo, capacitaciones oficiales y asignación territorial (Fichas A4, A5 y A6).</p>
            </div>
            <div class="view-actions">
              <button type="button" class="btn-action-icon btn-audit-export-icon" id="btnExportVoluntariosCSV"
                onclick="window.openModalExportVoluntarios ? window.openModalExportVoluntarios() : window.exportVoluntariosCSV()"
                aria-label="Descargar Padrón de Voluntariados CSV" title="Descargar Padrón de Voluntariados CSV">
                <svg width="18" height="18" fill="none" stroke="currentColor" stroke-width="2.2" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round"
                    d="M3 16.5v2.25A2.25 2.25 0 005.25 21h13.5A2.25 2.25 0 0021 18.75V16.5M16.5 12L12 16.5m0 0L7.5 12m4.5 4.5V3" />
                </svg>
              </button>
              <button type="button" class="btn-action primary" onclick="window.openInscripcionVoluntario ? window.openInscripcionVoluntario() : null" title="Registrar nueva voluntaria o personal de apoyo">
                <svg width="15" height="15" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M12 4.5v15m7.5-7.5h-15" />
                </svg>
                <span>Nueva Inscripción</span>
              </button>
            </div>
          </div>

          <!-- Reparto en campo: asignación del voluntariado por servicio y territorio.
               Sustituye a la banda de KPIs, que es lenguaje exclusivo del /dashboard. -->
          <section class="vol-reparto" aria-labelledby="volRepartoTitle">
            <header class="vol-reparto-head">
              <div>
                <h3 class="vol-reparto-title" id="volRepartoTitle">Reparto en campo</h3>
                <p class="vol-reparto-sub">Voluntariado asignado por servicio y distrito</p>
              </div>
              <p class="vol-reparto-total"><span id="volRepartoTotal">8</span> en el padrón · <span id="volRepartoPausa">0</span> en pausa</p>
            </header>
            <div class="vol-reparto-bar vol-reparto-bar--labels" role="img" aria-label="Composición del voluntariado por servicio">
              <span class="vol-reparto-seg vol-reparto-seg--food" id="volRepartoBarFood" style="width: 50%;"><span class="vol-reparto-bar-tag">Servicio Alimentario · 50%</span></span>
              <span class="vol-reparto-seg vol-reparto-seg--casita" id="volRepartoBarCasita" style="width: 37.5%;"><span class="vol-reparto-bar-tag">Casita del Saber · 38%</span></span>
              <span class="vol-reparto-seg vol-reparto-seg--asp" id="volRepartoBarAsp" style="width: 12.5%;"><span class="vol-reparto-bar-tag">ASP · 13%</span></span>
            </div>
            <ul class="vol-reparto-list">
              <li class="vol-reparto-row">
                <span class="vol-reparto-dot vol-reparto-dot--food" aria-hidden="true"></span>
                <span class="vol-reparto-name">Servicio Alimentario</span>
                <span class="vol-reparto-detail">Desayunos e iglesias aliadas</span>
                <span class="vol-reparto-count"><strong id="volRepartoDesayuno">4</strong> asignadas</span>
              </li>
              <li class="vol-reparto-row">
                <span class="vol-reparto-dot vol-reparto-dot--casita" aria-hidden="true"></span>
                <span class="vol-reparto-name">Casita del Saber</span>
                <span class="vol-reparto-detail">Acompañamiento y biblioteca</span>
                <span class="vol-reparto-count"><strong id="volRepartoCasita">3</strong> asignadas</span>
              </li>
              <li class="vol-reparto-row">
                <span class="vol-reparto-dot vol-reparto-dot--asp" aria-hidden="true"></span>
                <span class="vol-reparto-name">Área Social Pastoral</span>
                <span class="vol-reparto-detail">Derivaciones y visitas</span>
                <span class="vol-reparto-count"><strong id="volRepartoAsp">1</strong> asignada</span>
              </li>
            </ul>
            <footer class="vol-reparto-foot">
              <dl class="vol-reparto-terr">
                <div><dt>Comas</dt><dd id="volRepartoComas">5</dd></div>
                <div><dt>Carabayllo</dt><dd id="volRepartoCarabayllo">3</dd></div>
              </dl>
              <p class="vol-reparto-note"><span id="volRepartoCanastas">18</span> canastas de estímulo por labor comunitaria</p>
            </footer>
          </section>
          <!-- Barra de Filtros y Búsqueda Rápida de Voluntariados -->
          <div class="card" id="cardVoluntariosPadron" style="position: relative; z-index: 80;">
            <div class="audit-toolbar">
              <div class="audit-search-wrap">
                <svg class="audit-search-icon" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M21 21l-5.197-5.197m0 0A7.5 7.5 0 105.196 5.196a7.5 7.5 0 0010.607 10.607z" />
                </svg>
                <input type="text" id="inputVoluntariosSearch" class="audit-search-input" placeholder="Buscar por nombre, DNI, código, sede o rol...">
                <button type="button" class="audit-search-clear" id="btnVoluntariosSearchClear" onclick="window.clearVoluntariosSearch ? window.clearVoluntariosSearch() : (window.PDI?.VoluntariadosView?.clearSearch ? window.PDI.VoluntariadosView.clearSearch() : null)" style="display: none;" title="Limpiar búsqueda">
                  <svg width="12" height="12" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M6 18L18 6M6 6l12 12" />
                  </svg>
                </button>
              </div>

              <!-- Filtro Popover Dropdown -->
              <div class="audit-filter-panel-wrap">
                <div class="custom-dropdown audit-filters-dropdown" id="dropdownVoluntariosFilterPanel">
                  <button type="button" class="btn-action audit-filter-btn" id="btnDropdownVoluntariosFilterPanel" onclick="window.toggleCustomDropdown ? window.toggleCustomDropdown('dropdownVoluntariosFilterPanel') : null">
                    <svg width="16" height="16" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
                      <path stroke-linecap="round" stroke-linejoin="round" d="M12 3c2.755 0 5.455.232 8.083.678.533.09.917.556.917 1.096v1.044a2.25 2.25 0 01-.659 1.591l-5.432 5.432a2.25 2.25 0 00-.659 1.591v2.927a2.25 2.25 0 01-1.244 2.013L9.75 21v-6.568a2.25 2.25 0 00-.659-1.591L3.659 7.409A2.25 2.25 0 013 5.818V4.774c0-.54.384-1.006.917-1.096A48.32 48.32 0 0112 3z" />
                    </svg>
                    <span>Filtros</span>
                    <span class="audit-filter-badge" id="voluntariosActiveFiltersCount" style="display:none;">0</span>
                    <svg width="12" height="12" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24" class="filter-caret">
                      <path stroke-linecap="round" stroke-linejoin="round" d="M19.5 8.25l-7.5 7.5-7.5-7.5" />
                    </svg>
                  </button>

                  <div class="custom-dropdown-menu audit-filters-menu" id="menuVoluntariosFilterPanel">
                    <div class="audit-filters-header">
                      <div class="audit-filters-header-title">
                        <span>Filtros de Voluntariados</span>
                      </div>
                      <div class="audit-filters-header-actions">
                        <button type="button" class="btn-text-subtle"
                          onclick="window.resetVoluntariosFilters ? window.resetVoluntariosFilters() : null">Restablecer</button>
                        <button type="button" class="btn-close-sheet" aria-label="Cerrar filtros"
                          onclick="window.closeAllFilterSheets ? window.closeAllFilterSheets() : null">
                          <svg width="15" height="15" fill="none" stroke="currentColor" stroke-width="2.2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M6 18L18 6M6 6l12 12"/></svg>
                        </button>
                      </div>
                    </div>

                    <div class="audit-filters-body">
                      <!-- Filtro 1: Distrito (multi-selección) -->
                      <div class="audit-filter-field">
                        <label class="audit-field-label">Distrito</label>
                        <div class="padron-inner-dropdown" id="dropdownVoluntariosDistrito">
                          <button type="button" class="padron-inner-dropdown-btn"
                            onclick="window.toggleVoluntariosInnerDropdown ? window.toggleVoluntariosInnerDropdown('dropdownVoluntariosDistrito') : null">
                            <span id="labelVoluntariosDistritoSelect">Todos los Distritos</span>
                            <svg class="caret" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24">
                              <path stroke-linecap="round" stroke-linejoin="round" d="M19.5 8.25l-7.5 7.5-7.5-7.5" />
                            </svg>
                          </button>
                          <div class="padron-inner-dropdown-menu" id="menuVoluntariosDistrito">
                            <div class="padron-dropdown-item selected" data-value="all"
                              onclick="window.toggleVoluntariosDistrito ? window.toggleVoluntariosDistrito('all') : null">
                              <div class="padron-item-left">
                                <span class="padron-item-checkbox">
                                  <svg width="10" height="10" fill="none" stroke="currentColor" stroke-width="3"
                                    viewBox="0 0 24 24">
                                    <path stroke-linecap="round" stroke-linejoin="round" d="M4.5 12.75l6 6 9-13.5" />
                                  </svg>
                                </span>
                                <span class="padron-item-label">Todos los Distritos</span>
                              </div>
                            </div>
                            <div class="padron-dropdown-item" data-value="Comas"
                              onclick="window.toggleVoluntariosDistrito ? window.toggleVoluntariosDistrito('Comas') : null">
                              <div class="padron-item-left">
                                <span class="padron-item-checkbox">
                                  <svg width="10" height="10" fill="none" stroke="currentColor" stroke-width="3"
                                    viewBox="0 0 24 24">
                                    <path stroke-linecap="round" stroke-linejoin="round" d="M4.5 12.75l6 6 9-13.5" />
                                  </svg>
                                </span>
                                <span class="padron-item-label">Comas</span>
                              </div>
                            </div>
                            <div class="padron-dropdown-item" data-value="Carabayllo"
                              onclick="window.toggleVoluntariosDistrito ? window.toggleVoluntariosDistrito('Carabayllo') : null">
                              <div class="padron-item-left">
                                <span class="padron-item-checkbox">
                                  <svg width="10" height="10" fill="none" stroke="currentColor" stroke-width="3"
                                    viewBox="0 0 24 24">
                                    <path stroke-linecap="round" stroke-linejoin="round" d="M4.5 12.75l6 6 9-13.5" />
                                  </svg>
                                </span>
                                <span class="padron-item-label">Carabayllo</span>
                              </div>
                            </div>
                          </div>
                        </div>
                      </div>

                      <!-- Filtro 2: Servicio Asignado (multi-selección) -->
                      <div class="audit-filter-field">
                        <label class="audit-field-label">Servicio Asignado</label>
                        <div class="padron-inner-dropdown" id="dropdownVoluntariosServicio">
                          <button type="button" class="padron-inner-dropdown-btn"
                            onclick="window.toggleVoluntariosInnerDropdown ? window.toggleVoluntariosInnerDropdown('dropdownVoluntariosServicio') : null">
                            <span id="labelVoluntariosServicioSelect">Todos los Servicios</span>
                            <svg class="caret" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24">
                              <path stroke-linecap="round" stroke-linejoin="round" d="M19.5 8.25l-7.5 7.5-7.5-7.5" />
                            </svg>
                          </button>
                          <div class="padron-inner-dropdown-menu" id="menuVoluntariosServicio">
                            <div class="padron-dropdown-item selected" data-value="all"
                              onclick="window.toggleVoluntariosServicio ? window.toggleVoluntariosServicio('all') : null">
                              <div class="padron-item-left">
                                <span class="padron-item-checkbox">
                                  <svg width="10" height="10" fill="none" stroke="currentColor" stroke-width="3"
                                    viewBox="0 0 24 24">
                                    <path stroke-linecap="round" stroke-linejoin="round" d="M4.5 12.75l6 6 9-13.5" />
                                  </svg>
                                </span>
                                <span class="padron-item-label">Todos los Servicios</span>
                              </div>
                            </div>
                            {OPCIONES_VOLUNTARIADO.map((opcion) => (
                              <div class="padron-dropdown-item" data-value={opcion.valor}
                                onclick={`window.toggleVoluntariosServicio ? window.toggleVoluntariosServicio('${opcion.valor}') : null`}>
                                <div class="padron-item-left">
                                  <span class="padron-item-checkbox">
                                    <svg width="10" height="10" fill="none" stroke="currentColor" stroke-width="3"
                                      viewBox="0 0 24 24">
                                      <path stroke-linecap="round" stroke-linejoin="round" d="M4.5 12.75l6 6 9-13.5" />
                                    </svg>
                                  </span>
                                  <span class="padron-item-label">{opcion.etiqueta}</span>
                                </div>
                              </div>
                            ))}
                          </div>
                        </div>
                      </div>

                      <!-- Filtro 3: Rol Comunitario (multi-selección) -->
                      <div class="audit-filter-field">
                        <label class="audit-field-label">Rol en Sede</label>
                        <div class="padron-inner-dropdown" id="dropdownVoluntariosRol">
                          <button type="button" class="padron-inner-dropdown-btn"
                            onclick="window.toggleVoluntariosInnerDropdown ? window.toggleVoluntariosInnerDropdown('dropdownVoluntariosRol') : null">
                            <span id="labelVoluntariosRolSelect">Todos los Roles</span>
                            <svg class="caret" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24">
                              <path stroke-linecap="round" stroke-linejoin="round" d="M19.5 8.25l-7.5 7.5-7.5-7.5" />
                            </svg>
                          </button>
                          <div class="padron-inner-dropdown-menu" id="menuVoluntariosRol">
                            <div class="padron-dropdown-item selected" data-value="all"
                              onclick="window.toggleVoluntariosRol ? window.toggleVoluntariosRol('all') : null">
                              <div class="padron-item-left">
                                <span class="padron-item-checkbox">
                                  <svg width="10" height="10" fill="none" stroke="currentColor" stroke-width="3" viewBox="0 0 24 24">
                                    <path stroke-linecap="round" stroke-linejoin="round" d="M4.5 12.75l6 6 9-13.5" />
                                  </svg>
                                </span>
                                <span class="padron-item-label">Todos los Roles</span>
                              </div>
                            </div>
                            <div class="padron-dropdown-item" data-value="Voluntaria Responsable"
                              onclick="window.toggleVoluntariosRol ? window.toggleVoluntariosRol('Voluntaria Responsable') : null">
                              <div class="padron-item-left">
                                <span class="padron-item-checkbox">
                                  <svg width="10" height="10" fill="none" stroke="currentColor" stroke-width="3" viewBox="0 0 24 24">
                                    <path stroke-linecap="round" stroke-linejoin="round" d="M4.5 12.75l6 6 9-13.5" />
                                  </svg>
                                </span>
                                <span class="padron-item-label">Voluntaria Responsable</span>
                              </div>
                            </div>
                            <div class="padron-dropdown-item" data-value="Voluntaria de Apoyo"
                              onclick="window.toggleVoluntariosRol ? window.toggleVoluntariosRol('Voluntaria de Apoyo') : null">
                              <div class="padron-item-left">
                                <span class="padron-item-checkbox">
                                  <svg width="10" height="10" fill="none" stroke="currentColor" stroke-width="3" viewBox="0 0 24 24">
                                    <path stroke-linecap="round" stroke-linejoin="round" d="M4.5 12.75l6 6 9-13.5" />
                                  </svg>
                                </span>
                                <span class="padron-item-label">Voluntaria de Apoyo</span>
                              </div>
                            </div>
                            <div class="padron-dropdown-item" data-value="Acompañante Pedagógica"
                              onclick="window.toggleVoluntariosRol ? window.toggleVoluntariosRol('Acompañante Pedagógica') : null">
                              <div class="padron-item-left">
                                <span class="padron-item-checkbox">
                                  <svg width="10" height="10" fill="none" stroke="currentColor" stroke-width="3" viewBox="0 0 24 24">
                                    <path stroke-linecap="round" stroke-linejoin="round" d="M4.5 12.75l6 6 9-13.5" />
                                  </svg>
                                </span>
                                <span class="padron-item-label">Acompañante Pedagógica</span>
                              </div>
                            </div>
                            <div class="padron-dropdown-item" data-value="Mediadora Lectora"
                              onclick="window.toggleVoluntariosRol ? window.toggleVoluntariosRol('Mediadora Lectora') : null">
                              <div class="padron-item-left">
                                <span class="padron-item-checkbox">
                                  <svg width="10" height="10" fill="none" stroke="currentColor" stroke-width="3" viewBox="0 0 24 24">
                                    <path stroke-linecap="round" stroke-linejoin="round" d="M4.5 12.75l6 6 9-13.5" />
                                  </svg>
                                </span>
                                <span class="padron-item-label">Mediadora Lectora</span>
                              </div>
                            </div>
                            <div class="padron-dropdown-item" data-value="Pastoral Comunitario"
                              onclick="window.toggleVoluntariosRol ? window.toggleVoluntariosRol('Pastoral Comunitario') : null">
                              <div class="padron-item-left">
                                <span class="padron-item-checkbox">
                                  <svg width="10" height="10" fill="none" stroke="currentColor" stroke-width="3" viewBox="0 0 24 24">
                                    <path stroke-linecap="round" stroke-linejoin="round" d="M4.5 12.75l6 6 9-13.5" />
                                  </svg>
                                </span>
                                <span class="padron-item-label">Pastoral Comunitario</span>
                              </div>
                            </div>
                          </div>
                        </div>
                      </div>

                      <!-- Filtro 4: Estado de la Voluntaria (selección única) -->
                      <div class="audit-filter-field">
                        <label class="audit-field-label">Estado de la Voluntaria</label>
                        <div class="padron-inner-dropdown" id="dropdownVoluntariosEstado">
                          <button type="button" class="padron-inner-dropdown-btn"
                            onclick="window.toggleVoluntariosInnerDropdown ? window.toggleVoluntariosInnerDropdown('dropdownVoluntariosEstado') : null">
                            <span id="labelVoluntariosEstadoSelect">Todos los Estados</span>
                            <svg class="caret" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24">
                              <path stroke-linecap="round" stroke-linejoin="round" d="M19.5 8.25l-7.5 7.5-7.5-7.5" />
                            </svg>
                          </button>
                          <div class="padron-inner-dropdown-menu" id="menuVoluntariosEstado">
                            <div class="padron-dropdown-item selected" data-value="all"
                              onclick="window.toggleVoluntariosEstado ? window.toggleVoluntariosEstado('all') : null">
                              <div class="padron-item-left">
                                <span class="padron-item-radio"></span>
                                <span class="padron-item-label">Todos los Estados</span>
                              </div>
                            </div>
                            <div class="padron-dropdown-item" data-value="Activo"
                              onclick="window.toggleVoluntariosEstado ? window.toggleVoluntariosEstado('Activo') : null">
                              <div class="padron-item-left">
                                <span class="padron-item-radio"></span>
                                <span class="padron-item-label">Activo</span>
                              </div>
                            </div>
                            <div class="padron-dropdown-item" data-value="En Pausa"
                              onclick="window.toggleVoluntariosEstado ? window.toggleVoluntariosEstado('En Pausa') : null">
                              <div class="padron-item-left">
                                <span class="padron-item-radio"></span>
                                <span class="padron-item-label">En Pausa</span>
                              </div>
                            </div>
                          </div>
                        </div>
                      </div>
                    </div>

                    <!-- Footer fijo móvil con botón para aplicar y cerrar el Bottom Sheet -->
                    <div class="audit-filters-footer">
                      <button type="button" class="btn-action primary btn-apply-filters"
                        onclick="window.closeAllFilterSheets ? window.closeAllFilterSheets() : null">
                        <svg width="15" height="15" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M4.5 12.75l6 6 9-13.5"/></svg>
                        <span>Aplicar Filtros</span>
                      </button>
                    </div>
                  </div>
                </div>
              </div>
            </div>

            <!-- Chips Activos Bar -->
            <div class="padron-active-chips-bar" id="voluntariosActiveChipsBar" style="display: none;">
              <span class="padron-active-chips-label">Filtros aplicados:</span>
              <div class="padron-active-chips-list" id="voluntariosActiveChipsList"
                style="display: flex; align-items: center; flex-wrap: wrap; gap: 6px;"></div>
              <button type="button" class="btn-text-subtle" style="margin-left: auto; font-size: 11.5px;"
                onclick="window.resetVoluntariosFilters ? window.resetVoluntariosFilters() : null">
                Borrar todos
              </button>
            </div>

            <!-- Tabla PC -->
            <div class="table-responsive">
              <table class="data-table">
                <thead>
                  <tr>
                    <th>Voluntario(a) / DNI</th>
                    <th>Sede y Distrito</th>
                    <th>Servicio y Rol</th>
                    <th>Contacto</th>
                    <th>Capacitaciones</th>
                    <th>Estado</th>
                    <th>Acciones</th>
                  </tr>
                </thead>
                <tbody id="tbodyVoluntarios">
                  <!-- Inyectado dinámicamente -->
                </tbody>
              </table>
            </div>

            <!-- Tarjetas Móviles -->
            <div class="padron-mobile-cards" id="mobileCardsVoluntarios">
              <!-- Inyectado dinámicamente -->
            </div>

            <!-- Controles de Paginación de Voluntarios (PC / Móvil) -->
            <div class="padron-pagination-bar" id="voluntariosPaginationBar">
              <div class="padron-pagination-left">
                <span id="voluntariosPaginationInfo" style="font-size:12.5px; color:var(--text-muted); font-weight:500;">
                  Mostrando 0 de 0 voluntarios
                </span>
                <div class="padron-density-wrapper" id="voluntariosDensityWrapper"
                  style="display:flex; align-items:center; gap:6px;">
                  <span style="font-size:12px; color:var(--text-dim);">Mostrar:</span>
                  <select class="audit-density-select padron-density-select" id="selectVoluntariosPageSize"
                    onchange="window.voluntariosSetPageSize ? window.voluntariosSetPageSize(this.value) : (window.PDI?.VoluntariadosView?.setPageSize ? window.PDI.VoluntariadosView.setPageSize(this.value) : null)">
                    <option value="10">10 por página</option>
                    <option value="20" selected>20 por página</option>
                    <option value="50">50 por página (Máx)</option>
                  </select>
                </div>
              </div>
              <div class="padron-pagination-right">
                <button type="button" class="btn-page" id="btnVoluntariosPagePrev"
                  onclick="window.voluntariosPrevPage ? window.voluntariosPrevPage() : (window.PDI?.VoluntariadosView?.prevPage ? window.PDI.VoluntariadosView.prevPage() : null)">
                  <svg width="14" height="14" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M15.75 19.5L8.25 12l7.5-7.5" />
                  </svg>
                  <span>Anterior</span>
                </button>
