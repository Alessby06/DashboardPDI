---
import AppLayout from '../layouts/AppLayout.astro';
import FilterPanel from '../components/FilterPanel.astro';
import FilterField from '../components/FilterField.astro';
import SortMenu from '../components/SortMenu.astro';
import { OPCIONES_VOLUNTARIADO, SEDES_OPERATIVAS } from '../data/opcionesBeneficiario.js';
import '../styles/views-voluntariados.css';
import '../styles/views-actions-buttons.css';
import '../styles/views-export-icon.css';
import { SEDES_POR_DISTRITO } from '../scripts/core/catalogos.js';
import Icon from '../components/Icon.astro';

const OPCIONES_DISTRITO = Object.keys(SEDES_POR_DISTRITO).map((distrito) => ({ valor: distrito, etiqueta: distrito }));
const OPCIONES_SERVICIO = OPCIONES_VOLUNTARIADO.map((opcion) => ({ valor: opcion.valor, etiqueta: opcion.etiqueta }));
const OPCIONES_ROL = [
  'Voluntaria Responsable',
  'Voluntaria de Apoyo',
  'Acompañante Pedagógica',
  'Mediadora Lectora',
  'Pastoral Comunitario',
].map((rol) => ({ valor: rol, etiqueta: rol }));
const OPCIONES_ESTADO = [
  { valor: 'Activo', etiqueta: 'Activo' },
  { valor: 'En Pausa', etiqueta: 'En Pausa' },
];
const OPCIONES_ORDEN_VOLUNTARIOS = [
  { valor: 'apellido-asc', etiqueta: 'Apellido (A-Z)' },
  { valor: 'apellido-desc', etiqueta: 'Apellido (Z-A)' },
  { valor: 'sede-asc', etiqueta: 'Sede (A-Z)' },
  { valor: 'distrito-asc', etiqueta: 'Distrito (A-Z)' },
  { valor: 'servicio-asc', etiqueta: 'Servicio (A-Z)' },
  { valor: 'rol-asc', etiqueta: 'Rol (A-Z)' },
  { valor: 'estado-asc', etiqueta: 'Estado (activo primero)' },
  { valor: 'ingreso-desc', etiqueta: 'Ingreso (reciente)' },
  { valor: 'ingreso-asc', etiqueta: 'Ingreso (antiguo)' },
];
---

<AppLayout title="Padrón de Voluntarios" currentPage="voluntariados">
        <section class="app-view active" id="view-voluntarios">
          <div class="view-header">
            <div class="view-title-group">
              <h1>Padrón de Voluntarios y Personal de Apoyo</h1>
              <p>Gestión de voluntarias de sede, promotoras de apoyo, capacitaciones oficiales y asignación territorial (Fichas A4, A5 y A6).</p>
            </div>
            <div class="view-actions">
              <button type="button" class="btn-action secondary pdi-motion" id="btnToggleTalleresReposteria" aria-expanded="false" aria-controls="panelTalleresReposteria">
                <Icon name="nav.alimentario" size={15} />
                <span>Talleres de Repostería</span>
              </button>
              <button type="button" class="btn-action primary pdi-motion" data-pdi-on="click" data-pdi-h="h171" title="Registrar nueva voluntaria o personal de apoyo">
                <Icon name="accion.agregar" size={15} />
                <span>Nueva Inscripción</span>
              </button>
            </div>
          </div>

          <!-- Reparto en campo: asignación del voluntariado por servicio y territorio.
               Sustituye a la banda de KPIs, que es lenguaje exclusivo del /dashboard. -->
          <section class="vol-reparto" aria-labelledby="volRepartoTitle">
            <header class="vol-reparto-head">
              <div>
                <h2 class="vol-reparto-title" id="volRepartoTitle">Reparto en campo</h2>
                <p class="vol-reparto-sub">Voluntariado asignado por servicio y distrito</p>
              </div>
              <p class="vol-reparto-total"><span id="volRepartoTotal">8</span> en el padrón · <span id="volRepartoPausa">0</span> en pausa</p>
            </header>
            <div class="vol-reparto-bar" role="img" aria-label="Composición del voluntariado por servicio">
              <span class="vol-reparto-seg vol-reparto-seg--food" id="volRepartoBarFood" style="width: 50%;"></span>
              <span class="vol-reparto-seg vol-reparto-seg--casita" id="volRepartoBarCasita" style="width: 37.5%;"></span>
              <span class="vol-reparto-seg vol-reparto-seg--asp" id="volRepartoBarAsp" style="width: 12.5%;"></span>
              <span class="vol-reparto-seg vol-reparto-seg--otros" id="volRepartoBarOtros" style="width: 0%;" hidden></span>
            </div>
            <ul class="vol-reparto-list">
              <li class="vol-reparto-row">
                <span class="vol-reparto-dot vol-reparto-dot--food" aria-hidden="true"></span>
                <span class="vol-reparto-name">Desayuno Infantil</span>
                <span class="vol-reparto-detail">Desayunos e iglesias aliadas</span>
                <span class="vol-reparto-count"><strong class="vol-reparto-pct" id="volRepartoPctDesayuno">No disponible</strong> · <span id="volRepartoDesayuno">4</span> asignadas</span>
              </li>
              <li class="vol-reparto-row">
                <span class="vol-reparto-dot vol-reparto-dot--casita" aria-hidden="true"></span>
                <span class="vol-reparto-name">Casita del Saber</span>
                <span class="vol-reparto-detail">Acompañamiento y biblioteca</span>
                <span class="vol-reparto-count"><strong class="vol-reparto-pct" id="volRepartoPctCasita">No disponible</strong> · <span id="volRepartoCasita">3</span> asignadas</span>
              </li>
              <li class="vol-reparto-row">
                <span class="vol-reparto-dot vol-reparto-dot--asp" aria-hidden="true"></span>
                <span class="vol-reparto-name">Área Social Pastoral</span>
                <span class="vol-reparto-detail">Derivaciones y visitas</span>
                <span class="vol-reparto-count"><strong class="vol-reparto-pct" id="volRepartoPctAsp">No disponible</strong> · <span id="volRepartoAsp">1</span> asignada</span>
              </li>
              <li class="vol-reparto-row" id="volRepartoRowOtros" hidden>
                <span class="vol-reparto-dot vol-reparto-dot--otros" aria-hidden="true"></span>
                <span class="vol-reparto-name">Otros servicios</span>
                <span class="vol-reparto-detail">Talleres y otros</span>
                <span class="vol-reparto-count"><strong class="vol-reparto-pct" id="volRepartoPctOtros">0%</strong> · <span id="volRepartoOtros">0</span> asignadas</span>
              </li>
            </ul>
            <footer class="vol-reparto-foot">
              <dl class="vol-reparto-terr">
                <div><dt>Comas</dt><dd id="volRepartoComas">5</dd></div>
                <div><dt>Carabayllo</dt><dd id="volRepartoCarabayllo">3</dd></div>
              </dl>
              <p class="vol-reparto-note"><span id="volRepartoCanastas">18</span> canastas de estímulo por labor comunitaria</p>
            </footer>
          </section>

          <!-- Panel de Talleres Productivos de Repostería -->
          <section class="card rep-panel" id="panelTalleresReposteria" hidden aria-labelledby="repPanelTitle">
            <div class="rep-panel-header">
              <div>
                <h2 class="card-title" id="repPanelTitle" style="margin: 0; font-size: 16px;">
                  Talleres Productivos de Repostería y Panadería
                </h2>
                <p style="font-size: 12.5px; color: var(--text-muted); margin: 4px 0 0 0;">
                  Registro de sesiones prácticas con comités de madres, maestras reposteras y producción de refrigerios saludables.
                </p>
              </div>
              <button type="button" class="btn-action secondary pdi-motion" id="btnCerrarTalleresReposteria">
                <Icon name="accion.cerrar" size={14} />
                <span>Ocultar</span>
              </button>
            </div>

            <div class="rep-stats-row">
              <div class="rep-stat-card">
                <span class="rep-stat-label">Talleres Realizados</span>
                <span class="rep-stat-val" id="statRepTalleres">0</span>
              </div>
              <div class="rep-stat-card">
                <span class="rep-stat-label">Madres / Participantes</span>
                <span class="rep-stat-val" id="statRepMadres">0</span>
              </div>
              <div class="rep-stat-card">
                <span class="rep-stat-label">Porciones / Refrigerios</span>
                <span class="rep-stat-val" id="statRepPorciones">0</span>
              </div>
            </div>

            <form id="formTallerReposteria" class="rep-form-grid" novalidate>
              <div class="rep-form-row-3">
                <div class="form-group">
                  <label for="repFecha" class="form-label">Fecha de Taller <span class="req">*</span></label>
                  <input type="date" id="repFecha" class="form-control" required />
                </div>
                <div class="form-group">
                  <label for="repSede" class="form-label">Sede Territorial <span class="req">*</span></label>
                  <select id="repSede" class="form-control" required>
                    <option value="">Seleccionar sede...</option>
                    {SEDES_OPERATIVAS.map((s) => (
                      <option value={s.nombre}>{s.etiqueta}</option>
                    ))}
                  </select>
                </div>
                <div class="form-group">
                  <label for="repComite" class="form-label">Comité / Local Anfitrión</label>
                  <input type="text" id="repComite" class="form-control" list="datalistComitesRep" placeholder="Buscar comedor, iglesia o comité..." autocomplete="off" />
                  <datalist id="datalistComitesRep"></datalist>
                </div>
              </div>

              <div class="form-group">
                <label class="form-label">Línea Productiva del Taller <span class="req">*</span></label>
                <div class="rep-tematicas-grid">
                  <label class="rep-tematica-pill">
                    <input type="radio" name="repTematica" value="panaderia" checked />
                    <span>Panadería y Masas Saludables</span>
                  </label>
                  <label class="rep-tematica-pill">
                    <input type="radio" name="repTematica" value="reposteria_nutritiva" />
                    <span>Repostería Nutritiva (Hierro)</span>
                  </label>
                  <label class="rep-tematica-pill">
                    <input type="radio" name="repTematica" value="higiene" />
                    <span>Higiene Alimentaria</span>
                  </label>
                  <label class="rep-tematica-pill">
                    <input type="radio" name="repTematica" value="emprendimiento" />
                    <span>Costos y Emprendimiento</span>
                  </label>
                </div>
              </div>

              <div class="rep-form-row-3">
                <div class="form-group">
                  <label for="repMadres" class="form-label"># Madres / Participantes</label>
                  <input type="number" id="repMadres" class="form-control" min="0" value="0" />
                </div>
                <div class="form-group">
                  <label for="repPorciones" class="form-label"># Porciones / Refrigerios</label>
                  <input type="number" id="repPorciones" class="form-control" min="0" value="0" />
                </div>
                <div class="form-group">
                  <label for="repDestino" class="form-label">Destino de Producción</label>
                  <select id="repDestino" class="form-control">
                    <option value="Consumo Desayuno PDI">Consumo Desayuno PDI</option>
                    <option value="Emprendimiento / Venta">Emprendimiento / Venta</option>
                    <option value="Mixto (PDI y Emprendimiento)">Mixto (PDI y Emprendimiento)</option>
                  </select>
                </div>
              </div>

              <div class="form-group">
                <label for="repMaestra" class="form-label">Maestra Repostera / Responsable</label>
                <input type="text" id="repMaestra" class="form-control" list="datalistMaestrasRep" placeholder="Buscar voluntaria repostera o facilitadora..." autocomplete="off" />
                <datalist id="datalistMaestrasRep"></datalist>
              </div>

              <div class="form-group">
                <label for="repObservaciones" class="form-label">Insumos y Observaciones</label>
                <textarea id="repObservaciones" class="form-control" rows="2" maxlength="300" placeholder="Receta elaborada, insumos utilizados o acuerdos del comité de madres..."></textarea>
              </div>

              <div style="display: flex; justify-content: flex-end;">
                <button type="submit" class="btn-action primary pdi-motion">
                  <Icon name="accion.confirmar" size={16} />
                  <span>Registrar Taller de Repostería</span>
                </button>
              </div>
            </form>

            <div class="table-container desktop-table-view" style="margin-top: 18px;">
              <table class="data-table">
                <thead>
                  <tr>
                    <th style="width: 11%;">Fecha</th>
                    <th style="width: 15%;">Sede & Distrito</th>
                    <th style="width: 31%;">Línea Productiva y Destino</th>
                    <th style="width: 19%;">Comité / Local</th>
                    <th style="width: 12%; text-align: center;">Producción</th>
                    <th style="width: 12%;">Maestra</th>
                  </tr>
                </thead>
                <tbody id="tbodyTalleresReposteria"></tbody>
              </table>
            </div>
          </section>

          <!-- Barra de Filtros y Búsqueda Rápida de Voluntariados -->
          <div class="card" id="cardVoluntariosPadron" style="position: relative; z-index: 80;">
            <div class="audit-toolbar table-toolbar">
              <div class="audit-search-wrap">
                <Icon name="accion.buscar" size={2} class="audit-search-icon" />
                <input type="text" id="inputVoluntariosSearch" class="audit-search-input" placeholder="Buscar..." aria-label="Buscar por nombre, DNI, código, sede o rol" title="Buscar por nombre, DNI, código, sede o rol">
                <button type="button" class="audit-search-clear" id="btnVoluntariosSearchClear" data-pdi-on="click" data-pdi-h="h172" style="display: none;" title="Limpiar búsqueda">
                  <Icon name="accion.cerrar" size={12} />
                </button>
              </div>

              <SortMenu id="VoluntariosSort" options={OPCIONES_ORDEN_VOLUNTARIOS} selected="apellido-asc" />

              <!-- Filtro Popover Dropdown -->
              <FilterPanel
                id="dropdownVoluntariosFilterPanel"
                buttonId="btnDropdownVoluntariosFilterPanel"
                menuId="menuVoluntariosFilterPanel"
                countId="voluntariosActiveFiltersCount"
                title="Filtros de Voluntariados"
                reset="window.resetVoluntariosFilters ? window.resetVoluntariosFilters() : null"
              >
                      <!-- Filtro 1: Distrito (multiseleccion) -->
                      <FilterField
                        id="dropdownVoluntariosDistrito"
                        menuId="menuVoluntariosDistrito"
                        labelId="labelVoluntariosDistritoSelect"
                        label="Distrito"
                        prefix="Distrito:"
                        labelTodos="Todos los Distritos"
                        todosEtiqueta="Todos los Distritos"
                        opciones={OPCIONES_DISTRITO}
                        countPrefix="countFacetVoluntariosDistrito"
                        onSelect="window.toggleVoluntariosDistrito"
                        abrir="window.toggleVoluntariosInnerDropdown ? window.toggleVoluntariosInnerDropdown('dropdownVoluntariosDistrito') : null"
                      />
                      
                      <!-- Filtro 2: Servicio asignado (multiseleccion) -->
                      <FilterField
                        id="dropdownVoluntariosServicio"
                        menuId="menuVoluntariosServicio"
                        labelId="labelVoluntariosServicioSelect"
                        label="Servicio Asignado"
                        prefix="Servicio:"
                        labelTodos="Todos los Servicios"
                        todosEtiqueta="Todos los Servicios"
                        opciones={OPCIONES_SERVICIO}
                        countPrefix="countFacetVoluntariosServicio"
                        onSelect="window.toggleVoluntariosServicio"
                        abrir="window.toggleVoluntariosInnerDropdown ? window.toggleVoluntariosInnerDropdown('dropdownVoluntariosServicio') : null"
                      />
                      
                      <!-- Filtro 3: Rol en sede (multiseleccion) -->
                      <FilterField
                        id="dropdownVoluntariosRol"
                        menuId="menuVoluntariosRol"
                        labelId="labelVoluntariosRolSelect"
                        label="Rol en Sede"
                        prefix="Rol:"
                        labelTodos="Todos los Roles"
                        todosEtiqueta="Todos los Roles"
                        opciones={OPCIONES_ROL}
                        countPrefix="countFacetVoluntariosRol"
                        onSelect="window.toggleVoluntariosRol"
                        abrir="window.toggleVoluntariosInnerDropdown ? window.toggleVoluntariosInnerDropdown('dropdownVoluntariosRol') : null"
                      />
                      
                      <!-- Filtro 4: Estado de la voluntaria (seleccion unica con radio) -->
                      <FilterField
                        id="dropdownVoluntariosEstado"
                        menuId="menuVoluntariosEstado"
                        labelId="labelVoluntariosEstadoSelect"
                        label="Estado de la Voluntaria"
                        prefix="Estado:"
                        labelTodos="Todos los Estados"
                        todosEtiqueta="Todos los Estados"
                        opciones={OPCIONES_ESTADO}
                        tipo="single"
                        countPrefix="countFacetVoluntariosEstado"
                        onSelect="window.toggleVoluntariosEstado"
                        abrir="window.toggleVoluntariosInnerDropdown ? window.toggleVoluntariosInnerDropdown('dropdownVoluntariosEstado') : null"
                      />
              </FilterPanel>

              <button type="button" class="btn-action-icon btn-audit-export-icon table-export-btn pdi-motion" id="btnExportVoluntariosCSV"
                data-pdi-on="click" data-pdi-h="h173"
                aria-label="Descargar el padrón de voluntariados filtrado" title="Descargar el padrón filtrado">
                <Icon name="accion.descargar" size={18} />
              </button>
            </div>

            <!-- Chips Activos Bar -->
            <div class="padron-active-chips-bar" id="voluntariosActiveChipsBar">
              <span class="padron-active-chips-label">Filtros aplicados:</span>
              <div class="padron-active-chips-list" id="voluntariosActiveChipsList"
                style="display: flex; align-items: center; flex-wrap: wrap; gap: 6px;"></div>
              <button type="button" class="btn-text-subtle" style="margin-left: auto; font-size: 11.5px;"
                data-pdi-on="click" data-pdi-h="h178">
                Limpiar filtros
              </button>
            </div>

            <!-- Tabla PC -->
            <div class="table-responsive">
              <table class="data-table">
                <thead>
                  <tr>
                    <th>Voluntario(a) / DNI</th>
                    <th>Sede y Distrito</th>
                    <th>Servicio y Rol</th>
                    <th>Contacto</th>
                    <th>Capacitaciones</th>
                    <th>Estado</th>
                    <th>Acciones</th>
                  </tr>
                </thead>
                <tbody id="tbodyVoluntarios">
                  <tr id="voluntariosCargando">
                    <td colspan="7" style="text-align: center; padding: 32px; color: var(--text-dim);">
                      Cargando voluntarios…
                    </td>
                  </tr>
                </tbody>
              </table>
            </div>

            <!-- Tarjetas Móviles -->
            <div class="padron-mobile-cards" id="mobileCardsVoluntarios">
              <!-- Inyectado dinámicamente -->
            </div>

            <!-- Controles de Paginación de Voluntarios (PC / Móvil) -->
            <div class="padron-pagination-bar" id="voluntariosPaginationBar">
              <div class="padron-pagination-left">
                <span id="voluntariosPaginationInfo" style="font-size:12.5px; color:var(--text-muted); font-weight:500;">
                  Mostrando voluntarios…
                </span>
                <div class="padron-density-wrapper" id="voluntariosDensityWrapper"
                  style="display:flex; align-items:center; gap:6px;">
                  <span style="font-size:12px; color:var(--text-dim);">Mostrar:</span>
                  <select class="audit-density-select padron-density-select" id="selectVoluntariosPageSize"
                    data-pdi-on="change" data-pdi-h="h179">
                    <option value="10">10 por página</option>
                    <option value="20" selected>20 por página</option>
                    <option value="30">30 por página</option>
                    <option value="40">40 por página</option>
                    <option value="50">50 por página (Máx)</option>
                  </select>
                </div>
              </div>
              <div class="padron-pagination-right">
                <button type="button" class="btn-page" id="btnVoluntariosPagePrev"
                  data-pdi-on="click" data-pdi-h="h180">
                  <Icon name="accion.volver" size={14} />
                  <span>Anterior</span>
                </button>
                <span class="audit-page-indicator" id="voluntariosCurrentPageNum">Página 1</span>
                <button type="button" class="btn-page" id="btnVoluntariosPageNext"
                  data-pdi-on="click" data-pdi-h="h181">
                  <span>Siguiente</span>
                  <Icon name="accion.abrir" size={14} />
                </button>
              </div>
            </div>
          </div>
        </section>

  <script>
    import '../scripts/pages/voluntariados.js';
  </script>
</AppLayout>