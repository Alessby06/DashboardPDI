---
import AppLayout from '../layouts/AppLayout.astro';
import FilterPanel from '../components/FilterPanel.astro';
import FilterField from '../components/FilterField.astro';
import { OPCIONES_VOLUNTARIADO } from '../data/opcionesBeneficiario.js';
import '../styles/views-voluntariados.css';
import { SEDES_POR_DISTRITO } from '../scripts/core/catalogos.js';
import Icon from '../components/Icon.astro';

const OPCIONES_DISTRITO = Object.keys(SEDES_POR_DISTRITO).map((distrito) => ({ valor: distrito, etiqueta: distrito }));
const OPCIONES_SERVICIO = OPCIONES_VOLUNTARIADO.map((opcion) => ({ valor: opcion.valor, etiqueta: opcion.etiqueta }));
const OPCIONES_ROL = [
  'Voluntaria Responsable',
  'Voluntaria de Apoyo',
  'Acompañante Pedagógica',
  'Mediadora Lectora',
  'Pastoral Comunitario',
].map((rol) => ({ valor: rol, etiqueta: rol }));
const OPCIONES_ESTADO = [
  { valor: 'Activo', etiqueta: 'Activo' },
  { valor: 'En Pausa', etiqueta: 'En Pausa' },
];
---

<AppLayout title="Padrón de Voluntarios" currentPage="voluntariados">
        <section class="app-view active" id="view-voluntarios">
          <div class="view-header">
            <div class="view-title-group">
              <h2>Padrón de Voluntarios y Personal de Apoyo</h2>
              <p>Gestión de voluntarias de sede, promotoras de apoyo, capacitaciones oficiales y asignación territorial (Fichas A4, A5 y A6).</p>
            </div>
            <div class="view-actions">
              <button type="button" class="btn-action-icon btn-audit-export-icon" id="btnExportVoluntariosCSV"
                onclick="window.openModalExportVoluntarios ? window.openModalExportVoluntarios() : window.exportVoluntariosCSV()"
                aria-label="Descargar Padrón de Voluntariados CSV" title="Descargar Padrón de Voluntariados CSV">
                <Icon name="accion.descargar" size={18} />
              </button>
              <button type="button" class="btn-action primary" onclick="window.openInscripcionVoluntario ? window.openInscripcionVoluntario() : null" title="Registrar nueva voluntaria o personal de apoyo">
                <Icon name="accion.agregar" size={15} />
                <span>Nueva Inscripción</span>
              </button>
            </div>
          </div>

          <!-- Reparto en campo: asignación del voluntariado por servicio y territorio.
               Sustituye a la banda de KPIs, que es lenguaje exclusivo del /dashboard. -->
          <section class="vol-reparto" aria-labelledby="volRepartoTitle">
            <header class="vol-reparto-head">
              <div>
                <h3 class="vol-reparto-title" id="volRepartoTitle">Reparto en campo</h3>
                <p class="vol-reparto-sub">Voluntariado asignado por servicio y distrito</p>
              </div>
              <p class="vol-reparto-total"><span id="volRepartoTotal">8</span> en el padrón · <span id="volRepartoPausa">0</span> en pausa</p>
            </header>
            <div class="vol-reparto-bar" role="img" aria-label="Composición del voluntariado por servicio">
              <span class="vol-reparto-seg vol-reparto-seg--food" id="volRepartoBarFood" style="width: 50%;"></span>
              <span class="vol-reparto-seg vol-reparto-seg--casita" id="volRepartoBarCasita" style="width: 37.5%;"></span>
              <span class="vol-reparto-seg vol-reparto-seg--asp" id="volRepartoBarAsp" style="width: 12.5%;"></span>
              <span class="vol-reparto-seg vol-reparto-seg--otros" id="volRepartoBarOtros" style="width: 0%;" hidden></span>
            </div>
            <ul class="vol-reparto-list">
              <li class="vol-reparto-row">
                <span class="vol-reparto-dot vol-reparto-dot--food" aria-hidden="true"></span>
                <span class="vol-reparto-name">Servicio Alimentario</span>
                <span class="vol-reparto-detail">Desayunos e iglesias aliadas</span>
                <span class="vol-reparto-count"><strong class="vol-reparto-pct" id="volRepartoPctDesayuno">—</strong> · <span id="volRepartoDesayuno">4</span> asignadas</span>
              </li>
              <li class="vol-reparto-row">
                <span class="vol-reparto-dot vol-reparto-dot--casita" aria-hidden="true"></span>
                <span class="vol-reparto-name">Casita del Saber</span>
                <span class="vol-reparto-detail">Acompañamiento y biblioteca</span>
                <span class="vol-reparto-count"><strong class="vol-reparto-pct" id="volRepartoPctCasita">—</strong> · <span id="volRepartoCasita">3</span> asignadas</span>
              </li>
              <li class="vol-reparto-row">
                <span class="vol-reparto-dot vol-reparto-dot--asp" aria-hidden="true"></span>
                <span class="vol-reparto-name">Área Social Pastoral</span>
                <span class="vol-reparto-detail">Derivaciones y visitas</span>
                <span class="vol-reparto-count"><strong class="vol-reparto-pct" id="volRepartoPctAsp">—</strong> · <span id="volRepartoAsp">1</span> asignada</span>
              </li>
              <li class="vol-reparto-row" id="volRepartoRowOtros" hidden>
                <span class="vol-reparto-dot vol-reparto-dot--otros" aria-hidden="true"></span>
                <span class="vol-reparto-name">Otros servicios</span>
                <span class="vol-reparto-detail">Biblioteca y talleres</span>
                <span class="vol-reparto-count"><strong class="vol-reparto-pct" id="volRepartoPctOtros">0%</strong> · <span id="volRepartoOtros">0</span> asignadas</span>
              </li>
            </ul>
            <footer class="vol-reparto-foot">
              <dl class="vol-reparto-terr">
                <div><dt>Comas</dt><dd id="volRepartoComas">5</dd></div>
                <div><dt>Carabayllo</dt><dd id="volRepartoCarabayllo">3</dd></div>
              </dl>
              <p class="vol-reparto-note"><span id="volRepartoCanastas">18</span> canastas de estímulo por labor comunitaria</p>
            </footer>
          </section>
          <!-- Barra de Filtros y Búsqueda Rápida de Voluntariados -->
          <div class="card" id="cardVoluntariosPadron" style="position: relative; z-index: 80;">
            <div class="audit-toolbar">
              <div class="audit-search-wrap">
                <Icon name="accion.buscar" size={2} class="audit-search-icon" />
                <input type="text" id="inputVoluntariosSearch" class="audit-search-input" placeholder="Buscar..." aria-label="Buscar por nombre, DNI, código, sede o rol" title="Buscar por nombre, DNI, código, sede o rol">
                <button type="button" class="audit-search-clear" id="btnVoluntariosSearchClear" onclick="window.clearVoluntariosSearch ? window.clearVoluntariosSearch() : (window.PDI?.VoluntariadosView?.clearSearch ? window.PDI.VoluntariadosView.clearSearch() : null)" style="display: none;" title="Limpiar búsqueda">
                  <Icon name="accion.cerrar" size={12} />
                </button>
              </div>

              <!-- Filtro Popover Dropdown -->
              <FilterPanel
                id="dropdownVoluntariosFilterPanel"
                buttonId="btnDropdownVoluntariosFilterPanel"
                menuId="menuVoluntariosFilterPanel"
                badgeId="voluntariosActiveFiltersCount"
                title="Filtros de Voluntariados"
                reset="window.resetVoluntariosFilters ? window.resetVoluntariosFilters() : null"
              >
                      <!-- Filtro 1: Distrito (multiseleccion) -->
                      <FilterField
                        id="dropdownVoluntariosDistrito"
                        menuId="menuVoluntariosDistrito"
                        labelId="labelVoluntariosDistritoSelect"
                        label="Distrito"
                        labelTodos="Todos los Distritos"
                        todosEtiqueta="Todos los Distritos"
                        opciones={OPCIONES_DISTRITO}
                        countPrefix="countFacetVoluntariosDistrito"
                        onSelect="window.toggleVoluntariosDistrito"
                        abrir="window.toggleVoluntariosInnerDropdown ? window.toggleVoluntariosInnerDropdown('dropdownVoluntariosDistrito') : null"
                      />
                      
                      <!-- Filtro 2: Servicio asignado (multiseleccion) -->
                      <FilterField
                        id="dropdownVoluntariosServicio"
                        menuId="menuVoluntariosServicio"
                        labelId="labelVoluntariosServicioSelect"
                        label="Servicio Asignado"
                        labelTodos="Todos los Servicios"
                        todosEtiqueta="Todos los Servicios"
                        opciones={OPCIONES_SERVICIO}
                        countPrefix="countFacetVoluntariosServicio"
                        onSelect="window.toggleVoluntariosServicio"
                        abrir="window.toggleVoluntariosInnerDropdown ? window.toggleVoluntariosInnerDropdown('dropdownVoluntariosServicio') : null"
                      />
                      
                      <!-- Filtro 3: Rol en sede (multiseleccion) -->
                      <FilterField
                        id="dropdownVoluntariosRol"
                        menuId="menuVoluntariosRol"
                        labelId="labelVoluntariosRolSelect"
                        label="Rol en Sede"
                        labelTodos="Todos los Roles"
                        todosEtiqueta="Todos los Roles"
                        opciones={OPCIONES_ROL}
                        countPrefix="countFacetVoluntariosRol"
                        onSelect="window.toggleVoluntariosRol"
                        abrir="window.toggleVoluntariosInnerDropdown ? window.toggleVoluntariosInnerDropdown('dropdownVoluntariosRol') : null"
                      />
                      
                      <!-- Filtro 4: Estado de la voluntaria (seleccion unica con radio) -->
                      <FilterField
                        id="dropdownVoluntariosEstado"
                        menuId="menuVoluntariosEstado"
                        labelId="labelVoluntariosEstadoSelect"
                        label="Estado de la Voluntaria"
                        labelTodos="Todos los Estados"
                        todosEtiqueta="Todos los Estados"
                        opciones={OPCIONES_ESTADO}
                        tipo="single"
                        countPrefix="countFacetVoluntariosEstado"
                        onSelect="window.toggleVoluntariosEstado"
                        abrir="window.toggleVoluntariosInnerDropdown ? window.toggleVoluntariosInnerDropdown('dropdownVoluntariosEstado') : null"
                      />
                              </FilterPanel>
            </div>

            <!-- Chips Activos Bar -->
            <div class="padron-active-chips-bar" id="voluntariosActiveChipsBar">
              <span class="padron-active-chips-label">Filtros aplicados:</span>
              <div class="padron-active-chips-list" id="voluntariosActiveChipsList"
                style="display: flex; align-items: center; flex-wrap: wrap; gap: 6px;"></div>
              <button type="button" class="btn-text-subtle" style="margin-left: auto; font-size: 11.5px;"
                onclick="window.resetVoluntariosFilters ? window.resetVoluntariosFilters() : null">
                Limpiar filtros
              </button>
            </div>

            <!-- Tabla PC -->
            <div class="table-responsive">
              <table class="data-table">
                <thead>
                  <tr>
                    <th>Voluntario(a) / DNI</th>
                    <th>Sede y Distrito</th>
                    <th>Servicio y Rol</th>
                    <th>Contacto</th>
                    <th>Capacitaciones</th>
                    <th>Estado</th>
                    <th>Acciones</th>
                  </tr>
                </thead>
                <tbody id="tbodyVoluntarios">
                  <!-- Inyectado dinámicamente -->
                </tbody>
              </table>
            </div>

            <!-- Tarjetas Móviles -->
            <div class="padron-mobile-cards" id="mobileCardsVoluntarios">
              <!-- Inyectado dinámicamente -->
            </div>

            <!-- Controles de Paginación de Voluntarios (PC / Móvil) -->
            <div class="padron-pagination-bar" id="voluntariosPaginationBar">
              <div class="padron-pagination-left">
                <span id="voluntariosPaginationInfo" style="font-size:12.5px; color:var(--text-muted); font-weight:500;">
                  Mostrando 0 de 0 voluntarios
                </span>
                <div class="padron-density-wrapper" id="voluntariosDensityWrapper"
                  style="display:flex; align-items:center; gap:6px;">
                  <span style="font-size:12px; color:var(--text-dim);">Mostrar:</span>
                  <select class="audit-density-select padron-density-select" id="selectVoluntariosPageSize"
                    onchange="window.voluntariosSetPageSize ? window.voluntariosSetPageSize(this.value) : (window.PDI?.VoluntariadosView?.setPageSize ? window.PDI.VoluntariadosView.setPageSize(this.value) : null)">
                    <option value="10">10 por página</option>
                    <option value="20" selected>20 por página</option>
                    <option value="50">50 por página (Máx)</option>
                  </select>
                </div>
              </div>
              <div class="padron-pagination-right">
                <button type="button" class="btn-page" id="btnVoluntariosPagePrev"
                  onclick="window.voluntariosPrevPage ? window.voluntariosPrevPage() : (window.PDI?.VoluntariadosView?.prevPage ? window.PDI.VoluntariadosView.prevPage() : null)">
                  <Icon name="accion.volver" size={14} />
                  <span>Anterior</span>
                </button>
                <span class="audit-page-indicator" id="voluntariosCurrentPageNum">Página 1</span>
                <button type="button" class="btn-page" id="btnVoluntariosPageNext"
                  onclick="window.voluntariosNextPage ? window.voluntariosNextPage() : (window.PDI?.VoluntariadosView?.nextPage ? window.PDI.VoluntariadosView.nextPage() : null)">
                  <span>Siguiente</span>
                  <Icon name="accion.abrir" size={14} />
                </button>
              </div>
            </div>
          </div>
        </section>

  <script>
    import '../scripts/pages/voluntariados.js';
  </script>
</AppLayout>