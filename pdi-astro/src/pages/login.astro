---
import Icon from '../components/Icon.astro';
import '../styles/fonts.css';
// Login page — Versión Definitiva con diseño artesanal (Craft & Human-First)
// Basado en /frontend-design y /interface-design para el Sistema PDI — ACJG

// Edicion visual en vivo de impeccable: mismo toggle que AppLayout. La
// inyeccion de live.js solo entra en dev y con la llave activa; el build de
// produccion nunca lleva la URL de localhost.
const impeccableLive =
  String(import.meta.env.PUBLIC_IMPECCABLE_LIVE ?? 'true').toLowerCase() !== 'false';

const soporteEmail = String(import.meta.env.PUBLIC_SOPORTE_EMAIL || '').trim();
---
<!doctype html>
<html lang="es">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover" />
  <meta name="description" content="Sistema PDI — Portal de gestión y seguimiento del Programa de Desarrollo Integral de la Asociación Cultural Johannes Gutenberg." />
  <title>Acceso al Sistema | PDI — Johannes Gutenberg</title>
  <link rel="icon" type="image/png" href="/assets/jg-icon.png" />
  <link rel="apple-touch-icon" href="/assets/jg-icon.png" />
  <meta name="theme-color" id="metaThemeColor" content="#f2ece1" />

  <script is:inline>
    /* Antiflash: aplica tema antes del primer render para evitar FOUC */
    (function () {
      try {
        var saved = localStorage.getItem("pdi_theme") || "light";
        var oscuro = saved === "dark" ||
          (saved === "system" && window.matchMedia("(prefers-color-scheme: dark)").matches);
        document.documentElement.setAttribute("data-theme", oscuro ? "dark" : "light");
        var meta = document.getElementById("metaThemeColor");
        if (meta) meta.setAttribute("content", oscuro ? "#12110f" : "#f2ece1");
      } catch (e) {}
    })();

    /* Antiflash de sesion: el chequeo "ya estas logueado" debe correr ANTES del
       primer paint. Antes vivia en el script de modulo del final del body, que
       es diferido: el login se pintaba entero y unos segundos despues saltaba
       al dashboard (el destello al recargar o reabrir la ventana). Mismas claves
       que valida haySesion() / AppLayout. Fallo conservador: sin sesion clara
       el login se queda quieto. */
    (function () {
      try {
        var sesionActiva = localStorage.getItem("pdi_sesion_activa");
        var login = localStorage.getItem("pdi_usuario_login");
        var exp = parseInt(localStorage.getItem("pdi_session_exp"), 10);
        if (sesionActiva === "1" && login && exp && Date.now() < exp) {
          window.location.replace("/dashboard");
          return;
        }
      } catch (e) {}
    })();
  </script>

  <style>
    /* =========================================================================
       ACCESO · composición centrada
       Una sola paleta cálida, un solo componente de formulario. La marca
       acompaña; la tarea de ingresar es lo primero.
       ========================================================================= */

    :root {
      --paper: #f2ece1;
      --surface: #fbf8f1;
      --surface-2: #efe8db;
      --ink: #1b1a17;
      --body: #5c574d;
      --muted: #6f685c;
      --line: #e0d8c9;
      --line-2: #cfc5b2;
      --brand: #00715d;
      --brand-hover: #005c4b;
      --brand-soft: #d9efe8;
      --brand-ink: #00594a;
      --on-brand: #ffffff;
      --danger: #b91c1c;
      --danger-soft: #fbe9e7;
      --focus: #00715d;
      --shadow-card: 0 1px 0 rgba(27, 26, 23, 0.03), 0 28px 56px -32px rgba(27, 26, 23, 0.32);
      color-scheme: light;
    }

    [data-theme="dark"] {
      --paper: #12110f;
      --surface: #1b1915;
      --surface-2: #191713;
      --ink: #f4efe5;
      --body: #c9c2b4;
      --muted: #a39b8c;
      --line: #2f2b25;
      --line-2: #3d3830;
      --brand: #2ee6a0;
      --brand-hover: #6bffc4;
      --brand-soft: rgba(46, 230, 160, 0.12);
      --brand-ink: #8bf2c8;
      --on-brand: #00130c;
      --danger: #ff8b8b;
      --danger-soft: rgba(239, 68, 68, 0.12);
      --focus: #2ee6a0;
      --shadow-card: 0 1px 0 rgba(0, 0, 0, 0.5), 0 28px 56px -32px rgba(0, 0, 0, 0.75);
      color-scheme: dark;
    }

    *,
    *::before,
    *::after {
      box-sizing: border-box;
    }

    html,
    body {
      min-height: 100%;
    }

    body {
      margin: 0;
      background: var(--paper);
      color: var(--body);
      font-family: "Manrope", system-ui, -apple-system, "Segoe UI", sans-serif;
      font-size: 15px;
      line-height: 1.55;
      -webkit-font-smoothing: antialiased;
      text-rendering: optimizeLegibility;
    }

    h1,
    h2,
    p {
      margin: 0;
    }

    button,
    input {
      font: inherit;
      color: inherit;
    }

    button {
      cursor: pointer;
    }

    img,
    svg {
      display: block;
    }

    [hidden] {
      display: none !important;
    }

    :focus-visible {
      outline: 2px solid var(--focus);
      outline-offset: 2px;
      border-radius: 8px;
    }

    /* --- Cabecera --------------------------------------------------------- */
    .top {
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: 16px;
      max-width: 1160px;
      margin: 0 auto;
      padding: 26px 40px;
    }

    .brand {
      display: flex;
      align-items: center;
      gap: 14px;
    }

    .brand .emblem {
      width: 44px;
      height: 44px;
      flex: 0 0 44px;
      border-radius: 12px;
    }

    .brand strong {
      display: block;
      font-size: 13.5px;
      font-weight: 700;
      line-height: 1.3;
      color: var(--ink);
    }

    .brand span {
      display: block;
      margin-top: 3px;
      font-size: 10.5px;
      font-weight: 600;
      letter-spacing: 0.07em;
      text-transform: uppercase;
      color: var(--muted);
    }

    .theme {
      display: inline-flex;
      align-items: center;
      gap: 8px;
      height: 44px;
      padding: 0 14px;
      border: 1px solid var(--line);
      border-radius: 999px;
      background: var(--surface);
      color: var(--body);
      font-size: 12px;
      font-weight: 600;
      transition: border-color 0.16s ease, color 0.16s ease, background-color 0.16s ease;
    }

    /* --- Tarjeta de acceso ----------------------------------------------- */
    .stage {
      display: flex;
      justify-content: center;
      padding: 18px 40px 0;
    }

    .card {
      width: min(100%, 520px);
      padding: 40px;
      border: 1px solid var(--line);
      border-radius: 20px;
      background: var(--surface);
      box-shadow: var(--shadow-card);
      animation: rise 0.42s cubic-bezier(0.23, 1, 0.32, 1) both;
    }

    .eyebrow {
      font-size: 10.5px;
      font-weight: 700;
      letter-spacing: 0.1em;
      text-transform: uppercase;
      color: var(--muted);
    }

    .card h1 {
      margin-top: 10px;
      font-size: 40px;
      line-height: 1.08;
      letter-spacing: -0.035em;
      font-weight: 700;
      color: var(--ink);
      text-wrap: balance;
    }

    .sub {
      margin-top: 14px;
      max-width: 38ch;
      font-size: 15.5px;
      line-height: 1.55;
    }

    /* --- Formulario ------------------------------------------------------ */
    .form {
      display: flex;
      flex-direction: column;
      gap: 18px;
      margin-top: 30px;
    }

    .field {
      display: flex;
      flex-direction: column;
      gap: 8px;
    }

    .field label {
      font-size: 12.5px;
      font-weight: 700;
      letter-spacing: 0.01em;
      color: var(--ink);
    }

    .control {
      position: relative;
      display: flex;
      align-items: center;
      height: 48px;
      border-bottom: 1px solid var(--line-2);
      transition: border-color 0.16s ease;
    }

    .control:focus-within {
      border-bottom-color: var(--brand);
    }

    .control:has(input:focus-visible) {
      outline: 2px solid var(--focus);
      outline-offset: 2px;
      border-radius: 8px;
    }

    .control:has(input[aria-invalid="true"]) {
      border-bottom-color: var(--danger);
    }

    .control:has(input[aria-invalid="true"]) .lead {
      color: var(--danger);
    }

    .control:has(input[aria-invalid="true"]:focus-visible) {
      outline-color: var(--danger);
    }

    .control .lead {
      position: absolute;
      left: 2px;
      color: var(--muted);
      pointer-events: none;
      transition: color 0.16s ease;
    }

    .control:focus-within .lead {
      color: var(--brand);
    }

    .control input {
      width: 100%;
      height: 100%;
      padding: 0 46px 0 34px;
      border: 0;
      background: transparent;
      color: var(--ink);
      font-size: 16px;
      outline: none;
    }

    .control input::placeholder {
      color: var(--muted);
      opacity: 0.72;
    }

    .eye {
      position: absolute;
      right: 0;
      display: grid;
      place-items: center;
      width: 44px;
      height: 44px;
      border: 0;
      border-radius: 8px;
      background: transparent;
      color: var(--muted);
      transition: color 0.16s ease;
    }

    #iconPassEye {
      display: flex;
    }

    /* --- Error ----------------------------------------------------------- */
    .status-error-callout {
      display: none;
      align-items: flex-start;
      gap: 10px;
      padding: 12px 14px;
      border-left: 3px solid var(--danger);
      border-radius: 0 8px 8px 0;
      background: var(--danger-soft);
      color: var(--danger);
      font-size: 12.5px;
      line-height: 1.45;
    }

    .status-error-callout.visible {
      display: flex;
    }

    .status-error-callout svg {
      flex: 0 0 16px;
      margin-top: 1px;
    }

    .recovery {
      display: flex;
      align-items: center;
      flex-wrap: wrap;
      gap: 2px 6px;
      margin-top: -2px;
      font-size: 12.5px;
      color: var(--muted);
    }

    .recovery-link {
      display: inline-flex;
      align-items: center;
      min-height: 44px;
      padding: 0 2px;
      border: 0;
      background: transparent;
      color: var(--brand-ink);
      font: inherit;
      font-weight: 700;
      text-decoration: underline;
      text-underline-offset: 3px;
      cursor: pointer;
    }

    /* --- Botón ----------------------------------------------------------- */
    .btn-primary-action {
      position: relative;
      display: inline-flex;
      align-items: center;
      justify-content: center;
      gap: 10px;
      width: 100%;
      height: 52px;
      border: 0;
      border-radius: 12px;
      background: var(--brand);
      color: var(--on-brand);
      font-size: 15px;
      font-weight: 700;
      letter-spacing: 0.01em;
      transition: background-color 0.16s ease, transform 0.12s ease, opacity 0.16s ease;
    }

    .btn-primary-action:active {
      transform: scale(0.985);
    }

    .btn-primary-action:disabled {
      opacity: 0.72;
      cursor: progress;
    }

    .btn-spinner {
      display: none;
      width: 16px;
      height: 16px;
      border: 2px solid color-mix(in srgb, var(--on-brand) 30%, transparent);
      border-top-color: var(--on-brand);
      border-radius: 50%;
      animation: spin 0.7s linear infinite;
    }

    .btn-primary-action.loading .btn-spinner {
      display: block;
    }

    .btn-primary-action.loading .btn-label {
      opacity: 0.75;
    }

    @keyframes spin {
      to {
        transform: rotate(360deg);
      }
    }

    /* --- Acceso rápido (temporal, hasta el 5 de diciembre) --------------- */
    .quick {
      margin-top: 34px;
      padding-top: 20px;
      border-top: 1px solid var(--line);
    }

    .quick-head {
      display: flex;
      align-items: baseline;
      justify-content: space-between;
      gap: 12px;
      margin-bottom: 12px;
    }

    .quick-title {
      font-size: 10.5px;
      font-weight: 700;
      letter-spacing: 0.1em;
      text-transform: uppercase;
      color: var(--muted);
    }

    .quick-note {
      font-size: 11px;
      color: var(--muted);
      opacity: 0.85;
    }

    .chips {
      display: grid;
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: 8px;
    }

    .chip {
      display: flex;
      align-items: center;
      justify-content: center;
      height: 44px;
      padding: 0 10px;
      border: 1px solid var(--line);
      border-radius: 10px;
      background: var(--paper);
      color: var(--ink);
      font-size: 12.5px;
      font-weight: 600;
      text-align: center;
      transition: border-color 0.16s ease, background-color 0.16s ease, color 0.16s ease;
    }

    .chip.active,
    .chip[aria-pressed="true"] {
      border-color: color-mix(in srgb, var(--brand) 45%, var(--line));
      background: var(--brand-soft);
      color: var(--brand-ink);
      font-weight: 700;
    }

    .chip:last-child:nth-child(odd) {
      grid-column: 1 / -1;
    }

    /* --- Banda de módulos ------------------------------------------------ */
    .band {
      display: grid;
      grid-template-columns: repeat(4, 1fr);
      max-width: 1040px;
      margin: 52px auto 0;
      padding: 0 40px;
      border-top: 1px solid var(--line);
    }

    .mod {
      padding: 20px 22px 0 0;
    }

    .mod .ico {
      margin-bottom: 10px;
      color: var(--muted);
    }

    .mod b {
      display: block;
      font-size: 13px;
      font-weight: 700;
      color: var(--ink);
    }

    .mod span {
      display: block;
      margin-top: 4px;
      font-size: 12px;
      line-height: 1.45;
      color: var(--muted);
    }

    /* --- Pie ------------------------------------------------------------- */
    .foot {
      display: flex;
      justify-content: space-between;
      gap: 12px;
      max-width: 1160px;
      margin: 34px auto 0;
      padding: 18px 40px 28px;
      border-top: 1px solid var(--line);
      font-size: 11.5px;
      color: var(--muted);
    }

    @keyframes rise {
      from {
        opacity: 0;
        transform: translateY(10px);
      }
    }

    /* --- Interacción ----------------------------------------------------- */
    @media (hover: hover) and (pointer: fine) {
      .theme:hover {
        border-color: var(--line-2);
        color: var(--ink);
      }

      .eye:hover {
        color: var(--ink);
      }

      .chip:hover {
        border-color: var(--line-2);
      }

      .btn-primary-action:hover {
        background: var(--brand-hover);
      }
    }

    @media (prefers-reduced-motion: reduce) {
      .card {
        animation: none;
      }

      .btn-primary-action,
      .eye,
      .theme,
      .chip,
      .control,
      .btn-spinner {
        transition-duration: 0.01ms !important;
        animation-duration: 0.01ms !important;
      }
    }

    /* --- Ajuste por altura ------------------------------------------------
       El login no debe pedir scroll. Si la pantalla no puede contener la
       composición completa (tarjeta + banda + pie), la tarjeta se queda sola
       y centrada; la banda y el pie vuelven en pantallas altas. */
    @media (max-height: 1155px) {
      .top {
        padding: 10px 40px;
      }

      .stage {
        min-height: calc(100vh - 64px);
        align-items: center;
        padding: 0 40px;
      }

      .band,
      .foot {
        display: none;
      }
    }

    @media (max-height: 839px) and (min-width: 521px) {
      .card {
        padding: 32px;
      }

      .card h1 {
        font-size: 36px;
      }

      .form {
        gap: 16px;
        margin-top: 24px;
      }

      .quick {
        margin-top: 24px;
        padding-top: 16px;
      }

      .chips {
        grid-template-columns: repeat(3, minmax(0, 1fr));
      }

      .chip:last-child:nth-child(odd) {
        grid-column: auto;
      }
    }

    /* --- Responsive ------------------------------------------------------ */
    @media (max-width: 820px) {
      .top,
      .stage,
      .band,
      .foot {
        padding-left: 24px;
        padding-right: 24px;
      }

      .stage {
        padding-top: 10px;
      }

      .card {
        padding: 28px;
        border-radius: 16px;
      }

      .card h1 {
        font-size: 32px;
      }

      .band {
        grid-template-columns: 1fr 1fr;
        gap: 0 20px;
      }

      .mod {
        padding-right: 0;
      }

      .foot {
        flex-direction: column;
        gap: 6px;
      }
    }

    @media (max-width: 520px) {
      .top .brand span {
        display: none;
      }

      .card {
        padding: 24px;
      }

      .quick-head {
        flex-direction: column;
        gap: 2px;
      }
    }

    /* --- Recuperación de acceso ------------------------------------------ */
    .rec-dialog {
      width: min(calc(100% - 32px), 480px);
      max-height: calc(100dvh - 32px);
      padding: 0;
      border: 1px solid var(--line);
      border-radius: 20px;
      background: var(--surface);
      color: var(--body);
      box-shadow: var(--shadow-card);
      overflow: auto;
    }

    .rec-dialog::backdrop {
      background: rgba(18, 17, 15, 0.55);
      backdrop-filter: blur(2px);
    }

    .rec-card {
      padding: 28px;
    }

    .rec-head {
      display: flex;
      align-items: flex-start;
      justify-content: space-between;
      gap: 16px;
    }

    .rec-head h2 {
      margin: 8px 0 0;
      font-size: 24px;
      line-height: 1.2;
      letter-spacing: -0.02em;
      color: var(--ink);
    }

    .rec-close {
      display: grid;
      place-items: center;
      width: 44px;
      height: 44px;
      border: 0;
      border-radius: 50%;
      background: transparent;
      color: var(--muted);
      font-size: 24px;
      line-height: 1;
    }

    .rec-desc {
      margin-top: 14px;
      font-size: 14px;
      line-height: 1.6;
    }

    .rec-dialog .form {
      margin-top: 22px;
      gap: 16px;
    }

    .rec-hp {
      position: absolute;
      left: -9999px;
      width: 1px;
      height: 1px;
      opacity: 0;
    }

    .rec-error {
      padding: 10px 12px;
      border-left: 3px solid var(--danger);
      border-radius: 0 8px 8px 0;
      background: var(--danger-soft);
      color: var(--danger);
      font-size: 12.5px;
      line-height: 1.45;
    }

    .rec-soporte {
      margin-top: -2px;
      font-size: 12px;
      color: var(--muted);
    }

    .rec-ok-title {
      font-size: 20px;
      font-weight: 700;
      color: var(--ink);
    }

    .rec-ok-desc {
      margin-top: 8px;
      font-size: 13.5px;
      line-height: 1.55;
    }

    .rec-code {
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: 12px;
      margin: 18px 0;
      padding: 12px 14px;
      border: 1px dashed var(--line-2);
      border-radius: 10px;
      background: var(--paper);
    }

    .rec-code span {
      font-size: 20px;
      font-weight: 800;
      letter-spacing: 0.16em;
      color: var(--ink);
      font-variant-numeric: tabular-nums;
    }

    .rec-copy {
      height: 44px;
      padding: 0 12px;
      border: 1px solid var(--line);
      border-radius: 8px;
      background: var(--surface);
      color: var(--brand-ink);
      font-size: 12px;
      font-weight: 700;
    }

    @media (hover: hover) and (pointer: fine) {
      .recovery-link:hover {
        color: var(--brand);
      }

      .rec-close:hover {
        background: var(--paper);
        color: var(--ink);
      }

      .rec-copy:hover {
        border-color: var(--line-2);
      }
    }

    @media (max-width: 520px) {
      .rec-dialog {
        width: calc(100% - 24px);
      }

      .rec-card {
        padding: 22px;
      }

      .rec-head h2 {
        font-size: 21px;
      }
    }

  </style>
</head>
<body>

  <header class="top">
    <div class="brand">
      <img class="emblem" src="/assets/jg-icon.png" alt="" width="44" height="44" />
      <div>
        <strong>Asociación Cultural Johannes Gutenberg</strong>
        <span>Comas y Carabayllo</span>
      </div>
    </div>
    <button class="theme" type="button" id="btnThemeToggle">
      <Icon name="tema.claro" size={15} />
      <span id="themeToggleLabel">Claro</span>
    </button>
  </header>

  <main class="stage">
    <section class="card" aria-labelledby="tituloAcceso">
      <p class="eyebrow">Programa Infancia Saludable</p>
      <h1 id="tituloAcceso">Ingreso al Sistema</h1>
      <p class="sub">Digita tus credenciales para acceder a los módulos de trabajo.</p>

      <form class="form" id="loginForm" autocomplete="on" novalidate>
        <div class="field">
          <label for="inputUsuario">Usuario institucional</label>
          <div class="control">
            <span class="lead" aria-hidden="true">
              <Icon name="persona.usuario" size={18} />
            </span>
            <input
              type="text"
              id="inputUsuario"
              name="usuario"
              class="text-input"
              placeholder="ej. coordinacion"
              autocomplete="username"
              required
              spellcheck="false"
              aria-describedby="loginError"
            />
          </div>
        </div>

        <div class="field">
          <label for="inputClave">Contraseña</label>
          <div class="control">
            <span class="lead" aria-hidden="true">
              <Icon name="seguridad.candado" size={18} />
            </span>
            <input
              type="password"
              id="inputClave"
              name="clave"
              class="text-input"
              placeholder="Tu contraseña"
              autocomplete="current-password"
              required
              aria-describedby="loginError"
            />
            <button type="button" class="eye" id="btnTogglePass" aria-label="Mostrar contraseña" aria-pressed="false">
              <span id="iconPassEye"><Icon name="password.ver" size={17} /></span>
            </button>
          </div>
        </div>

        <div class="field" id="filaCodigoTotp" hidden>
          <label for="inputCodigoTotp">Código de verificación</label>
          <div class="control">
            <span class="lead" aria-hidden="true">
              <Icon name="seguridad.candado" size={18} />
            </span>
            <input
              type="text"
              id="inputCodigoTotp"
              name="codigo"
              class="text-input"
              placeholder="123456"
              inputmode="numeric"
              autocomplete="one-time-code"
              maxlength="6"
              pattern="[0-9]{6}"
            />
          </div>
        </div>

        <div class="status-error-callout" id="loginError" role="alert" aria-live="polite">
          <Icon name="estado.alerta" size={17} />
          <span id="loginErrorMsg">Credenciales no válidas. Revisa usuario y contraseña.</span>
        </div>

        <p class="recovery">
          ¿Problemas para ingresar?
          <button type="button" class="recovery-link" id="btnRecuperar" aria-haspopup="dialog">Solicita una recuperación</button>
        </p>

        <button type="submit" class="btn-primary-action" id="btnLogin">
          <span class="btn-spinner" aria-hidden="true"></span>
          <span class="btn-label">Ingresar al sistema</span>
        </button>
      </form>

      <section class="quick" aria-label="Acceso rápido">
        <div class="quick-head">
          <span class="quick-title">Acceso rápido</span>
          <span class="quick-note">Disponible hasta el 5 de diciembre</span>
        </div>
        <div class="chips" id="profilesGrid">
          <button type="button" class="profile-card-btn chip" data-user="coordinacion" aria-pressed="false">Coordinación</button>
          <button type="button" class="profile-card-btn chip" data-user="facilitadora" aria-pressed="false">Nutrición</button>
          <button type="button" class="profile-card-btn chip" data-user="promotora" aria-pressed="false">Educación</button>
          <button type="button" class="profile-card-btn chip" data-user="social" aria-pressed="false">Trabajo Social</button>
          <button type="button" class="profile-card-btn chip" data-user="admin" aria-pressed="false">Administración TI</button>
        </div>
      </section>
    </section>
  </main>

  <section class="band" aria-label="Líneas de trabajo">
    <div class="mod">
      <span class="ico" aria-hidden="true"><Icon name="nav.alimentario" size={18} /></span>
      <b>Desayuno infantil</b>
      <span>Antropometría, asistencia y tamizaje.</span>
    </div>
    <div class="mod">
      <span class="ico" aria-hidden="true"><Icon name="educacion.libro" size={18} /></span>
      <b>Acompañamiento educativo</b>
      <span>Refuerzo escolar y soporte pedagógico.</span>
    </div>
    <div class="mod">
      <span class="ico" aria-hidden="true"><Icon name="modulo.social" size={18} /></span>
      <b>Atención social</b>
      <span>Visitas, canalización y expediente único.</span>
    </div>
    <div class="mod">
      <span class="ico" aria-hidden="true"><Icon name="modulo.salud" size={18} /></span>
      <b>Salud preventiva</b>
      <span>Desarrollo, vacunas y derivaciones.</span>
    </div>
  </section>

  <footer class="foot">
    <span>© 2026 Asociación Cultural Johannes Gutenberg</span>
    <span>Sistema PDI · Todos los derechos reservados</span>
  </footer>


  <dialog class="rec-dialog" id="dialogRecuperar" aria-labelledby="recTitulo" aria-describedby="recDesc">
    <div class="rec-card">
      <header class="rec-head">
        <div>
          <p class="eyebrow">Recuperar acceso</p>
          <h2 id="recTitulo">Solicita una clave temporal</h2>
        </div>
        <button type="button" class="rec-close" id="btnRecCerrar" aria-label="Cerrar">×</button>
      </header>
      <p class="rec-desc" id="recDesc">La recuperación la realiza Administración TI. Si la solicitud corresponde a una cuenta activa, se generará una clave temporal de un solo uso y deberás cambiarla al entrar.</p>

      <div id="recFormWrap">
        <form class="form" id="recForm" novalidate>
          <div class="field">
            <label for="recUsuario">Usuario institucional</label>
            <div class="control">
              <span class="lead" aria-hidden="true"><Icon name="persona.usuario" size={18} /></span>
              <input id="recUsuario" name="usuario" type="text" placeholder="ej. coordinacion" autocomplete="username" spellcheck="false" maxlength="32" />
            </div>
          </div>
          <input type="text" id="recHp" name="hp" class="rec-hp" tabindex="-1" autocomplete="off" aria-hidden="true" />
          <div class="rec-error" id="recError" role="alert" aria-live="polite" hidden></div>
          <button type="submit" class="btn-primary-action" id="btnRecEnviar">
            <span class="btn-spinner" aria-hidden="true"></span>
            <span class="btn-label">Enviar solicitud</span>
          </button>
          {soporteEmail && (
            <p class="rec-soporte">¿Prefieres escribir? <a href={`mailto:${soporteEmail}`}>{soporteEmail}</a></p>
          )}
        </form>
      </div>

      <div id="recOk" role="status" hidden>
        <p class="rec-ok-title">Solicitud registrada</p>
        <p class="rec-ok-desc">Menciona este código cuando contactes a Administración TI. No compartas tu contraseña por ningún canal.</p>
        <div class="rec-code">
          <span id="recCodigo">—</span>
          <button type="button" class="rec-copy" id="btnRecCopiar">Copiar</button>
        </div>
        <button type="button" class="btn-primary-action" id="btnRecListo">Cerrar</button>
      </div>
    </div>
  </dialog>

  <script>
    import { autenticar, haySesion } from '../scripts/auth/usuarios.js';
    import { iconBody } from '../data/iconos.js';

    // 1. Redirigir si ya existe sesión
    if (haySesion()) {
      window.location.replace('/dashboard');
    }

    // 2. Control de Tema con persistencia en localStorage
    const btnThemeToggle = document.getElementById('btnThemeToggle');
    const themeToggleLabel = document.getElementById('themeToggleLabel');
    const metaTema = document.getElementById('metaThemeColor');

    function syncThemeText(theme) {
      if (themeToggleLabel) {
        themeToggleLabel.textContent = theme === 'dark' ? 'Oscuro' : 'Claro';
      }
      if (metaTema) metaTema.setAttribute('content', theme === 'dark' ? '#12110f' : '#f2ece1');
    }

    const currentTheme = document.documentElement.getAttribute('data-theme') || 'light';
    syncThemeText(currentTheme);

    btnThemeToggle?.addEventListener('click', () => {
      const active = document.documentElement.getAttribute('data-theme') || 'light';
      const target = active === 'dark' ? 'light' : 'dark';
      document.documentElement.setAttribute('data-theme', target);
      try {
        localStorage.setItem('pdi_theme', target);
      } catch (e) {}
      syncThemeText(target);
    });

    // 3. Toggle de Visibilidad de Contraseña
    const btnTogglePass = document.getElementById('btnTogglePass');
    const inputClave = document.getElementById('inputClave');
    const filaCodigoTotp = document.getElementById('filaCodigoTotp');
    const inputCodigoTotp = document.getElementById('inputCodigoTotp');
    const iconPassEye = document.getElementById('iconPassEye');

    const EYE_OPEN = iconBody('password.ver');
    const EYE_SLASH = iconBody('password.ocultar');

    btnTogglePass?.addEventListener('click', () => {
      if (!inputClave) return;
      const isPass = inputClave.type === 'password';
      inputClave.type = isPass ? 'text' : 'password';
      btnTogglePass.setAttribute('aria-label', isPass ? 'Ocultar contraseña' : 'Mostrar contraseña');
      btnTogglePass.setAttribute('aria-pressed', String(isPass));
      if (iconPassEye) {
        iconPassEye.innerHTML = isPass ? EYE_SLASH : EYE_OPEN;
      }
    });

    // 4. Selector de Perfiles (Directorio Rápido)
    // Las pastillas solo rellenan el usuario: las contraseñas ya no viven en
    // el HTML ni en el bundle.
    const profilesGrid = document.getElementById('profilesGrid');
    const inputUsuario = document.getElementById('inputUsuario');

    profilesGrid?.addEventListener('click', (e) => {
      const card = e.target.closest('.profile-card-btn');
      if (!card) return;

      document.querySelectorAll('.profile-card-btn').forEach((c) => {
        c.classList.remove('active');
        c.setAttribute('aria-pressed', 'false');
      });
      card.classList.add('active');
      card.setAttribute('aria-pressed', 'true');

      if (inputUsuario) inputUsuario.value = card.dataset.user || '';

      ocultarError();
      inputClave?.focus();
    });

    // 5. Errores y Alertas
    function mostrarError(msg) {
      const box = document.getElementById('loginError');
      const text = document.getElementById('loginErrorMsg');
      if (text) text.textContent = msg;
      if (box) {
        box.classList.remove('visible');
        void box.offsetWidth;
        box.classList.add('visible');
      }
    }

    function limpiarInvalidos() {
      [inputUsuario, inputClave].forEach((campo) => campo?.removeAttribute('aria-invalid'));
    }

    function ocultarError() {
      document.getElementById('loginError')?.classList.remove('visible');
      limpiarInvalidos();
    }

    [inputUsuario, inputClave].forEach((campo) => {
      campo?.addEventListener('input', () => campo.removeAttribute('aria-invalid'));
    });

    // 6. Envío del Formulario
    const loginForm = document.getElementById('loginForm');
    const btnLogin = document.getElementById('btnLogin');

    loginForm?.addEventListener('submit', async (e) => {
      e.preventDefault();
      ocultarError();

      const usuario = inputUsuario?.value?.trim() ?? '';
      const clave = inputClave?.value ?? '';
      const codigo = inputCodigoTotp?.value?.trim() ?? '';

      if (!usuario || !clave) {
        mostrarError('Por favor completa tanto tu usuario como tu contraseña.');
        if (!usuario) {
          inputUsuario?.setAttribute('aria-invalid', 'true');
          inputUsuario?.focus();
        } else {
          inputClave?.setAttribute('aria-invalid', 'true');
          inputClave?.focus();
        }
        return;
      }

      if (btnLogin) {
        btnLogin.disabled = true;
        btnLogin.classList.add('loading');
      }

      // Timeout amplio: el login ahora pasa por Argon2 y SurrealDB en el
      // servidor; en un arranque en frío 8 s se quedaban cortos.
      const timeout = new Promise((_, reject) =>
        setTimeout(() => reject(new Error('timeout')), 20000)
      );

      let res;
      try {
        res = await Promise.race([
          autenticar(usuario, clave, codigo),
          timeout
        ]);
      } catch (err) {
        if (btnLogin) {
          btnLogin.disabled = false;
          btnLogin.classList.remove('loading');
        }
        if (err.message === 'timeout') {
          mostrarError('No se pudo conectar. Verifica tu conexión o intenta más tarde.');
        } else {
          mostrarError('Error inesperado. Intenta nuevamente.');
        }
        inputClave?.select();
        return;
      }

      if (res.ok) {
        window.location.replace(res.debeCambiarClave ? '/perfil' : '/dashboard');
      } else {
        if (btnLogin) {
          btnLogin.disabled = false;
          btnLogin.classList.remove('loading');
        }
        if (res.requiereTotp && filaCodigoTotp) {
          filaCodigoTotp.hidden = false;
          inputCodigoTotp?.focus();
        } else if (filaCodigoTotp) {
          // Si el fallo no es del segundo factor, se retira: un código viejo
          // junto a una contraseña equivocada solo confunde.
          filaCodigoTotp.hidden = true;
          if (inputCodigoTotp) inputCodigoTotp.value = '';
        }
        mostrarError(res.error || 'Credenciales incorrectas. Verifica tu usuario y clave.');
        if (!res.requiereTotp) inputClave?.select();
      }
    });
  </script>

  <script>
    const dialogRec = document.getElementById('dialogRecuperar');
    const btnRecuperar = document.getElementById('btnRecuperar');
    const recForm = document.getElementById('recForm');
    const recUsuario = document.getElementById('recUsuario');
    const recHp = document.getElementById('recHp');
    const recError = document.getElementById('recError');
    const recFormWrap = document.getElementById('recFormWrap');
    const recOk = document.getElementById('recOk');
    const recCodigo = document.getElementById('recCodigo');
    const btnRecEnviar = document.getElementById('btnRecEnviar');
    const btnRecCopiar = document.getElementById('btnRecCopiar');
    let recAbiertoEl = 0;

    function limpiarRecError() {
      if (!recError) return;
      recError.hidden = true;
      recError.textContent = '';
    }

    function mostrarRecError(mensaje) {
      if (!recError) return;
      recError.textContent = mensaje;
      recError.hidden = false;
    }

    btnRecuperar?.addEventListener('click', () => {
      if (!dialogRec) return;
      const loginUsuario = document.getElementById('inputUsuario');
      if (recUsuario) recUsuario.value = loginUsuario?.value?.trim() || '';
      limpiarRecError();
      if (recFormWrap) recFormWrap.hidden = false;
      if (recOk) recOk.hidden = true;
      recAbiertoEl = Date.now();
      dialogRec.showModal();
      recUsuario?.focus();
    });

    document.getElementById('btnRecCerrar')?.addEventListener('click', () => dialogRec?.close());
    document.getElementById('btnRecListo')?.addEventListener('click', () => dialogRec?.close());

    dialogRec?.addEventListener('click', (evento) => {
      if (evento.target === dialogRec) dialogRec.close();
    });

    dialogRec?.addEventListener('close', () => {
      btnRecuperar?.focus();
      if (recForm) recForm.reset();
      limpiarRecError();
      if (recFormWrap) recFormWrap.hidden = false;
      if (recOk) recOk.hidden = true;
      if (recCodigo) recCodigo.textContent = '—';
    });

    recForm?.addEventListener('submit', async (evento) => {
      evento.preventDefault();
      limpiarRecError();
      const usuario = recUsuario?.value?.trim() || '';
      if (!usuario) {
        mostrarRecError('Escribe tu usuario institucional.');
        recUsuario?.focus();
        return;
      }

      btnRecEnviar?.classList.add('loading');
      if (btnRecEnviar) btnRecEnviar.disabled = true;

      try {
        const res = await fetch('/api/cuenta/recuperacion', {
          method: 'POST',
          credentials: 'same-origin',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ usuario, hp: recHp?.value || '', ts: recAbiertoEl }),
        });
        const datos = await res.json().catch(() => ({}));
        if (res.ok && datos.ok) {
          if (recCodigo) recCodigo.textContent = datos.codigo || '—';
          if (recFormWrap) recFormWrap.hidden = true;
          if (recOk) recOk.hidden = false;
          btnRecCopiar?.focus();
        } else {
          mostrarRecError(datos.error || 'No se pudo registrar la solicitud. Intenta de nuevo.');
        }
      } catch {
        mostrarRecError('No se pudo conectar. Revisa tu conexión e intenta de nuevo.');
      } finally {
        btnRecEnviar?.classList.remove('loading');
        if (btnRecEnviar) btnRecEnviar.disabled = false;
      }
    });

    btnRecCopiar?.addEventListener('click', async () => {
      const codigo = (recCodigo?.textContent || '').trim();
      if (!codigo || codigo === '—') return;
      try {
        await navigator.clipboard.writeText(codigo);
        btnRecCopiar.textContent = 'Copiado';
        window.setTimeout(() => {
          btnRecCopiar.textContent = 'Copiar';
        }, 1800);
      } catch {
        // Sin portapapeles, el código sigue visible para copiarlo a mano.
      }
    });
  </script>

</body>
