    /* Entrada del panel de identidad — coreografía b06589e2 sustituida por la accion 5caee1a3
       "Manifiesto" (aceptada): el panel asienta por capas a distinta profundidad, sin cascada heredada. */
    @keyframes layerSettle {
      from { opacity: 0; transform: translateY(var(--dy)); }
      to   { opacity: 1; transform: translateY(0); }
    }
    .showcase-header { --dy: 21.6px; animation: layerSettle 0.45s cubic-bezier(0.16, 1, 0.3, 1) both; }
    .showcase-body   { --dy: 12px;   animation: layerSettle 0.45s cubic-bezier(0.16, 1, 0.3, 1) both; }
    .showcase-footer { --dy: 6px;    animation: layerSettle 0.45s cubic-bezier(0.16, 1, 0.3, 1) both; }
    .showcase-tagline,
    .showcase-title {
      --dy: 9.6px;
      animation: layerSettle 0.396s cubic-bezier(0.16, 1, 0.3, 1) both;
      animation-delay: 81ms;
    }
    @media (prefers-reduced-motion: reduce) {
      .showcase-header,
      .showcase-body,
      .showcase-footer,
      .showcase-tagline,
      .showcase-title {
        animation: none !important;
        opacity: 1 !important;
        transform: none !important;
        clip-path: none !important;
      }
    }
    /* Menu de modulos desplegable */
