      cursor: pointer;
      color: var(--hero-text);
      border: 1px solid transparent;
      transition: background-color 0.2s ease, border-color 0.2s ease;
    }
    .module-row:hover {
      background: rgba(255, 255, 255, 0.04);
    }
    .module-radio:focus-visible + .module-row {
      outline: 2px solid var(--hero-accent);
