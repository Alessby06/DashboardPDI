---
// Login page — Versión Definitiva con diseño artesanal (Craft & Human-First)
// Basado en /frontend-design y /interface-design para el Sistema PDI — ACJG
---
<!doctype html>
<html lang="es">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover" />
  <meta name="description" content="Sistema PDI — Portal de gestión y seguimiento del Programa de Desarrollo Integral de la Asociación Cultural Johannes Gutenberg." />
  <title>Acceso al Sistema | PDI — Johannes Gutenberg</title>
  <link rel="icon" type="image/png" href="/assets/jg-icon.png" />
  <link rel="apple-touch-icon" href="/assets/jg-icon.png" />
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Manrope:wght@300..800&display=swap" rel="stylesheet" />

  <script is:inline>
    /* Antiflash: aplica tema antes del primer render para evitar FOUC */
    (function () {
      try {
        var saved = localStorage.getItem("pdi_theme") || "system";
        var oscuro = saved === "dark" ||
          (saved === "system" && window.matchMedia("(prefers-color-scheme: dark)").matches);
        document.documentElement.setAttribute("data-theme", oscuro ? "dark" : "light");
      } catch (e) {}
    })();
  </script>

  <style>
    /* ── Reset & Tokens Fundacionales (Dominio PDI) ─────────────── */
    *, *::before, *::after {
      box-sizing: border-box;
      margin: 0;
      padding: 0;
    }

    :root {
      /* Identidad Teal Gutenberg (DESIGN.md) */
      --brand-primary: #0f766e;
      --brand-hover: #0d655d;
      --brand-light: #14b8a6;
      --brand-surface: rgba(15, 118, 110, 0.08);
      --brand-border: rgba(15, 118, 110, 0.24);

      /* Alertas */
      --danger: #b91c1c;
      --danger-bg: rgba(185, 28, 28, 0.08);
      --danger-border: rgba(185, 28, 28, 0.22);

      /* Superficies y Neutros (Lienzo institucional cálido) */
      --bg-page: #f6f8fa;
      --surface-card: #ffffff;
      --surface-subtle: #f1f4f7;
      --surface-inset: #f8fafc;
      --border-subtle: rgba(15, 23, 42, 0.08);
      --border-medium: rgba(15, 23, 42, 0.14);

      /* Tipografía & Textos */
      --text-title: #0f172a;
      --text-body: #334155;
      --text-muted: #475569;
      --text-faint: #64748b;

      /* Hero Izquierdo (Atmósfera institucional sobria) */
      --hero-bg: #0d1519;
      --hero-card-bg: rgba(22, 33, 39, 0.7);
      --hero-card-border: rgba(255, 255, 255, 0.08);
      --hero-title: #f8fafc;
      --hero-text: #94a3b8;
      --hero-accent: #34d399;

      /* Escala de Radios (DESIGN.md) */
      --radius-sm: 6px;
      --radius-md: 10px;
      --radius-lg: 16px;
      --radius-full: 9999px;

      /* Sombras Multicapa (Estrategia de Elevación Layered) */
      --shadow-flat: 0 1px 2px rgba(15, 23, 42, 0.04);
      --shadow-raised: 0 0 0 1px rgba(15, 23, 42, 0.06), 0 3px 12px -2px rgba(15, 23, 42, 0.06), 0 1px 3px rgba(15, 23, 42, 0.04);

      --ease-snappy: cubic-bezier(0.23, 1, 0.32, 1);
      --ui-font: 'Manrope', sans-serif;
    }

    [data-theme="dark"] {
      --brand-primary: #10b981;
      --brand-hover: #059669;
      --brand-light: #34d399;
      --brand-surface: rgba(16, 185, 129, 0.12);
      --brand-border: rgba(16, 185, 129, 0.3);

      --danger: #ef4444;
      --danger-bg: rgba(239, 68, 68, 0.14);
      --danger-border: rgba(239, 68, 68, 0.3);

      --bg-page: #0b0f14;
      --surface-card: #121820;
      --surface-subtle: #19212c;
      --surface-inset: #0e131a;
      --border-subtle: rgba(255, 255, 255, 0.07);
      --border-medium: rgba(255, 255, 255, 0.13);

      --text-title: #f1f5f9;
      --text-body: #cbd5e1;
      --text-muted: #8b99ad;
      --text-faint: #64748b;

      --hero-bg: #070b10;
      --hero-card-bg: rgba(14, 20, 27, 0.85);
      --hero-card-border: rgba(255, 255, 255, 0.07);
      --hero-title: #f1f5f9;
      --hero-text: #8b99ad;
      --hero-accent: #10b981;

      --shadow-flat: 0 1px 2px rgba(0, 0, 0, 0.3);
      --shadow-raised: 0 0 0 1px rgba(255, 255, 255, 0.08), 0 4px 18px rgba(0, 0, 0, 0.4);
    }

    /* ── Estructura de Página ───────────────────────────────────── */
    html, body {
      min-height: 100dvh;
      font-family: var(--ui-font);
      background: var(--bg-page);
      color: var(--text-body);
      -webkit-font-smoothing: antialiased;
      -moz-osx-font-smoothing: grayscale;
    }

    .login-container {
      min-height: 100dvh;
      display: grid;
      grid-template-columns: 1fr;
    }

    @media (min-width: 1024px) {
      .login-container {
        grid-template-columns: 1.1fr 1fr;
      }
    }

    /* ── Columna Izquierda: Identidad Institucional ─────────────── */
    .showcase-column {
      display: none;
      background: var(--hero-bg);
      padding: 56px 60px;
      flex-direction: column;
      justify-content: space-between;
      position: relative;
      border-right: 1px solid var(--border-subtle);
      overflow-y: auto;
    }

    @media (min-width: 1024px) {
      .showcase-column {
        display: flex;
      }
    }

    .showcase-header {
      display: flex;
      align-items: center;
      gap: 14px;
    }

    .showcase-badge-icon {
      width: 42px;
      height: 42px;
      border-radius: var(--radius-md);
      background: rgba(255, 255, 255, 0.06);
      border: 1px solid rgba(255, 255, 255, 0.12);
      display: flex;
      align-items: center;
      justify-content: center;
    }

    .showcase-badge-icon img {
      width: 26px;
      height: 26px;
      object-fit: contain;
    }

    .showcase-brand-text h3 {
      font-size: 14px;
      font-weight: 800;
      color: #ffffff;
      letter-spacing: 0.01em;
    }

    .showcase-brand-text p {
      font-size: 12px;
      color: var(--hero-text);
      font-weight: 600;
    }

    .showcase-body {
      margin: 40px 0;
      max-width: 520px;
    }

    .showcase-tagline {
      display: inline-flex;
      align-items: center;
      gap: 8px;
      font-size: 12px;
      font-weight: 700;
      color: var(--brand-primary);
      background: var(--brand-surface);
      border: 1px solid var(--brand-border);
      padding: 4px 12px;
      border-radius: var(--radius-full);
      margin-bottom: 20px;
    }

    .showcase-title {
      font-size: 32px;
      font-weight: 800;
      line-height: 1.2;
      color: var(--hero-title);
      letter-spacing: -0.025em;
      text-wrap: balance;
      margin-bottom: 14px;
    }

    .showcase-desc {
      font-size: 15px;
      line-height: 1.55;
      color: var(--hero-text);
      text-wrap: pretty;
      margin-bottom: 32px;
    }

    /* Módulos Operativos (The Signature Element del PDI) */
    .modules-card {
      background: var(--hero-card-bg);
      border: 1px solid var(--hero-card-border);
      border-radius: var(--radius-lg);
      padding: 20px;
      display: flex;
      flex-direction: column;
      gap: 14px;
    }

    .modules-card-label {
      font-size: 11px;
      font-weight: 800;
      text-transform: uppercase;
      letter-spacing: 0.05em;
      color: var(--hero-text);
      padding-bottom: 8px;
      border-bottom: 1px solid var(--hero-card-border);
    }

    .module-item {
      position: relative;
    }

    .module-icon-well {
      width: 36px;
      height: 36px;
      border-radius: var(--radius-md);
      background: rgba(255, 255, 255, 0.04);
      border: 1px solid rgba(255, 255, 255, 0.09);
      display: flex;
      align-items: center;
      justify-content: center;
      flex-shrink: 0;
      color: #34d399;
      box-shadow: inset 0 1px 1px rgba(255, 255, 255, 0.04);
      transition: border-color 0.2s ease, background 0.2s ease, transform 0.2s cubic-bezier(0.23, 1, 0.32, 1);
    }

    .module-item:hover .module-icon-well {
      background: rgba(16, 185, 129, 0.1);
      border-color: rgba(16, 185, 129, 0.35);
      transform: translateY(-1px);
    }

    /* ── SVG Micro-Animations (Seamless Harmonic Loops) ────────── */
    /* 1. Nutrición: respiración y balanceo orgánico continuo */
    .anim-svg-sprout .anim-leaf-main {
      transform-origin: 12px 10px;
      animation: sproutBreathe 3.8s cubic-bezier(0.45, 0.05, 0.55, 0.95) infinite;
    }
    .anim-svg-sprout .anim-leaf-sub {
      transform-origin: 12px 13px;
      animation: sproutSubBreathe 3.8s cubic-bezier(0.45, 0.05, 0.55, 0.95) infinite;
    }

    @keyframes sproutBreathe {
      0%, 100% { transform: rotate(0deg) scale(1); }
      50%      { transform: rotate(4deg) scale(1.05); }
    }
    @keyframes sproutSubBreathe {
      0%, 100% { transform: rotate(0deg) scale(1); }
      50%      { transform: rotate(-3.5deg) scale(1.04); }
    }

    /* 2. Educación: libro flotante con leve arqueo de páginas */
    .anim-svg-book {
      animation: bookFloat 4.2s cubic-bezier(0.45, 0.05, 0.55, 0.95) infinite;
    }
    .anim-svg-book .anim-page-right {
      transform-origin: 12px 12px;
      animation: pageRightTurn 4.2s cubic-bezier(0.45, 0.05, 0.55, 0.95) infinite;
    }
    .anim-svg-book .anim-page-left {
      transform-origin: 12px 12px;
      animation: pageLeftTurn 4.2s cubic-bezier(0.45, 0.05, 0.55, 0.95) infinite;
    }

    @keyframes bookFloat {
      0%, 100% { transform: translateY(0); }
      50%      { transform: translateY(-1.8px); }
    }
    @keyframes pageRightTurn {
      0%, 100% { transform: skewY(0deg) scaleX(1); }
      50%      { transform: skewY(-1.6deg) scaleX(0.97); }
    }
    @keyframes pageLeftTurn {
      0%, 100% { transform: skewY(0deg) scaleX(1); }
      50%      { transform: skewY(1.6deg) scaleX(0.97); }
    }

    /* 3. Atención Social: latido armónico y cálido en reposo */
    .anim-svg-social .anim-social-heart {
      transform-origin: 12px 12px;
      animation: heartWarmPulse 3.4s cubic-bezier(0.45, 0.05, 0.55, 0.95) infinite;
    }
    .anim-svg-social .anim-social-hands {
      transform-origin: 12px 12px;
      animation: handsWarmTouch 3.4s cubic-bezier(0.45, 0.05, 0.55, 0.95) infinite;
    }

    @keyframes heartWarmPulse {
      0%, 100% { transform: scale(1); opacity: 0.88; }
      22%      { transform: scale(1.09); opacity: 1; }
      38%      { transform: scale(1.02); opacity: 0.92; }
      52%      { transform: scale(1.06); opacity: 1; }
      72%      { transform: scale(1); opacity: 0.88; }
    }

    @keyframes handsWarmTouch {
      0%, 100% { opacity: 0.82; transform: translateY(0); }
      22%, 52% { opacity: 1; transform: translateY(-0.5px); }
      72%      { opacity: 0.82; transform: translateY(0); }
    }

    /* 4. Salud Preventiva: pulso vital armónico continuo */
    .anim-svg-pulse .anim-ecg-path {
      transform-origin: 12px 12px;
      animation: ecgHarmonicPulse 3.2s cubic-bezier(0.45, 0.05, 0.55, 0.95) infinite;
    }

    @keyframes ecgHarmonicPulse {
      0%, 100% { transform: scaleY(1); opacity: 0.78; filter: none; }
      24%      { transform: scaleY(1.18); opacity: 1; filter: drop-shadow(0 0 2px rgba(52, 211, 153, 0.55)); }
      48%      { transform: scaleY(0.92); opacity: 0.85; filter: none; }
      68%      { transform: scaleY(1.06); opacity: 0.94; }
      85%      { transform: scaleY(1); opacity: 0.78; filter: none; }
    }

    @media (prefers-reduced-motion: reduce) {
      .anim-svg-sprout .anim-leaf-main,
      .anim-svg-sprout .anim-leaf-sub,
      .anim-svg-book,
      .anim-svg-book .anim-page-right,
      .anim-svg-book .anim-page-left,
      .anim-svg-social .anim-social-heart,
      .anim-svg-social .anim-social-hands,
      .anim-svg-pulse .anim-ecg-path {
        animation: none !important;
      }
    }

    .module-text-wrap h4 {
      font-size: 13px;
      font-weight: 700;
      color: #ffffff;
      line-height: 1.3;
    }

    .module-text-wrap p {
      font-size: 12px;
      color: var(--hero-text);
      line-height: 1.35;
    }

    .showcase-footer {
      display: flex;
      align-items: center;
      justify-content: space-between;
      padding-top: 20px;
      border-top: 1px solid var(--border-subtle);
      font-size: 12px;
      color: var(--text-faint);
    }

    /* ── Columna Derecha: Panel de Acceso ───────────────────────── */
    .access-column {
      display: flex;
      flex-direction: column;
      justify-content: space-between;
      padding: 32px 24px;
      min-height: 100dvh;
      background: var(--bg-page);
    }

    @media (min-width: 640px) {
      .access-column {
        padding: 44px 48px;
      }
    }

    @media (min-width: 1024px) {
      .access-column {
        padding: 44px 56px;
      }
    }

    /* Cabecera del Panel */
    .access-header {
      display: flex;
      align-items: center;
      justify-content: space-between;
      width: 100%;
      max-width: 440px;
      margin: 0 auto;
    }

    .brand-mobile-slot {
      display: flex;
      align-items: center;
      gap: 10px;
    }

    @media (min-width: 1024px) {
      .brand-mobile-slot {
        visibility: hidden;
      }
    }

    .brand-logo-img {
      height: 28px;
      width: auto;
      object-fit: contain;
    }

    /* Control de logos 100% CSS */
    .brand-logo-light { display: block; }
    .brand-logo-dark  { display: none; }
    [data-theme="dark"] .brand-logo-light { display: none !important; }
    [data-theme="dark"] .brand-logo-dark  { display: block !important; }

    /* Botón de Tema */
    .theme-button {
      background: var(--surface-card);
      border: 1px solid var(--border-subtle);
      border-radius: var(--radius-full);
      padding: 7px 12px;
      display: inline-flex;
      align-items: center;
      gap: 6px;
      font-size: 12px;
      font-weight: 700;
      color: var(--text-body);
      cursor: pointer;
      box-shadow: var(--shadow-flat);
      transition: color 0.15s ease, border-color 0.15s ease, transform 0.15s var(--ease-snappy);
    }

    .theme-button:hover {
      color: var(--text-title);
      border-color: var(--border-medium);
      transform: translateY(-1px);
    }

    /* Contenido Central: Formulario */
    .access-content {
      width: 100%;
      max-width: 420px;
      margin: auto;
      padding: 24px 0;
    }

    .form-header-group {
      margin-bottom: 24px;
    }

    .form-main-title {
      font-size: 24px;
      font-weight: 800;
      color: var(--text-title);
      letter-spacing: -0.02em;
      line-height: 1.2;
      text-wrap: balance;
      margin-bottom: 6px;
    }

    .form-sub-title {
      font-size: 14px;
      color: var(--text-muted);
      line-height: 1.45;
      text-wrap: pretty;
    }

    /* Formulario */
    .form-stack {
      display: flex;
      flex-direction: column;
      gap: 16px;
    }

    .form-row {
      display: flex;
      flex-direction: column;
      gap: 6px;
    }

    .label-caption {
      font-size: 13px;
      font-weight: 700;
      color: var(--text-body);
      letter-spacing: -0.01em;
    }

    .input-wrapper {
      position: relative;
      display: flex;
      align-items: center;
    }

    .input-icon-glyph {
      position: absolute;
      left: 14px;
      color: var(--text-muted);
      display: flex;
      align-items: center;
      justify-content: center;
      pointer-events: none;
      transition: color 0.15s ease;
    }

    .text-input {
      width: 100%;
      height: 44px;
      padding: 0 14px 0 42px;
      background: var(--surface-card);
      border: 1px solid var(--border-subtle);
      border-radius: var(--radius-md);
      font-family: var(--ui-font);
      font-size: 14px;
      color: var(--text-title);
      box-shadow: var(--shadow-flat);
      outline: none;
      transition: border-color 0.15s ease, box-shadow 0.15s ease;
    }

    .text-input::placeholder {
      color: var(--text-faint);
    }

    .text-input:hover {
      border-color: var(--border-medium);
    }

    .text-input:focus {
      border-color: var(--brand-primary);
      box-shadow: 0 0 0 3px var(--brand-surface);
    }

    .input-wrapper:focus-within .input-icon-glyph {
      color: var(--brand-primary);
    }

    /* Toggle Contraseña */
    .btn-eye-toggle {
      position: absolute;
      right: 8px;
      background: transparent;
      border: none;
      color: var(--text-muted);
      padding: 6px 8px;
      border-radius: var(--radius-sm);
      cursor: pointer;
      display: flex;
      align-items: center;
      justify-content: center;
      transition: color 0.15s ease;
    }

    .btn-eye-toggle:hover {
      color: var(--text-title);
    }

    /* Mensaje de Error */
    .status-error-callout {
      display: none;
      align-items: flex-start;
      gap: 10px;
      background: var(--danger-bg);
      border: 1px solid var(--danger-border);
      border-radius: var(--radius-md);
      padding: 10px 12px;
      font-size: 13px;
      line-height: 1.4;
      color: var(--danger);
      font-weight: 600;
      animation: calloutShake 0.28s ease;
    }

    .status-error-callout.visible {
      display: flex;
    }

    .status-error-callout svg {
      flex-shrink: 0;
      margin-top: 1px;
    }

    @keyframes calloutShake {
      0%, 100% { transform: translateX(0); }
      25% { transform: translateX(-4px); }
      75% { transform: translateX(4px); }
    }

    /* Botón Principal (Active verb: "Ingresar al sistema") */
    .btn-primary-action {
      width: 100%;
      height: 46px;
      background: var(--brand-primary);
      color: #ffffff;
      border: none;
      border-radius: var(--radius-md);
      font-family: var(--ui-font);
      font-size: 14.5px;
      font-weight: 700;
      letter-spacing: -0.01em;
      cursor: pointer;
      display: flex;
      align-items: center;
      justify-content: center;
      gap: 8px;
      margin-top: 4px;
      box-shadow: 0 1px 3px rgba(0, 122, 100, 0.25);
      transition: background 0.15s ease, transform 0.12s var(--ease-snappy);
    }

    .btn-primary-action:hover {
      background: var(--brand-hover);
    }

    .btn-primary-action:active {
      transform: scale(0.975);
    }

    .btn-primary-action:disabled {
      opacity: 0.6;
      cursor: not-allowed;
      transform: none;
    }

    .btn-spinner {
      display: none;
      width: 16px;
      height: 16px;
      border: 2px solid rgba(255, 255, 255, 0.35);
      border-top-color: #ffffff;
      border-radius: 50%;
      animation: spinRound 0.65s linear infinite;
    }

    .btn-primary-action.loading .btn-spinner {
      display: block;
    }

    .btn-primary-action.loading .btn-label {
      opacity: 0.8;
    }

    @keyframes spinRound {
      to { transform: rotate(360deg); }
    }

    /* ── Selector de Perfiles Institucionales ──────────────────── */
    .profiles-directory {
      margin-top: 24px;
      padding-top: 20px;
      border-top: 1px solid var(--border-subtle);
    }

    .profiles-label-bar {
      display: flex;
      align-items: center;
      justify-content: space-between;
      margin-bottom: 10px;
    }

    .profiles-title {
      font-size: 11.5px;
      font-weight: 700;
      color: var(--text-muted);
      letter-spacing: 0.02em;
    }

    .profiles-note {
      font-size: 11px;
      color: var(--text-faint);
    }

    .profiles-grid {
      display: grid;
      grid-template-columns: repeat(2, 1fr);
      gap: 8px;
    }

    @media (min-width: 400px) {
      .profiles-grid {
        grid-template-columns: repeat(3, 1fr);
      }
      .profile-card-btn:last-child {
        grid-column: span 2;
      }
    }

    .profile-card-btn {
      background: var(--surface-card);
      border: 1px solid var(--border-subtle);
      border-radius: var(--radius-md);
      padding: 9px 10px;
      font-family: var(--ui-font);
      cursor: pointer;
      display: flex;
      flex-direction: column;
      align-items: flex-start;
      gap: 2px;
      text-align: left;
      box-shadow: var(--shadow-flat);
      transition: border-color 0.15s ease, background 0.15s ease, transform 0.12s var(--ease-snappy);
    }

    .profile-card-btn:hover {
      border-color: var(--brand-light);
      background: var(--surface-subtle);
      transform: translateY(-1px);
    }

    .profile-card-btn:active {
      transform: scale(0.97);
    }

    .profile-card-btn.active {
      background: var(--brand-surface);
      border-color: var(--brand-primary);
    }

    .profile-role-name {
      font-size: 12px;
      font-weight: 800;
      color: var(--text-title);
      line-height: 1.2;
    }

    .profile-card-btn.active .profile-role-name {
      color: var(--brand-primary);
    }

    .profile-user-id {
      font-size: 11px;
      font-weight: 600;
      color: var(--text-muted);
    }

    /* Pie de Página */
    .access-footer {
      width: 100%;
      max-width: 420px;
      margin: 0 auto;
      text-align: center;
      font-size: 11.5px;
      color: var(--text-faint);
      line-height: 1.4;
    }
    /* Refinamientos de pulido (impeccable live, sesion 9e3bf80c) */
    .showcase-column {
      scrollbar-width: thin;
