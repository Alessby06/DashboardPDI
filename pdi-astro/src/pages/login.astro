  /* Distribución armónica: Fila 1 (2 pills: Administración TI y Coordinación, 3 columnas cada una), Fila 2 (3 pills: Educación, Nutrición, Trabajo Social, 2 columnas cada una) */
  .access-column .profiles-grid .profile-card-btn:nth-child(5) {
    grid-column: span 3; /* Administración TI */
