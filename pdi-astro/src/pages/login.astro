  .showcase-brand-text h3 { font-size: 13px; font-weight: 600; letter-spacing: 0; }
  .showcase-brand-text p { font-size: 10.5px; font-weight: 700; text-transform: uppercase; letter-spacing: 0.12em; }
  .showcase-body { margin: 34px 0 26px; }
  .showcase-tagline {
    background: none;
    border: none;
    border-radius: 0;
    padding: 0;
    margin-bottom: 18px;
    gap: 0;
    font-size: 11px;
    font-weight: 800;
    text-transform: uppercase;
    letter-spacing: 0.2em;
  }
  .showcase-title {
    font-size: 32px;
    font-weight: 800;
    line-height: 1.03;
    letter-spacing: -0.028em;
  }
  .showcase-desc { font-size: 15.5px; max-width: 46ch; margin-bottom: 30px; }
  .modules-card {
    background: none;
    border: none;
    border-top: 1px solid var(--border-subtle);
    border-bottom: 1px solid var(--border-subtle);
    border-radius: 0;
    padding: 0;
  }
  .module-item { margin: 0; border-top: 1px solid var(--border-subtle); }
  .module-row { align-items: flex-start; gap: 14px; padding: 14px 0; border-radius: 0; }
  .showcase-column .modules-card .module-radio:checked + .module-row .module-text-wrap p {
    max-height: 120px;
    opacity: 1;
    margin-top: 4px;
  }
  /* ── Acompañamiento sobrio: transiciones suaves y limpias para despliegue/pliegue, fondo negro/neutro en reposo ── */
  .showcase-column .modules-card .module-row {
    transition: background 0.24s cubic-bezier(0.2, 0, 0, 1), border-color 0.24s cubic-bezier(0.2, 0, 0, 1), transform 0.2s ease;
  }
  .showcase-column .modules-card .module-row:hover {
    background: #000000;
    border-color: rgba(255, 255, 255, 0.14);
  }
  .showcase-column .modules-card .module-icon-well {
    border-radius: 10px;
    color: #ffffff;
    background: rgba(255, 255, 255, 0.06);
    border: 1px solid rgba(255, 255, 255, 0.12);
    transition: background 0.2s ease, border-color 0.2s ease, color 0.2s ease;
  }
  .showcase-column .modules-card .module-row:hover .module-icon-well {
    color: #ffffff;
    background: rgba(255, 255, 255, 0.1);
    border-color: rgba(255, 255, 255, 0.2);
  }
  .showcase-column .modules-card .module-radio:checked + .module-row {
    background: #000000;
    border-color: rgba(255, 255, 255, 0.22);
    box-shadow: 0 4px 16px rgba(0, 0, 0, 0.35);
  }
  .showcase-column .modules-card .module-radio:checked + .module-row .module-icon-well {
    color: #ffffff;
    background: rgba(255, 255, 255, 0.12);
    border-color: rgba(255, 255, 255, 0.25);
  }
  .showcase-column .modules-card .module-radio:checked + .module-row h4 {
    color: #ffffff;
    font-weight: 700;
  }
  .showcase-column .modules-card .module-radio:focus-visible + .module-row {
    outline: 2px solid #ffffff;
    outline-offset: 2px;
    border-radius: 12px;
  }
  /* Rejilla 2×2 de módulos en negro con bordes definidos y consistentes.
     align-items: start evita que la tarjeta abierta estire a su vecina: cada
     celda toma su altura natural y solo crece la que se despliega. */
  .showcase-column .modules-card {
    display: grid;
    grid-template-columns: 1fr 1fr;
    align-items: start;
    gap: 10px;
    border-top: 0;
    border-bottom: 0;
  }
  .showcase-column .modules-card .modules-card-label {
    grid-column: 1 / -1;
    border-bottom: 0;
    padding-bottom: 8px;
    font-size: 13px;
    font-weight: 700;
    letter-spacing: 0.02em;
    color: var(--text-title);
    opacity: 0.95;
  }
  [data-theme="dark"] .showcase-column .modules-card .modules-card-label {
    color: #ffffff;
  }
  .showcase-column .modules-card .module-item {
    border-top: 0;
    margin: 0;
    display: flex;
    align-self: start;
    width: 100%;
  }
  .showcase-column .modules-card .module-row {
    flex: 1 1 auto;
    gap: 10px;
    padding: 13px 12px;
    border-radius: 12px;
    background: #000000;
    border: 1px solid rgba(255, 255, 255, 0.1);
    box-sizing: border-box;
  }
  .showcase-column .modules-card .module-text-wrap h4 {
    font-size: 13px;
    font-weight: 700;
    letter-spacing: -0.01em;
    line-height: 1.3;
    color: #ffffff;
  }
  .showcase-column .modules-card .module-text-wrap p {
    font-size: 11.5px;
    font-weight: 450;
    line-height: 1.5;
    color: rgba(255, 255, 255, 0.72);
    margin-top: 0;
    max-height: 0;
    opacity: 0;
    overflow: hidden;
    /* 0.4s → 0.582s: 45% más lenta en total, misma curva para no perder fluidez */
    transition: max-height 0.582s cubic-bezier(0.16, 1, 0.3, 1), opacity 0.437s cubic-bezier(0.16, 1, 0.3, 1), margin-top 0.437s cubic-bezier(0.16, 1, 0.3, 1);
  }
  .showcase-column .modules-card .module-radio:checked + .module-row .module-text-wrap p {
    max-height: 140px;
    opacity: 1;
    margin-top: 6px;
  }
  .showcase-column .modules-card .module-chev {
    color: #ffffff !important;
    opacity: 1;
    margin-top: 2px;
    transition: transform 0.509s cubic-bezier(0.16, 1, 0.3, 1);
  }
  .showcase-column .modules-card .module-chev svg {
    width: 17px;
    height: 17px;
    stroke: #ffffff;
    stroke-width: 2.5;
  }
  .showcase-column .modules-card .module-radio:checked + .module-row .module-chev {
    transform: rotate(180deg);
    color: #ffffff !important;
    opacity: 1;
  }
  /* ── Aceptado 4b350464 · "Tinta azulada": botón primario en azul-negro #1c2233, sombra neutra y hover con un toque del azul del logo ACJG ── */
  /* Ajuste: negro puro (#000000) igual que las tarjetas de módulos, con hover casi negro
     y sombra neutra para que en tema claro conserve la separación del fondo. */
  .access-column .btn-primary-action {
    background: #000000;
    box-shadow: 0 1px 2px rgba(15, 23, 42, 0.2);
  }
  .access-column .btn-primary-action:hover {
    background: #14161a;
  }
  [data-theme="dark"] .access-column .btn-primary-action {
    background: #ffffff;
    color: #0b0f14;
    border: none;
    box-shadow: 0 2px 14px rgba(0, 0, 0, 0.55);
  }
  [data-theme="dark"] .access-column .btn-primary-action:hover {
    background: #e6e8ec;
  }
  /* El spinner del botón es blanco sobre negro: en modo oscuro el fondo es blanco,
     así que sus bordes pasan a oscuro para que siga siendo visible. */
  [data-theme="dark"] .access-column .btn-primary-action .btn-spinner {
    border-color: rgba(15, 23, 42, 0.25);
    border-top-color: #0b0f14;
  }
  /* ── Modo oscuro · "Inversión": tarjetas de módulos y botón pasan de negro a superficie clara.
     Jerarquía: el botón es blanco puro (#ffffff) porque es la acción principal y el elemento
     más pequeño — el punto más brillante de la pantalla. Las tarjetas usan un blancobatido
     (#f4f6f8) para no competir con él y evitar el deslumbramiento de una superficie grande
     en blanco absoluto sobre un fondo casi negro. Texto y bordes se invieren a oscuro. ── */
  [data-theme="dark"] .showcase-column .modules-card .module-row {
    background: #f4f6f8;
    border-color: rgba(15, 23, 42, 0.1);
  }
  [data-theme="dark"] .showcase-column .modules-card .module-row:hover {
    background: #ffffff;
    border-color: rgba(15, 23, 42, 0.18);
  }
  [data-theme="dark"] .showcase-column .modules-card .module-radio:checked + .module-row {
    background: #ffffff;
    border-color: rgba(15, 23, 42, 0.26);
    box-shadow: 0 6px 22px rgba(0, 0, 0, 0.55);
  }
  [data-theme="dark"] .showcase-column .modules-card .module-icon-well {
    color: #0f172a;
    background: rgba(15, 23, 42, 0.05);
    border-color: rgba(15, 23, 42, 0.12);
  }
  [data-theme="dark"] .showcase-column .modules-card .module-row:hover .module-icon-well {
    color: #0f172a;
    background: rgba(15, 23, 42, 0.08);
    border-color: rgba(15, 23, 42, 0.18);
  }
  [data-theme="dark"] .showcase-column .modules-card .module-radio:checked + .module-row .module-icon-well {
    color: #0f172a;
    background: rgba(15, 23, 42, 0.1);
    border-color: rgba(15, 23, 42, 0.22);
  }
  [data-theme="dark"] .showcase-column .modules-card .module-text-wrap h4,
  [data-theme="dark"] .showcase-column .modules-card .module-radio:checked + .module-row h4 {
    color: #0f172a;
  }
  [data-theme="dark"] .showcase-column .modules-card .module-text-wrap p {
    color: rgba(15, 23, 42, 0.66);
  }
  [data-theme="dark"] .showcase-column .modules-card .module-chev,
  [data-theme="dark"] .showcase-column .modules-card .module-radio:checked + .module-row .module-chev {
    color: #0f172a !important;
  }
  [data-theme="dark"] .showcase-column .modules-card .module-chev svg {
    stroke: #0f172a;
  }
  [data-theme="dark"] .showcase-column .modules-card .module-radio:focus-visible + .module-row {
    outline-color: #0f172a;
  }
  /* ── Aceptado 5e7e4623 · "Wipe": la columna de acceso se revela como lámina por máscara desde la izquierda; el titular asienta en una segunda ola ── */
  @keyframes accWipeLeft {
    from { clip-path: inset(0 100% 0 0); opacity: 0.4; }
    to   { clip-path: inset(0 0 0 0);    opacity: 1; }
  }
  @keyframes accCascade {
    from { opacity: 0; transform: translateY(16px); }
    to   { opacity: 1; transform: translateY(0); }
  }
  .access-column {
