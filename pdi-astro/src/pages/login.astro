---
import Icon from '../components/Icon.astro';
import '../styles/fonts.css';
// Login page — ingreso al PDI. Composición de 1040 px: placa de programa y
// tarjeta de 400. La autenticación y la recuperación viven en la API; aquí
// solo se compone la superficie.

// Edicion visual en vivo de impeccable: mismo toggle que AppLayout. La
// inyeccion de live.js solo entra en dev y con la llave activa; el build de
// produccion nunca lleva la URL de localhost.
const impeccableLive =
  String(import.meta.env.PUBLIC_IMPECCABLE_LIVE ?? 'true').toLowerCase() !== 'false';

const soporteEmail = String(import.meta.env.PUBLIC_SOPORTE_EMAIL || '').trim();
---
<!doctype html>
<html lang="es">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover" />
  <meta name="description" content="Ingreso al Programa Infancia Saludable de la Asociación Cultural Johannes Gutenberg: coordinación, salud, educación y atención social." />
  <title>Ingreso al PDI | Johannes Gutenberg</title>
  <link rel="icon" type="image/png" href="/assets/jg-icon.png" />
  <link rel="apple-touch-icon" href="/assets/jg-icon.png" />
  <meta name="theme-color" id="metaThemeColor" content="#f2ece1" />
  <link rel="preload" href="/fonts/manrope-latin.woff2" as="font" type="font/woff2" crossorigin />

  <script is:inline>
    /* Antiflash: aplica tema antes del primer render para evitar FOUC */
    (function () {
      try {
        var saved = localStorage.getItem("pdi_theme") || "light";
        var oscuro = saved === "dark" ||
          (saved === "system" && window.matchMedia("(prefers-color-scheme: dark)").matches);
        document.documentElement.setAttribute("data-theme", oscuro ? "dark" : "light");
        var meta = document.getElementById("metaThemeColor");
        if (meta) meta.setAttribute("content", oscuro ? "#12110f" : "#f2ece1");
      } catch (e) {}
    })();

    /* Antiflash de sesion: el chequeo "ya estas logueado" debe correr ANTES del
       primer paint. Antes vivia en el script de modulo del final del body, que
       es diferido: el login se pintaba entero y unos segundos despues saltaba
       al dashboard (el destello al recargar o reabrir la ventana). Mismas claves
       que valida haySesion() / AppLayout. Fallo conservador: sin sesion clara
       el login se queda quieto. */
    (function () {
      try {
        var sesionActiva = localStorage.getItem("pdi_sesion_activa");
        var login = localStorage.getItem("pdi_usuario_login");
        var exp = parseInt(localStorage.getItem("pdi_session_exp"), 10);
        if (sesionActiva === "1" && login && exp && Date.now() < exp) {
          window.location.replace("/dashboard");
          return;
        }
      } catch (e) {}
    })();
  </script>

  <script is:inline>
    /* Modo de entrada: el anillo de foco solo se dibuja al navegar con teclado.
       Al escribir con ratón o dedo, el campo no se enciende. */
    (function () {
      var raiz = document.documentElement;
      document.addEventListener("pointerdown", function () {
        raiz.setAttribute("data-pointer", "");
      }, true);
      document.addEventListener("keydown", function (evento) {
        if (evento.key === "Tab") raiz.removeAttribute("data-pointer");
      }, true);
    })();
  </script>

  <style>
    /* =========================================================================
       ACCESO · placa + tarjeta
       El login comparte la gramática del sistema: papel cálido, tarjeta plana,
       campos en caja, radios 10/16 y una única sombra ambiente.
       ========================================================================= */

    :root {
      --paper: #f2ece1;
      --surface: #fbf8f1;
      --surface-2: #efe8db;
      --ink: #1b1a17;
      --body: #5c574d;
      --muted: #6f685c;
      --line: #e0d8c9;
      --line-2: #c8bfae;
      --brand: #2f5c6b;
      --brand-hover: #244b58;
      --brand-soft: #dfe9ed;
      --brand-ink: #2f5c6b;
      --brand-link: #2f5c6b;
      --brand-link-hover: #244b58;
      --action: #1b1a17;
      --action-hover: #2b2a26;
      --on-action: #f4efe5;
      --on-brand: #f4efe5;
      --danger: #8a3d32;
      --danger-soft: #f3ded6;
      --focus: #1b1a17;
      --field-border: #c8bfae;
      --field-border-strong: #a89d8b;
      --field-bg: #efe8db;
      --hover: #ece4d6;
      --line-strong: #a89d8b;
      --scrim: rgba(18, 17, 15, 0.65);
      --shadow-ambient: 0 4px 16px -2px rgba(27, 26, 23, 0.08), 0 1px 3px 0 rgba(27, 26, 23, 0.05);
      --shadow-overlay: 0 16px 40px -8px rgba(15, 23, 42, 0.18), 0 6px 16px -8px rgba(15, 23, 42, 0.12);
      color-scheme: light;
    }

    [data-theme="dark"] {
      --paper: #12110f;
      --surface: #1b1915;
      --surface-2: #191713;
      --ink: #f4efe5;
      --body: #c9c2b4;
      --muted: #a39b8c;
      --line: #2f2b25;
      --line-2: #4a443a;
      --brand: #9fc4d0;
      --brand-hover: #b7d6df;
      --brand-soft: #1c2a31;
      --brand-ink: #cfe2e8;
      --brand-link: #9fc4d0;
      --brand-link-hover: #b7d6df;
      --action: #f4efe5;
      --action-hover: #ffffff;
      --on-action: #12110f;
      --on-brand: #12110f;
      --danger: #f0d0cb;
      --danger-soft: #33201f;
      --focus: #f4efe5;
      --field-border: #4a443a;
      --field-border-strong: #8a8172;
      --field-bg: #191713;
      --hover: rgba(244, 239, 229, 0.08);
      --line-strong: #8a8172;
      --scrim: rgba(18, 17, 15, 0.65);
      --shadow-ambient: 0 0 0 1px rgba(244, 239, 229, 0.05);
      --shadow-overlay: 0 0 0 1px rgba(255, 255, 255, 0.05), 0 20px 40px -16px rgba(0, 0, 0, 0.9);
      color-scheme: dark;
    }

    *,
    *::before,
    *::after {
      box-sizing: border-box;
    }

    html {
      min-height: 100%;
    }

    body {
      display: flex;
      flex-direction: column;
      min-height: 100vh;
      margin: 0;
      background: var(--paper);
      color: var(--body);
      font-family: "Manrope", system-ui, -apple-system, "Segoe UI", sans-serif;
      font-size: 14px;
      line-height: 1.55;
      -webkit-font-smoothing: antialiased;
      text-rendering: optimizeLegibility;
    }

    h1,
    h2,
    p {
      margin: 0;
    }

    button,
    input {
      font: inherit;
      color: inherit;
    }

    button {
      cursor: pointer;
    }

    img,
    svg {
      display: block;
    }

    [hidden] {
      display: none !important;
    }

    :focus-visible {
      outline: 2px solid var(--focus);
      outline-offset: 2px;
    }

    /* --- Cabecera --------------------------------------------------------- */
    .top {
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: 16px;
      margin: 0 auto;
    }

    .brand {
      display: flex;
      align-items: center;
      gap: 12px;
      min-width: 0;
    }

    .brand > div {
      min-width: 0;
    }

    .brand .emblem {
      border-radius: 10px;
    }

    .brand strong {
      display: block;
      font-weight: 700;
      line-height: 1.3;
      color: var(--ink);
    }

    .brand span {
      display: block;
      margin-top: 3px;
      font-size: 11px;
      font-weight: 600;
      letter-spacing: 0.07em;
      text-transform: uppercase;
      color: var(--muted);
    }

    .theme {
      display: inline-flex;
      align-items: center;
      justify-content: center;
      gap: 8px;
      flex: 0 0 auto;
      border: 1px solid var(--line);
      border-radius: 10px;
      background: var(--surface);
      color: var(--body);
      font-weight: 600;
      transition: border-color 160ms ease, color 160ms ease, background-color 160ms ease;
    }

    .theme-icon,
    .theme-label {
      display: none;
    }

    .theme-moon,
    .theme-label-to-dark {
      display: inline-flex;
    }

    [data-theme="dark"] .theme-moon,
    [data-theme="dark"] .theme-label-to-dark {
      display: none;
    }

    [data-theme="dark"] .theme-sun,
    [data-theme="dark"] .theme-label-to-light {
      display: inline-flex;
    }

    /* --- Composición ------------------------------------------------------ */
    .stage {
      flex: 1 0 auto;
    }

    .card {
      width: 100%;
      border: 1px solid var(--line);
      border-radius: 16px;
      background: var(--surface);
      box-shadow: var(--shadow-ambient);
      animation: login-rise 320ms cubic-bezier(0.23, 1, 0.32, 1) both;
    }

    .card h1 {
      line-height: 1.1;
      letter-spacing: -0.03em;
      font-weight: 700;
      color: var(--ink);
      text-wrap: balance;
    }

    .sub {
      margin-top: 8px;
      line-height: 1.55;
    }

    /* --- Formulario ------------------------------------------------------ */
    .form {
      display: flex;
      flex-direction: column;
    }

    .field {
      display: flex;
      flex-direction: column;
      gap: 6px;
    }

    .field label {
      font-weight: 700;
      letter-spacing: 0.01em;
      color: var(--ink);
    }

    .control {
      position: relative;
      display: flex;
      align-items: center;
      height: 36px;
      border: 0;
      border-radius: 10px;
      background: var(--field-bg);
      box-shadow: inset 0 0 0 1px var(--field-border);
      transition: box-shadow 160ms ease;
    }

    .control:focus-within {
      box-shadow: inset 0 0 0 1px var(--field-border-strong);
    }

    .control:has(input:focus-visible) {
      outline: 2px solid var(--focus);
      outline-offset: 0;
    }

    html[data-pointer] .control:has(input:focus-visible) {
      outline: none;
    }

    .control:has(input[aria-invalid="true"]) {
      box-shadow: inset 0 0 0 1px var(--danger);
    }

    .control input {
      width: 100%;
      height: 100%;
      padding: 0 14px;
      border: 0;
      background: transparent;
      color: var(--ink);
      font-size: 15px;
      outline: none;
    }

    .control:has(.eye) input {
      padding-right: 40px;
    }

    /* El navegador pinta su propio ojo y su botón de credenciales dentro del
       campo; el login ya tiene el suyo. Se ocultan para que no se dupliquen. */
    .control input[type="password"]::-ms-reveal,
    .control input[type="password"]::-ms-clear,
    .control input[type="password"]::-webkit-credentials-auto-fill-button {
      display: none;
    }

    .control input::placeholder {
      color: var(--muted);
      opacity: 1;
    }

    .field-error {
      font-size: 12.5px;
      line-height: 1.45;
      color: var(--danger);
    }

    .field-error:not([hidden]) {
      animation: login-reveal 150ms cubic-bezier(0.23, 1, 0.32, 1) both;
    }

    .sr-only {
      position: absolute;
      width: 1px;
      height: 1px;
      padding: 0;
      margin: -1px;
      overflow: hidden;
      clip: rect(0 0 0 0);
      white-space: nowrap;
      border: 0;
    }

    .noscript {
      margin-top: 16px;
      padding: 12px 14px;
      border: 1px solid var(--field-border);
      border-radius: 10px;
      background: var(--field-bg);
      color: var(--body);
      font-size: 12.5px;
      line-height: 1.5;
    }

    .noscript a {
      color: var(--brand-link);
      font-weight: 700;
    }

    .eye {
      position: absolute;
      right: 0;
      display: grid;
      place-items: center;
      width: 36px;
      height: 36px;
      border: 0;
      border-radius: 10px;
      background: transparent;
      color: var(--muted);
      transition: color 160ms ease;
    }

    .eye:focus-visible {
      outline-offset: -2px;
    }

    .eye-icon {
      grid-area: 1 / 1;
      display: flex;
      transition:
        opacity 150ms cubic-bezier(0.23, 1, 0.32, 1),
        transform 150ms cubic-bezier(0.23, 1, 0.32, 1);
    }

    .eye-off,
    .eye[aria-pressed="true"] .eye-on {
      opacity: 0;
      transform: scale(0.9);
    }

    .eye[aria-pressed="true"] .eye-off {
      opacity: 1;
      transform: none;
    }

    .totp-status {
      margin-top: 2px;
      font-size: 12.5px;
      font-weight: 600;
      line-height: 1.45;
      color: var(--brand-ink);
    }

    #filaCodigoTotp:not([hidden]) {
      animation: login-reveal 180ms cubic-bezier(0.23, 1, 0.32, 1) both;
    }

    /* --- Error ----------------------------------------------------------- */
    .status-error-callout {
      display: none;
      align-items: flex-start;
      gap: 10px;
      padding: 12px 14px;
      border: 1px solid color-mix(in srgb, var(--danger) 38%, transparent);
      border-radius: 10px;
      background: var(--danger-soft);
      color: var(--danger);
      font-size: 12.5px;
      line-height: 1.45;
    }

    .status-error-callout.visible {
      display: flex;
      animation: login-reveal 150ms cubic-bezier(0.23, 1, 0.32, 1) both;
    }

    .status-error-callout svg {
      flex: 0 0 16px;
      margin-top: 1px;
    }

    .recovery {
      display: flex;
      align-items: center;
      justify-content: center;
      flex-wrap: wrap;
      gap: 2px 6px;
      margin-top: -4px;
      font-size: 12.5px;
      color: var(--muted);
      text-align: center;
    }

    .recovery-link {
      display: inline-flex;
      align-items: center;
      min-height: 32px;
      padding: 0 2px;
      border: 0;
      background: transparent;
      color: var(--brand-link);
      font: inherit;
      font-weight: 700;
      text-decoration: underline;
      text-underline-offset: 3px;
      cursor: pointer;
      transition: color 160ms ease;
    }

    /* --- Botón ----------------------------------------------------------- */
    .btn-primary-action {
      position: relative;
      display: inline-flex;
      align-items: center;
      justify-content: center;
      gap: 10px;
      width: 100%;
      height: 48px;
      border: 0;
      border-radius: 10px;
      background: var(--brand);
      color: var(--on-brand);
      font-size: 14px;
      font-weight: 700;
      letter-spacing: 0.01em;
      transition: background-color 160ms ease, transform 120ms ease, opacity 160ms ease;
    }

    .btn-primary-action:active {
      transform: scale(0.985);
    }

    .btn-primary-action:disabled {
      opacity: 0.72;
      cursor: not-allowed;
    }

    .btn-label {
      transition: opacity 160ms ease;
    }

    .btn-spinner {
      position: absolute;
      left: 16px;
      top: 50%;
      display: none;
      width: 16px;
      height: 16px;
      margin-top: -8px;
      border: 2px solid color-mix(in srgb, var(--on-brand) 30%, transparent);
      border-top-color: var(--on-brand);
      border-radius: 50%;
      animation: login-spin 0.7s linear infinite;
    }

    .btn-primary-action.loading .btn-spinner {
      display: block;
    }

    .btn-primary-action.loading .btn-label {
      opacity: 0.85;
    }

    /* --- Usuarios de prueba ---------------------------------------------- */
    .quick {
      border-top: 1px solid var(--line);
    }

    .quick-head {
      display: flex;
      align-items: baseline;
      justify-content: space-between;
      gap: 12px;
      flex-wrap: wrap;
      margin-bottom: 10px;
    }

    .quick-title {
      font-size: 12.5px;
      font-weight: 600;
      color: var(--ink);
    }

    .chips {
      display: grid;
      grid-template-columns: repeat(6, minmax(0, 1fr));
      gap: 6px;
    }

    .chip {
      position: relative;
      grid-column: span 2;
      display: flex;
      align-items: center;
      justify-content: center;
      padding: 0 8px;
      border: 1px solid var(--line);
      border-radius: 10px;
      background: var(--surface);
      color: var(--ink);
      font-weight: 600;
      text-align: center;
      cursor: pointer;
      transition: border-color 160ms ease, background-color 160ms ease, color 160ms ease;
    }

    .chip input {
      position: absolute;
      width: 1px;
      height: 1px;
      margin: 0;
      opacity: 0;
      pointer-events: none;
    }

    .chip input:focus-visible {
      outline: none;
    }

    .chip:has(input:focus-visible) {
      outline: 2px solid var(--focus);
      outline-offset: 2px;
    }

    .chip:nth-child(4),
    .chip:nth-child(5) {
      grid-column: span 3;
    }

    .chip:has(input:checked) {
      border-color: var(--brand);
      background: var(--brand-soft);
      color: var(--brand-ink);
      font-weight: 700;
    }

    .chip:has(input:disabled) {
      opacity: 0.55;
      cursor: not-allowed;
    }

    .stage.is-totp .quick {
      display: none;
    }

    .foot {
      border-top: 1px solid var(--line);
      font-size: 11.5px;
      color: var(--muted);
      text-align: center;
    }

    /* --- Movimiento ------------------------------------------------------ */
    @keyframes login-rise {
      from {
        opacity: 0;
        transform: translateY(10px);
      }
    }

    @keyframes login-spin {
      to {
        transform: rotate(360deg);
      }
    }

    @keyframes login-reveal {
      from {
        opacity: 0;
        transform: translateY(-4px);
      }
    }

    @media (hover: hover) and (pointer: fine) {
      .theme:hover {
        border-color: var(--line-strong);
        background: var(--hover);
        color: var(--ink);
      }

      .eye:hover {
        color: var(--ink);
      }

      .chip:not(:has(input:checked)):not(:has(input:disabled)):hover {
        border-color: var(--line-strong);
        background: var(--hover);
      }

      .btn-primary-action:hover {
        background: var(--brand-hover);
      }

      .recovery-link:hover {
        color: var(--brand-link-hover);
      }

      .rec-close:hover {
        background: var(--hover);
        color: var(--ink);
      }

      .rec-copy:hover {
        border-color: var(--line-strong);
        background: var(--hover);
      }

      .rec-soporte a:hover {
        color: var(--brand-link-hover);
      }
    }

    @media (prefers-reduced-motion: reduce) {
      .card,
      .status-error-callout.visible,
      .field-error:not([hidden]),
      #filaCodigoTotp:not([hidden]),
      .rec-dialog.is-opening,
      .rec-dialog.is-closing,
      .rec-dialog.is-opening::backdrop,
      .rec-dialog.is-closing::backdrop,
      #recOk.is-entering,
      .rec-error {
        animation: none;
      }

      .btn-primary-action,
      .btn-label,
      .eye,
      .eye-icon,
      .theme,
      .chip,
      .control,
      .rec-close,
      .rec-copy,
      .recovery-link {
        transition-duration: 0.01ms;
      }

      .btn-spinner,
      .btn-primary-action.loading .btn-spinner {
        display: none;
        animation: none;
      }
    }

    @media (any-pointer: coarse) {
      .recovery-link {
        min-height: 44px;
      }

      .chip {
        height: 44px;
      }
    }

    /* --- Recuperación de acceso ------------------------------------------ */
    .rec-dialog {
      width: min(calc(100% - 48px), 480px);
      max-height: calc(100dvh - 48px);
      padding: 0;
      border: 1px solid var(--line);
      border-radius: 16px;
      background: var(--surface);
      color: var(--body);
      box-shadow: var(--shadow-overlay);
      overflow: auto;
    }

    .rec-dialog.is-opening {
      animation: login-dialog-in 220ms cubic-bezier(0.23, 1, 0.32, 1) both;
    }

    .rec-dialog.is-closing {
      animation: login-dialog-out 160ms cubic-bezier(0.23, 1, 0.32, 1) both;
    }

    .rec-dialog::backdrop {
      background: var(--scrim);
      backdrop-filter: blur(2px);
    }

    .rec-dialog.is-opening::backdrop {
      animation: login-backdrop-in 220ms ease both;
    }

    .rec-dialog.is-closing::backdrop {
      animation: login-backdrop-out 160ms ease both;
    }

    .rec-card {
      display: flex;
      flex-direction: column;
      min-height: 360px;
      padding: 24px;
    }

    .rec-head {
      display: flex;
      align-items: flex-start;
      justify-content: space-between;
      gap: 16px;
    }

    .rec-head h2 {
      margin: 0;
      font-size: 22px;
      line-height: 1.2;
      letter-spacing: -0.02em;
      color: var(--ink);
    }

    .rec-close {
      display: grid;
      place-items: center;
      flex: 0 0 44px;
      width: 44px;
      height: 44px;
      border: 0;
      border-radius: 9999px;
      background: transparent;
      color: var(--muted);
      transition: background-color 160ms ease, color 160ms ease;
    }

    .rec-desc {
      margin-top: 12px;
      font-size: 14px;
      line-height: 1.6;
    }

    .rec-dialog .form {
      margin-top: 20px;
    }

    .rec-dialog .control {
      background: var(--paper);
    }

    .rec-hp {
      position: absolute;
      left: -9999px;
      width: 1px;
      height: 1px;
      opacity: 0;
    }

    .rec-error {
      padding: 10px 12px;
      border: 1px solid color-mix(in srgb, var(--danger) 38%, transparent);
      border-radius: 10px;
      background: var(--danger-soft);
      color: var(--danger);
      font-size: 12.5px;
      line-height: 1.45;
      animation: login-reveal 150ms cubic-bezier(0.23, 1, 0.32, 1) both;
    }

    .rec-soporte {
      margin-top: -2px;
      font-size: 12.5px;
      color: var(--muted);
    }

    .rec-soporte a {
      color: var(--brand-link);
      text-underline-offset: 2px;
      transition: color 160ms ease;
    }

    .rec-ok-desc {
      margin-top: 8px;
      font-size: 14px;
      line-height: 1.55;
    }

    .rec-code {
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: 12px;
      margin: 18px 0;
      padding: 12px 14px;
      border: 1px dashed var(--line-2);
      border-radius: 10px;
      background: var(--paper);
    }

    .rec-code span {
      font-family: ui-monospace, "SFMono-Regular", Consolas, "Liberation Mono", monospace;
      font-size: 20px;
      font-weight: 800;
      letter-spacing: 0.08em;
      color: var(--ink);
      font-variant-numeric: tabular-nums;
    }

    .rec-copy {
      height: 44px;
      min-width: 78px;
      padding: 0 12px;
      border: 1px solid var(--field-border);
      border-radius: 10px;
      background: var(--surface);
      color: var(--brand-link);
      font-size: 12.5px;
      font-weight: 700;
      transition: border-color 160ms ease, background-color 160ms ease;
    }

    #recOk:not([hidden]) {
      display: flex;
      flex-direction: column;
      flex: 1;
    }

    #recOk .rec-soporte {
      margin-top: 12px;
    }

    #recOk .btn-primary-action {
      margin-top: auto;
    }

    #recOk.is-entering {
      animation: login-ok-in 180ms cubic-bezier(0.23, 1, 0.32, 1) both;
    }

    @keyframes login-dialog-in {
      from {
        opacity: 0;
        transform: translateY(8px) scale(0.97);
      }
    }

    @keyframes login-dialog-out {
      to {
        opacity: 0;
        transform: translateY(4px) scale(0.98);
      }
    }

    @keyframes login-backdrop-in {
      from {
        opacity: 0;
        backdrop-filter: blur(0);
      }
    }

    @keyframes login-backdrop-out {
      to {
        opacity: 0;
        backdrop-filter: blur(0);
      }
    }

    @keyframes login-ok-in {
      from {
        opacity: 0;
        transform: translateY(4px);
      }
    }

    /* --- Composición B ---------------------------------------------------- */
    .skip-link {
      position: fixed;
      left: 16px;
      top: -60px;
      z-index: 50;
      padding: 10px 14px;
      border-radius: 10px;
      background: var(--surface);
      color: var(--ink);
      box-shadow: var(--shadow-overlay);
      font-size: 12.5px;
      font-weight: 700;
      transition: top 160ms ease;
    }

    .skip-link:focus {
      top: 12px;
    }

    .top {
      width: min(calc(100% - 64px), 1040px);
      padding: 26px 0 0;
    }

    .brand {
      gap: 11px;
    }

    .brand .emblem {
      width: 36px;
      height: 36px;
      flex: 0 0 36px;
      border-radius: 10px;
    }

    .brand strong {
      font-size: 12.5px;
    }

    .theme {
      min-width: 88px;
      height: 38px;
      padding: 0 11px;
      font-size: 11.5px;
    }

    .stage {
      display: grid;
      grid-template-columns: minmax(0, 1fr) 400px;
      align-items: start;
      align-content: start;
      column-gap: 48px;
      row-gap: 14px;
      width: min(calc(100% - 64px), 1040px);
      margin: 0 auto;
      padding: 26px 0 0;
    }

    .plate {
      min-width: 0;
      padding-top: 4px;
      grid-column: 1;
      grid-row: 1 / span 2;
    }

    .plate h2 {
      color: var(--ink);
      font-size: 22px;
      font-weight: 700;
      line-height: 1.2;
      letter-spacing: -0.02em;
      text-wrap: balance;
    }

    .plate-desc {
      margin-top: 10px;
      max-width: 72ch;
      font-size: 13px;
      line-height: 1.55;
    }

    .plate-modules {
      display: grid;
      grid-template-columns: 1fr 1fr;
      row-gap: 14px;
      margin: 24px 0 0;
      padding: 0;
      list-style: none;
      border-top: 1px solid var(--line);
    }

    .plate-mod {
      min-width: 0;
      padding: 11px 16px 11px 0;
      border-bottom: 1px solid var(--line);
    }

    .plate-mod:nth-child(odd) {
      border-right: 1px solid var(--line);
    }

    .plate-mod:nth-child(even) {
      padding: 11px 0 11px 16px;
    }

    .plate-mod strong {
      display: block;
      color: var(--ink);
      font-size: 12px;
      font-weight: 700;
    }

    .plate-mod span {
      display: block;
      margin-top: 3px;
      color: var(--muted);
      font-size: 11px;
      line-height: 1.4;
    }

    .access {
      display: flex;
      flex-direction: column;
      min-width: 0;
      grid-column: 2;
      grid-row: 1;
    }

    .card {
      padding: 22px;
    }

    .card h1 {
      font-size: 26px;
    }

    .sub {
      margin-top: 8px;
      font-size: 13.5px;
      line-height: 1.5;
    }

    .form {
      gap: 14px;
      margin-top: 16px;
    }

    .field label {
      font-size: 12px;
    }

    .btn-primary-action {
      height: 44px;
      background: var(--action);
      color: var(--on-action);
      font-size: 13.5px;
    }

    .btn-spinner {
      border-color: color-mix(in srgb, var(--on-action) 30%, transparent);
      border-top-color: var(--on-action);
    }

    .quick {
      grid-column: 2;
      grid-row: 2;
      padding-top: 12px;
    }

    .quick-head {
      justify-content: flex-start;
      margin-bottom: 7px;
    }

    .quick-title {
      font-size: 12px;
    }

    .chip {
      height: 34px;
      font-size: 11.5px;
    }

    .foot {
      width: min(calc(100% - 64px), 1040px);
      margin: 20px auto 0;
      padding: 14px 0 calc(24px + env(safe-area-inset-bottom));
    }

    .rec-dialog {
      width: min(calc(100% - 48px), 440px);
      overscroll-behavior: contain;
    }

    .rec-card {
      min-height: 340px;
      padding: 22px;
    }

    .rec-close {
      width: 40px;
      height: 40px;
      flex: 0 0 40px;
    }

    .rec-copy {
      height: 40px;
    }

    button,
    a,
    label,
    input {
      touch-action: manipulation;
    }

    button,
    a,
    label {
      -webkit-tap-highlight-color: transparent;
    }

    @media (hover: hover) and (pointer: fine) {
      .btn-primary-action:hover {
        background: var(--action-hover);
      }
    }

    @media (any-pointer: coarse) {
      .control,
      .eye,
      .theme {
        height: 44px;
      }

      .control input {
        font-size: 16px;
      }

      .eye {
        width: 44px;
      }

      .chip {
        height: 44px;
      }

      .rec-close {
        width: 44px;
        height: 44px;
        flex: 0 0 44px;
      }

      .rec-copy {
        height: 44px;
      }

      .recovery-link {
        min-height: 44px;
      }
    }

    @media (max-width: 1080px) {
      .stage {
        grid-template-columns: 1fr;
        gap: 22px;
      }

      .plate,
      .access,
      .quick {
        grid-column: 1;
        grid-row: auto;
      }

      .plate {
        max-width: 560px;
      }

      .access {
        max-width: 400px;
      }

      .quick {
        max-width: 400px;
      }
    }

    @media (max-width: 820px) {
      .top,
      .stage,
      .foot {
        width: calc(100% - 40px);
      }

      .stage {
        padding-top: 20px;
      }

      .plate h2 {
        font-size: 20px;
      }

      .plate-desc {
        font-size: 12.5px;
      }

      .plate-mod {
        padding: 11px 12px 11px 0;
      }

      .plate-mod:nth-child(even) {
        padding-left: 12px;
      }

      .plate-mod strong {
        font-size: 11.5px;
      }

      .access {
        max-width: 400px;
      }
    }

    @media (max-width: 520px) {
      .stage {
        padding-top: 18px;
      }

      .plate {
        max-width: none;
      }

      .plate h2 {
        font-size: 20px;
      }

      .plate-desc,
      .plate-mod span {
        display: none;
      }

      .plate-modules {
        margin-top: 8px;
        row-gap: 8px;
      }

      .plate-mod {
        padding: 6px 10px 6px 0;
      }

      .plate-mod:nth-child(even) {
        padding-left: 10px;
      }

      .plate-mod strong {
        font-size: 11.5px;
      }

      .sub {
        display: none;
      }

      .card {
        padding: 20px;
      }

      .quick-head {
        align-items: flex-start;
      }

      .quick {
        padding-top: 10px;
      }

      .chips {
        grid-template-columns: repeat(2, minmax(0, 1fr));
      }

      .chip,
      .chip:nth-child(4),
      .chip:nth-child(5) {
        grid-column: auto;
      }

      .chip:last-child {
        grid-column: 1 / -1;
      }

      .foot {
        margin-top: 14px;
        padding: 12px 0 calc(18px + env(safe-area-inset-bottom));
      }

      .rec-dialog {
        width: calc(100% - 40px);
      }

      .rec-card {
        min-height: 340px;
        padding: 20px;
      }

      .rec-head h2 {
        font-size: 20px;
      }

      .rec-dialog .form {
        margin-top: 18px;
      }

      .top .brand span {
        display: block;
      }
    }

    @media (prefers-reduced-motion: reduce) {
      .skip-link {
        transition: none;
      }
    }

  </style>
</head>
<body>

  <a class="skip-link" href="#inputUsuario">Saltar al formulario de acceso</a>

  <header class="top">
    <div class="brand">
      <img class="emblem" src="/assets/jg-icon.png" alt="" width="36" height="36" />
      <div>
        <strong>Asociación Cultural Johannes Gutenberg</strong>
        <span>El Agustino y Comas</span>
      </div>
    </div>
    <button class="theme" type="button" id="btnThemeToggle" aria-label="Cambiar a oscuro" title="Cambiar a oscuro">
      <span class="theme-icon theme-sun" aria-hidden="true"><Icon name="tema.claro" size={15} /></span>
      <span class="theme-icon theme-moon" aria-hidden="true"><Icon name="tema.oscuro" size={15} /></span>
      <span class="theme-label theme-label-to-dark" aria-hidden="true">Oscuro</span>
      <span class="theme-label theme-label-to-light" aria-hidden="true">Claro</span>
    </button>
  </header>

  <main class="stage">
    <div class="access">
    <section class="card" aria-labelledby="tituloAcceso">
      <h1 id="tituloAcceso">Ingreso al PDI</h1>
      <p class="sub">Solo personal autorizado del programa.</p>

      <noscript>
        <style>
          .quick.quick,
          .recovery.recovery {
            display: none;
          }
        </style>
        <p class="noscript">
          Activa JavaScript para ingresar. Si necesitas recuperar tu acceso,{' '}
          {soporteEmail ? (
            <a href={`mailto:${soporteEmail}`}>{soporteEmail}</a>
          ) : (
            'contacta a Administración TI'
          )}.
        </p>
      </noscript>

      <form class="form" id="loginForm" method="post" autocomplete="on" novalidate>
        <div class="field">
          <label for="inputUsuario">Usuario institucional</label>
          <div class="control">
            <input
              type="text"
              id="inputUsuario"
              name="usuario"
              class="text-input"
              placeholder="ej. coordinacion"
              autocomplete="username"
              autocapitalize="none"
              autocorrect="off"
              required
              spellcheck="false"
              aria-describedby="errorUsuario loginError"
            />
          </div>
          <p class="field-error" id="errorUsuario" hidden></p>
        </div>

        <div class="field">
          <label for="inputClave">Contraseña</label>
          <div class="control">
            <input
              type="password"
              id="inputClave"
              name="clave"
              class="text-input"
              placeholder="Tu contraseña…"
              autocomplete="current-password"
              autocapitalize="none"
              required
              aria-describedby="errorClave loginError"
            />
            <button type="button" class="eye" id="btnTogglePass" aria-label="Mostrar contraseña" aria-pressed="false">
              <span class="eye-icon eye-on"><Icon name="password.ver" size={17} /></span>
              <span class="eye-icon eye-off"><Icon name="password.ocultar" size={17} /></span>
            </button>
          </div>
          <p class="field-error" id="errorClave" hidden></p>
        </div>

        <div class="field" id="filaCodigoTotp" hidden>
          <label for="inputCodigoTotp">Código de verificación</label>
          <p class="totp-status" id="totpStatus" role="status">Contraseña verificada. Ingresa el código de 6 dígitos de tu aplicación de autenticación.</p>
          <div class="control">
            <input
              type="text"
              id="inputCodigoTotp"
              name="codigo"
              class="text-input"
              placeholder="123456"
              inputmode="numeric"
              autocomplete="one-time-code"
              autocapitalize="none"
              autocorrect="off"
              spellcheck="false"
              maxlength="6"
              pattern="[0-9]{6}"
              aria-describedby="totpStatus loginError"
            />
          </div>
        </div>

        <div class="status-error-callout" id="loginError">
          <Icon name="estado.alerta" size={17} />
          <span id="loginErrorMsg">Usuario o contraseña incorrectos. Revísalos e inténtalo de nuevo.</span>
        </div>
        <p class="sr-only" id="loginStatus" role="status" aria-live="polite"></p>

        <button type="submit" class="btn-primary-action" id="btnLogin" disabled>
          <span class="btn-spinner" aria-hidden="true"></span>
          <span class="btn-label">Ingresar al sistema</span>
        </button>

        <p class="recovery">
          ¿Olvidaste tu contraseña?
          <button type="button" class="recovery-link" id="btnRecuperar" aria-haspopup="dialog">Recuperar acceso</button>
        </p>
      </form>
    </section>
    </div>

    <aside class="plate" aria-labelledby="plateTitle">
      <h2 id="plateTitle">Programa Infancia Saludable</h2>
      <p class="plate-desc">Padrón, educación, salud y atención social en un mismo expediente.</p>
      <ul class="plate-modules">
        <li class="plate-mod"><strong>Desayuno infantil</strong><span>Antropometría, asistencia y tamizaje.</span></li>
        <li class="plate-mod"><strong>Educación</strong><span>Refuerzo escolar y soporte pedagógico.</span></li>
        <li class="plate-mod"><strong>Atención social</strong><span>Visitas, canalización y expediente único.</span></li>
        <li class="plate-mod"><strong>Salud preventiva</strong><span>Desarrollo, vacunas y derivaciones.</span></li>
      </ul>
    </aside>

    <section class="quick" aria-label="Usuarios de prueba">
      <div class="quick-head">
        <span class="quick-title">Usuarios de prueba</span>
      </div>
      <div class="chips" id="profilesGrid" role="radiogroup" aria-label="Usuarios de prueba">
        <label class="profile-card-btn chip">
          <input type="radio" name="perfilDemo" value="coordinacion" data-user="coordinacion" />
          Coordinación
        </label>
        <label class="profile-card-btn chip">
          <input type="radio" name="perfilDemo" value="facilitadora" data-user="facilitadora" />
          Desayuno
        </label>
        <label class="profile-card-btn chip">
          <input type="radio" name="perfilDemo" value="promotora" data-user="promotora" />
          Educación
        </label>
        <label class="profile-card-btn chip">
          <input type="radio" name="perfilDemo" value="social" data-user="social" />
          Atención social
        </label>
        <label class="profile-card-btn chip">
          <input type="radio" name="perfilDemo" value="admin" data-user="admin" />
          Administración TI
        </label>
      </div>
    </section>
  </main>

  <footer class="foot">
    <span>© 2026 Asociación Cultural Johannes Gutenberg</span>
  </footer>

  <dialog class="rec-dialog" id="dialogRecuperar" aria-labelledby="recTitulo" aria-describedby="recDesc">
    <div class="rec-card">
      <header class="rec-head">
        <h2 id="recTitulo">Recuperar acceso</h2>
        <button type="button" class="rec-close" id="btnRecCerrar" aria-label="Cerrar">
          <Icon name="accion.cerrar" size={18} />
        </button>
      </header>
      <p class="rec-desc" id="recDesc">Administración TI revisará tu solicitud. Si la cuenta está activa, generará una contraseña temporal de un solo uso que deberás cambiar al entrar.</p>

      <div id="recFormWrap">
        <form class="form" id="recForm" novalidate>
          <div class="field">
            <label for="recUsuario">Usuario institucional</label>
            <div class="control">
              <input id="recUsuario" name="usuario" type="text" placeholder="ej. coordinacion" autocomplete="username" autocapitalize="none" autocorrect="off" spellcheck="false" maxlength="32" />
            </div>
          </div>
          <input type="text" id="recHp" name="hp" class="rec-hp" tabindex="-1" autocomplete="off" aria-hidden="true" />
          <div class="rec-error" id="recError" role="alert" aria-atomic="true" hidden></div>
          <button type="submit" class="btn-primary-action" id="btnRecEnviar">
            <span class="btn-spinner" aria-hidden="true"></span>
            <span class="btn-label">Enviar solicitud</span>
          </button>
          {soporteEmail && (
            <p class="rec-soporte">¿Prefieres escribir? <a href={`mailto:${soporteEmail}`}>{soporteEmail}</a></p>
          )}
        </form>
      </div>

      <div id="recOk" role="status" hidden>
        <p class="rec-ok-desc" id="recOkDesc">Menciona este código cuando contactes a Administración TI. No compartas tu contraseña por ningún canal.</p>
        <div class="rec-code">
          <span id="recCodigo">—</span>
          <button type="button" class="rec-copy" id="btnRecCopiar">Copiar</button>
        </div>
        {soporteEmail && (
          <p class="rec-soporte">¿Necesitas ayuda? Escribe a <a id="recSoporteOk" href={`mailto:${soporteEmail}`}>{soporteEmail}</a> con el código en el asunto.</p>
        )}
        <p class="sr-only" id="recCopiado" role="status" aria-live="polite"></p>
        <button type="button" class="btn-primary-action" id="btnRecListo">Cerrar</button>
      </div>
    </div>
  </dialog>

  <script>
    import { autenticar, haySesion } from '../scripts/auth/usuarios.js';

    // 1. Redirigir si ya existe sesión
    if (haySesion()) {
      window.location.replace('/dashboard');
    }

    // 2. Control de Tema con persistencia en localStorage
    const btnThemeToggle = document.getElementById('btnThemeToggle');
    const metaTema = document.getElementById('metaThemeColor');

    function syncThemeState(theme) {
      const oscuro = theme === 'dark';
      btnThemeToggle?.setAttribute('aria-label', oscuro ? 'Cambiar a claro' : 'Cambiar a oscuro');
      btnThemeToggle?.setAttribute('title', oscuro ? 'Cambiar a claro' : 'Cambiar a oscuro');
      if (metaTema) metaTema.setAttribute('content', oscuro ? '#12110f' : '#f2ece1');
    }

    const currentTheme = document.documentElement.getAttribute('data-theme') || 'light';
    syncThemeState(currentTheme);

    btnThemeToggle?.addEventListener('click', () => {
      const active = document.documentElement.getAttribute('data-theme') || 'light';
      const target = active === 'dark' ? 'light' : 'dark';
      document.documentElement.setAttribute('data-theme', target);
      try {
        localStorage.setItem('pdi_theme', target);
      } catch (e) {}
      syncThemeState(target);
    });

    // 3. Toggle de Visibilidad de Contraseña
    const btnTogglePass = document.getElementById('btnTogglePass');
    const inputClave = document.getElementById('inputClave');
    const filaCodigoTotp = document.getElementById('filaCodigoTotp');
    const inputCodigoTotp = document.getElementById('inputCodigoTotp');
    const stage = document.querySelector('.stage');
    const loginForm = document.getElementById('loginForm');
    const btnLogin = document.getElementById('btnLogin');
    if (btnLogin) btnLogin.disabled = false;

    function textoBotonLogin() {
      return filaCodigoTotp && !filaCodigoTotp.hidden ? 'Verificar código' : 'Ingresar al sistema';
    }

    function textoCargaLogin() {
      return filaCodigoTotp && !filaCodigoTotp.hidden ? 'Verificando código…' : 'Verificando…';
    }

    function mostrarTotp(visible) {
      if (filaCodigoTotp) filaCodigoTotp.hidden = !visible;
      stage?.classList.toggle('is-totp', visible);
      if (!visible && inputCodigoTotp) inputCodigoTotp.value = '';
      const label = btnLogin?.querySelector('.btn-label');
      if (label && !btnLogin?.classList.contains('loading')) {
        label.textContent = visible ? 'Verificar código' : 'Ingresar al sistema';
      }
    }

    btnTogglePass?.addEventListener('click', () => {
      if (!inputClave) return;
      const isPass = inputClave.type === 'password';
      inputClave.type = isPass ? 'text' : 'password';
      btnTogglePass.setAttribute('aria-label', isPass ? 'Ocultar contraseña' : 'Mostrar contraseña');
      btnTogglePass.setAttribute('aria-pressed', String(isPass));
    });

    // 4. Selector de Perfiles (Directorio Rápido)
    // Los radios solo rellenan el usuario: las contraseñas no viven en el HTML
    // ni en el bundle. La tira es un atajo, no una credencial completa.
    const profilesGrid = document.getElementById('profilesGrid');
    const inputUsuario = document.getElementById('inputUsuario');

    profilesGrid?.addEventListener('change', (e) => {
      const radio = e.target.closest('input[name="perfilDemo"]');
      if (!radio) return;
      if (inputUsuario) inputUsuario.value = radio.dataset.user || '';
      ocultarError();
      mostrarTotp(false);
    });

    profilesGrid?.addEventListener('click', (e) => {
      if (!e.target.closest('.chip')) return;
      if (e.detail > 0) requestAnimationFrame(() => inputClave?.focus());
    });

    const demoExpira = Date.parse('2026-12-06T00:00:00-05:00');
    if (Number.isFinite(demoExpira) && Date.now() >= demoExpira) {
      profilesGrid?.querySelectorAll('input[name="perfilDemo"]').forEach((radio) => {
        radio.disabled = true;
      });
      document.querySelector('.quick')?.setAttribute('hidden', '');
    }

    // 5. Errores y Alertas
    function mostrarError(msg) {
      const box = document.getElementById('loginError');
      const text = document.getElementById('loginErrorMsg');
      const status = document.getElementById('loginStatus');
      if (text) text.textContent = msg;
      if (status) status.textContent = msg;
      if (box) {
        box.classList.remove('visible');
        void box.offsetWidth;
        box.classList.add('visible');
      }
    }

    function mostrarErrorCampo(idError, msg) {
      const error = document.getElementById(idError);
      const status = document.getElementById('loginStatus');
      if (error) {
        error.textContent = msg;
        error.hidden = false;
      }
      if (status) status.textContent = msg;
    }

    function limpiarErroresCampo() {
      ['errorUsuario', 'errorClave'].forEach((id) => {
        const error = document.getElementById(id);
        if (!error) return;
        error.hidden = true;
        error.textContent = '';
      });
    }

    function limpiarInvalidos() {
      [inputUsuario, inputClave, inputCodigoTotp].forEach((campo) => campo?.removeAttribute('aria-invalid'));
    }

    function ocultarError() {
      document.getElementById('loginError')?.classList.remove('visible');
      limpiarInvalidos();
      limpiarErroresCampo();
      const status = document.getElementById('loginStatus');
      if (status) status.textContent = '';
    }

    [inputUsuario, inputClave, inputCodigoTotp].forEach((campo) => {
      campo?.addEventListener('input', () => {
        campo.removeAttribute('aria-invalid');
        const idError = campo.id === 'inputUsuario'
          ? 'errorUsuario'
          : campo.id === 'inputClave'
            ? 'errorClave'
            : null;
        if (idError) {
          const error = document.getElementById(idError);
          if (error) {
            error.hidden = true;
            error.textContent = '';
          }
        }
        const status = document.getElementById('loginStatus');
        if (status) status.textContent = '';
      });
    });

    inputUsuario?.addEventListener('input', () => {
      const seleccionado = profilesGrid?.querySelector('input[name="perfilDemo"]:checked');
      if (seleccionado && seleccionado.dataset.user !== inputUsuario.value) {
        seleccionado.checked = false;
      }
    });

    // 6. Envío del Formulario
    function ponerBotonCargando(boton, activo, textoNormal, textoCarga) {
      if (!boton) return;
      boton.disabled = activo;
      boton.classList.toggle('loading', activo);
      if (activo) boton.setAttribute('aria-busy', 'true');
      else boton.removeAttribute('aria-busy');
      const label = boton.querySelector('.btn-label');
      if (label) label.textContent = activo ? textoCarga : textoNormal;
    }

    loginForm?.addEventListener('submit', async (e) => {
      e.preventDefault();
      ocultarError();

      const usuario = inputUsuario?.value?.trim() ?? '';
      const clave = inputClave?.value ?? '';
      const codigo = inputCodigoTotp?.value?.trim() ?? '';

      if (!usuario || !clave) {
        const faltantes = [];
        if (!usuario) {
          inputUsuario?.setAttribute('aria-invalid', 'true');
          mostrarErrorCampo('errorUsuario', 'Falta el usuario.');
          faltantes.push('el usuario');
        }
        if (!clave) {
          inputClave?.setAttribute('aria-invalid', 'true');
          mostrarErrorCampo('errorClave', 'Falta la contraseña.');
          faltantes.push('la contraseña');
        }
        const status = document.getElementById('loginStatus');
        if (status) {
          status.textContent = faltantes.length === 2
            ? 'Escribe tu usuario y tu contraseña.'
            : 'Falta ' + faltantes[0] + '.';
        }
        if (!usuario) inputUsuario?.focus();
        else inputClave?.focus();
        return;
      }

      ponerBotonCargando(btnLogin, true, textoBotonLogin(), textoCargaLogin());

      // Timeout amplio: el login ahora pasa por Argon2 y SurrealDB en el
      // servidor; en un arranque en frío 8 s se quedaban cortos.
      const timeout = new Promise((_, reject) =>
        setTimeout(() => reject(new Error('timeout')), 20000)
      );

      let res;
      try {
        res = await Promise.race([
          autenticar(usuario, clave, codigo),
          timeout
        ]);
      } catch (err) {
        ponerBotonCargando(btnLogin, false, textoBotonLogin(), textoCargaLogin());
        if (err.message === 'timeout') {
          mostrarError('No pudimos conectar. Revisa tu conexión e inténtalo de nuevo.');
        } else {
          mostrarError('Ocurrió un error. Inténtalo de nuevo.');
        }
        inputClave?.select();
        return;
      }

      if (res.ok) {
        window.location.replace(res.debeCambiarClave ? '/perfil' : '/dashboard');
      } else {
        ponerBotonCargando(btnLogin, false, textoBotonLogin(), textoCargaLogin());

        if (res.requiereTotp) {
          mostrarTotp(true);
          if (!codigo) {
            ocultarError();
            inputCodigoTotp?.focus();
          } else {
            inputCodigoTotp?.setAttribute('aria-invalid', 'true');
            mostrarError(res.error || 'Código de verificación incorrecto. Inténtalo de nuevo.');
            inputCodigoTotp?.select();
          }
        } else {
          mostrarTotp(false);
          const mensaje = res.error || 'Usuario o contraseña incorrectos.';
          mostrarError(
            mensaje === 'Usuario o contraseña incorrectos.'
              ? mensaje + ' Revísalos e inténtalo de nuevo.'
              : mensaje
          );
          inputClave?.select();
        }
      }
    });
  </script>

  <script>
    const dialogRec = document.getElementById('dialogRecuperar');
    const btnRecuperar = document.getElementById('btnRecuperar');
    const recForm = document.getElementById('recForm');
    const recUsuario = document.getElementById('recUsuario');
    const recHp = document.getElementById('recHp');
    const recError = document.getElementById('recError');
    const recDesc = document.getElementById('recDesc');
    const recTitulo = document.getElementById('recTitulo');
    const recFormWrap = document.getElementById('recFormWrap');
    const recOk = document.getElementById('recOk');
    const recCodigo = document.getElementById('recCodigo');
    const recSoporteOk = document.getElementById('recSoporteOk');
    const recCopiado = document.getElementById('recCopiado');
    const btnRecEnviar = document.getElementById('btnRecEnviar');
    const btnRecCopiar = document.getElementById('btnRecCopiar');
    const prefiereMenosMovimiento = window.matchMedia('(prefers-reduced-motion: reduce)');
    let recAbiertoEl = 0;
    let recCerrando = false;

    function limpiarRecError() {
      recUsuario?.removeAttribute('aria-invalid');
      if (!recError) return;
      recError.hidden = true;
      recError.textContent = '';
    }

    function mostrarRecError(mensaje) {
      recUsuario?.setAttribute('aria-invalid', 'true');
      if (!recError) return;
      recError.textContent = mensaje;
      recError.hidden = false;
    }

    function cerrarRecDialogo() {
      if (!dialogRec?.open || recCerrando) return;
      if (prefiereMenosMovimiento.matches) {
        dialogRec.close();
        return;
      }
      recCerrando = true;
      dialogRec.classList.remove('is-opening');
      dialogRec.classList.add('is-closing');
      window.setTimeout(() => {
        if (dialogRec.open) dialogRec.close();
        dialogRec.classList.remove('is-closing');
        recCerrando = false;
      }, 180);
    }

    function abrirRecDialogo() {
      if (!dialogRec || dialogRec.open) return;
      const loginUsuario = document.getElementById('inputUsuario');
      if (recUsuario) recUsuario.value = loginUsuario?.value?.trim() || '';
      limpiarRecError();
      if (recFormWrap) recFormWrap.hidden = false;
      if (recOk) recOk.hidden = true;
      if (recDesc) recDesc.hidden = false;
      if (recTitulo) recTitulo.textContent = 'Recuperar acceso';
      dialogRec.setAttribute('aria-describedby', 'recDesc');
      recAbiertoEl = Date.now();
      dialogRec.classList.remove('is-closing');
      if (location.hash !== '#recuperar') {
        history.pushState({ recuperar: true }, '', '#recuperar');
      }
      dialogRec.showModal();
      dialogRec.classList.add('is-opening');
      window.setTimeout(() => dialogRec.classList.remove('is-opening'), 240);
      recUsuario?.focus();
    }

    btnRecuperar?.addEventListener('click', abrirRecDialogo);

    window.addEventListener('popstate', () => {
      if (location.hash === '#recuperar') abrirRecDialogo();
      else if (dialogRec?.open) cerrarRecDialogo();
    });

    document.getElementById('btnRecCerrar')?.addEventListener('click', cerrarRecDialogo);
    document.getElementById('btnRecListo')?.addEventListener('click', cerrarRecDialogo);

    dialogRec?.addEventListener('click', (evento) => {
      if (evento.target === dialogRec) cerrarRecDialogo();
    });

    dialogRec?.addEventListener('cancel', (evento) => {
      evento.preventDefault();
      cerrarRecDialogo();
    });

    recUsuario?.addEventListener('input', () => recUsuario.removeAttribute('aria-invalid'));

    if (location.hash === '#recuperar') abrirRecDialogo();

    dialogRec?.addEventListener('close', () => {
      recCerrando = false;
      dialogRec?.classList.remove('is-opening', 'is-closing');
      if (location.hash === '#recuperar') {
        history.replaceState(null, '', location.pathname + location.search);
      }
      btnRecuperar?.focus();
      if (recForm) recForm.reset();
      limpiarRecError();
      if (recFormWrap) recFormWrap.hidden = false;
      if (recOk) recOk.hidden = true;
      if (recDesc) recDesc.hidden = false;
      if (recTitulo) recTitulo.textContent = 'Recuperar acceso';
      if (recCopiado) recCopiado.textContent = '';
      dialogRec?.setAttribute('aria-describedby', 'recDesc');
      if (recCodigo) recCodigo.textContent = '—';
    });

    recForm?.addEventListener('submit', async (evento) => {
      evento.preventDefault();
      limpiarRecError();
      const usuario = recUsuario?.value?.trim() || '';
      if (!usuario) {
        mostrarRecError('Escribe tu usuario institucional.');
        recUsuario?.focus();
        return;
      }

      const labelRec = btnRecEnviar?.querySelector('.btn-label');
      btnRecEnviar?.classList.add('loading');
      if (btnRecEnviar) {
        btnRecEnviar.disabled = true;
        btnRecEnviar.setAttribute('aria-busy', 'true');
      }
      if (labelRec) labelRec.textContent = 'Enviando…';

      try {
        const res = await fetch('/api/cuenta/recuperacion', {
          method: 'POST',
          credentials: 'same-origin',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ usuario, hp: recHp?.value || '', ts: recAbiertoEl }),
        });
        const datos = await res.json().catch(() => ({}));
        if (res.ok && datos.ok) {
          if (recCodigo) recCodigo.textContent = datos.codigo || '—';
          if (recTitulo) recTitulo.textContent = 'Solicitud registrada';
          if (recFormWrap) recFormWrap.hidden = true;
          if (recDesc) recDesc.hidden = true;
          if (recSoporteOk && datos.codigo) {
            const base = (recSoporteOk.getAttribute('href') || '').split('?')[0];
            if (base) {
              recSoporteOk.href = base + '?subject=' + encodeURIComponent('Recuperación de acceso PDI · ' + datos.codigo);
            }
          }
          if (recOk) {
            recOk.hidden = false;
            recOk.classList.remove('is-entering');
            void recOk.offsetWidth;
            recOk.classList.add('is-entering');
            window.setTimeout(() => recOk.classList.remove('is-entering'), 220);
          }
          dialogRec?.setAttribute('aria-describedby', 'recOkDesc');
          btnRecCopiar?.focus();
        } else {
          mostrarRecError(datos.error || 'No se pudo registrar la solicitud. Intenta de nuevo.');
        }
      } catch {
        mostrarRecError('No se pudo conectar. Revisa tu conexión e intenta de nuevo.');
      } finally {
        btnRecEnviar?.classList.remove('loading');
        if (btnRecEnviar) {
          btnRecEnviar.disabled = false;
          btnRecEnviar.removeAttribute('aria-busy');
        }
        if (labelRec) labelRec.textContent = 'Enviar solicitud';
      }
    });

    btnRecCopiar?.addEventListener('click', async () => {
      const codigo = (recCodigo?.textContent || '').trim();
      if (!codigo || codigo === '—') return;
      try {
        await navigator.clipboard.writeText(codigo);
        btnRecCopiar.textContent = 'Copiado';
        if (recCopiado) recCopiado.textContent = 'Código copiado.';
        window.setTimeout(() => {
          btnRecCopiar.textContent = 'Copiar';
          if (recCopiado) recCopiado.textContent = '';
        }, 1800);
      } catch {
        // Sin portapapeles, el código sigue visible para copiarlo a mano.
      }
    });
  </script>

</body>
</html>


