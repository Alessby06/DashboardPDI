    55%  { transform: scale(1.22); opacity: 1; box-shadow: 0 0 0 5px color-mix(in srgb, var(--v-blue-focus) 0%, transparent); }
    100% { transform: scale(1); opacity: 1; box-shadow: 0 0 0 4px color-mix(in srgb, var(--v-blue-focus) 0%, transparent); }
  }
  @media (prefers-reduced-motion: reduce) {
