  /* ── Aceptado dd791b86 · "Franja bandera": identidad tricolor del logo ACJG (azul #3048f0 · rojo #c03018 · amarillo #e8c21a) ── */
  .showcase-column {
    --v-blue: #3048f0;
    --v-blue-focus: #3048f0;
    --v-red: #c03018;
    --v-yellow: #e8c21a;
    background: var(--bg-page);
    color: var(--text-body);
    padding: 40px 44px;
  }
  /* Modo oscuro: los tres se calculan en OKLCh conservando el matiz exacto del
     color claro. El azul recupera el 100% de su croma (0.248) —imposible a esta
     luminosidad en el tono pastel anterior, que ya estaba en el límite de gamut sRGB.
     Rojo y amarillo superan la croma de su versión clara.
     --v-blue-focus existe porque el gamut no permite croma pleno Y contraste alto
     a la vez: el filete (gráfico) usa --v-blue, los indicadores de foco usan el
     derivado más claro. Mismo matiz 268.4°, se leen como una sola familia. */
  [data-theme="dark"] .showcase-column {
    --v-blue: #3a57ff;
    --v-blue-focus: #5c80ff;
    --v-red: #ff4324;
    --v-yellow: #f7cd03;
  }
