                <span class="module-icon-well" aria-hidden="true"><svg class="anim-svg-pulse" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><path class="anim-ecg-path" stroke-linecap="round" stroke-linejoin="round" d="M2 12h4l2-5 3 10 2.5-7 1.5 3.5 2-1.5H22" /></svg></span>
