  }
  .showcase-desc { color: var(--text-muted); }
  .modules-card { background: var(--surface-card); border-color: var(--border-subtle); padding: 14px; gap: 9px; }
  .modules-card-label { color: var(--text-muted); border-bottom-color: var(--border-subtle); }
  .module-icon-well {
