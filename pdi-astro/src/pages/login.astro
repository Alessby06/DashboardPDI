      animation-duration: 0.54s !important;
      animation-delay: 0.12s;
      contain: layout paint;
    }
    .access-column .form-main-title {
      animation-delay: 0.26s;
    }
    .showcase-header,
    .showcase-body,
    .showcase-footer {
      animation-duration: 0.38s !important;
    }
    .showcase-tagline,
    .showcase-title {
      animation-duration: 0.33s !important;
    }
  }
  /* Menu de modulos desplegable */
    .module-radio {
      position: absolute;
      opacity: 0;
      pointer-events: none;
    }
    .module-row {
      display: flex;
      align-items: flex-start;
      gap: 12px;
      width: 100%;
      box-sizing: border-box;
      padding: 7px 8px;
      border-radius: var(--radius-md);
      cursor: pointer;
      color: var(--hero-text);
      border: 1px solid transparent;
      transition: background-color 0.28s var(--ease-fluid), border-color 0.28s var(--ease-fluid);
    }
    .module-row:hover {
      background: rgba(255, 255, 255, 0.04);
    }
    .module-radio:focus-visible + .module-row {
      outline: 2px solid var(--hero-accent);
      outline-offset: 2px;
    }
    .module-text-wrap {
      flex: 1;
      min-width: 0;
      padding-top: 1px;
    }
    .module-text-wrap h4 {
      font-size: 13px;
      font-weight: 700;
      color: #ffffff;
      line-height: 1.35;
      transition: color 0.2s ease;
    }
    .module-text-wrap p {
      /* El alto real del texto es el que manda: se anima de 0 a auto gracias a
         interpolate-size, sin un max-height de relleno que abre la descripcion
         de golpe en los primeros milisegundos y deja el resto del recorrido
         sin nada que ver. El hueco de arriba es relleno animado, para que el
         estado plegado mida 0 exacto. */
      margin: 0;
      height: 0;
      padding-top: 0;
      box-sizing: border-box;
      overflow: hidden;
      opacity: 0;
      transform: translateY(-3px);
      font-size: 12px;
      color: var(--hero-text);
      line-height: 1.4;
      /* Despliegue y pliegue simetricos: misma duracion y curva en ambos sentidos */
      transition: height 0.46s var(--ease-fluid), padding-top 0.46s var(--ease-fluid), opacity 0.34s var(--ease-fluid), transform 0.44s var(--ease-fluid);
    }
    .module-chev {
      display: inline-flex;
      align-items: center;
      justify-content: center;
      color: var(--hero-text);
      transform: rotate(0deg);
      transition: transform 0.46s var(--ease-fluid), color 0.2s ease, opacity 0.2s ease;
      margin-top: 9px;
      flex-shrink: 0;
      opacity: 0.6;
    }
    .module-radio:checked + .module-row {
      background: rgba(255, 255, 255, 0.05);
      border-color: rgba(var(--hero-accent-rgb), 0.25);
    }
    .module-radio:checked + .module-row .module-text-wrap p {
      height: auto;
      padding-top: 5px;
      opacity: 1;
      transform: none;
    }
    .module-radio:checked + .module-row .module-text-wrap h4 {
      color: #ffffff;
    }
    .module-radio:checked + .module-row .module-chev {
      transform: rotate(180deg);
      color: var(--hero-accent);
      opacity: 1;
    }
    .module-radio:checked + .module-row .module-icon-well {
      background: rgba(var(--brand-rgb), 0.12);
      border-color: rgba(var(--brand-rgb), 0.4);
    }
    .module-row:hover .module-chev {
      color: var(--hero-accent);
      opacity: 0.9;
    }
    
  /* ── Aceptado dd791b86 · "Franja bandera": identidad tricolor del logo ACJG (azul #3048f0 · rojo #c03018 · amarillo #e8c21a) ── */
  .showcase-column {
    --v-blue: #3048f0;
