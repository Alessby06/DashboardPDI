      font-size: 13px;
      font-weight: 700;
      color: #ffffff;
      line-height: 1.35;
      transition: color 0.2s ease;
    }
    .module-text-wrap p {
      max-height: 0;
      opacity: 0;
      margin-top: 0;
      overflow: hidden;
