              placeholder="ej. coordinacion"
              autocomplete="username"
              required
              spellcheck="false"
            />
          </div>
        </div>

        <!-- Contraseña -->
        <div class="form-row">
          <label class="label-caption" for="inputClave">Contraseña</label>
          <div class="input-wrapper">
            <span class="input-icon-glyph" aria-hidden="true">
              <Icon name="seguridad.candado" size={17} />
            </span>
            <input
              type="password"
              id="inputClave"
              name="clave"
              class="text-input"
              placeholder="••••••••"
              autocomplete="current-password"
              required
            />
            <button type="button" class="btn-eye-toggle" id="btnTogglePass" aria-label="Mostrar contraseña">
              <Icon name="accion.ver" size={17} id="iconPassEye" />
            </button>
          </div>
        </div>

        <!-- Mensaje de Error -->
        <div class="status-error-callout" id="loginError" role="alert" aria-live="polite">
          <Icon name="estado.alerta" size={17} />
          <span id="loginErrorMsg">Credenciales no válidas. Revisa usuario y contraseña.</span>
        </div>
        <p class="help-recovery">¿Problemas para ingresar? Contacta a Administración TI</p>

        <!-- Botón de Envío -->
        <button type="submit" class="btn-primary-action" id="btnLogin">
          <span class="btn-spinner" aria-hidden="true"></span>
          <span class="btn-label">Ingresar al sistema</span>
        </button>
      </form>

      <!-- Directorio de Perfiles para Acceso Rápido -->
      <section class="profiles-directory" aria-label="Perfiles autorizados de trabajo" data-snap>
        <div class="profiles-label-bar">
          <span class="profiles-title">Perfiles autorizados</span>
          <span class="profiles-note">Acceso rápido</span>
        </div>

        <div class="profiles-grid" id="profilesGrid">
          <button type="button" class="profile-card-btn" data-user="coordinacion" data-clave="coord2024">
            <span class="profile-role-name">Coordinación</span>
            <span class="profile-user-id">coordinacion</span>
          </button>
          <button type="button" class="profile-card-btn" data-user="facilitadora" data-clave="facil2024">
            <span class="profile-role-name">Nutrición</span>
            <span class="profile-user-id">facilitadora</span>
          </button>
          <button type="button" class="profile-card-btn" data-user="promotora" data-clave="promo2024">
            <span class="profile-role-name">Educación</span>
            <span class="profile-user-id">promotora</span>
          </button>
          <button type="button" class="profile-card-btn" data-user="social" data-clave="social2024">
            <span class="profile-role-name">Trabajo Social</span>
            <span class="profile-user-id">social</span>
          </button>
          <button type="button" class="profile-card-btn" data-user="admin" data-clave="admin2024">
            <span class="profile-role-name">Administración TI</span>
            <span class="profile-user-id">admin</span>
          </button>
        </div>
      </section>
    </div>

    <footer class="access-footer">
      <p>Sistema PDI &bull; Asociación Cultural Johannes Gutenberg</p>
    </footer>
  </main>
  </div>

  <script>
    import { autenticar, haySesion } from '../scripts/auth/usuarios.js';
    import { iconBody } from '../data/iconos.js';

    // 1. Redirigir si ya existe sesión
    if (haySesion()) {
      window.location.replace('/dashboard');
    }

    // 2. Control de Tema con persistencia en localStorage
    const btnThemeToggle = document.getElementById('btnThemeToggle');
    const themeToggleLabel = document.getElementById('themeToggleLabel');

    function syncThemeText(theme) {
      if (themeToggleLabel) {
        themeToggleLabel.textContent = theme === 'dark' ? 'Oscuro' : 'Claro';
      }
    }

    const currentTheme = document.documentElement.getAttribute('data-theme') || 'light';
    syncThemeText(currentTheme);

    btnThemeToggle?.addEventListener('click', () => {
      const active = document.documentElement.getAttribute('data-theme') || 'light';
      const target = active === 'dark' ? 'light' : 'dark';
      document.documentElement.setAttribute('data-theme', target);
      try {
        localStorage.setItem('pdi_theme', target);
      } catch (e) {}
      syncThemeText(target);
    });

    // 3. Toggle de Visibilidad de Contraseña
    const btnTogglePass = document.getElementById('btnTogglePass');
    const inputClave = document.getElementById('inputClave');
    const iconPassEye = document.getElementById('iconPassEye');

    const EYE_OPEN = iconBody('accion.ver');
    const EYE_SLASH = iconBody('accion.ocultar');

    btnTogglePass?.addEventListener('click', () => {
      if (!inputClave) return;
      const isPass = inputClave.type === 'password';
      inputClave.type = isPass ? 'text' : 'password';
      btnTogglePass.setAttribute('aria-label', isPass ? 'Ocultar contraseña' : 'Mostrar contraseña');
      if (iconPassEye) {
        iconPassEye.innerHTML = isPass ? EYE_SLASH : EYE_OPEN;
      }
    });

    // 4. Selector de Perfiles (Directorio Rápido)
    // RELLENO_CONTRASEÑAS: en producción se pone en false y las pastillas solo
    // rellenan el usuario (la contraseña se escribe a mano).
    const RELLENO_CONTRASEÑAS = true;

    const profilesGrid = document.getElementById('profilesGrid');
    const inputUsuario = document.getElementById('inputUsuario');

    profilesGrid?.addEventListener('click', (e) => {
      const card = e.target.closest('.profile-card-btn');
      if (!card) return;

      document.querySelectorAll('.profile-card-btn').forEach(c => c.classList.remove('active'));
      card.classList.add('active');

      if (inputUsuario) inputUsuario.value = card.dataset.user || '';

      if (RELLENO_CONTRASEÑAS && inputClave) {
        inputClave.value = card.dataset.clave || '';
      }

      ocultarError();
      if (RELLENO_CONTRASEÑAS) {
        btnLogin?.focus();
      } else {
        inputClave?.focus();
      }
    });

    // 4b. Acordeón de Módulos Operativos (Permite desplegar y plegar al hacer clic)
    const moduleRows = document.querySelectorAll('.modules-card .module-row');
    moduleRows.forEach((row) => {
      row.addEventListener('click', (e) => {
        e.preventDefault();
        const forId = row.getAttribute('for');
        const radio = forId ? document.getElementById(forId) : null;
        if (!radio) return;

        const isCurrentlyChecked = radio.checked;
        // Cerrar todos los radios primero
        document.querySelectorAll('.modules-card .module-radio').forEach((r) => {
          r.checked = false;
        });

        // Si no estaba marcado, marcarlo (abrir). Si estaba marcado, queda cerrado.
        if (!isCurrentlyChecked) {
          radio.checked = true;
        }
      });
    });

    // 5. Errores y Alertas
    function mostrarError(msg) {
      const box = document.getElementById('loginError');
      const text = document.getElementById('loginErrorMsg');
      if (text) text.textContent = msg;
      if (box) {
        box.classList.remove('visible');
        void box.offsetWidth;
        box.classList.add('visible');
      }
    }

    function ocultarError() {
      document.getElementById('loginError')?.classList.remove('visible');
    }

    // 6. Envío del Formulario
    const loginForm = document.getElementById('loginForm');
    const btnLogin = document.getElementById('btnLogin');

    loginForm?.addEventListener('submit', async (e) => {
      e.preventDefault();
      ocultarError();

      const usuario = inputUsuario?.value?.trim() ?? '';
      const clave = inputClave?.value ?? '';

      if (!usuario || !clave) {
        mostrarError('Por favor completa tanto tu usuario como tu contraseña.');
        if (!usuario) inputUsuario?.focus();
        else inputClave?.focus();
        return;
      }

      if (btnLogin) {
        btnLogin.disabled = true;
        btnLogin.classList.add('loading');
      }

      // Timeout race: 8s max para la conexión con SurrealDB
      const timeout = new Promise((_, reject) =>
        setTimeout(() => reject(new Error('timeout')), 8000)
      );

      let res;
      try {
        res = await Promise.race([
          autenticar(usuario, clave),
          timeout
        ]);
      } catch (err) {
        if (btnLogin) {
          btnLogin.disabled = false;
          btnLogin.classList.remove('loading');
        }
        if (err.message === 'timeout') {
          mostrarError('No se pudo conectar. Verifica tu conexión o intenta más tarde.');
        } else {
          mostrarError('Error inesperado. Intenta nuevamente.');
        }
        inputClave?.select();
        return;
      }

      if (res.ok) {
        window.location.replace('/dashboard');
      } else {
        if (btnLogin) {
          btnLogin.disabled = false;
          btnLogin.classList.remove('loading');
        }
        mostrarError(res.error || 'Credenciales incorrectas. Verifica tu usuario y clave.');
        inputClave?.select();
      }
    });
  </script>

  <script>
    import '../scripts/core/SmoothScroll.js';
  </script>
</body>
</html>

