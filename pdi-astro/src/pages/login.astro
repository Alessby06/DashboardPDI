    border-color: var(--border-subtle);
  }
  .showcase-title { color: var(--text-title); }
  .showcase-title::after {
    content: "";
    display: block;
    width: 64px;
    height: 4px;
    margin-top: 16px;
    border-radius: var(--radius-full);
