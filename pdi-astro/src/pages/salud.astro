---
import AppLayout from "../layouts/AppLayout.astro";
import FilterPanel from '../components/FilterPanel.astro';
import FilterField from '../components/FilterField.astro';
import { SEDES_OPERATIVAS } from "../data/opcionesBeneficiario.js";
import "../styles/views-salud.css";
import Icon from '../components/Icon.astro';

const OPCIONES_ANEMIA = [
  { valor: 'Normal', etiqueta: 'Normal (≥ 11.0 g/dL)' },
  { valor: 'Leve', etiqueta: 'Anemia Leve (10.0 - 10.9)' },
  { valor: 'Moderada', etiqueta: 'Anemia Moderada / Severa (< 10.0)' },
];
const OPCIONES_SEDE = SEDES_OPERATIVAS.map((sede) => ({ valor: sede.nombre, etiqueta: sede.etiqueta }));
const OPCIONES_HB = [
  { valor: 'anemia', etiqueta: 'Hb < 11.0 g/dL (Con Anemia)' },
  { valor: 'normal', etiqueta: 'Hb ≥ 11.0 g/dL (Normal)' },
  { valor: 'critico', etiqueta: 'Hb < 10.0 g/dL (Crítico)' },
];
---

<AppLayout title="Servicio Alimentario Nutricional" currentPage="salud">
  <section class="app-view active" id="view-salud">
    <div class="view-header">
      <div class="view-title-group">
        <h2>Servicio Alimentario Nutricional</h2>
        <p>
          Control antropométrico, semáforo automatizado de anemia MINSA, dosaje
          de hemoglobina y suplementación ferrosa.
        </p>
      </div>
      <div class="view-actions">
        <button type="button" class="btn-action-icon btn-audit-export-icon" id="btnExportSaludCSV"
          onclick="window.openModalExportSalud ? window.openModalExportSalud() : null"
          aria-label="Descargar Reporte CRED CSV" title="Descargar Reporte CRED CSV">
          <Icon name="accion.descargar" size={18} />
        </button>
      </div>
    </div>


    <!-- Tabla y Evaluaciones CRED en Tarjeta Unificada (Estandarizada con padron.astro) -->
    <div class="card" id="cardSaludEvaluaciones" style="margin-top: 18px;">
      <div class="card-header">
        <div class="card-title">Historial de Evaluaciones CRED por Usuario</div>
      </div>

      <!-- Barra de Filtros y Búsqueda Rápida de Salud CRED -->
      <div class="audit-toolbar" style="margin-bottom: 16px;">
        <!-- Buscador de Salud (Lado Izquierdo) -->
        <div class="audit-search-wrap">
          <Icon name="accion.buscar" size={2} class="audit-search-icon" />
          <input
            type="text"
            class="audit-search-input"
            id="inputSaludSearch"
            placeholder="Buscar usuario por nombre, código, DNI, apoderado o sede..."
            oninput="window.filterSaludSearch ? window.filterSaludSearch(this.value) : (window.PDI?.SaludCredView ? window.PDI.SaludCredView.filterBySearch(this.value) : null)"
          />
          <button
            type="button"
            class="audit-search-clear"
            id="btnSaludSearchClear"
            style="display:none;"
            onclick="window.clearSaludSearch ? window.clearSaludSearch() : (window.PDI?.SaludCredView ? window.PDI.SaludCredView.clearSearch() : null)"
            title="Limpiar búsqueda"
          >
            <Icon name="accion.cerrar" size={12} />
          </button>
        </div>

        <!-- Botonera de Filtros Salud (Lado Derecho) -->
        <FilterPanel
          id="dropdownSaludFilterPanel"
          buttonId="btnDropdownSaludFilterPanel"
          menuId="menuSaludFilterPanel"
          badgeId="saludActiveFiltersCount"
          title="Filtros Salud & Anemia CRED"
          reset="window.resetSaludFilters ? window.resetSaludFilters() : null"
        >
                <!-- Filtro 1: Diagnostico de Anemia (multiseleccion) -->
                <FilterField
                  id="dropdownSaludAnemia"
                  menuId="menuSaludAnemia"
                  labelId="labelSaludAnemiaSelect"
                  label="Diagnóstico de Anemia"
                  labelTodos="Todas las Condiciones"
                  todosEtiqueta="Todas las Condiciones"
                  opciones={OPCIONES_ANEMIA}
                  countPrefix="countFacetSaludAnemia"
                  onSelect="window.toggleSaludAnemia"
                  abrir="window.toggleInnerFilterDropdown ? window.toggleInnerFilterDropdown('dropdownSaludAnemia') : (window.toggleCustomDropdown ? window.toggleCustomDropdown('dropdownSaludAnemia') : null)"
                />
                
                <!-- Filtro 2: Sede Operativa (multiseleccion) -->
                <FilterField
                  id="dropdownSaludSede"
                  menuId="menuSaludSede"
                  labelId="labelSaludSedeSelect"
                  label="Sede Operativa"
                  labelTodos="Todas las Sedes"
                  todosEtiqueta="Todas las Sedes"
                  opciones={OPCIONES_SEDE}
                  countPrefix="countFacetSaludSede"
                  onSelect="window.toggleSaludSede"
                  abrir="window.toggleInnerFilterDropdown ? window.toggleInnerFilterDropdown('dropdownSaludSede') : (window.toggleCustomDropdown ? window.toggleCustomDropdown('dropdownSaludSede') : null)"
                />
                
                <!-- Filtro 3: Nivel de Hemoglobina (seleccion unica con radio) -->
                <FilterField
                  id="dropdownSaludHb"
                  menuId="menuSaludHb"
                  labelId="labelSaludHbSelect"
                  label="Rango de Hemoglobina"
                  labelTodos="Todos los Niveles"
                  todosEtiqueta="Todos los Niveles"
                  opciones={OPCIONES_HB}
                  tipo="single"
                  countPrefix="countFacetSaludHb"
                  conEtiqueta={true}
                  onSelect="window.selectSaludHb"
                  abrir="window.toggleInnerFilterDropdown ? window.toggleInnerFilterDropdown('dropdownSaludHb') : (window.toggleCustomDropdown ? window.toggleCustomDropdown('dropdownSaludHb') : null)"
                />
                        </FilterPanel>
      </div>

      <!-- Barra de Filtros Aplicados Salud -->
      <div class="padron-active-chips-bar" id="saludActiveChipsBar">
        <span class="padron-active-chips-label">Filtros aplicados:</span>
        <div id="saludActiveChipsList" style="display: flex; align-items: center; flex-wrap: wrap; gap: 6px;">
        </div>
        <button
          type="button"
          class="btn-text-subtle"
          style="margin-left: auto; font-size: 11.5px;"
          onclick="window.resetSaludFilters ? window.resetSaludFilters() : null"
          >Limpiar filtros</button
        >
      </div>

      <div class="table-container desktop-table-view">
        <table class="data-table">
          <thead>
            <tr>
              <th>Usuario</th>
              <th>Edad</th>
              <th>Peso / Talla</th>
              <th>Hemoglobina (Hb)</th>
              <th>Diagnóstico Anemia</th>
              <th>Suplementación</th>
              <th>Acciones</th>
            </tr>
          </thead>
          <tbody id="tbodySaludCred">
            <!-- Injected via JS -->
          </tbody>
        </table>
      </div>
      <div class="mobile-accordion-list" id="mobileCardsSalud">
        <!-- Injected via JS -->
      </div>

      <!-- Controles de Paginación de Salud CRED (PC / Móvil) -->
      <div class="padron-pagination-bar" id="saludPaginationBar">
        <div class="padron-pagination-left">
          <span id="saludPaginationInfo" style="font-size:12.5px; color:var(--text-muted); font-weight:500;">
            Mostrando 0 de 0 evaluaciones
          </span>
          <div class="padron-density-wrapper" id="saludDensityWrapper"
            style="display:flex; align-items:center; gap:6px;">
            <span style="font-size:12px; color:var(--text-dim);">Mostrar:</span>
            <select class="audit-density-select padron-density-select" id="selectSaludPageSize"
              onchange="window.saludSetPageSize ? window.saludSetPageSize(this.value) : (window.PDI?.SaludCredView?.setPageSize ? window.PDI.SaludCredView.setPageSize(this.value) : null)">
              <option value="10">10 por página</option>
              <option value="20" selected>20 por página</option>
              <option value="50">50 por página (Máx)</option>
            </select>
          </div>
        </div>
        <div class="padron-pagination-right">
          <button type="button" class="btn-page" id="btnSaludPagePrev"
            onclick="window.saludPrevPage ? window.saludPrevPage() : (window.PDI?.SaludCredView?.prevPage ? window.PDI.SaludCredView.prevPage() : null)">
            <Icon name="accion.volver" size={14} />
            <span>Anterior</span>
          </button>
          <span class="audit-page-indicator" id="saludCurrentPageNum">Página 1</span>
          <button type="button" class="btn-page" id="btnSaludPageNext"
            onclick="window.saludNextPage ? window.saludNextPage() : (window.PDI?.SaludCredView?.nextPage ? window.PDI.SaludCredView.nextPage() : null)">
            <span>Siguiente</span>
            <Icon name="accion.abrir" size={14} />
          </button>
        </div>
      </div>
    </div>
  </section>

  <script>
    import "../scripts/pages/salud.js";
  </script>
</AppLayout>
