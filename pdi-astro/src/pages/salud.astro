---
import AppLayout from '../layouts/AppLayout.astro';
import '../styles/views-salud.css';
---

<AppLayout title="Salud y Nutrición (CRED)" currentPage="salud">
        <section class="app-view active" id="view-salud">
          <div class="view-header">
            <div class="view-title-group">
              <h2>Salud y Nutrición CRED</h2>
              <p>Control antropométrico, semáforo automatizado de anemia MINSA, dosaje de hemoglobina y suplementación
                ferrosa.</p>
            </div>
          </div>

          <!-- Calculadora Antropométrica CRED Desplegable (Oculta por defecto) -->
          <div class="cred-calc-accordion" id="cardCalculadoraCred">
            <button type="button" class="cred-calc-toggle-btn" id="btnToggleCredCalc"
              onclick="window.toggleCalculadoraCred ? window.toggleCalculadoraCred() : null">
              <div class="cred-calc-header-left">
                <div class="cred-calc-icon-box">
                  <svg width="20" height="20" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round"
                      d="M15.75 15.75V18m-7.5-6.75h.008v.008H8.25v-.008zm0 2.25h.008v.008H8.25V13.5zm0 2.25h.008v.008H8.25v-.008zm0 2.25h.008v.008H8.25V18zm2.498-6.75h.007v.008h-.007v-.008zm0 2.25h.007v.008h-.007V13.5zm0 2.25h.007v.008h-.007v-.008zm0 2.25h.007v.008h-.007V18zm2.504-6.75h.008v.008h-.008v-.008zm0 2.25h.008v.008h-.008V13.5zm0 2.25h.008v.008h-.008v-.008zm0 2.25h.008v.008h-.008V18zm2.498-6.75h.008v.008h-.008v-.008zm0 2.25h.008v.008h-.008V13.5zM8.25 6h7.5v2.25h-7.5V6zM12 2.25c-5.385 0-9.75 4.365-9.75 9.75s4.365 9.75 9.75 9.75 9.75-4.365 9.75-9.75S17.385 2.25 12 2.25z" />
                  </svg>
                </div>
                <div>
                  <div class="cred-calc-title">Calculadora Antropométrica CRED</div>
                  <div class="cred-calc-subtitle">Dosaje de Hemoglobina y semáforo automatizado de anemia MINSA</div>
                </div>
              </div>
              <div class="cred-calc-header-right">
                <svg class="cred-calc-chevron" width="18" height="18" fill="none" stroke="currentColor"
                  stroke-width="2.5" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M19.5 8.25l-7.5 7.5-7.5-7.5" />
                </svg>
              </div>
            </button>

            <div class="cred-calc-body" id="credCalcBody" style="display: none;">
              <div class="cred-calc-grid">
                <div class="form-group">
                  <label for="calcHbInput">Hemoglobina (g/dL):</label>
                  <input type="number" step="0.1" class="form-control" id="calcHbInput" value="10.4"
                    oninput="calculateAnemiaPreview()">
                </div>
                <div class="form-group">
                  <label for="calcPesoInput">Peso (kg):</label>
                  <input type="number" step="0.1" class="form-control" id="calcPesoInput" value="14.2"
                    oninput="calculateAnemiaPreview()">
                </div>
                <div class="form-group">
                  <label for="calcTallaInput">Talla (cm):</label>
                  <input type="number" step="0.5" class="form-control" id="calcTallaInput" value="94.5"
                    oninput="calculateAnemiaPreview()">
                </div>
              </div>

              <div class="cred-calc-result-box" id="calcResultBox">
                <div class="cred-calc-result-header">
                  <span class="cred-calc-result-tag">Diagnóstico Clínico Automatizado:</span>
                </div>
                <div class="cred-calc-result-title" id="calcDiagnosticoLabel">Anemia Leve (10.0 - 10.9 g/dL)</div>
                <div class="cred-calc-result-action" id="calcAccionSugerida">
                  Acción: Iniciar suplementación con Sulfato Ferroso y control a los 30 días.
                </div>
              </div>
            </div>
          </div>

          <!-- Barra de Búsqueda y Filtros de Salud CRED -->
          <div class="card"
            style="margin-top: 18px; margin-bottom: 12px; padding: 12px 16px; position: relative; z-index: 80; overflow: visible;">
            <div class="sedes-controls-row"
              style="display: flex; align-items: center; justify-content: space-between; gap: 12px; flex-wrap: wrap;">

              <!-- Buscador de Salud (Lado Izquierdo) -->
              <div class="audit-search-wrap" style="flex: 1; min-width: 240px; position: relative;">
                <svg width="16" height="16" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"
                  style="position: absolute; left: 12px; top: 50%; transform: translateY(-50%); color: var(--text-dim); pointer-events: none;">
                  <path stroke-linecap="round" stroke-linejoin="round"
                    d="M21 21l-5.197-5.197m0 0A7.5 7.5 0 105.196 5.196a7.5 7.5 0 0010.607 10.607z" />
                </svg>
                <input type="text" class="audit-search-input" id="inputSaludSearch"
                  placeholder="Buscar menor por nombre, código, DNI, apoderado o sede..."
                  oninput="window.filterSaludSearch ? window.filterSaludSearch(this.value) : (window.PDI?.SaludCredView ? window.PDI.SaludCredView.filterBySearch(this.value) : null)"
                  style="width: 100%; padding-left: 36px; padding-right: 32px;">
                <button type="button" class="btn-clear-search" id="btnSaludSearchClear"
                  style="display:none; position: absolute; right: 10px; top: 50%; transform: translateY(-50%); background: none; border: none; color: var(--text-dim); cursor: pointer;"
                  onclick="window.clearSaludSearch ? window.clearSaludSearch() : (window.PDI?.SaludCredView ? window.PDI.SaludCredView.clearSearch() : null)">
                  <svg width="14" height="14" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M6 18L18 6M6 6l12 12" />
                  </svg>
                </button>
              </div>

              <!-- Botonera de Filtros Salud -->
              <div style="display: flex; align-items: center; gap: 8px;">
                <div class="custom-dropdown audit-filters-dropdown" id="dropdownSaludFilterPanel">
                  <button type="button" class="btn-action audit-filter-btn" id="btnDropdownSaludFilterPanel"
                    onclick="window.toggleCustomDropdown ? window.toggleCustomDropdown('dropdownSaludFilterPanel') : null">
                    <svg width="16" height="16" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
                      <path stroke-linecap="round" stroke-linejoin="round"
                        d="M12 3c2.755 0 5.455.232 8.083.678.533.09.917.556.917 1.096v1.044a2.25 2.25 0 01-.659 1.591l-5.432 5.432a2.25 2.25 0 00-.659 1.591v2.927a2.25 2.25 0 01-1.244 2.013L9.75 21v-6.568a2.25 2.25 0 00-.659-1.591L3.659 7.409A2.25 2.25 0 013 5.818V4.774c0-.54.384-1.006.917-1.096A48.32 48.32 0 0112 3z" />
                    </svg>
                    <span>Filtros</span>
                    <span class="audit-filter-badge" id="saludActiveFiltersCount" style="display:none;">0</span>
                    <svg width="12" height="12" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24"
                      class="filter-caret">
                      <path stroke-linecap="round" stroke-linejoin="round" d="M19.5 8.25l-7.5 7.5-7.5-7.5" />
                    </svg>
                  </button>

                  <div class="custom-dropdown-menu audit-filters-menu" id="menuSaludFilterPanel">
                    <div class="audit-filters-header">
                      <div class="audit-filters-header-title">
                        <svg width="15" height="15" fill="none" stroke="currentColor" stroke-width="2"
                          viewBox="0 0 24 24">
                          <path stroke-linecap="round" stroke-linejoin="round"
                            d="M12 3c2.755 0 5.455.232 8.083.678.533.09.917.556.917 1.096v1.044a2.25 2.25 0 01-.659 1.591l-5.432 5.432a2.25 2.25 0 00-.659 1.591v2.927a2.25 2.25 0 01-1.244 2.013L9.75 21v-6.568a2.25 2.25 0 00-.659-1.591L3.659 7.409A2.25 2.25 0 013 5.818V4.774c0-.54.384-1.006.917-1.096A48.32 48.32 0 0112 3z" />
                        </svg>
                        <span>Filtros Salud & Anemia CRED</span>
                      </div>
                      <button type="button" class="btn-text-subtle"
                        onclick="window.resetSaludFilters ? window.resetSaludFilters() : null">Restablecer</button>
                    </div>

                    <div class="audit-filters-body">
                      <!-- Filtro 1: Diagnóstico Anemia -->
                      <div class="audit-filter-field">
                        <label class="audit-field-label">Diagnóstico de Anemia</label>
                        <div class="padron-inner-dropdown" id="dropdownSaludAnemia">
                          <button type="button" class="padron-inner-dropdown-btn"
                            onclick="window.toggleInnerFilterDropdown ? window.toggleInnerFilterDropdown('dropdownSaludAnemia') : (window.toggleCustomDropdown ? window.toggleCustomDropdown('dropdownSaludAnemia') : null)">
                            <span id="labelSaludAnemiaSelect">Todas las Condiciones</span>
                            <svg class="caret" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24">
                              <path stroke-linecap="round" stroke-linejoin="round" d="M19.5 8.25l-7.5 7.5-7.5-7.5" />
                            </svg>
                          </button>
                          <div class="padron-inner-dropdown-menu" id="menuSaludAnemia">
                            <div class="padron-dropdown-item selected" data-value="all"
                              onclick="window.toggleSaludAnemia ? window.toggleSaludAnemia('all') : null">
                              <div class="padron-item-left">
                                <span class="padron-item-checkbox">
                                  <svg width="10" height="10" fill="none" stroke="currentColor" stroke-width="3"
                                    viewBox="0 0 24 24">
                                    <path stroke-linecap="round" stroke-linejoin="round" d="M4.5 12.75l6 6 9-13.5" />
                                  </svg>
                                </span>
                                <span class="padron-item-label">Todas las Condiciones</span>
                              </div>
                            </div>
                            <div class="padron-dropdown-item" data-value="Normal"
                              onclick="window.toggleSaludAnemia ? window.toggleSaludAnemia('Normal') : null">
                              <div class="padron-item-left">
                                <span class="padron-item-checkbox">
                                  <svg width="10" height="10" fill="none" stroke="currentColor" stroke-width="3"
                                    viewBox="0 0 24 24">
                                    <path stroke-linecap="round" stroke-linejoin="round" d="M4.5 12.75l6 6 9-13.5" />
                                  </svg>
                                </span>
                                <span class="padron-item-label">Normal (≥ 11.0 g/dL)</span>
                              </div>
                            </div>
                            <div class="padron-dropdown-item" data-value="Leve"
                              onclick="window.toggleSaludAnemia ? window.toggleSaludAnemia('Leve') : null">
                              <div class="padron-item-left">
                                <span class="padron-item-checkbox">
                                  <svg width="10" height="10" fill="none" stroke="currentColor" stroke-width="3"
                                    viewBox="0 0 24 24">
                                    <path stroke-linecap="round" stroke-linejoin="round" d="M4.5 12.75l6 6 9-13.5" />
                                  </svg>
                                </span>
                                <span class="padron-item-label">Anemia Leve (10.0 - 10.9)</span>
                              </div>
                            </div>
                            <div class="padron-dropdown-item" data-value="Moderada"
                              onclick="window.toggleSaludAnemia ? window.toggleSaludAnemia('Moderada') : null">
                              <div class="padron-item-left">
                                <span class="padron-item-checkbox">
                                  <svg width="10" height="10" fill="none" stroke="currentColor" stroke-width="3"
                                    viewBox="0 0 24 24">
                                    <path stroke-linecap="round" stroke-linejoin="round" d="M4.5 12.75l6 6 9-13.5" />
                                  </svg>
                                </span>
                                <span class="padron-item-label">Anemia Moderada / Severa (&lt; 10.0)</span>
                              </div>
                            </div>
                          </div>
                        </div>
                      </div>

                      <!-- Filtro 2: Sede Operativa -->
                      <div class="audit-filter-field">
                        <label class="audit-field-label">Sede Operativa</label>
                        <div class="padron-inner-dropdown" id="dropdownSaludSede">
                          <button type="button" class="padron-inner-dropdown-btn"
                            onclick="window.toggleInnerFilterDropdown ? window.toggleInnerFilterDropdown('dropdownSaludSede') : (window.toggleCustomDropdown ? window.toggleCustomDropdown('dropdownSaludSede') : null)">
                            <span id="labelSaludSedeSelect">Todas las Sedes</span>
                            <svg class="caret" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24">
                              <path stroke-linecap="round" stroke-linejoin="round" d="M19.5 8.25l-7.5 7.5-7.5-7.5" />
                            </svg>
                          </button>
                          <div class="padron-inner-dropdown-menu" id="menuSaludSede">
                            <div class="padron-dropdown-item selected" data-value="all"
                              onclick="window.toggleSaludSede ? window.toggleSaludSede('all') : null">
                              <div class="padron-item-left">
                                <span class="padron-item-checkbox">
                                  <svg width="10" height="10" fill="none" stroke="currentColor" stroke-width="3"
                                    viewBox="0 0 24 24">
                                    <path stroke-linecap="round" stroke-linejoin="round" d="M4.5 12.75l6 6 9-13.5" />
                                  </svg>
                                </span>
                                <span class="padron-item-label">Todas las Sedes</span>
                              </div>
                            </div>
                            <div class="padron-dropdown-item" data-value="Año Nuevo"
                              onclick="window.toggleSaludSede ? window.toggleSaludSede('Año Nuevo') : null">
                              <div class="padron-item-left">
                                <span class="padron-item-checkbox">
                                  <svg width="10" height="10" fill="none" stroke="currentColor" stroke-width="3"
                                    viewBox="0 0 24 24">
                                    <path stroke-linecap="round" stroke-linejoin="round" d="M4.5 12.75l6 6 9-13.5" />
                                  </svg>
                                </span>
                                <span class="padron-item-label">Año Nuevo (Comas)</span>
                              </div>
                            </div>
                            <div class="padron-dropdown-item" data-value="La Libertad"
                              onclick="window.toggleSaludSede ? window.toggleSaludSede('La Libertad') : null">
                              <div class="padron-item-left">
                                <span class="padron-item-checkbox">
                                  <svg width="10" height="10" fill="none" stroke="currentColor" stroke-width="3"
                                    viewBox="0 0 24 24">
                                    <path stroke-linecap="round" stroke-linejoin="round" d="M4.5 12.75l6 6 9-13.5" />
                                  </svg>
                                </span>
                                <span class="padron-item-label">La Libertad (Comas)</span>
                              </div>
                            </div>
                            <div class="padron-dropdown-item" data-value="San Pedro"
                              onclick="window.toggleSaludSede ? window.toggleSaludSede('San Pedro') : null">
                              <div class="padron-item-left">
                                <span class="padron-item-checkbox">
                                  <svg width="10" height="10" fill="none" stroke="currentColor" stroke-width="3"
                                    viewBox="0 0 24 24">
                                    <path stroke-linecap="round" stroke-linejoin="round" d="M4.5 12.75l6 6 9-13.5" />
                                  </svg>
                                </span>
                                <span class="padron-item-label">San Pedro (Carabayllo)</span>
                              </div>
                            </div>
                            <div class="padron-dropdown-item" data-value="El Progreso"
                              onclick="window.toggleSaludSede ? window.toggleSaludSede('El Progreso') : null">
                              <div class="padron-item-left">
                                <span class="padron-item-checkbox">
                                  <svg width="10" height="10" fill="none" stroke="currentColor" stroke-width="3"
                                    viewBox="0 0 24 24">
                                    <path stroke-linecap="round" stroke-linejoin="round" d="M4.5 12.75l6 6 9-13.5" />
                                  </svg>
                                </span>
                                <span class="padron-item-label">El Progreso (Carabayllo)</span>
                              </div>
                            </div>
                            <div class="padron-dropdown-item" data-value="Santa Rosa"
                              onclick="window.toggleSaludSede ? window.toggleSaludSede('Santa Rosa') : null">
                              <div class="padron-item-left">
                                <span class="padron-item-checkbox">
                                  <svg width="10" height="10" fill="none" stroke="currentColor" stroke-width="3"
                                    viewBox="0 0 24 24">
                                    <path stroke-linecap="round" stroke-linejoin="round" d="M4.5 12.75l6 6 9-13.5" />
                                  </svg>
                                </span>
                                <span class="padron-item-label">Santa Rosa (Carabayllo)</span>
                              </div>
                            </div>
                            <div class="padron-dropdown-item" data-value="Los Bendecidos"
                              onclick="window.toggleSaludSede ? window.toggleSaludSede('Los Bendecidos') : null">
                              <div class="padron-item-left">
                                <span class="padron-item-checkbox">
                                  <svg width="10" height="10" fill="none" stroke="currentColor" stroke-width="3"
                                    viewBox="0 0 24 24">
                                    <path stroke-linecap="round" stroke-linejoin="round" d="M4.5 12.75l6 6 9-13.5" />
                                  </svg>
                                </span>
                                <span class="padron-item-label">Los Bendecidos (Carabayllo)</span>
                              </div>
                            </div>
                          </div>
                        </div>
                      </div>

                      <!-- Filtro 3: Nivel Hemoglobina -->
                      <div class="audit-filter-field">
                        <label class="audit-field-label">Rango de Hemoglobina</label>
                        <div class="padron-inner-dropdown" id="dropdownSaludHb">
                          <button type="button" class="padron-inner-dropdown-btn"
                            onclick="window.toggleInnerFilterDropdown ? window.toggleInnerFilterDropdown('dropdownSaludHb') : (window.toggleCustomDropdown ? window.toggleCustomDropdown('dropdownSaludHb') : null)">
                            <span id="labelSaludHbSelect">Todos los Niveles</span>
                            <svg class="caret" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24">
                              <path stroke-linecap="round" stroke-linejoin="round" d="M19.5 8.25l-7.5 7.5-7.5-7.5" />
                            </svg>
                          </button>
                          <div class="padron-inner-dropdown-menu" id="menuSaludHb">
                            <div class="padron-dropdown-item selected" data-value="all"
                              onclick="window.selectSaludHb ? window.selectSaludHb('all', 'Todos los Niveles') : null">
                              <div class="padron-item-left">
                                <span class="padron-item-radio"></span>
                                <span class="padron-item-label">Todos los Niveles</span>
                              </div>
                            </div>
                            <div class="padron-dropdown-item" data-value="anemia"
                              onclick="window.selectSaludHb ? window.selectSaludHb('anemia', 'Hb < 11.0 g/dL (Con Anemia)') : null">
                              <div class="padron-item-left">
                                <span class="padron-item-radio"></span>
                                <span class="padron-item-label">Hb &lt; 11.0 g/dL (Con Anemia)</span>
                              </div>
                            </div>
                            <div class="padron-dropdown-item" data-value="normal"
                              onclick="window.selectSaludHb ? window.selectSaludHb('normal', 'Hb ≥ 11.0 g/dL (Normal)') : null">
                              <div class="padron-item-left">
                                <span class="padron-item-radio"></span>
                                <span class="padron-item-label">Hb &ge; 11.0 g/dL (Normal)</span>
                              </div>
                            </div>
                            <div class="padron-dropdown-item" data-value="critico"
                              onclick="window.selectSaludHb ? window.selectSaludHb('critico', 'Hb < 10.0 g/dL (Crítico)') : null">
                              <div class="padron-item-left">
                                <span class="padron-item-radio"></span>
                                <span class="padron-item-label">Hb &lt; 10.0 g/dL (Crítico)</span>
                              </div>
                            </div>
                          </div>
                        </div>
                      </div>

                    </div>
                  </div>
                </div>
              </div>
            </div>

            <!-- Barra de Filtros Aplicados Salud -->
            <div class="padron-active-chips-bar" id="saludActiveChipsBar"
              style="display: none; margin-top: 10px; padding-top: 8px; border-top: 1px solid var(--border-subtle);">
              <span class="padron-active-chips-label">Filtros aplicados:</span>
              <div id="saludActiveChipsList" style="display: flex; align-items: center; flex-wrap: wrap; gap: 6px;">
              </div>
              <button type="button" class="btn-text-subtle" style="margin-left: auto; font-size: 11.5px;"
                onclick="window.resetSaludFilters ? window.resetSaludFilters() : null">Limpiar todo</button>
            </div>
          </div>

          <!-- CRED Registrations Table & Mobile Cards -->
          <div class="card" style="margin-top: 0px;">
            <div class="card-header" style="display: flex; justify-content: space-between; align-items: center;">
              <div class="card-title">Historial de Evaluaciones CRED por Menor</div>
              <div id="saludRecordsCount" style="font-size: 12.5px; color: var(--text-muted); font-weight: 600;"></div>
            </div>
            <div class="table-container desktop-table-view">
              <table class="data-table">
                <thead>
                  <tr>
                    <th>Beneficiario</th>
                    <th>Edad</th>
                    <th>Peso / Talla</th>
                    <th>Hemoglobina (Hb)</th>
                    <th>Diagnóstico Anemia</th>
                    <th>Suplementación</th>
                    <th style="text-align: right;">Acciones</th>
                  </tr>
                </thead>
                <tbody id="tbodySaludCred">
                  <!-- Injected via JS -->
                </tbody>
              </table>
            </div>
            <div class="mobile-accordion-list" id="mobileCardsSalud">
              <!-- Injected via JS -->
            </div>
          </div>
        </section>

  <script>
    import '../scripts/pages/salud.js';
  </script>
</AppLayout>