---
import AppLayout from "../layouts/AppLayout.astro";
import { SEDES_OPERATIVAS } from "../data/opcionesBeneficiario.js";
import "../styles/views-salud.css";
---

<AppLayout title="Servicio Alimentario Nutricional" currentPage="salud">
  <section class="app-view active" id="view-salud">
    <div class="view-header">
      <div class="view-title-group">
        <h2>Servicio Alimentario Nutricional</h2>
        <p>
          Control antropométrico, semáforo automatizado de anemia MINSA, dosaje
          de hemoglobina y suplementación ferrosa.
        </p>
      </div>
      <div class="view-actions">
        <button type="button" class="btn-action primary" id="btnRegistrarDosaje"
          onclick="window.abrirSelectorDosaje ? window.abrirSelectorDosaje() : null">
          <svg width="16" height="16" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24" aria-hidden="true">
            <path stroke-linecap="round" stroke-linejoin="round" d="M12 5v14M5 12h14" />
          </svg>
          Registrar dosaje
        </button>
        <button type="button" class="btn-action-icon btn-audit-export-icon" id="btnExportSaludCSV"
          onclick="window.openModalExportSalud ? window.openModalExportSalud() : null"
          aria-label="Descargar Reporte CRED CSV" title="Descargar Reporte CRED CSV">
          <svg width="18" height="18" fill="none" stroke="currentColor" stroke-width="2.2" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round"
              d="M3 16.5v2.25A2.25 2.25 0 005.25 21h13.5A2.25 2.25 0 0021 18.75V16.5M16.5 12L12 16.5m0 0L7.5 12m4.5 4.5V3" />
          </svg>
        </button>
      </div>
    </div>

    <!-- Panel rápido CRED: semáforo MINSA + KPIs (sustituye a la calculadora) -->
    <section class="panel dash-rapido" id="dashRapido" aria-label="Panel rápido de salud CRED">
      <div class="dash-rapido-head">
        <h3 class="dash-rapido-title">Panel rápido CRED</h3>
        <p class="dash-rapido-hint">Selecciona la leyenda, el anillo o «Con anemia» para filtrar la tabla de evaluaciones</p>
      </div>
      <div class="dash-rapido-statusbar">
        <p class="dash-rapido-state" id="dashRapidoState" tabindex="-1" aria-live="polite">Mostrando los usuarios del padrón</p>
        <button type="button" class="dash-rapido-clear" id="dashRapidoClear" hidden
          onclick="window.resetSaludFilters ? window.resetSaludFilters() : null">Ver todo</button>
      </div>
      <div class="dash-rapido-body">
        <div class="dash-donut-wrap">
          <svg class="dash-donut" id="dashDonut" width="168" height="168" viewBox="0 0 168 168" role="img" aria-label="Distribución de diagnósticos por semáforo MINSA">
            <circle class="dash-donut-track" cx="84" cy="84" r="66"></circle>
            <g id="dashDonutArcs"></g>
          </svg>
          <div class="dash-donut-center" aria-hidden="true">
            <strong id="dashDonutPct">46%</strong>
            <span id="dashDonutLabel">Normal</span>
          </div>
        </div>

                <div class="dash-leyenda" id="dashLeyenda" role="group" aria-label="Filtrar la tabla por diagnóstico">
          <button type="button" class="dash-leyenda-item" data-clase="Normal" style="--dash-seg:var(--gt-green);" aria-pressed="false" title="Filtrar la tabla por normal" onclick="window.dashboardFiltrar ? window.dashboardFiltrar('clase', 'Normal') : null"><span class="dash-leyenda-dot" aria-hidden="true"></span><span class="dash-leyenda-name">Normal <span class="dash-leyenda-rango">≥ 11.0</span></span><span class="dash-leyenda-count" id="dashCuentaNormal">6</span><span class="dash-leyenda-pct" id="dashPctNormal">46%</span></button>
          <button type="button" class="dash-leyenda-item" data-clase="Leve" style="--dash-seg:var(--gt-yellow);" aria-pressed="false" title="Filtrar la tabla por leve" onclick="window.dashboardFiltrar ? window.dashboardFiltrar('clase', 'Leve') : null"><span class="dash-leyenda-dot" aria-hidden="true"></span><span class="dash-leyenda-name">Leve <span class="dash-leyenda-rango">10.0–10.9</span></span><span class="dash-leyenda-count" id="dashCuentaLeve">5</span><span class="dash-leyenda-pct" id="dashPctLeve">38%</span></button>
          <button type="button" class="dash-leyenda-item" data-clase="Moderada" style="--dash-seg:linear-gradient(90deg, var(--gt-orange) 50%, var(--gt-red) 50%);" aria-pressed="false" title="Filtrar la tabla por moderada o severa" onclick="window.dashboardFiltrar ? window.dashboardFiltrar('clase', 'Moderada') : null"><span class="dash-leyenda-dot" aria-hidden="true"></span><span class="dash-leyenda-name">Moderada o severa <span class="dash-leyenda-rango">7.0–9.9</span></span><span class="dash-leyenda-count" id="dashCuentaModerada">2</span><span class="dash-leyenda-pct" id="dashPctModerada">15%</span></button>
        </div>
        <div class="dash-kpis">
          <div class="dash-kpi dash-kpi--compact dash-kpi--static" id="dashKpiCartera" title="Usuarios del padrón de salud">
            <span class="dash-kpi-label">Usuarios en cartera</span>
            <strong class="dash-kpi-value" id="dashKpiCarteraVal">13</strong>
            <span class="dash-kpi-note" id="dashKpiCarteraNote">13 con diagnóstico activo</span>
          </div>
          <button type="button" class="dash-kpi dash-kpi--compact" id="dashKpiAnemia" style="--dash-kpi-ring: var(--gt-yellow);" title="Filtrar la tabla: Hb menor a 11.0 g/dL" aria-pressed="false" onclick="window.dashboardFiltrar ? window.dashboardFiltrar('hb', 'anemia') : null">
            <span class="dash-kpi-label">Con anemia</span>
            <strong class="dash-kpi-value" id="dashKpiAnemiaVal">7</strong>
            <span class="dash-kpi-note" id="dashKpiAnemiaNote">54% de los diagnosticados</span>
          </button>
          <div class="dash-kpi dash-kpi--compact dash-kpi--static" id="dashKpiHb" title="Promedio del valor de hemoglobina vigente del padrón">
            <span class="dash-kpi-label">Hb promedio</span>
            <strong class="dash-kpi-value is-leve" id="dashKpiHbVal">10.9</strong>
            <span class="dash-kpi-note" id="dashKpiHbNote">g/dL · promedio de 13 con dato</span>
          </div>
          <div class="dash-kpi dash-kpi--compact dash-kpi--static" id="dashKpiMes" title="Dosajes de hemoglobina registrados en el mes en curso">
            <span class="dash-kpi-label">Pruebas este mes</span>
            <strong class="dash-kpi-value" id="dashKpiMesVal">38</strong>
            <span class="dash-kpi-note" id="dashKpiMesNote">dosajes en Octubre</span>
          </div>
        </div>
      </div>
    </section>

    <!-- Selector de usuario para registrar un dosaje desde la cabecera -->
    <div class="modal-backdrop" id="modalElegirDosaje" inert aria-hidden="true"
      onclick="if (event.target === this && window.cerrarSelectorDosaje) window.cerrarSelectorDosaje()">
      <div class="modal-box" role="dialog" aria-modal="true" aria-labelledby="elegirDosajeTitulo"
        style="max-width: 560px; width: 92%; max-height: 85vh; overflow-y: auto;">
        <div class="modal-header">
          <div>
            <h3 id="elegirDosajeTitulo"
              style="margin: 0; font-size: 16px; font-weight: 800; color: var(--text-main);">Registrar dosaje</h3>
            <p style="margin: 3px 0 0; font-size: 12px; color: var(--text-muted);">
              Elige el usuario al que se le tomará la hemoglobina.
            </p>
          </div>
          <button type="button" class="btn-close-modal"
            onclick="window.cerrarSelectorDosaje ? window.cerrarSelectorDosaje() : null" aria-label="Cerrar">
            <svg width="18" height="18" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" d="M6 18L18 6M6 6l12 12" />
            </svg>
          </button>
        </div>
        <div class="modal-body" style="padding: 10px 20px 18px;">
          <div id="elegirDosajeLista" class="elegir-dosaje-lista"></div>
        </div>
      </div>
    </div>

    <!-- Tabla y Evaluaciones CRED en Tarjeta Unificada (Estandarizada con padron.astro) -->
    <div class="card" id="cardSaludEvaluaciones" style="margin-top: 18px;">
      <div class="card-header">
        <div class="card-title">Historial de Evaluaciones CRED por Usuario</div>
      </div>

      <!-- Barra de Filtros y Búsqueda Rápida de Salud CRED -->
      <div class="audit-toolbar" style="margin-bottom: 16px;">
        <!-- Buscador de Salud (Lado Izquierdo) -->
        <div class="audit-search-wrap">
          <svg class="audit-search-icon" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round"
              d="M21 21l-5.197-5.197m0 0A7.5 7.5 0 105.196 5.196a7.5 7.5 0 0010.607 10.607z" />
          </svg>
          <input
            type="text"
            class="audit-search-input"
            id="inputSaludSearch"
            placeholder="Buscar usuario por nombre, código, DNI, apoderado o sede..."
            oninput="window.filterSaludSearch ? window.filterSaludSearch(this.value) : (window.PDI?.SaludCredView ? window.PDI.SaludCredView.filterBySearch(this.value) : null)"
          />
          <button
            type="button"
            class="audit-search-clear"
            id="btnSaludSearchClear"
            style="display:none;"
            onclick="window.clearSaludSearch ? window.clearSaludSearch() : (window.PDI?.SaludCredView ? window.PDI.SaludCredView.clearSearch() : null)"
            title="Limpiar búsqueda"
          >
            <svg width="12" height="12" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" d="M6 18L18 6M6 6l12 12" />
            </svg>
          </button>
        </div>

        <!-- Botonera de Filtros Salud (Lado Derecho) -->
        <div class="audit-filter-panel-wrap">
          <div
            class="custom-dropdown audit-filters-dropdown"
            id="dropdownSaludFilterPanel"
          >
            <button
              type="button"
              class="btn-action audit-filter-btn"
              id="btnDropdownSaludFilterPanel"
              onclick="window.toggleCustomDropdown ? window.toggleCustomDropdown('dropdownSaludFilterPanel') : null"
            >
              <svg
                width="16"
                height="16"
                fill="none"
                stroke="currentColor"
                stroke-width="2"
                viewBox="0 0 24 24"
              >
                <path
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  d="M12 3c2.755 0 5.455.232 8.083.678.533.09.917.556.917 1.096v1.044a2.25 2.25 0 01-.659 1.591l-5.432 5.432a2.25 2.25 0 00-.659 1.591v2.927a2.25 2.25 0 01-1.244 2.013L9.75 21v-6.568a2.25 2.25 0 00-.659-1.591L3.659 7.409A2.25 2.25 0 013 5.818V4.774c0-.54.384-1.006.917-1.096A48.32 48.32 0 0112 3z"
                ></path>
              </svg>
              <span>Filtros</span>
              <span
                class="audit-filter-badge"
                id="saludActiveFiltersCount"
                style="display:none;">0</span
              >
              <svg
                width="12"
                height="12"
                fill="none"
                stroke="currentColor"
                stroke-width="2.5"
                viewBox="0 0 24 24"
                class="filter-caret"
              >
                <path
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  d="M19.5 8.25l-7.5 7.5-7.5-7.5"></path>
              </svg>
            </button>

            <div
              class="custom-dropdown-menu audit-filters-menu"
              id="menuSaludFilterPanel"
            >
              <div class="audit-filters-header">
                <div class="audit-filters-header-title">
                  <span>Filtros Salud & Anemia CRED</span>
                </div>
                <div class="audit-filters-header-actions">
                  <button
                    type="button"
                    class="btn-text-subtle"
                    onclick="window.resetSaludFilters ? window.resetSaludFilters() : null"
                    >Restablecer</button
                  >
                  <button type="button" class="btn-close-sheet" aria-label="Cerrar filtros"
                    onclick="window.closeAllFilterSheets ? window.closeAllFilterSheets() : null">
                    <svg width="15" height="15" fill="none" stroke="currentColor" stroke-width="2.2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M6 18L18 6M6 6l12 12"/></svg>
                  </button>
                </div>
              </div>

              <div class="audit-filters-body">
                <!-- Filtro 1: Diagnóstico Anemia -->
                <div class="audit-filter-field">
                  <label class="audit-field-label">Diagnóstico de Anemia</label>
                  <div class="padron-inner-dropdown" id="dropdownSaludAnemia">
                    <button
                      type="button"
                      class="padron-inner-dropdown-btn"
                      onclick="window.toggleInnerFilterDropdown ? window.toggleInnerFilterDropdown('dropdownSaludAnemia') : (window.toggleCustomDropdown ? window.toggleCustomDropdown('dropdownSaludAnemia') : null)"
                    >
                      <span id="labelSaludAnemiaSelect"
                        >Todas las Condiciones</span
                      >
                      <svg
                        class="caret"
                        fill="none"
                        stroke="currentColor"
                        stroke-width="2.5"
                        viewBox="0 0 24 24"
                      >
                        <path
                          stroke-linecap="round"
                          stroke-linejoin="round"
                          d="M19.5 8.25l-7.5 7.5-7.5-7.5"></path>
                      </svg>
                    </button>
                    <div
                      class="padron-inner-dropdown-menu"
                      id="menuSaludAnemia"
                    >
                      <div
                        class="padron-dropdown-item selected"
                        data-value="all"
                        onclick="window.toggleSaludAnemia ? window.toggleSaludAnemia('all') : null"
                      >
                        <div class="padron-item-left">
                          <span class="padron-item-checkbox">
                            <svg
                              width="10"
                              height="10"
                              fill="none"
                              stroke="currentColor"
                              stroke-width="3"
                              viewBox="0 0 24 24"
                            >
                              <path
                                stroke-linecap="round"
                                stroke-linejoin="round"
                                d="M4.5 12.75l6 6 9-13.5"></path>
                            </svg>
                          </span>
                          <span class="padron-item-label"
                            >Todas las Condiciones</span
                          >
                        </div>
                      </div>
                      <div
                        class="padron-dropdown-item"
                        data-value="Normal"
                        onclick="window.toggleSaludAnemia ? window.toggleSaludAnemia('Normal') : null"
                      >
                        <div class="padron-item-left">
                          <span class="padron-item-checkbox">
                            <svg
                              width="10"
                              height="10"
                              fill="none"
                              stroke="currentColor"
                              stroke-width="3"
                              viewBox="0 0 24 24"
                            >
                              <path
                                stroke-linecap="round"
                                stroke-linejoin="round"
                                d="M4.5 12.75l6 6 9-13.5"></path>
                            </svg>
                          </span>
                          <span class="padron-item-label"
                            >Normal (≥ 11.0 g/dL)</span
                          >
                        </div>
                      </div>
                      <div
                        class="padron-dropdown-item"
                        data-value="Leve"
                        onclick="window.toggleSaludAnemia ? window.toggleSaludAnemia('Leve') : null"
                      >
                        <div class="padron-item-left">
                          <span class="padron-item-checkbox">
                            <svg
                              width="10"
                              height="10"
                              fill="none"
                              stroke="currentColor"
                              stroke-width="3"
                              viewBox="0 0 24 24"
                            >
                              <path
                                stroke-linecap="round"
                                stroke-linejoin="round"
                                d="M4.5 12.75l6 6 9-13.5"></path>
                            </svg>
                          </span>
                          <span class="padron-item-label"
                            >Anemia Leve (10.0 - 10.9)</span
                          >
                        </div>
                      </div>
                      <div
                        class="padron-dropdown-item"
                        data-value="Moderada"
                        onclick="window.toggleSaludAnemia ? window.toggleSaludAnemia('Moderada') : null"
                      >
                        <div class="padron-item-left">
                          <span class="padron-item-checkbox">
                            <svg
                              width="10"
                              height="10"
                              fill="none"
                              stroke="currentColor"
                              stroke-width="3"
                              viewBox="0 0 24 24"
                            >
                              <path
                                stroke-linecap="round"
                                stroke-linejoin="round"
                                d="M4.5 12.75l6 6 9-13.5"></path>
                            </svg>
                          </span>
                          <span class="padron-item-label"
                            >Anemia Moderada / Severa (&lt; 10.0)</span
                          >
                        </div>
                      </div>
                    </div>
                  </div>
                </div>

                <!-- Filtro 2: Sede Operativa -->
                <div class="audit-filter-field">
                  <label class="audit-field-label">Sede Operativa</label>
                  <div class="padron-inner-dropdown" id="dropdownSaludSede">
                    <button
                      type="button"
                      class="padron-inner-dropdown-btn"
                      onclick="window.toggleInnerFilterDropdown ? window.toggleInnerFilterDropdown('dropdownSaludSede') : (window.toggleCustomDropdown ? window.toggleCustomDropdown('dropdownSaludSede') : null)"
                    >
                      <span id="labelSaludSedeSelect">Todas las Sedes</span>
                      <svg
                        class="caret"
                        fill="none"
                        stroke="currentColor"
                        stroke-width="2.5"
                        viewBox="0 0 24 24"
                      >
                        <path
                          stroke-linecap="round"
                          stroke-linejoin="round"
                          d="M19.5 8.25l-7.5 7.5-7.5-7.5"></path>
                      </svg>
                    </button>
                    <div class="padron-inner-dropdown-menu" id="menuSaludSede">
                      <div
                        class="padron-dropdown-item selected"
                        data-value="all"
                        onclick="window.toggleSaludSede ? window.toggleSaludSede('all') : null"
                      >
                        <div class="padron-item-left">
                          <span class="padron-item-checkbox">
                            <svg
                              width="10"
                              height="10"
                              fill="none"
                              stroke="currentColor"
                              stroke-width="3"
                              viewBox="0 0 24 24"
                            >
                              <path
                                stroke-linecap="round"
                                stroke-linejoin="round"
                                d="M4.5 12.75l6 6 9-13.5"></path>
                            </svg>
                          </span>
                          <span class="padron-item-label">Todas las Sedes</span>
                        </div>
                      </div>
                      {SEDES_OPERATIVAS.map((sede) => (
                        <div
                          class="padron-dropdown-item"
                          data-value={sede.nombre}
                          onclick={`window.toggleSaludSede ? window.toggleSaludSede('${sede.nombre}') : null`}
                        >
                          <div class="padron-item-left">
                            <span class="padron-item-checkbox">
                              <svg
                                width="10"
                                height="10"
                                fill="none"
                                stroke="currentColor"
                                stroke-width="3"
                                viewBox="0 0 24 24"
                              >
                                <path
                                  stroke-linecap="round"
                                  stroke-linejoin="round"
                                  d="M4.5 12.75l6 6 9-13.5"></path>
                              </svg>
                            </span>
                            <span class="padron-item-label">{sede.etiqueta}</span>
                          </div>
                        </div>
                      ))}
                    </div>
                  </div>
                </div>

                <!-- Filtro 3: Nivel Hemoglobina -->
                <div class="audit-filter-field">
                  <label class="audit-field-label">Rango de Hemoglobina</label>
                  <div class="padron-inner-dropdown" id="dropdownSaludHb">
                    <button
                      type="button"
                      class="padron-inner-dropdown-btn"
                      onclick="window.toggleInnerFilterDropdown ? window.toggleInnerFilterDropdown('dropdownSaludHb') : (window.toggleCustomDropdown ? window.toggleCustomDropdown('dropdownSaludHb') : null)"
                    >
                      <span id="labelSaludHbSelect">Todos los Niveles</span>
                      <svg
                        class="caret"
                        fill="none"
                        stroke="currentColor"
                        stroke-width="2.5"
                        viewBox="0 0 24 24"
                      >
                        <path
                          stroke-linecap="round"
                          stroke-linejoin="round"
                          d="M19.5 8.25l-7.5 7.5-7.5-7.5"></path>
                      </svg>
                    </button>
                    <div class="padron-inner-dropdown-menu" id="menuSaludHb">
                      <div
                        class="padron-dropdown-item selected"
                        data-value="all"
                        onclick="window.selectSaludHb ? window.selectSaludHb('all', 'Todos los Niveles') : null"
                      >
                        <div class="padron-item-left">
                          <span class="padron-item-radio"></span>
                          <span class="padron-item-label"
                            >Todos los Niveles</span
                          >
                        </div>
                      </div>
                      <div
                        class="padron-dropdown-item"
                        data-value="anemia"
                        onclick="window.selectSaludHb ? window.selectSaludHb('anemia', 'Hb < 11.0 g/dL (Con Anemia)') : null"
                      >
                        <div class="padron-item-left">
                          <span class="padron-item-radio"></span>
                          <span class="padron-item-label"
                            >Hb &lt; 11.0 g/dL (Con Anemia)</span
                          >
                        </div>
                      </div>
                      <div
                        class="padron-dropdown-item"
                        data-value="normal"
                        onclick="window.selectSaludHb ? window.selectSaludHb('normal', 'Hb ≥ 11.0 g/dL (Normal)') : null"
                      >
                        <div class="padron-item-left">
                          <span class="padron-item-radio"></span>
                          <span class="padron-item-label"
                            >Hb &ge; 11.0 g/dL (Normal)</span
                          >
                        </div>
                      </div>
                      <div
                        class="padron-dropdown-item"
                        data-value="critico"
                        onclick="window.selectSaludHb ? window.selectSaludHb('critico', 'Hb < 10.0 g/dL (Crítico)') : null"
                      >
                        <div class="padron-item-left">
                          <span class="padron-item-radio"></span>
                          <span class="padron-item-label"
                            >Hb &lt; 10.0 g/dL (Crítico)</span
                          >
                        </div>
                      </div>
                    </div>
                  </div>
                </div>
              </div>

              <!-- Footer fijo móvil con botón para aplicar y cerrar el Bottom Sheet -->
              <div class="audit-filters-footer">
                <button type="button" class="btn-action primary btn-apply-filters"
                  onclick="window.closeAllFilterSheets ? window.closeAllFilterSheets() : null">
                  <svg width="15" height="15" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M4.5 12.75l6 6 9-13.5"/></svg>
                  <span>Aplicar Filtros</span>
                </button>
              </div>
            </div>
          </div>
        </div>
      </div>

      <!-- Barra de Filtros Aplicados Salud -->
      <div class="padron-active-chips-bar" id="saludActiveChipsBar" style="display: none;">
        <span class="padron-active-chips-label">Filtros aplicados:</span>
        <div id="saludActiveChipsList" style="display: flex; align-items: center; flex-wrap: wrap; gap: 6px;">
        </div>
        <button
          type="button"
          class="btn-text-subtle"
          style="margin-left: auto; font-size: 11.5px;"
          onclick="window.resetSaludFilters ? window.resetSaludFilters() : null"
          >Limpiar filtros</button
        >
      </div>

      <div class="table-container desktop-table-view">
        <table class="data-table">
          <thead>
            <tr>
              <th>Usuario</th>
              <th>Edad</th>
              <th>Peso / Talla</th>
              <th>Hemoglobina (Hb)</th>
              <th>Diagnóstico Anemia</th>
              <th>Suplementación</th>
              <th>Acciones</th>
            </tr>
          </thead>
          <tbody id="tbodySaludCred">
            <!-- Injected via JS -->
          </tbody>
        </table>
      </div>
      <div class="mobile-accordion-list" id="mobileCardsSalud">
        <!-- Injected via JS -->
      </div>

      <!-- Controles de Paginación de Salud CRED (PC / Móvil) -->
      <div class="padron-pagination-bar" id="saludPaginationBar">
        <div class="padron-pagination-left">
          <span id="saludPaginationInfo" style="font-size:12.5px; color:var(--text-muted); font-weight:500;">
            Mostrando 0 de 0 evaluaciones
          </span>
          <div class="padron-density-wrapper" id="saludDensityWrapper"
            style="display:flex; align-items:center; gap:6px;">
            <span style="font-size:12px; color:var(--text-dim);">Mostrar:</span>
            <select class="audit-density-select padron-density-select" id="selectSaludPageSize"
              onchange="window.saludSetPageSize ? window.saludSetPageSize(this.value) : (window.PDI?.SaludCredView?.setPageSize ? window.PDI.SaludCredView.setPageSize(this.value) : null)">
              <option value="10">10 por página</option>
              <option value="20" selected>20 por página</option>
              <option value="50">50 por página (Máx)</option>
            </select>
          </div>
        </div>
        <div class="padron-pagination-right">
          <button type="button" class="btn-page" id="btnSaludPagePrev"
            onclick="window.saludPrevPage ? window.saludPrevPage() : (window.PDI?.SaludCredView?.prevPage ? window.PDI.SaludCredView.prevPage() : null)">
            <svg width="14" height="14" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" d="M15.75 19.5L8.25 12l7.5-7.5" />
            </svg>
            <span>Anterior</span>
          </button>
          <span class="audit-page-indicator" id="saludCurrentPageNum">Página 1</span>
          <button type="button" class="btn-page" id="btnSaludPageNext"
            onclick="window.saludNextPage ? window.saludNextPage() : (window.PDI?.SaludCredView?.nextPage ? window.PDI.SaludCredView.nextPage() : null)">
            <span>Siguiente</span>
            <svg width="14" height="14" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" d="M8.25 4.5l7.5 7.5-7.5 7.5" />
            </svg>
          </button>
        </div>
      </div>
    </div>
  </section>

  <script>
    import "../scripts/pages/salud.js";
  </script>
</AppLayout>
