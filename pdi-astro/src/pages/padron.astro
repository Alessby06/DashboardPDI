---
import AppLayout from '../layouts/AppLayout.astro';
import '../styles/views-padron.css';
---

<AppLayout title="Padrón de Usuarios" currentPage="padron">
        <section class="app-view active" id="view-beneficiarios">
          <div class="view-header">
            <div class="view-title-group">
              <h2>Padrón Único de Usuarios</h2>
              <p>Identidad central del menor, seguro de salud, escolaridad, apoderados y consentimiento informado Ley
                N.° 29733.</p>
            </div>
            <div class="view-actions">
              <button type="button" class="btn-action" onclick="window.exportDataCSV ? window.exportDataCSV() : null" title="Exportar Padrón de Usuarios a CSV">
                <svg width="15" height="15" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M3 16.5v2.25A2.25 2.25 0 005.25 21h13.5A2.25 2.25 0 0021 18.75V16.5M16.5 12L12 16.5m0 0L7.5 12m4.5 4.5V3" />
                </svg>
                <span>Exportar Padrón</span>
              </button>
              <button type="button" class="btn-action primary" id="btnNuevoBeneficiario"
                onclick="window.openModalNuevoBeneficiario ? window.openModalNuevoBeneficiario() : openModalNuevoMenor()" title="Registrar nuevo usuario">
                <svg width="15" height="15" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M12 4.5v15m7.5-7.5h-15" />
                </svg>
                <span>Nuevo Usuario</span>
              </button>
            </div>
          </div>

          <!-- Usuarios Table Card -->
          <div class="card" id="cardPadronBeneficiarios">
            <!-- Barra de Filtros y Búsqueda Rápida de Padrón -->
            <div class="audit-toolbar" style="margin-bottom: 16px;">
              <!-- Buscador Rápido del Padrón (Lado Izquierdo) -->
              <div class="audit-search-wrap">
                <svg class="audit-search-icon" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round"
                    d="M21 21l-5.197-5.197m0 0A7.5 7.5 0 105.196 5.196a7.5 7.5 0 0010.607 10.607z" />
                </svg>
                <input type="text" id="inputPadronSearch" class="audit-search-input"
                  placeholder="Buscar por Nombre, Apellidos, DNI o Código..."
                  oninput="window.filterPadronSearch ? window.filterPadronSearch(this.value) : null">
                <button type="button" class="audit-search-clear" id="btnPadronSearchClear" style="display:none;"
                  onclick="window.clearPadronSearch ? window.clearPadronSearch() : null" title="Limpiar búsqueda">
                  <svg width="12" height="12" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M6 18L18 6M6 6l12 12" />
                  </svg>
                </button>
              </div>

              <!-- Botón de Filtros y Panel Desplegable (Lado Derecho) -->
              <div class="audit-filter-panel-wrap">
                <div class="custom-dropdown audit-filters-dropdown" id="dropdownPadronFilterPanel">
                  <button type="button" class="btn-action audit-filter-btn" id="btnDropdownPadronFilterPanel"
                    onclick="window.toggleCustomDropdown ? window.toggleCustomDropdown('dropdownPadronFilterPanel') : null">
                    <svg width="16" height="16" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
                      <path stroke-linecap="round" stroke-linejoin="round"
                        d="M12 3c2.755 0 5.455.232 8.083.678.533.09.917.556.917 1.096v1.044a2.25 2.25 0 01-.659 1.591l-5.432 5.432a2.25 2.25 0 00-.659 1.591v2.927a2.25 2.25 0 01-1.244 2.013L9.75 21v-6.568a2.25 2.25 0 00-.659-1.591L3.659 7.409A2.25 2.25 0 013 5.818V4.774c0-.54.384-1.006.917-1.096A48.32 48.32 0 0112 3z" />
                    </svg>
                    <span>Filtros</span>
                    <span class="audit-filter-badge" id="padronActiveFiltersCount" style="display:none;">0</span>
                    <svg width="12" height="12" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24"
                      class="filter-caret">
                      <path stroke-linecap="round" stroke-linejoin="round" d="M19.5 8.25l-7.5 7.5-7.5-7.5" />
                    </svg>
                  </button>

                  <!-- Panel Desplegable de Filtros de Padrón -->
                  <div class="custom-dropdown-menu audit-filters-menu" id="menuPadronFilterPanel">
                    <div class="audit-filters-header">
                      <div class="audit-filters-header-title">
                        <svg width="15" height="15" fill="none" stroke="currentColor" stroke-width="2"
                          viewBox="0 0 24 24">
                          <path stroke-linecap="round" stroke-linejoin="round"
                            d="M12 3c2.755 0 5.455.232 8.083.678.533.09.917.556.917 1.096v1.044a2.25 2.25 0 01-.659 1.591l-5.432 5.432a2.25 2.25 0 00-.659 1.591v2.927a2.25 2.25 0 01-1.244 2.013L9.75 21v-6.568a2.25 2.25 0 00-.659-1.591L3.659 7.409A2.25 2.25 0 013 5.818V4.774c0-.54.384-1.006.917-1.096A48.32 48.32 0 0112 3z" />
                        </svg>
                        <span>Filtros de Padrón</span>
                      </div>
                      <button type="button" class="btn-text-subtle"
                        onclick="window.resetPadronFilters ? window.resetPadronFilters() : null">Restablecer</button>
                    </div>

                    <div class="audit-filters-body">
                      <!-- Filtro 1: Servicio / Programa (Dropdown Multi-selección con Checkbox) -->
                      <div class="audit-filter-field">
                        <label class="audit-field-label">Servicio / Programa</label>
                        <div class="padron-inner-dropdown" id="dropdownPadronServicio">
                          <button type="button" class="padron-inner-dropdown-btn"
                            onclick="window.togglePadronInnerDropdown ? window.togglePadronInnerDropdown('dropdownPadronServicio') : null">
                            <span id="labelPadronServicioSelect">Todos los Servicios</span>
                            <svg class="caret" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24">
                              <path stroke-linecap="round" stroke-linejoin="round" d="M19.5 8.25l-7.5 7.5-7.5-7.5" />
                            </svg>
                          </button>
                          <div class="padron-inner-dropdown-menu" id="menuPadronServicio">
                            <div class="padron-dropdown-item selected" data-value="all"
                              onclick="window.togglePadronServicio ? window.togglePadronServicio('all') : null">
                              <div class="padron-item-left">
                                <span class="padron-item-checkbox">
                                  <svg width="10" height="10" fill="none" stroke="currentColor" stroke-width="3"
                                    viewBox="0 0 24 24">
                                    <path stroke-linecap="round" stroke-linejoin="round" d="M4.5 12.75l6 6 9-13.5" />
                                  </svg>
                                </span>
                                <span class="padron-item-label">Todos</span>
                              </div>
                              <span class="padron-item-count" id="countFacetServicio-all">(28)</span>
                            </div>
                            <div class="padron-dropdown-item" data-value="desayuno"
                              onclick="window.togglePadronServicio ? window.togglePadronServicio('desayuno') : null">
                              <div class="padron-item-left">
                                <span class="padron-item-checkbox">
                                  <svg width="10" height="10" fill="none" stroke="currentColor" stroke-width="3"
                                    viewBox="0 0 24 24">
                                    <path stroke-linecap="round" stroke-linejoin="round" d="M4.5 12.75l6 6 9-13.5" />
                                  </svg>
                                </span>
                                <span class="padron-item-label">Servicio Alimentario Nutricional</span>
                              </div>
                              <span class="padron-item-count" id="countFacetServicio-desayuno">(0)</span>
                            </div>
                            <div class="padron-dropdown-item" data-value="casita"
                              onclick="window.togglePadronServicio ? window.togglePadronServicio('casita') : null">
                              <div class="padron-item-left">
                                <span class="padron-item-checkbox">
                                  <svg width="10" height="10" fill="none" stroke="currentColor" stroke-width="3"
                                    viewBox="0 0 24 24">
                                    <path stroke-linecap="round" stroke-linejoin="round" d="M4.5 12.75l6 6 9-13.5" />
                                  </svg>
                                </span>
                                <span class="padron-item-label">Casita del Saber</span>
                              </div>
                              <span class="padron-item-count" id="countFacetServicio-casita">(0)</span>
                            </div>
                            <div class="padron-dropdown-item" data-value="pastoral"
                              onclick="window.togglePadronServicio ? window.togglePadronServicio('pastoral') : null">
                              <div class="padron-item-left">
                                <span class="padron-item-checkbox">
                                  <svg width="10" height="10" fill="none" stroke="currentColor" stroke-width="3"
                                    viewBox="0 0 24 24">
                                    <path stroke-linecap="round" stroke-linejoin="round" d="M4.5 12.75l6 6 9-13.5" />
                                  </svg>
                                </span>
                                <span class="padron-item-label">Área Social Pastoral</span>
                              </div>
                              <span class="padron-item-count" id="countFacetServicio-pastoral">(0)</span>
                            </div>
                          </div>
                        </div>
                      </div>

                      <!-- Filtro 2: Sede Operativa (Dropdown Multi-selección con Checkbox) -->
                      <div class="audit-filter-field">
                        <label class="audit-field-label">Sede Operativa</label>
                        <div class="padron-inner-dropdown" id="dropdownPadronSede">
                          <button type="button" class="padron-inner-dropdown-btn"
                            onclick="window.togglePadronInnerDropdown ? window.togglePadronInnerDropdown('dropdownPadronSede') : null">
                            <span id="labelPadronSedeSelect">Todas las Sedes</span>
                            <svg class="caret" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24">
                              <path stroke-linecap="round" stroke-linejoin="round" d="M19.5 8.25l-7.5 7.5-7.5-7.5" />
                            </svg>
                          </button>
                          <div class="padron-inner-dropdown-menu" id="menuPadronSede">
                            <div class="padron-dropdown-item selected" data-value="all"
                              onclick="window.togglePadronSede ? window.togglePadronSede('all') : null">
                              <div class="padron-item-left">
                                <span class="padron-item-checkbox">
                                  <svg width="10" height="10" fill="none" stroke="currentColor" stroke-width="3"
                                    viewBox="0 0 24 24">
                                    <path stroke-linecap="round" stroke-linejoin="round" d="M4.5 12.75l6 6 9-13.5" />
                                  </svg>
                                </span>
                                <span class="padron-item-label">Todas las Sedes</span>
                              </div>
                              <span class="padron-item-count" id="countFacetSede-all">(28)</span>
                            </div>
                            <div class="padron-dropdown-item" data-value="Año Nuevo"
                              onclick="window.togglePadronSede ? window.togglePadronSede('Año Nuevo') : null">
                              <div class="padron-item-left">
                                <span class="padron-item-checkbox">
                                  <svg width="10" height="10" fill="none" stroke="currentColor" stroke-width="3"
                                    viewBox="0 0 24 24">
                                    <path stroke-linecap="round" stroke-linejoin="round" d="M4.5 12.75l6 6 9-13.5" />
                                  </svg>
                                </span>
                                <span class="padron-item-label">Año Nuevo (Comas)</span>
                              </div>
                              <span class="padron-item-count" id="countFacetSede-Año Nuevo">(0)</span>
                            </div>
                            <div class="padron-dropdown-item" data-value="La Libertad"
                              onclick="window.togglePadronSede ? window.togglePadronSede('La Libertad') : null">
                              <div class="padron-item-left">
                                <span class="padron-item-checkbox">
                                  <svg width="10" height="10" fill="none" stroke="currentColor" stroke-width="3"
                                    viewBox="0 0 24 24">
                                    <path stroke-linecap="round" stroke-linejoin="round" d="M4.5 12.75l6 6 9-13.5" />
                                  </svg>
                                </span>
                                <span class="padron-item-label">La Libertad (Comas)</span>
                              </div>
                              <span class="padron-item-count" id="countFacetSede-La Libertad">(0)</span>
                            </div>
                            <div class="padron-dropdown-item" data-value="San Pedro"
                              onclick="window.togglePadronSede ? window.togglePadronSede('San Pedro') : null">
                              <div class="padron-item-left">
                                <span class="padron-item-checkbox">
                                  <svg width="10" height="10" fill="none" stroke="currentColor" stroke-width="3"
                                    viewBox="0 0 24 24">
                                    <path stroke-linecap="round" stroke-linejoin="round" d="M4.5 12.75l6 6 9-13.5" />
                                  </svg>
                                </span>
                                <span class="padron-item-label">San Pedro (Carabayllo)</span>
                              </div>
                              <span class="padron-item-count" id="countFacetSede-San Pedro">(0)</span>
                            </div>
                            <div class="padron-dropdown-item" data-value="El Progreso"
                              onclick="window.togglePadronSede ? window.togglePadronSede('El Progreso') : null">
                              <div class="padron-item-left">
                                <span class="padron-item-checkbox">
                                  <svg width="10" height="10" fill="none" stroke="currentColor" stroke-width="3"
                                    viewBox="0 0 24 24">
                                    <path stroke-linecap="round" stroke-linejoin="round" d="M4.5 12.75l6 6 9-13.5" />
                                  </svg>
                                </span>
                                <span class="padron-item-label">El Progreso (Carabayllo)</span>
                              </div>
                              <span class="padron-item-count" id="countFacetSede-El Progreso">(0)</span>
                            </div>
                            <div class="padron-dropdown-item" data-value="Santa Rosa"
                              onclick="window.togglePadronSede ? window.togglePadronSede('Santa Rosa') : null">
                              <div class="padron-item-left">
                                <span class="padron-item-checkbox">
                                  <svg width="10" height="10" fill="none" stroke="currentColor" stroke-width="3"
                                    viewBox="0 0 24 24">
                                    <path stroke-linecap="round" stroke-linejoin="round" d="M4.5 12.75l6 6 9-13.5" />
                                  </svg>
                                </span>
                                <span class="padron-item-label">Santa Rosa (Carabayllo)</span>
                              </div>
                              <span class="padron-item-count" id="countFacetSede-Santa Rosa">(0)</span>
                            </div>
                            <div class="padron-dropdown-item" data-value="Los Bendecidos"
                              onclick="window.togglePadronSede ? window.togglePadronSede('Los Bendecidos') : null">
                              <div class="padron-item-left">
                                <span class="padron-item-checkbox">
                                  <svg width="10" height="10" fill="none" stroke="currentColor" stroke-width="3"
                                    viewBox="0 0 24 24">
                                    <path stroke-linecap="round" stroke-linejoin="round" d="M4.5 12.75l6 6 9-13.5" />
                                  </svg>
                                </span>
                                <span class="padron-item-label">Los Bendecidos (Carabayllo)</span>
                              </div>
                              <span class="padron-item-count" id="countFacetSede-Los Bendecidos">(0)</span>
                            </div>
                          </div>
                        </div>
                      </div>

                      <!-- Filtro 3: Condición Nutricional / Semáforo Anemia MINSA (Dropdown Multi-selección con Checkbox) -->
                      <div class="audit-filter-field">
                        <label class="audit-field-label">Condición Nutricional (Anemia)</label>
                        <div class="padron-inner-dropdown" id="dropdownPadronAnemia">
                          <button type="button" class="padron-inner-dropdown-btn"
                            onclick="window.togglePadronInnerDropdown ? window.togglePadronInnerDropdown('dropdownPadronAnemia') : null">
                            <span id="labelPadronAnemiaSelect">Todas las Condiciones</span>
                            <svg class="caret" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24">
                              <path stroke-linecap="round" stroke-linejoin="round" d="M19.5 8.25l-7.5 7.5-7.5-7.5" />
                            </svg>
                          </button>
                          <div class="padron-inner-dropdown-menu" id="menuPadronAnemia">
                            <div class="padron-dropdown-item selected" data-value="all"
                              onclick="window.togglePadronAnemia ? window.togglePadronAnemia('all') : null">
                              <div class="padron-item-left">
                                <span class="padron-item-checkbox">
                                  <svg width="10" height="10" fill="none" stroke="currentColor" stroke-width="3"
                                    viewBox="0 0 24 24">
                                    <path stroke-linecap="round" stroke-linejoin="round" d="M4.5 12.75l6 6 9-13.5" />
                                  </svg>
                                </span>
                                <span class="padron-item-label">Todos</span>
                              </div>
                              <span class="padron-item-count" id="countFacetAnemia-all">(28)</span>
                            </div>
                            <div class="padron-dropdown-item" data-value="Normal"
                              onclick="window.togglePadronAnemia ? window.togglePadronAnemia('Normal') : null">
                              <div class="padron-item-left">
                                <span class="padron-item-checkbox">
                                  <svg width="10" height="10" fill="none" stroke="currentColor" stroke-width="3"
                                    viewBox="0 0 24 24">
                                    <path stroke-linecap="round" stroke-linejoin="round" d="M4.5 12.75l6 6 9-13.5" />
                                  </svg>
                                </span>
                                <span class="badge badge-green" style="padding:1px 5px; font-size:10.5px;">Normal</span>
                              </div>
                              <span class="padron-item-count" id="countFacetAnemia-Normal">(0)</span>
                            </div>
                            <div class="padron-dropdown-item" data-value="Leve"
                              onclick="window.togglePadronAnemia ? window.togglePadronAnemia('Leve') : null">
                              <div class="padron-item-left">
                                <span class="padron-item-checkbox">
                                  <svg width="10" height="10" fill="none" stroke="currentColor" stroke-width="3"
                                    viewBox="0 0 24 24">
                                    <path stroke-linecap="round" stroke-linejoin="round" d="M4.5 12.75l6 6 9-13.5" />
                                  </svg>
                                </span>
                                <span class="badge badge-yellow" style="padding:1px 5px; font-size:10.5px;">Leve</span>
                              </div>
                              <span class="padron-item-count" id="countFacetAnemia-Leve">(0)</span>
                            </div>
                            <div class="padron-dropdown-item" data-value="Moderada"
                              onclick="window.togglePadronAnemia ? window.togglePadronAnemia('Moderada') : null">
                              <div class="padron-item-left">
                                <span class="padron-item-checkbox">
                                  <svg width="10" height="10" fill="none" stroke="currentColor" stroke-width="3"
                                    viewBox="0 0 24 24">
                                    <path stroke-linecap="round" stroke-linejoin="round" d="M4.5 12.75l6 6 9-13.5" />
                                  </svg>
                                </span>
                                <span class="badge badge-red" style="padding:1px 5px; font-size:10.5px;">Mod /
                                  Sev</span>
                              </div>
                              <span class="padron-item-count" id="countFacetAnemia-Moderada">(0)</span>
                            </div>
                          </div>
                        </div>
                      </div>

                      <!-- Filtro 4: Edad del Usuario (0 a 18 años con Cuadro de Edad Específica, Barra Slider de Rango 0-18 y Botón Todas) -->
                      <div class="audit-filter-field">
                        <div class="facet-edad-header">
                          <label class="audit-field-label" style="margin-bottom:0;">Edad del Usuario</label>
                          <button type="button" class="btn-facet-all-edad active" id="btnPadronEdadTodas"
                            onclick="window.clearPadronEdad ? window.clearPadronEdad() : null">
                            Todas las edades
                          </button>
                        </div>
                        <div class="facet-edad-card">
                          <div class="facet-edad-input-row">
                            <span class="facet-edad-input-label">Edad específica:</span>
                            <div class="facet-edad-input-box">
                              <input type="number" min="0" max="18" placeholder="—" id="numPadronEdad"
                                class="facet-edad-num-input"
                                oninput="window.setPadronEdadExacta ? window.setPadronEdadExacta(this.value) : null">
                              <span class="facet-edad-unit">años</span>
                            </div>
                          </div>
                          <div class="facet-edad-slider-section">
                            <div class="facet-edad-slider-labels">
                              <span>0 años</span>
                              <span id="labelPadronEdadSliderVal" style="font-weight:700; color:var(--text-brand);">0 a 18
                                años</span>
                              <span>18 años</span>
                            </div>
                            <div class="facet-range-slider-wrapper">
                              <div class="facet-range-slider-track"></div>
                              <div class="facet-range-slider-highlight" id="sliderPadronEdadHighlight"
                                style="left:0%; right:0%;"></div>
                              <input type="range" min="0" max="18" value="0" id="sliderPadronEdadMin"
                                class="facet-range-slider-input"
                                oninput="window.syncPadronEdadRango ? window.syncPadronEdadRango('min', this.value) : null">
                              <input type="range" min="0" max="18" value="18" id="sliderPadronEdadMax"
                                class="facet-range-slider-input"
                                oninput="window.syncPadronEdadRango ? window.syncPadronEdadRango('max', this.value) : null">
                            </div>
                          </div>
                        </div>
                      </div>

                      <!-- Filtro 5: Estado de Matrícula (Dropdown Desplegable) -->
                      <div class="audit-filter-field">
                        <label class="audit-field-label">Estado de Matrícula</label>
                        <div class="padron-inner-dropdown" id="dropdownPadronEstado">
                          <button type="button" class="padron-inner-dropdown-btn"
                            onclick="window.togglePadronInnerDropdown ? window.togglePadronInnerDropdown('dropdownPadronEstado') : null">
                            <span id="labelPadronEstadoSelect">Todos los Estados</span>
                            <svg class="caret" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24">
                              <path stroke-linecap="round" stroke-linejoin="round" d="M19.5 8.25l-7.5 7.5-7.5-7.5" />
                            </svg>
                          </button>
                          <div class="padron-inner-dropdown-menu" id="menuPadronEstado">
                            <div class="padron-dropdown-item selected" data-value="all"
                              onclick="window.selectPadronEstado ? window.selectPadronEstado('all') : null">
                              <div class="padron-item-left">
                                <span class="padron-item-radio"></span>
                                <span class="padron-item-label">Todos</span>
                              </div>
                              <span class="padron-item-count" id="countFacetEstado-all">(28)</span>
                            </div>
                            <div class="padron-dropdown-item" data-value="Activo"
                              onclick="window.selectPadronEstado ? window.selectPadronEstado('Activo') : null">
                              <div class="padron-item-left">
                                <span class="padron-item-radio"></span>
                                <span class="padron-item-label">Activo</span>
                              </div>
                              <span class="padron-item-count" id="countFacetEstado-Activo">(0)</span>
                            </div>
                            <div class="padron-dropdown-item" data-value="Inactivo"
                              onclick="window.selectPadronEstado ? window.selectPadronEstado('Inactivo') : null">
                              <div class="padron-item-left">
                                <span class="padron-item-radio"></span>
                                <span class="padron-item-label">Inactivo / Baja</span>
                              </div>
                              <span class="padron-item-count" id="countFacetEstado-Inactivo">(0)</span>
                            </div>
                          </div>
                        </div>
                      </div>

                      <!-- Filtro 6: Sexo del Usuario (Niñas / Niños) -->
                      <div class="audit-filter-field">
                        <label class="audit-field-label">Sexo del Usuario</label>
                        <div class="padron-inner-dropdown" id="dropdownPadronSexo">
                          <button type="button" class="padron-inner-dropdown-btn"
                            onclick="window.togglePadronInnerDropdown ? window.togglePadronInnerDropdown('dropdownPadronSexo') : null">
                            <span id="labelPadronSexoSelect">Todos</span>
                            <svg class="caret" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24">
                              <path stroke-linecap="round" stroke-linejoin="round" d="M19.5 8.25l-7.5 7.5-7.5-7.5" />
                            </svg>
                          </button>
                          <div class="padron-inner-dropdown-menu" id="menuPadronSexo">
                            <div class="padron-dropdown-item selected" data-value="all"
                              onclick="window.selectPadronSexo ? window.selectPadronSexo('all') : null">
                              <div class="padron-item-left">
                                <span class="padron-item-radio"></span>
                                <span class="padron-item-label">Todos</span>
                              </div>
                              <span class="padron-item-count" id="countFacetSexo-all">(28)</span>
                            </div>
                            <div class="padron-dropdown-item" data-value="F"
                              onclick="window.selectPadronSexo ? window.selectPadronSexo('F') : null">
                              <div class="padron-item-left">
                                <span class="padron-item-radio"></span>
                                <span class="padron-item-label">Niñas (Femenino)</span>
                              </div>
                              <span class="padron-item-count" id="countFacetSexo-F">(0)</span>
                            </div>
                            <div class="padron-dropdown-item" data-value="M"
                              onclick="window.selectPadronSexo ? window.selectPadronSexo('M') : null">
                              <div class="padron-item-left">
                                <span class="padron-item-radio"></span>
                                <span class="padron-item-label">Niños (Masculino)</span>
                              </div>
                              <span class="padron-item-count" id="countFacetSexo-M">(0)</span>
                            </div>
                          </div>
                        </div>
                      </div>
                    </div>
                  </div>
                </div>
              </div>
            </div>

            <!-- Barra de Píldoras de Filtros Activos (Chips Descartables - Visible en PC/Tablets) -->
            <div class="padron-active-chips-bar" id="padronActiveChipsBar" style="display: none;">
              <span class="padron-active-chips-label">Filtros aplicados:</span>
              <div id="padronActiveChipsList" style="display: flex; align-items: center; flex-wrap: wrap; gap: 6px;">
              </div>
              <button type="button" class="btn-text-subtle" style="margin-left: auto; font-size: 11.5px;"
                onclick="window.resetPadronFilters ? window.resetPadronFilters() : null">
                Borrar todos
              </button>
            </div>

            <!-- Vista de Tabla para Escritorio / Desktop -->
            <div class="table-container desktop-table-view">
              <table class="data-table" id="tablaBeneficiarios">
                <thead>
                  <tr>
                    <th>Código</th>
                    <th>Nombres y Apellidos</th>
                    <th>DNI / Doc</th>
                    <th>Edad / Sexo</th>
                    <th>Distrito / Sede</th>
                    <th>Servicios Activos</th>
                    <th>Estado</th>
                    <th style="text-align: right;">Acciones</th>
                  </tr>
                </thead>
                <tbody id="tbodyBeneficiarios">
                  <!-- Injected via JS -->
                </tbody>
              </table>
            </div>

            <!-- Vista de Tarjetas Acordeón para Dispositivos Móviles / Smartphones -->
            <div class="mobile-accordion-list" id="mobileCardsBeneficiarios">
              <!-- Injected via JS -->
            </div>

            <!-- Controles de Paginación del Padrón de Usuarios (PC / Móvil) -->
            <div class="padron-pagination-bar" id="padronPaginationBar">
              <div class="padron-pagination-left">
                <span id="padronPaginationInfo" style="font-size:12.5px; color:var(--text-muted); font-weight:500;">
                  Mostrando 0 de 0 usuarios
                </span>
                <div class="padron-density-wrapper" id="padronDensityWrapper"
                  style="display:flex; align-items:center; gap:6px;">
                  <span style="font-size:12px; color:var(--text-dim);">Mostrar:</span>
                  <select class="audit-density-select padron-density-select" id="selectPadronPageSize"
                    onchange="window.padronSetPageSize ? window.padronSetPageSize(this.value) : (window.PDI?.BeneficiariosView?.setPageSize ? window.PDI.BeneficiariosView.setPageSize(this.value) : null)">
                    <option value="10">10 por página</option>
                    <option value="20" selected>20 por página</option>
                    <option value="50">50 por página (Máx)</option>
                  </select>
                </div>
              </div>
              <div class="padron-pagination-right">
                <button type="button" class="btn-page" id="btnPadronPagePrev"
                  onclick="window.padronPrevPage ? window.padronPrevPage() : (window.PDI?.BeneficiariosView?.prevPage ? window.PDI.BeneficiariosView.prevPage() : null)">
                  <svg width="14" height="14" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M15.75 19.5L8.25 12l7.5-7.5" />
                  </svg>
                  <span>Anterior</span>
                </button>
                <span class="audit-page-indicator" id="padronCurrentPageNum">Página 1</span>
                <button type="button" class="btn-page" id="btnPadronPageNext"
                  onclick="window.padronNextPage ? window.padronNextPage() : (window.PDI?.BeneficiariosView?.nextPage ? window.PDI.BeneficiariosView.nextPage() : null)">
                  <span>Siguiente</span>
                  <svg width="14" height="14" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M8.25 4.5l7.5 7.5-7.5 7.5" />
                  </svg>
                </button>
              </div>
            </div>
          </div>
        </section>

  <script>
    import '../scripts/pages/padron.js';
  </script>
</AppLayout>