---
import AppLayout from '../layouts/AppLayout.astro';
import FilterPanel from '../components/FilterPanel.astro';
import FilterField from '../components/FilterField.astro';
import { ESTRATEGIAS, SEDES_OPERATIVAS } from '../data/opcionesBeneficiario.js';
import '../styles/views-padron.css';

const OPCIONES_ESTRATEGIA = ESTRATEGIAS.map((opcion) => ({ valor: opcion.clave, etiqueta: opcion.etiqueta }));
const OPCIONES_SEDE = SEDES_OPERATIVAS.map((sede) => ({ valor: sede.nombre, etiqueta: sede.etiqueta }));
const OPCIONES_ANEMIA = [
  { valor: 'Normal', badge: { texto: 'Normal', tono: 'green' } },
  { valor: 'Leve', badge: { texto: 'Leve', tono: 'yellow' } },
  { valor: 'Moderada', badge: { texto: 'Mod / Sev', tono: 'red' } },
];
const OPCIONES_ESTADO = [
  { valor: 'Activo', etiqueta: 'Activo' },
  { valor: 'Inactivo', etiqueta: 'Inactivo / Baja' },
];
const OPCIONES_SEXO = [
  { valor: 'M', etiqueta: 'Masculino (M)' },
  { valor: 'F', etiqueta: 'Femenino (F)' },
];
---

<AppLayout title="Padrón Único de Usuarios" currentPage="padron">
        <section class="app-view active" id="view-beneficiarios">
          <div class="view-header">
            <div class="view-title-group">
              <h2>Padrón Único de Usuarios</h2>
              <p>Identidad central del usuario, seguro de salud, escolaridad, apoderados y consentimiento informado Ley
                N.° 29733.</p>
            </div>
            <div class="view-actions">
              <button type="button" class="btn-action-icon btn-audit-export-icon" id="btnExportPadronCSV"
                onclick="window.openModalExportPadron ? window.openModalExportPadron() : window.exportDataCSV()"
                aria-label="Descargar Padrón de Usuarios CSV" title="Descargar Padrón de Usuarios CSV">
                <svg width="18" height="18" fill="none" stroke="currentColor" stroke-width="2.2" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round"
                    d="M3 16.5v2.25A2.25 2.25 0 005.25 21h13.5A2.25 2.25 0 0021 18.75V16.5M16.5 12L12 16.5m0 0L7.5 12m4.5 4.5V3" />
                </svg>
              </button>
              <button type="button" class="btn-action primary" id="btnNuevoBeneficiario"
                onclick="window.openModalNuevoBeneficiario ? window.openModalNuevoBeneficiario() : openModalNuevoUsuario()" title="Registrar nuevo usuario">
                <svg width="15" height="15" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M12 4.5v15m7.5-7.5h-15" />
                </svg>
                <span>Nuevo Usuario</span>
              </button>
            </div>
          </div>

          <!-- Usuarios Table Card -->
          <div class="card" id="cardPadronBeneficiarios">
            <!-- Barra de Filtros y Búsqueda Rápida de Padrón -->
            <div class="audit-toolbar" style="margin-bottom: 16px;">
              <!-- Buscador Rápido del Padrón (Lado Izquierdo) -->
              <div class="audit-search-wrap">
                <svg class="audit-search-icon" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round"
                    d="M21 21l-5.197-5.197m0 0A7.5 7.5 0 105.196 5.196a7.5 7.5 0 0010.607 10.607z" />
                </svg>
                <input type="text" id="inputPadronSearch" class="audit-search-input"
                  placeholder="Buscar por Nombre, Apellidos, DNI o Código..."
                  oninput="window.filterPadronSearch ? window.filterPadronSearch(this.value) : null">
                <button type="button" class="audit-search-clear" id="btnPadronSearchClear" style="display:none;"
                  onclick="window.clearPadronSearch ? window.clearPadronSearch() : null" title="Limpiar búsqueda">
                  <svg width="12" height="12" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M6 18L18 6M6 6l12 12" />
                  </svg>
                </button>
              </div>

              <!-- Botón de Filtros y Panel Desplegable (Lado Derecho) -->
              <FilterPanel
                id="dropdownPadronFilterPanel"
                buttonId="btnDropdownPadronFilterPanel"
                menuId="menuPadronFilterPanel"
                badgeId="padronActiveFiltersCount"
                title="Filtros de Padrón"
                reset="window.resetPadronFilters ? window.resetPadronFilters() : null"
              >
                      <!-- Filtro 1: Estrategia Asignada (multiseleccion con checkbox) -->
                      <FilterField
                        id="dropdownPadronEstrategia"
                        menuId="menuPadronEstrategia"
                        labelId="labelPadronEstrategiaSelect"
                        label="Estrategia Asignada"
                        labelTodos="Todas las Estrategias"
                        todosEtiqueta="Todas"
                        opciones={OPCIONES_ESTRATEGIA}
                        onSelect="window.togglePadronEstrategia"
                        abrir="window.togglePadronInnerDropdown ? window.togglePadronInnerDropdown('dropdownPadronEstrategia') : null"
                        countPrefix="countFacetEstrategia"
                      />
                      
                      <!-- Filtro 2: Sede Operativa (multiseleccion con checkbox) -->
                      <FilterField
                        id="dropdownPadronSede"
                        menuId="menuPadronSede"
                        labelId="labelPadronSedeSelect"
                        label="Sede Operativa"
                        labelTodos="Todas las Sedes"
                        todosEtiqueta="Todas las Sedes"
                        opciones={OPCIONES_SEDE}
                        onSelect="window.togglePadronSede"
                        abrir="window.togglePadronInnerDropdown ? window.togglePadronInnerDropdown('dropdownPadronSede') : null"
                        countPrefix="countFacetSede"
                      />
                      
                      <!-- Filtro 3: Condicion Nutricional / Semaforo Anemia MINSA (multiseleccion) -->
                      <FilterField
                        id="dropdownPadronAnemia"
                        menuId="menuPadronAnemia"
                        labelId="labelPadronAnemiaSelect"
                        label="Condición Nutricional (Anemia)"
                        labelTodos="Todas las Condiciones"
                        todosEtiqueta="Todos"
                        opciones={OPCIONES_ANEMIA}
                        onSelect="window.togglePadronAnemia"
                        abrir="window.togglePadronInnerDropdown ? window.togglePadronInnerDropdown('dropdownPadronAnemia') : null"
                        countPrefix="countFacetAnemia"
                      />
                      
                      <!-- Filtro 4: Edad del Usuario (0 a 18 años con Cuadro de Edad Específica, Barra Slider de Rango 0-18 y Botón Todas) -->
                      <div class="audit-filter-field">
                        <div class="facet-edad-header">
                          <label class="audit-field-label" style="margin-bottom:0;">Edad del Usuario</label>
                          <button type="button" class="btn-facet-all-edad active" id="btnPadronEdadTodas"
                            onclick="window.clearPadronEdad ? window.clearPadronEdad() : null">
                            Todas las edades
                          </button>
                        </div>
                        <div class="facet-edad-card">
                          <div class="facet-edad-input-row">
                            <span class="facet-edad-input-label">Edad específica:</span>
                            <div class="facet-edad-input-box">
                              <input type="number" min="0" max="18" placeholder="—" id="numPadronEdad"
                                class="facet-edad-num-input"
                                oninput="window.setPadronEdadExacta ? window.setPadronEdadExacta(this.value) : null">
                              <span class="facet-edad-unit">años</span>
                            </div>
                          </div>
                          <div class="facet-edad-slider-section">
                            <div class="facet-edad-slider-labels">
                              <span>0 años</span>
                              <span id="labelPadronEdadSliderVal" style="font-weight:700; color:var(--text-brand);">0 a 18
                                años</span>
                              <span>18 años</span>
                            </div>
                            <div class="facet-range-slider-wrapper">
                              <div class="facet-range-slider-track"></div>
                              <div class="facet-range-slider-highlight" id="sliderPadronEdadHighlight"
                                style="left:0%; right:0%;"></div>
                              <input type="range" min="0" max="18" value="0" id="sliderPadronEdadMin"
                                class="facet-range-slider-input"
                                oninput="window.syncPadronEdadRango ? window.syncPadronEdadRango('min', this.value) : null">
                              <input type="range" min="0" max="18" value="18" id="sliderPadronEdadMax"
                                class="facet-range-slider-input"
                                oninput="window.syncPadronEdadRango ? window.syncPadronEdadRango('max', this.value) : null">
                            </div>
                          </div>
                        </div>
                      </div>

                      <!-- Filtro 5: Estado de Inscripcion (seleccion unica con radio) -->
                      <FilterField
                        id="dropdownPadronEstado"
                        menuId="menuPadronEstado"
                        labelId="labelPadronEstadoSelect"
                        label="Estado de Inscripción"
                        labelTodos="Todos los Estados"
                        todosEtiqueta="Todos"
                        opciones={OPCIONES_ESTADO}
                        tipo="single"
                        onSelect="window.selectPadronEstado"
                        abrir="window.togglePadronInnerDropdown ? window.togglePadronInnerDropdown('dropdownPadronEstado') : null"
                        countPrefix="countFacetEstado"
                      />
                      
                      <!-- Filtro 6: Sexo del Usuario (seleccion unica con radio) -->
                      <FilterField
                        id="dropdownPadronSexo"
                        menuId="menuPadronSexo"
                        labelId="labelPadronSexoSelect"
                        label="Sexo del Usuario"
                        labelTodos="Todos"
                        todosEtiqueta="Todos"
                        opciones={OPCIONES_SEXO}
                        tipo="single"
                        onSelect="window.selectPadronSexo"
                        abrir="window.togglePadronInnerDropdown ? window.togglePadronInnerDropdown('dropdownPadronSexo') : null"
                        countPrefix="countFacetSexo"
                      />
                              </FilterPanel>
            </div>

            <!-- Barra de Píldoras de Filtros Activos (Chips Descartables - Visible en PC/Tablets) -->
            <div class="padron-active-chips-bar" id="padronActiveChipsBar">
              <span class="padron-active-chips-label">Filtros aplicados:</span>
              <div id="padronActiveChipsList" style="display: flex; align-items: center; flex-wrap: wrap; gap: 6px;">
              </div>
              <button type="button" class="btn-text-subtle" style="margin-left: auto; font-size: 11.5px;"
                onclick="window.resetPadronFilters ? window.resetPadronFilters() : null">
                Limpiar filtros
              </button>
            </div>

            <!-- Vista de Tabla para Escritorio / Desktop -->
            <div class="table-container desktop-table-view">
              <table class="data-table" id="tablaBeneficiarios">
                <thead>
                  <tr>
                    <th>Código</th>
                    <th>Nombres y Apellidos</th>
                    <th style="text-align: center;">DNI / Doc</th>
                    <th style="text-align: center;">Edad / Sexo</th>
                    <th>Distrito / Sede</th>
                    <th>Estrategias</th>
                    <th style="text-align: center;">Estado</th>
                    <th style="text-align: center;">Acciones</th>
                  </tr>
                </thead>
                <tbody id="tbodyBeneficiarios">
                  <!-- Injected via JS -->
                </tbody>
              </table>
            </div>

            <!-- Vista de Tarjetas Acordeón para Dispositivos Móviles / Smartphones -->
            <div class="mobile-accordion-list" id="mobileCardsBeneficiarios">
              <!-- Injected via JS -->
            </div>

            <!-- Controles de Paginación del Padrón de Usuarios (PC / Móvil) -->
            <div class="padron-pagination-bar" id="padronPaginationBar">
              <div class="padron-pagination-left">
                <span id="padronPaginationInfo" style="font-size:12.5px; color:var(--text-muted); font-weight:500;">
                  Mostrando 0 de 0 usuarios
                </span>
                <div class="padron-density-wrapper" id="padronDensityWrapper"
                  style="display:flex; align-items:center; gap:6px;">
                  <span style="font-size:12px; color:var(--text-dim);">Mostrar:</span>
                  <select class="audit-density-select padron-density-select" id="selectPadronPageSize"
                    onchange="window.padronSetPageSize ? window.padronSetPageSize(this.value) : (window.PDI?.BeneficiariosView?.setPageSize ? window.PDI.BeneficiariosView.setPageSize(this.value) : null)">
                    <option value="10">10 por página</option>
                    <option value="20" selected>20 por página</option>
                    <option value="50">50 por página (Máx)</option>
                  </select>
                </div>
              </div>
              <div class="padron-pagination-right">
                <button type="button" class="btn-page" id="btnPadronPagePrev"
                  onclick="window.padronPrevPage ? window.padronPrevPage() : (window.PDI?.BeneficiariosView?.prevPage ? window.PDI.BeneficiariosView.prevPage() : null)">
                  <svg width="14" height="14" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M15.75 19.5L8.25 12l7.5-7.5" />
                  </svg>
                  <span>Anterior</span>
                </button>
                <span class="audit-page-indicator" id="padronCurrentPageNum">Página 1</span>
                <button type="button" class="btn-page" id="btnPadronPageNext"
                  onclick="window.padronNextPage ? window.padronNextPage() : (window.PDI?.BeneficiariosView?.nextPage ? window.PDI.BeneficiariosView.nextPage() : null)">
                  <span>Siguiente</span>
                  <svg width="14" height="14" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M8.25 4.5l7.5 7.5-7.5 7.5" />
                  </svg>
                </button>
              </div>
            </div>
          </div>
        </section>

  <script>
    import '../scripts/pages/padron.js';
  </script>
</AppLayout>