---
import AppLayout from '../layouts/AppLayout.astro';
import FilterPanel from '../components/FilterPanel.astro';
import FilterField from '../components/FilterField.astro';
import { ESTRATEGIAS, SEDES_OPERATIVAS, MODALIDADES, SEGUROS } from '../data/opcionesBeneficiario.js';
import '../styles/views-padron.css';
import '../styles/views-actions-buttons.css';
import '../styles/views-export-icon.css';
import Icon from '../components/Icon.astro';

const OPCIONES_ESTRATEGIA = ESTRATEGIAS.map((opcion) => ({ valor: opcion.clave, etiqueta: opcion.etiqueta }));
const OPCIONES_SEDE = SEDES_OPERATIVAS.map((sede) => ({ valor: sede.nombre, etiqueta: sede.etiqueta }));
const OPCIONES_ANEMIA = [
  { valor: 'Normal', chip: { texto: 'Normal', tono: 'green' } },
  { valor: 'Leve', chip: { texto: 'Leve', tono: 'yellow' } },
  { valor: 'Moderada', chip: { texto: 'Mod / Sev', tono: 'red' } },
];
const OPCIONES_SEXO = [
  { valor: 'M', etiqueta: 'Masculino (M)' },
  { valor: 'F', etiqueta: 'Femenino (F)' },
];
const OPCIONES_MODALIDAD = MODALIDADES;
const OPCIONES_SEGURO = SEGUROS;
---

<AppLayout title="Padrón Único de Usuarios" currentPage="padron">
        <section class="app-view active" id="view-beneficiarios">
          <div class="view-header">
            <div class="view-title-group">
              <h1 id="padronViewTitle">Padrón Único de Usuarios</h1>
              <p>Identidad central del usuario, seguro de salud, escolaridad, apoderados y consentimiento informado Ley
                N.° 29733.</p>
            </div>
            <div class="view-actions">
              <button type="button" class="btn-action" id="btnPadronArchivo"
                data-pdi-on="click" data-pdi-h="h106"
                title="Ver usuarios desactivados (Solo Dirección / Admin)" aria-pressed="false" style="display: none;">
                <Icon name="accion.archivar" size={15} />
                <span id="padronArchivoLabel">Archivo</span>
                <span class="count" id="padronArchivoCount">0</span>
              </button>
              <button type="button" class="btn-action primary" id="btnNuevoBeneficiario"
                data-pdi-on="click" data-pdi-h="h107" title="Registrar nuevo usuario">
                <Icon name="accion.agregar" size={15} />
                <span>Nuevo Usuario</span>
              </button>
            </div>
          </div>

          <!-- Usuarios Table Card -->
          <div class="card" id="cardPadronBeneficiarios">
            <!-- Barra de Filtros y Búsqueda Rápida de Padrón -->
            <div class="audit-toolbar table-toolbar" style="margin-bottom: 16px;">
              <!-- Buscador Rápido del Padrón (Lado Izquierdo) -->
              <div class="audit-search-wrap">
                <Icon name="accion.buscar" size={15} class="audit-search-icon" />
                <input type="text" id="inputPadronSearch" class="audit-search-input"
                  placeholder="Buscar por Nombre, Apellidos, DNI o Código..."
                  data-pdi-on="input" data-pdi-h="h108">
                <button type="button" class="audit-search-clear" id="btnPadronSearchClear" style="display:none;"
                  data-pdi-on="click" data-pdi-h="h109" title="Limpiar búsqueda">
                  <Icon name="accion.cerrar" size={12} />
                </button>
              </div>

              <!-- Orden del padrón: apellido por defecto y fechas del registro -->
              <div class="padron-sort-wrap">
                <div class="custom-dropdown padron-sort-dropdown" id="dropdownPadronSort">
                  <button type="button" class="btn-action padron-sort-btn"
                    id="btnPadronSort" aria-haspopup="listbox" aria-expanded="false"
                    aria-controls="menuPadronSort"
                    data-pdi-on="click" data-pdi-h="h111">
                    <span class="padron-sort-prefix">Ordenar:</span>
                    <span class="padron-sort-value" id="padronSortValue">Modificación (reciente)</span>
                    <Icon name="nav.desplegar" size={12} class="filter-caret" />
                  </button>
                  <div class="custom-dropdown-menu padron-sort-menu" id="menuPadronSort"
                    role="listbox" aria-labelledby="btnPadronSort">
                    <button type="button" role="option" aria-selected="false" data-sort-value="apellido-asc"
                      data-pdi-on="click" data-pdi-h="h112">Apellido (A-Z)</button>
                    <button type="button" role="option" aria-selected="false" data-sort-value="apellido-desc"
                      data-pdi-on="click" data-pdi-h="h113">Apellido (Z-A)</button>
                    <button type="button" role="option" aria-selected="false" data-sort-value="sede-asc"
                      data-pdi-on="click" data-pdi-h="h114">Sede (A-Z)</button>
                    <button type="button" role="option" aria-selected="false" data-sort-value="edad-asc"
                      data-pdi-on="click" data-pdi-h="h115">Edad (menor a mayor)</button>
                    <button type="button" role="option" aria-selected="false" data-sort-value="edad-desc"
                      data-pdi-on="click" data-pdi-h="h116">Edad (mayor a menor)</button>
                    <button type="button" role="option" aria-selected="false" data-sort-value="creado-desc"
                      data-pdi-on="click" data-pdi-h="h117">Creación (reciente)</button>
                    <button type="button" role="option" aria-selected="false" data-sort-value="creado-asc"
                      data-pdi-on="click" data-pdi-h="h118">Creación (antigua)</button>
                    <button type="button" role="option" aria-selected="true" data-sort-value="actualizado-desc"
                      data-pdi-on="click" data-pdi-h="h119">Modificación (reciente)</button>
                    <button type="button" role="option" aria-selected="false" data-sort-value="actualizado-asc"
                      data-pdi-on="click" data-pdi-h="h120">Modificación (antigua)</button>
                  </div>
                </div>
              </div>

              <!-- Botón de Filtros y Panel Desplegable (Lado Derecho / Barra de Chips en PC) -->
              <FilterPanel
                id="dropdownPadronFilterPanel"
                buttonId="btnDropdownPadronFilterPanel"
                menuId="menuPadronFilterPanel"
                countId="padronActiveFiltersCount"
                title="Filtros de Padrón"
                reset="window.resetPadronFilters ? window.resetPadronFilters() : null"
              >
                      <!-- Filtro 1: Estrategia Asignada (multiseleccion con checkbox) -->
                      <FilterField
                        id="dropdownPadronEstrategia"
                        menuId="menuPadronEstrategia"
                        labelId="labelPadronEstrategiaSelect"
                        label="Estrategia Asignada"
                        prefix="Estrategia:"
                        labelTodos="Todas"
                        todosEtiqueta="Todas"
                        opciones={OPCIONES_ESTRATEGIA}
                        onSelect="window.togglePadronEstrategia"
                        abrir="window.togglePadronInnerDropdown ? window.togglePadronInnerDropdown('dropdownPadronEstrategia') : null"
                        countPrefix="countFacetEstrategia"
                      />
                      
                      <!-- Filtro 2: Sede Operativa (multiseleccion con checkbox) -->
                      <FilterField
                        id="dropdownPadronSede"
                        menuId="menuPadronSede"
                        labelId="labelPadronSedeSelect"
                        label="Sede Operativa"
                        prefix="Sede:"
                        labelTodos="Todas las Sedes"
                        todosEtiqueta="Todas las Sedes"
                        opciones={OPCIONES_SEDE}
                        onSelect="window.togglePadronSede"
                        abrir="window.togglePadronInnerDropdown ? window.togglePadronInnerDropdown('dropdownPadronSede') : null"
                        countPrefix="countFacetSede"
                      />
                      
                      <!-- Filtro 3: Condicion Nutricional / Semaforo Anemia MINSA (multiseleccion) -->
                      <FilterField
                        id="dropdownPadronAnemia"
                        menuId="menuPadronAnemia"
                        labelId="labelPadronAnemiaSelect"
                        label="Condición Nutricional (Anemia)"
                        prefix="Condición:"
                        labelTodos="Todas"
                        todosEtiqueta="Todos"
                        opciones={OPCIONES_ANEMIA}
                        onSelect="window.togglePadronAnemia"
                        abrir="window.togglePadronInnerDropdown ? window.togglePadronInnerDropdown('dropdownPadronAnemia') : null"
                        countPrefix="countFacetAnemia"
                      />
                      
                      <!-- Filtro 4: Edad del Usuario (0 a 18 años con Cuadro de Edad Específica y Slider de Rango) -->
                      <div class="audit-filter-field padron-facet-field-edad">
                        <label class="audit-field-label" style="margin-bottom:0;">Edad del Usuario</label>
                        <div class="padron-inner-dropdown" id="dropdownPadronEdad">
                          <button type="button" class="padron-inner-dropdown-btn"
                            data-pdi-call="window.togglePadronInnerDropdown"
                            data-pdi-args='["dropdownPadronEdad"]'
                            aria-expanded="false" aria-controls="menuPadronEdad">
                            <span class="padron-chip-prefix">Edad:</span>
                            <span id="labelPadronEdadSelect">Todas</span>
                            <Icon name="nav.desplegar" size={null} class="caret" />
                          </button>
                          <div class="padron-inner-dropdown-reveal">
                            <div class="padron-inner-dropdown-menu padron-edad-dropdown-menu" id="menuPadronEdad">
                              <div class="facet-edad-header">
                                <span class="facet-edad-header-title">Rango de Edad</span>
                                <button type="button" class="btn-facet-all-edad active" id="btnPadronEdadTodas"
                                  data-pdi-on="click" data-pdi-h="h124">
                                  Todas
                                </button>
                              </div>
                              <div class="facet-edad-card">
                                <div class="facet-edad-input-row">
                                  <span class="facet-edad-input-label">Edad específica:</span>
                                  <div class="facet-edad-input-box">
                                    <input type="number" min="0" max="18" placeholder="7" id="numPadronEdad"
                                      class="facet-edad-num-input"
                                      data-pdi-on="input" data-pdi-h="h125">
                                    <span class="facet-edad-unit">años</span>
                                  </div>
                                </div>
                                <div class="facet-edad-slider-section">
                                  <div class="facet-edad-slider-labels">
                                    <span>0 años</span>
                                    <span id="labelPadronEdadSliderVal" style="font-weight:700; color:var(--text-brand);">0 a 18
                                      años</span>
                                    <span>18 años</span>
                                  </div>
                                  <div class="facet-range-slider-wrapper">
                                    <div class="facet-range-slider-track"></div>
                                    <div class="facet-range-slider-highlight" id="sliderPadronEdadHighlight"
                                      style="left:0%; right:0%;"></div>
                                    <input type="range" min="0" max="18" value="0" id="sliderPadronEdadMin"
                                      class="facet-range-slider-input"
                                      data-pdi-on="input" data-pdi-h="h126">
                                    <input type="range" min="0" max="18" value="18" id="sliderPadronEdadMax"
                                      class="facet-range-slider-input"
                                      data-pdi-on="input" data-pdi-h="h127">
                                  </div>
                                </div>
                              </div>
                            </div>
                          </div>
                        </div>
                      </div>

                      <!-- Filtro 5: Sexo del Usuario (seleccion unica con radio) -->
                      <FilterField
                        id="dropdownPadronSexo"
                        menuId="menuPadronSexo"
                        labelId="labelPadronSexoSelect"
                        label="Sexo del Usuario"
                        prefix="Sexo:"
                        labelTodos="Todos"
                        todosEtiqueta="Todos"
                        opciones={OPCIONES_SEXO}
                        tipo="single"
                        onSelect="window.selectPadronSexo"
                        abrir="window.togglePadronInnerDropdown ? window.togglePadronInnerDropdown('dropdownPadronSexo') : null"
                        countPrefix="countFacetSexo"
                      />

                      <!-- Filtro 6: Modalidad de atención (seleccion unica con radio) -->
                      <FilterField
                        id="dropdownPadronModalidad"
                        menuId="menuPadronModalidad"
                        labelId="labelPadronModalidadSelect"
                        label="Modalidad de Atención"
                        prefix="Modalidad:"
                        labelTodos="Todas"
                        todosEtiqueta="Todas"
                        opciones={OPCIONES_MODALIDAD}
                        tipo="single"
                        onSelect="window.selectPadronModalidad"
                        abrir="window.togglePadronInnerDropdown ? window.togglePadronInnerDropdown('dropdownPadronModalidad') : null"
                        countPrefix="countFacetModalidad"
                      />

                      <!-- Filtro 7: Seguro de salud (seleccion unica con radio) -->
                      <FilterField
                        id="dropdownPadronSeguro"
                        menuId="menuPadronSeguro"
                        labelId="labelPadronSeguroSelect"
                        label="Seguro de Salud"
                        prefix="Seguro:"
                        labelTodos="Todos"
                        todosEtiqueta="Todos"
                        opciones={OPCIONES_SEGURO}
                        tipo="single"
                        onSelect="window.selectPadronSeguro"
                        abrir="window.togglePadronInnerDropdown ? window.togglePadronInnerDropdown('dropdownPadronSeguro') : null"
                        countPrefix="countFacetSeguro"
                      />
              </FilterPanel>

              <button type="button" class="btn-action-icon btn-audit-export-icon table-export-btn pdi-motion" id="btnExportPadronCSV"
                data-pdi-on="click" data-pdi-h="h110"
                aria-label="Descargar el padrón filtrado" title="Descargar el padrón filtrado">
                <Icon name="accion.descargar" size={18} />
              </button>
            </div>

            <!-- Barra de Píldoras de Filtros Activos (Chips Descartables - Visible en PC/Tablets) -->
            <div class="padron-active-chips-bar" id="padronActiveChipsBar">
              <span class="padron-active-chips-label">Filtros aplicados:</span>
              <div id="padronActiveChipsList" style="display: flex; align-items: center; flex-wrap: wrap; gap: 6px;">
              </div>
              <button type="button" class="btn-text-subtle" style="margin-left: auto; font-size: 11.5px;"
                data-pdi-on="click" data-pdi-h="h129">
                Limpiar filtros
              </button>
            </div>

            <!-- Vista de Tabla para Escritorio / Desktop -->
            <div class="table-container desktop-table-view">
              <table class="data-table" id="tablaBeneficiarios">
                <thead>
                  <tr>
                    <th>Usuario(a) / DNI</th>
                    <th>Sede y distrito</th>
                    <th>Estrategias</th>
                    <th>Edad / Contacto</th>
                    <th>Apoderado</th>
                    <th>Estado</th>
                    <th>Acciones</th>
                  </tr>
                </thead>
                <tbody id="tbodyBeneficiarios">
                  <tr id="padronCargando">
                    <td colspan="7" style="text-align: center; padding: 32px; color: var(--text-dim);">
                      Cargando usuarios…
                    </td>
                  </tr>
                </tbody>
              </table>
            </div>

            <!-- Vista de Tarjetas Acordeón para Dispositivos Móviles / Smartphones -->
            <div class="mobile-accordion-list" id="mobileCardsBeneficiarios">
              <!-- Injected via JS -->
            </div>

            <!-- Controles de Paginación del Padrón de Usuarios (PC / Móvil) -->
            <div class="padron-pagination-bar" id="padronPaginationBar">
              <div class="padron-pagination-left">
                <span id="padronPaginationInfo" style="font-size:12.5px; color:var(--text-muted); font-weight:500;">
                  Mostrando usuarios…
                </span>
                <div class="padron-density-wrapper" id="padronDensityWrapper"
                  style="display:flex; align-items:center; gap:6px;">
                  <span style="font-size:12px; color:var(--text-dim);">Mostrar:</span>
                  <select class="audit-density-select padron-density-select" id="selectPadronPageSize"
                    data-pdi-on="change" data-pdi-h="h130">
                    <option value="10">10 por página</option>
                    <option value="20" selected>20 por página</option>
                    <option value="30">30 por página</option>
                    <option value="40">40 por página</option>
                    <option value="50">50 por página (Máx)</option>
                  </select>
                </div>
              </div>
              <div class="padron-pagination-right">
                <button type="button" class="btn-page" id="btnPadronPagePrev"
                  data-pdi-on="click" data-pdi-h="h131">
                  <Icon name="accion.volver" size={14} />
                  <span>Anterior</span>
                </button>
                <span class="audit-page-indicator" id="padronCurrentPageNum">Página 1</span>
                <button type="button" class="btn-page" id="btnPadronPageNext"
                  data-pdi-on="click" data-pdi-h="h132">
                  <span>Siguiente</span>
                  <Icon name="accion.abrir" size={14} />
                </button>
              </div>
            </div>
          </div>
        </section>

  <script>
    import '../scripts/pages/padron.js';
  </script>
</AppLayout>