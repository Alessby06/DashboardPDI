---
import AppLayout from '../layouts/AppLayout.astro';
import '../styles/views-auditoria.css';
---

<AppLayout title="Historial de Cambios" currentPage="auditoria">
        <section class="app-view active" id="view-auditoria">
          <div class="view-header audit-view-header">
            <div class="view-title-group">
              <div class="audit-header-title-row">
                <div class="audit-header-left">
                  <h2>Auditoría - Historial de cambios</h2>
                  <!-- Icono de Ley N.° 29733 con Popover Informativo Interactivo -->
                  <div class="audit-legal-popover-wrapper" id="wrapAuditLegalPopover">
                    <button type="button" class="audit-legal-icon-btn" id="btnAuditLegalInfo"
                      onclick="window.toggleAuditLegalInfo ? window.toggleAuditLegalInfo(event) : null"
                      aria-label="Información legal Ley N.° 29733"
                      title="Registro inmutable de trazabilidad conforme a la Ley N.° 29733 de Protección de Datos Personales">
                      <svg width="15" height="15" fill="none" stroke="currentColor" stroke-width="2.5"
                        viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round"
                          d="M9 12.75L11.25 15 15 9.75m-3-7.036A11.959 11.959 0 013.598 6 11.99 11.99 0 003 9.749c0 5.592 3.824 10.29 9 11.623 5.176-1.332 9-6.03 9-11.622 0-1.31-.21-2.571-.598-3.751h-.152c-3.196 0-6.1-1.248-8.25-3.285z" />
                      </svg>
                    </button>
                    <div class="audit-legal-popover" id="popoverAuditLegal">
                      <div class="audit-legal-popover-header">
                        <svg width="14" height="14" fill="none" stroke="currentColor" stroke-width="2.5"
                          viewBox="0 0 24 24">
                          <path stroke-linecap="round" stroke-linejoin="round"
                            d="M9 12.75L11.25 15 15 9.75m-3-7.036A11.959 11.959 0 013.598 6 11.99 11.99 0 003 9.749c0 5.592 3.824 10.29 9 11.623 5.176-1.332 9-6.03 9-11.622 0-1.31-.21-2.571-.598-3.751h-.152c-3.196 0-6.1-1.248-8.25-3.285z" />
                        </svg>
                        <span>Ley N.° 29733 · Registro Inmutable</span>
                      </div>
                      <p class="audit-legal-popover-text">
                        Registro inmutable de trazabilidad y auditoría forense conforme a la Ley de Protección de Datos
                        Personales. Las acciones son de solo lectura y no pueden alterarse.
                      </p>
                    </div>
                  </div>
                </div>

                <div class="audit-header-badge-actions">
                  <!-- Botón Descargar Bitácora CSV en formato icono con apertura de confirmación -->
                  <button type="button" class="btn-action-icon btn-audit-export-icon" id="btnExportAuditCSV"
                    onclick="window.openModalExportAudit ? window.openModalExportAudit() : null"
                    aria-label="Descargar Bitácora CSV" title="Descargar Bitácora Oficial CSV">
                    <svg width="18" height="18" fill="none" stroke="currentColor" stroke-width="2.2"
                      viewBox="0 0 24 24">
                      <path stroke-linecap="round" stroke-linejoin="round"
                        d="M3 16.5v2.25A2.25 2.25 0 005.25 21h13.5A2.25 2.25 0 0021 18.75V16.5M16.5 12L12 16.5m0 0L7.5 12m4.5 4.5V3" />
                    </svg>
                  </button>
                </div>
              </div>
            </div>
          </div>

          <!-- Barra Resumen Dinámica y Compacta de Auditoría (Solo KPIs estilizados, sin última actividad) -->
          <div class="audit-summary-bar">
            <div class="audit-kpi-chip">
              <div class="audit-kpi-icon-box total">
                <svg width="14" height="14" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round"
                    d="M3.75 12h16.5m-16.5 3.75h16.5M3.75 19.5h16.5M5.625 4.5h12.75a1.875 1.875 0 010 3.75H5.625a1.875 1.875 0 010-3.75z" />
                </svg>
              </div>
              <div class="audit-kpi-info">
                <span class="audit-kpi-label">Total Registros</span>
                <strong class="audit-kpi-value" id="auditKpiTotal">0</strong>
              </div>
            </div>

            <div class="audit-kpi-chip">
              <div class="audit-kpi-icon-box sensibles">
                <svg width="14" height="14" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round"
                    d="M12 9v3.75m-9.303 3.376c-.866 1.5.217 3.374 1.948 3.374h14.71c1.73 0 2.813-1.874 1.948-3.374L13.949 3.378c-.866-1.5-3.032-1.5-3.898 0L2.697 16.126zM12 15.75h.007v.008H12v-.008z" />
                </svg>
              </div>
              <div class="audit-kpi-info">
                <span class="audit-kpi-label">Acciones Sensibles</span>
                <strong class="audit-kpi-value text-sensibles" id="auditKpiSensibles">0</strong>
              </div>
            </div>
          </div>

          <div class="card">
            <!-- Barra de Filtros y Búsqueda Rápida Interna -->
            <div class="audit-toolbar">
              <!-- Buscador Rápido de Auditoría (Lado Izquierdo) -->
              <div class="audit-search-wrap">
                <svg class="audit-search-icon" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round"
                    d="M21 21l-5.197-5.197m0 0A7.5 7.5 0 105.196 5.196a7.5 7.5 0 0010.607 10.607z" />
                </svg>
                <input type="text" id="inputAuditSearch" class="audit-search-input"
                  placeholder="Buscar por DNI, código, usuario o acción..."
                  oninput="window.filterAuditSearch ? window.filterAuditSearch(this.value) : (window.PDI?.DashboardView?.filterBySearch ? window.PDI.DashboardView.filterBySearch(this.value) : null)">
                <button type="button" class="audit-search-clear" id="btnAuditSearchClear" style="display:none;"
                  onclick="window.clearAuditSearch ? window.clearAuditSearch() : null" title="Limpiar búsqueda">
                  <svg width="12" height="12" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M6 18L18 6M6 6l12 12" />
                  </svg>
                </button>
              </div>

              <!-- Botón Unificado de Filtros y Panel Desplegable (Lado Derecho) -->
              <div class="audit-filter-panel-wrap">
                <div class="custom-dropdown audit-filters-dropdown" id="dropdownAuditFilterPanel">
                  <button type="button" class="btn-action audit-filter-btn" id="btnDropdownAuditFilterPanel"
                    onclick="window.toggleCustomDropdown ? window.toggleCustomDropdown('dropdownAuditFilterPanel') : (window.PDI?.DashboardView?.toggleDropdown ? window.PDI.DashboardView.toggleDropdown('dropdownAuditFilterPanel') : null)">
                    <svg width="16" height="16" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
                      <path stroke-linecap="round" stroke-linejoin="round"
                        d="M12 3c2.755 0 5.455.232 8.083.678.533.09.917.556.917 1.096v1.044a2.25 2.25 0 01-.659 1.591l-5.432 5.432a2.25 2.25 0 00-.659 1.591v2.927a2.25 2.25 0 01-1.244 2.013L9.75 21v-6.568a2.25 2.25 0 00-.659-1.591L3.659 7.409A2.25 2.25 0 013 5.818V4.774c0-.54.384-1.006.917-1.096A48.32 48.32 0 0112 3z" />
                    </svg>
                    <span>Filtros</span>
                    <span class="audit-filter-badge" id="auditActiveFiltersCount" style="display:none;">0</span>
                    <svg width="12" height="12" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24"
                      class="filter-caret">
                      <path stroke-linecap="round" stroke-linejoin="round" d="M19.5 8.25l-7.5 7.5-7.5-7.5" />
                    </svg>
                  </button>

                  <!-- Panel Desplegable de Filtros Pulido -->
                  <div class="custom-dropdown-menu audit-filters-menu" id="menuAuditFilterPanel">
                    <div class="audit-filters-header">
                      <div class="audit-filters-header-title">
                        <svg width="15" height="15" fill="none" stroke="currentColor" stroke-width="2"
                          viewBox="0 0 24 24">
                          <path stroke-linecap="round" stroke-linejoin="round"
                            d="M12 3c2.755 0 5.455.232 8.083.678.533.09.917.556.917 1.096v1.044a2.25 2.25 0 01-.659 1.591l-5.432 5.432a2.25 2.25 0 00-.659 1.591v2.927a2.25 2.25 0 01-1.244 2.013L9.75 21v-6.568a2.25 2.25 0 00-.659-1.591L3.659 7.409A2.25 2.25 0 013 5.818V4.774c0-.54.384-1.006.917-1.096A48.32 48.32 0 0112 3z" />
                        </svg>
                        <span>Filtros de Bitácora</span>
                      </div>
                      <button type="button" class="btn-text-subtle"
                        onclick="window.resetAuditFilters ? window.resetAuditFilters() : null">Restablecer</button>
                    </div>

                    <div class="audit-filters-body">
                      <!-- Filtro 1: Tipo de Evento / Módulo (Dropdown Multi-selección con Checkbox) -->
                      <div class="audit-filter-field">
                        <label class="audit-field-label">Tipo de Evento</label>
                        <div class="padron-inner-dropdown" id="dropdownAuditAction">
                          <button type="button" class="padron-inner-dropdown-btn"
                            onclick="window.toggleAuditInnerDropdown ? window.toggleAuditInnerDropdown('dropdownAuditAction') : null">
                            <span id="labelAuditActionSelect">Todos los Eventos</span>
                            <svg class="caret" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24">
                              <path stroke-linecap="round" stroke-linejoin="round" d="M19.5 8.25l-7.5 7.5-7.5-7.5" />
                            </svg>
                          </button>
                          <div class="padron-inner-dropdown-menu" id="menuAuditAction">
                            <div class="padron-dropdown-item selected" data-value="all"
                              onclick="window.toggleAuditAction ? window.toggleAuditAction('all') : null">
                              <div class="padron-item-left">
                                <span class="padron-item-checkbox">
                                  <svg width="10" height="10" fill="none" stroke="currentColor" stroke-width="3"
                                    viewBox="0 0 24 24">
                                    <path stroke-linecap="round" stroke-linejoin="round" d="M4.5 12.75l6 6 9-13.5" />
                                  </svg>
                                </span>
                                <span class="padron-item-label">Todos</span>
                              </div>
                              <span class="padron-item-count" id="countFacetAuditAction-all">(4)</span>
                            </div>
                            <div class="padron-dropdown-item" data-value="salud"
                              onclick="window.toggleAuditAction ? window.toggleAuditAction('salud') : null">
                              <div class="padron-item-left">
                                <span class="padron-item-checkbox">
                                  <svg width="10" height="10" fill="none" stroke="currentColor" stroke-width="3"
                                    viewBox="0 0 24 24">
                                    <path stroke-linecap="round" stroke-linejoin="round" d="M4.5 12.75l6 6 9-13.5" />
                                  </svg>
                                </span>
                                <span class="badge badge-yellow" style="padding:1px 5px; font-size:10px;">CRED</span>
                                <span class="padron-item-label">Salud y Nutrición</span>
                              </div>
                              <span class="padron-item-count" id="countFacetAuditAction-salud">(0)</span>
                            </div>
                            <div class="padron-dropdown-item" data-value="social"
                              onclick="window.toggleAuditAction ? window.toggleAuditAction('social') : null">
                              <div class="padron-item-left">
                                <span class="padron-item-checkbox">
                                  <svg width="10" height="10" fill="none" stroke="currentColor" stroke-width="3"
                                    viewBox="0 0 24 24">
                                    <path stroke-linecap="round" stroke-linejoin="round" d="M4.5 12.75l6 6 9-13.5" />
                                  </svg>
                                </span>
                                <span class="badge badge-red" style="padding:1px 5px; font-size:10px;">ASP</span>
                                <span class="padron-item-label">Derivación Social</span>
                              </div>
                              <span class="padron-item-count" id="countFacetAuditAction-social">(0)</span>
                            </div>
                            <div class="padron-dropdown-item" data-value="educativo"
                              onclick="window.toggleAuditAction ? window.toggleAuditAction('educativo') : null">
                              <div class="padron-item-left">
                                <span class="padron-item-checkbox">
                                  <svg width="10" height="10" fill="none" stroke="currentColor" stroke-width="3"
                                    viewBox="0 0 24 24">
                                    <path stroke-linecap="round" stroke-linejoin="round" d="M4.5 12.75l6 6 9-13.5" />
                                  </svg>
                                </span>
                                <span class="badge badge-blue" style="padding:1px 5px; font-size:10px;">CS</span>
                                <span class="padron-item-label">Casitas del Saber</span>
                              </div>
                              <span class="padron-item-count" id="countFacetAuditAction-educativo">(0)</span>
                            </div>
                            <div class="padron-dropdown-item" data-value="padron"
                              onclick="window.toggleAuditAction ? window.toggleAuditAction('padron') : null">
                              <div class="padron-item-left">
                                <span class="padron-item-checkbox">
                                  <svg width="10" height="10" fill="none" stroke="currentColor" stroke-width="3"
                                    viewBox="0 0 24 24">
                                    <path stroke-linecap="round" stroke-linejoin="round" d="M4.5 12.75l6 6 9-13.5" />
                                  </svg>
                                </span>
                                <span class="badge badge-green" style="padding:1px 5px; font-size:10px;">Padrón</span>
                                <span class="padron-item-label">Padrón / Coordinación</span>
                              </div>
                              <span class="padron-item-count" id="countFacetAuditAction-padron">(0)</span>
                            </div>
                          </div>
                        </div>
                      </div>

                      <!-- Filtro 2: Periodo Temporal (Dropdown Desplegable con Radios y Panel Interactivo) -->
                      <div class="audit-filter-field">
                        <label class="audit-field-label">Periodo Temporal</label>
                        <div class="padron-inner-dropdown" id="dropdownAuditDate">
                          <button type="button" class="padron-inner-dropdown-btn"
                            onclick="window.toggleAuditInnerDropdown ? window.toggleAuditInnerDropdown('dropdownAuditDate') : null">
                            <span id="labelAuditDateSelect">Todas las Fechas</span>
                            <svg class="caret" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24">
                              <path stroke-linecap="round" stroke-linejoin="round" d="M19.5 8.25l-7.5 7.5-7.5-7.5" />
                            </svg>
                          </button>
                          <div class="padron-inner-dropdown-menu" id="menuAuditDate">
                            <div class="padron-dropdown-item selected" data-value="all"
                              onclick="window.selectAuditDate ? window.selectAuditDate('all', 'Todas las Fechas') : null">
                              <div class="padron-item-left">
                                <span class="padron-item-radio"></span>
                                <span class="padron-item-label">Todas las Fechas</span>
                              </div>
                              <span class="padron-item-count" id="countFacetAuditDate-all">(4)</span>
                            </div>
                            <div class="padron-dropdown-item" data-value="today"
                              onclick="window.selectAuditDate ? window.selectAuditDate('today', 'Hoy (Jornada en curso)') : null">
                              <div class="padron-item-left">
                                <span class="padron-item-radio"></span>
                                <span class="padron-item-label">Hoy (Jornada en curso)</span>
                              </div>
                              <span class="padron-item-count" id="countFacetAuditDate-today">(0)</span>
                            </div>
                            <div class="padron-dropdown-item" data-value="week"
                              onclick="window.selectAuditDate ? window.selectAuditDate('week', 'Últimos 7 días') : null">
                              <div class="padron-item-left">
                                <span class="padron-item-radio"></span>
                                <span class="padron-item-label">Últimos 7 días</span>
                              </div>
                              <span class="padron-item-count" id="countFacetAuditDate-week">(0)</span>
                            </div>
                            <div class="padron-dropdown-item" data-value="specific"
                              onclick="window.selectAuditDate ? window.selectAuditDate('specific', 'Fecha Específica') : null">
                              <div class="padron-item-left">
                                <span class="padron-item-radio"></span>
                                <span class="padron-item-label">Fecha Específica</span>
                              </div>
                            </div>
                            <div class="padron-dropdown-item" data-value="range"
                              onclick="window.selectAuditDate ? window.selectAuditDate('range', 'Rango de Fechas') : null">
                              <div class="padron-item-left">
                                <span class="padron-item-radio"></span>
                                <span class="padron-item-label">Rango de Fechas (Desde - Hasta)</span>
                              </div>
                            </div>
                          </div>
                        </div>

                        <!-- Panel Interactivo: Fecha Específica -->
                        <div class="audit-date-custom-panel" id="panelAuditDateSpecific"
                          style="display:none; margin-top:8px;">
                          <div class="audit-date-input-group">
                            <span class="audit-sub-label">Fecha del evento:</span>
                            <div class="audit-input-with-icon">
                              <input type="text" id="inputAuditSpecificDate" class="audit-date-text-input"
                                placeholder="DD/MM/AAAA (ej. 13/09/2026)" maxlength="10"
                                oninput="window.handleAuditDateManualInput ? window.handleAuditDateManualInput('specific', this) : null">
                              <input type="date" id="pickerAuditSpecificDate" class="audit-native-picker-hidden"
                                onchange="window.handleAuditDatePickerChange ? window.handleAuditDatePickerChange('specific', this.value) : null">
                              <button type="button" class="audit-calendar-icon-btn"
                                onclick="document.getElementById('pickerAuditSpecificDate').showPicker ? document.getElementById('pickerAuditSpecificDate').showPicker() : document.getElementById('pickerAuditSpecificDate').focus()"
                                title="Abrir calendario">
                                <svg width="15" height="15" fill="none" stroke="currentColor" stroke-width="2"
                                  viewBox="0 0 24 24">
                                  <path stroke-linecap="round" stroke-linejoin="round"
                                    d="M6.75 3v2.25M17.25 3v2.25M3.75 7.5h16.5M4.5 20.25h15a2.25 2.25 0 002.25-2.25V6.75a2.25 2.25 0 00-2.25-2.25h-15a2.25 2.25 0 00-2.25 2.25v11.25a2.25 2.25 0 002.25 2.25z" />
                                </svg>
                              </button>
                            </div>
                          </div>
                        </div>

                        <!-- Panel Interactivo: Rango de Fechas (Desde / Hasta) -->
                        <div class="audit-date-custom-panel" id="panelAuditDateRange"
                          style="display:none; margin-top:8px;">
                          <div class="audit-range-grid">
                            <div class="audit-date-input-group">
                              <span class="audit-sub-label">Desde:</span>
                              <div class="audit-input-with-icon">
                                <input type="text" id="inputAuditRangeStart" class="audit-date-text-input"
                                  placeholder="DD/MM/AAAA" maxlength="10"
                                  oninput="window.handleAuditDateManualInput ? window.handleAuditDateManualInput('range-start', this) : null">
                                <input type="date" id="pickerAuditRangeStart" class="audit-native-picker-hidden"
                                  onchange="window.handleAuditDatePickerChange ? window.handleAuditDatePickerChange('range-start', this.value) : null">
                                <button type="button" class="audit-calendar-icon-btn"
                                  onclick="document.getElementById('pickerAuditRangeStart').showPicker ? document.getElementById('pickerAuditRangeStart').showPicker() : document.getElementById('pickerAuditRangeStart').focus()"
                                  title="Abrir calendario">
                                  <svg width="15" height="15" fill="none" stroke="currentColor" stroke-width="2"
                                    viewBox="0 0 24 24">
                                    <path stroke-linecap="round" stroke-linejoin="round"
                                      d="M6.75 3v2.25M17.25 3v2.25M3.75 7.5h16.5M4.5 20.25h15a2.25 2.25 0 002.25-2.25V6.75a2.25 2.25 0 00-2.25-2.25h-15a2.25 2.25 0 00-2.25 2.25v11.25a2.25 2.25 0 002.25 2.25z" />
                                  </svg>
                                </button>
                              </div>
                            </div>
                            <div class="audit-date-input-group">
                              <span class="audit-sub-label">Hasta:</span>
                              <div class="audit-input-with-icon">
                                <input type="text" id="inputAuditRangeEnd" class="audit-date-text-input"
                                  placeholder="DD/MM/AAAA" maxlength="10"
                                  oninput="window.handleAuditDateManualInput ? window.handleAuditDateManualInput('range-end', this) : null">
                                <input type="date" id="pickerAuditRangeEnd" class="audit-native-picker-hidden"
                                  onchange="window.handleAuditDatePickerChange ? window.handleAuditDatePickerChange('range-end', this.value) : null">
                                <button type="button" class="audit-calendar-icon-btn"
                                  onclick="document.getElementById('pickerAuditRangeEnd').showPicker ? document.getElementById('pickerAuditRangeEnd').showPicker() : document.getElementById('pickerAuditRangeEnd').focus()"
                                  title="Abrir calendario">
                                  <svg width="15" height="15" fill="none" stroke="currentColor" stroke-width="2"
                                    viewBox="0 0 24 24">
                                    <path stroke-linecap="round" stroke-linejoin="round"
                                      d="M6.75 3v2.25M17.25 3v2.25M3.75 7.5h16.5M4.5 20.25h15a2.25 2.25 0 002.25-2.25V6.75a2.25 2.25 0 00-2.25-2.25h-15a2.25 2.25 0 00-2.25 2.25v11.25a2.25 2.25 0 002.25 2.25z" />
                                  </svg>
                                </button>
                              </div>
                            </div>
                          </div>
                        </div>
                      </div>

                      <!-- Filtro 3: Rol del Usuario (Dropdown Multi-selección con Checkbox) -->
                      <div class="audit-filter-field">
                        <label class="audit-field-label">Rol del Usuario</label>
                        <div class="padron-inner-dropdown" id="dropdownAuditRole">
                          <button type="button" class="padron-inner-dropdown-btn"
                            onclick="window.toggleAuditInnerDropdown ? window.toggleAuditInnerDropdown('dropdownAuditRole') : null">
                            <span id="labelAuditRoleSelect">Todos los Roles</span>
                            <svg class="caret" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24">
                              <path stroke-linecap="round" stroke-linejoin="round" d="M19.5 8.25l-7.5 7.5-7.5-7.5" />
                            </svg>
                          </button>
                          <div class="padron-inner-dropdown-menu" id="menuAuditRole">
                            <div class="padron-dropdown-item selected" data-value="all"
                              onclick="window.toggleAuditRole ? window.toggleAuditRole('all') : null">
                              <div class="padron-item-left">
                                <span class="padron-item-checkbox">
                                  <svg width="10" height="10" fill="none" stroke="currentColor" stroke-width="3"
                                    viewBox="0 0 24 24">
                                    <path stroke-linecap="round" stroke-linejoin="round" d="M4.5 12.75l6 6 9-13.5" />
                                  </svg>
                                </span>
                                <span class="padron-item-label">Todos los Roles</span>
                              </div>
                              <span class="padron-item-count" id="countFacetAuditRole-all">(4)</span>
                            </div>
                            <div class="padron-dropdown-item" data-value="Coordinación"
                              onclick="window.toggleAuditRole ? window.toggleAuditRole('Coordinación') : null">
                              <div class="padron-item-left">
                                <span class="padron-item-checkbox">
                                  <svg width="10" height="10" fill="none" stroke="currentColor" stroke-width="3"
