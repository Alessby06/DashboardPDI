---
import AppLayout from '../layouts/AppLayout.astro';
import FilterPanel from '../components/FilterPanel.astro';
import FilterField from '../components/FilterField.astro';
import SortMenu from '../components/SortMenu.astro';
import '../styles/views-auditoria.css';
import '../styles/views-export-icon.css';
import Icon from '../components/Icon.astro';

const OPCIONES_ACCION = [
  { valor: 'Padrón de Usuarios', chip: { texto: 'Usuarios', tono: 'green', compacta: true }, etiqueta: 'Padrón de Usuarios' },
  { valor: 'Padrón de Colaboradores', chip: { texto: 'Personal', tono: 'blue', compacta: true }, etiqueta: 'Padrón de Colaboradores' },
  { valor: 'Padrón de Voluntarios', chip: { texto: 'Voluntariado', tono: 'purple', compacta: true }, etiqueta: 'Padrón de Voluntarios' },
  { valor: 'Servicio Alimentario y Nutricional', chip: { texto: 'Nutrición', tono: 'yellow', compacta: true }, etiqueta: 'Servicio Alimentario y Nutricional' },
  { valor: 'Servicio de Acompañamiento Educativo', chip: { texto: 'Educación', tono: 'blue', compacta: true }, etiqueta: 'Servicio de Acompañamiento Educativo' },
  { valor: 'Servicio Social Pastoral (ASP)', chip: { texto: 'Pastoral', tono: 'red', compacta: true }, etiqueta: 'Servicio Social Pastoral (ASP)' },
  { valor: 'Sedes e Iglesias Aliadas', chip: { texto: 'Sedes', tono: 'green', compacta: true }, etiqueta: 'Sedes e Iglesias Aliadas' },
  { valor: 'Cuentas y Acceso', chip: { texto: 'Seguridad', tono: 'gray', compacta: true }, etiqueta: 'Cuentas y Acceso' },
];
const OPCIONES_FECHA = [
  { valor: 'today', etiqueta: 'Hoy (Jornada en curso)' },
  { valor: 'week', etiqueta: 'Últimos 7 días' },
  { valor: 'specific', etiqueta: 'Fecha Específica', contador: false },
  { valor: 'range', etiqueta: 'Rango de Fechas (Desde - Hasta)', contador: false },
];
const OPCIONES_ROL_AUDIT = [
  'Coordinación',
  'Facilitadora',
  'Promotora',
  'Trabajadora Social',
].map((rol) => ({ valor: rol, etiqueta: rol }));
const OPCIONES_ESTADO_AUDIT = [
  { valor: 'Rutinario', chip: { texto: 'Rutinario', tono: 'green', compacta: true }, etiqueta: 'Rutinario / Operativo' },
  { valor: 'Importante', chip: { texto: 'Importante', tono: 'yellow', compacta: true }, etiqueta: 'Importante / Relevante' },
  { valor: 'Sensible', chip: { texto: 'Sensible', tono: 'red', compacta: true }, etiqueta: 'Sensible / Confidencial' },
];
const OPCIONES_ORDEN_AUDIT = [
  { valor: 'reciente-desc', etiqueta: 'Más reciente' },
  { valor: 'reciente-asc', etiqueta: 'Más antigua' },
  { valor: 'usuario-asc', etiqueta: 'Usuario (A-Z)' },
  { valor: 'accion-asc', etiqueta: 'Acción (A-Z)' },
  { valor: 'entidad-asc', etiqueta: 'Entidad (A-Z)' },
];
---

<AppLayout title="Historial de Cambios" currentPage="auditoria">
        <section class="app-view active" id="view-auditoria">
          <div class="view-header audit-view-header">
            <div class="view-title-group">
              <div class="audit-header-title-row">
                <div class="audit-header-left">
                  <h1>Auditoría - Historial de cambios</h1>
                  <!-- Icono de Ley N.° 29733 con Popover Informativo Interactivo -->
                  <div class="audit-legal-popover-wrapper" id="wrapAuditLegalPopover">
                    <button type="button" class="audit-legal-icon-btn" id="btnAuditLegalInfo"
                      data-pdi-on="click" data-pdi-h="h050"
                      aria-label="Información legal Ley N.° 29733"
                      title="Registro inmutable de trazabilidad conforme a la Ley N.° 29733 de Protección de Datos Personales">
                      <Icon name="salud.escudo" size={15} />
                    </button>
                    <div class="audit-legal-popover" id="popoverAuditLegal">
                      <div class="audit-legal-popover-header">
                        <Icon name="salud.escudo" size={14} />
                        <span>Ley N.° 29733 · Registro Inmutable</span>
                      </div>
                      <p class="audit-legal-popover-text">
                        Registro inmutable de trazabilidad y auditoría forense conforme a la Ley de Protección de Datos
                        Personales. Las acciones son de solo lectura y no pueden alterarse.
                      </p>
                    </div>
                  </div>
                </div>

              </div>
            </div>
          </div>

          <!-- Barra Resumen Dinámica y Compacta de Auditoría (Solo KPIs estilizados, sin última actividad) -->
          <div class="audit-summary-bar">
            <div class="audit-kpi-chip">
              <div class="audit-kpi-icon-box total">
                <Icon name="accion.lista" size={14} />
              </div>
              <div class="audit-kpi-info">
                <span class="audit-kpi-label">Total Registros</span>
                <strong class="audit-kpi-value" id="auditKpiTotal">0</strong>
              </div>
            </div>

            <div class="audit-kpi-chip">
              <div class="audit-kpi-icon-box rutinario">
                <Icon name="estado.ok" size={14} />
              </div>
              <div class="audit-kpi-info">
                <span class="audit-kpi-label">Rutinario</span>
                <strong class="audit-kpi-value" id="auditKpiRutinario">0</strong>
              </div>
            </div>

            <div class="audit-kpi-chip">
              <div class="audit-kpi-icon-box importante">
                <Icon name="estado.info" size={14} />
              </div>
              <div class="audit-kpi-info">
                <span class="audit-kpi-label">Importante</span>
                <strong class="audit-kpi-value" id="auditKpiImportante">0</strong>
              </div>
            </div>

            <div class="audit-kpi-chip">
              <div class="audit-kpi-icon-box sensibles">
                <Icon name="estado.alerta" size={14} />
              </div>
              <div class="audit-kpi-info">
                <span class="audit-kpi-label">Sensible</span>
                <strong class="audit-kpi-value text-sensibles" id="auditKpiSensibles">0</strong>
              </div>
            </div>
          </div>

          <div class="card">
            <!-- Barra de Filtros y Búsqueda Rápida Interna -->
            <div class="audit-toolbar table-toolbar">
              <!-- Buscador Rápido de Auditoría (Lado Izquierdo) -->
              <div class="audit-search-wrap">
                <Icon name="accion.buscar" size={16} class="audit-search-icon" />
                <label for="inputAuditSearch" class="pdi-sr-only">Buscar en auditoría por DNI, código, usuario o acción</label>
                <input type="search" id="inputAuditSearch" class="audit-search-input" aria-label="Buscar en auditoría por DNI, código, usuario o acción"
                  placeholder="Buscar por DNI, código, usuario o acción..."
                  data-pdi-on="input" data-pdi-h="h051">
                <button type="button" class="audit-search-clear" id="btnAuditSearchClear" style="display:none;"
                  data-pdi-on="click" data-pdi-h="h052" title="Limpiar búsqueda">
                  <Icon name="accion.cerrar" size={12} />
                </button>
              </div>

              <SortMenu id="AuditoriaSort" options={OPCIONES_ORDEN_AUDIT} selected="reciente-desc" />

              <!-- Botón Unificado de Filtros y Panel Desplegable (Lado Derecho) -->
              <FilterPanel
                id="dropdownAuditFilterPanel"
                buttonId="btnDropdownAuditFilterPanel"
                menuId="menuAuditFilterPanel"
                countId="auditActiveFiltersCount"
                title="Filtros de Bitácora"
                reset="window.resetAuditFilters ? window.resetAuditFilters() : null"
              >
                      <!-- Filtro 1: Tipo de evento / modulo (multiseleccion) -->
                      <FilterField
                        id="dropdownAuditAction"
                        menuId="menuAuditAction"
                        labelId="labelAuditActionSelect"
                        label="Módulo Oficial"
                        prefix="Módulo:"
                        labelTodos="Todos los Módulos"
                        todosEtiqueta="Todos"
                        opciones={OPCIONES_ACCION}
                        onSelect="window.toggleAuditAction"
                        abrir="window.toggleAuditInnerDropdown ? window.toggleAuditInnerDropdown('dropdownAuditAction') : null"
                        countPrefix="countFacetAuditAction"
                      />
                      
                      <!-- Filtro 2: Periodo temporal (seleccion unica; paneles propios en el slot) -->
                      <FilterField
                        id="dropdownAuditDate"
                        menuId="menuAuditDate"
                        labelId="labelAuditDateSelect"
                        label="Periodo Temporal"
                        prefix="Periodo:"
                        labelTodos="Todas las Fechas"
                        todosEtiqueta="Todas las Fechas"
                        opciones={OPCIONES_FECHA}
                        tipo="single"
                        conEtiqueta={true}
                        onSelect="window.selectAuditDate"
                        abrir="window.toggleAuditInnerDropdown ? window.toggleAuditInnerDropdown('dropdownAuditDate') : null"
                        countPrefix="countFacetAuditDate"
                      >

<!-- Panel Interactivo: Fecha Específica -->
                        <div class="audit-date-custom-panel" id="panelAuditDateSpecific"
                          style="display:none; margin-top:8px;">
                          <div class="audit-date-input-group">
                            <span class="audit-sub-label">Fecha del evento:</span>
                            <div class="audit-input-with-icon">
                              <input type="text" id="inputAuditSpecificDate" class="audit-date-text-input"
                                placeholder="DD/MM/AAAA (ej. 13/09/2026)" maxlength="10"
                                data-pdi-on="input" data-pdi-h="h056">
                              <input type="date" id="pickerAuditSpecificDate" class="audit-native-picker-hidden"
                                data-pdi-on="change" data-pdi-h="h057">
                              <button type="button" class="audit-calendar-icon-btn"
                                data-pdi-on="click" data-pdi-h="h058"
                                title="Abrir calendario">
                                <Icon name="fecha.calendario" size={15} />
                              </button>
                            </div>
                          </div>
                        </div>

                        <!-- Panel Interactivo: Rango de Fechas (Desde / Hasta) -->
                        <div class="audit-date-custom-panel" id="panelAuditDateRange"
                          style="display:none; margin-top:8px;">
                          <div class="audit-range-grid">
                            <div class="audit-date-input-group">
                              <span class="audit-sub-label">Desde:</span>
                              <div class="audit-input-with-icon">
                                <input type="text" id="inputAuditRangeStart" class="audit-date-text-input"
                                  placeholder="DD/MM/AAAA" maxlength="10"
                                  data-pdi-on="input" data-pdi-h="h059">
                                <input type="date" id="pickerAuditRangeStart" class="audit-native-picker-hidden"
                                  data-pdi-on="change" data-pdi-h="h060">
                                <button type="button" class="audit-calendar-icon-btn"
                                  data-pdi-on="click" data-pdi-h="h061"
                                  title="Abrir calendario">
                                  <Icon name="fecha.calendario" size={15} />
                                </button>
                              </div>
                            </div>
                            <div class="audit-date-input-group">
                              <span class="audit-sub-label">Hasta:</span>
                              <div class="audit-input-with-icon">
                                <input type="text" id="inputAuditRangeEnd" class="audit-date-text-input"
                                  placeholder="DD/MM/AAAA" maxlength="10"
                                  data-pdi-on="input" data-pdi-h="h062">
                                <input type="date" id="pickerAuditRangeEnd" class="audit-native-picker-hidden"
                                  data-pdi-on="change" data-pdi-h="h063">
                                <button type="button" class="audit-calendar-icon-btn"
                                  data-pdi-on="click" data-pdi-h="h064"
                                  title="Abrir calendario">
                                  <Icon name="fecha.calendario" size={15} />
                                </button>
                              </div>
                            </div>
                          </div>
                        </div>
                      </FilterField>

                      <!-- Filtro 3: Rol del autor (multiseleccion) -->
                      <FilterField
                        id="dropdownAuditRole"
                        menuId="menuAuditRole"
                        labelId="labelAuditRoleSelect"
                        label="Rol del Autor"
                        prefix="Rol:"
                        labelTodos="Todos los Roles"
                        todosEtiqueta="Todos los Roles"
                        opciones={OPCIONES_ROL_AUDIT}
                        onSelect="window.toggleAuditRole"
                        abrir="window.toggleAuditInnerDropdown ? window.toggleAuditInnerDropdown('dropdownAuditRole') : null"
                        countPrefix="countFacetAuditRole"
                      />
                      
                      <!-- Filtro 4: Estado de registro / criticidad (multiseleccion) -->
                      <FilterField
                        id="dropdownAuditStatus"
                        menuId="menuAuditStatus"
                        labelId="labelAuditStatusSelect"
                        label="Severidad Institucional"
                        prefix="Severidad:"
                        labelTodos="Todas las Severidades"
                        todosEtiqueta="Todas"
                        opciones={OPCIONES_ESTADO_AUDIT}
                        onSelect="window.toggleAuditStatus"
                        abrir="window.toggleAuditInnerDropdown ? window.toggleAuditInnerDropdown('dropdownAuditStatus') : null"
                        countPrefix="countFacetAuditStatus"
                      />
              </FilterPanel>

              <button type="button" class="btn-action-icon btn-audit-export-icon table-export-btn pdi-motion" id="btnExportAuditCSV"
                data-pdi-on="click" data-pdi-h="h053"
                aria-label="Descargar la bitácora filtrada" title="Descargar la bitácora filtrada">
                <Icon name="accion.descargar" size={18} />
              </button>
            </div>

            <!-- Barra de Píldoras de Filtros Activos de Auditoría (Chips Descartables) -->
            <div class="padron-active-chips-bar" id="auditActiveChipsBar">
              <span class="padron-active-chips-label">Filtros aplicados:</span>
              <div id="auditActiveChipsList" style="display: flex; align-items: center; flex-wrap: wrap; gap: 6px;">
              </div>
              <button type="button" class="btn-text-subtle" style="margin-left: auto; font-size: 11.5px;"
                data-pdi-on="click" data-pdi-h="h067">
                Limpiar filtros
              </button>
            </div>

            <div class="table-container desktop-table-view">
              <span id="auditRowHint" class="pdi-sr-only">Pulse Enter o Espacio para alternar el detalle del registro.</span>
                <table class="data-table">
                <caption class="pdi-sr-only">Bitácora de auditoría. Cada registro describe una operación con su usuario, acción, entidad afectada y detalle.</caption>
                <thead>
                  <tr>
                    <th scope="col" id="auditThSeveridad" style="width:110px;">Severidad</th>
                    <th scope="col" id="auditThTitulo" style="min-width:250px;">Título del Evento</th>
                    <th scope="col" id="auditThModulo" style="width:180px;">Módulo</th>
                    <th scope="col" id="auditThAutor" style="width:190px;">Autor</th>
                    <th scope="col" id="auditThSede" style="width:105px;">Sede</th>
                    <th scope="col" id="auditThFecha" style="width:135px; text-align:right;">Fecha y Hora</th>
                    <th scope="col" id="auditThAcciones" style="width:44px; text-align:center;"></th>
                  </tr>
                </thead>
                <tbody id="tbodyAuditLogs">
                  <tr id="auditLogsCargando">
                    <td colspan="7" style="text-align:center; padding:32px; color:var(--text-dim);">
                      Cargando bitácora…
                    </td>
                  </tr>
                </tbody>
              </table>
            </div>

            <div class="mobile-accordion-list" id="mobileCardsAuditoria">
              <div id="auditCardsCargando" style="text-align:center; padding:32px; color:var(--text-dim); background:var(--surface-1); border-radius:var(--radius-md); border:1px solid var(--border-subtle);">
                Cargando bitácora…
              </div>
            </div>

            <!-- Controles de Paginación y Densidad -->
            <div class="padron-pagination-bar audit-pagination-bar" id="auditPaginationBar">
              <div class="padron-pagination-left audit-pagination-left">
                <span id="auditPaginationInfo"
                  style="font-size:12.5px; color:var(--text-muted); font-weight:500;">Mostrando eventos</span>
                <div class="padron-density-wrapper" style="display:flex; align-items:center; gap:6px;">
                  <span style="font-size:12px; color:var(--text-dim);">Mostrar:</span>
                  <select class="audit-density-select padron-density-select" id="selectAuditPageSize"
                    data-pdi-on="change" data-pdi-h="h068">
                    <option value="10" selected>10 por página</option>
                    <option value="20">20 por página</option>
                    <option value="30">30 por página</option>
                    <option value="40">40 por página</option>
                    <option value="50">50 por página (Máx)</option>
                  </select>
                </div>
                <button type="button" class="btn-text-subtle" id="btnAuditCargarMas" style="display:none;"
                  title="Pedir más eventos al servidor">
                  Cargar más
                </button>
              </div>
              <div class="padron-pagination-right audit-pagination-right">
                <button type="button" class="btn-page" id="btnAuditPagePrev"
                  data-pdi-on="click" data-pdi-h="h069">
                  <Icon name="accion.volver" size={14} />
                  <span>Anterior</span>
                </button>
                <span class="audit-page-indicator" id="auditCurrentPageNum">Página 1</span>
                <button type="button" class="btn-page" id="btnAuditPageNext"
                  data-pdi-on="click" data-pdi-h="h070">
                  <span>Siguiente</span>
                  <Icon name="accion.abrir" size={14} />
                </button>
              </div>
            </div>
          </div>
        </section>

  <script>
    import '../scripts/pages/auditoria.js';
  </script>
</AppLayout>