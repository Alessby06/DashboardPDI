                            </svg>
                          </button>
                          <div class="padron-inner-dropdown-menu" id="menuAuditStatus">
                            <div class="padron-dropdown-item selected" data-value="all"
                              onclick="window.toggleAuditStatus ? window.toggleAuditStatus('all') : null">
