---
import AppLayout from '../layouts/AppLayout.astro';
import {
  SEDES,
  MODALIDADES,
  EXONERACIONES,
  SEGUROS,
  NIVELES_EDUCATIVOS,
  PARENTESCOS,
  TIPOS_ALERGIA,
  SEVERIDADES_ALERGIA,
  gradosDeNivel,
} from '../data/opcionesBeneficiario.js';
import EstrategiaMultiSelect from '../components/EstrategiaMultiSelect.astro';
import '../styles/views-expediente.css';
import '../styles/expediente.css';
import Icon from '../components/Icon.astro';
---

<AppLayout title="Expediente Integral" currentPage="expediente">
<section class="app-view active" id="view-expediente">

  <!-- Script síncrono inline para pre-hidratación instantánea: elimina los 2 segundos de campos vacíos -->
  <script is:inline>
    (function () {
      function prehidratarExpediente() {
        try {
          var params = new URLSearchParams(window.location.search);
          var id = params.get("id");
          var codigo = params.get("codigo");
          if (!id && !codigo) return;

          var raw = localStorage.getItem("pdi_beneficiarios");
          if (!raw) return;
          var lista = JSON.parse(raw);
          if (!Array.isArray(lista) || !lista.length) return;

          var b = null;
          if (id) {
            var numId = parseInt(id, 10);
            b = lista.find(function (item) { return item.id === numId; });
          } else if (codigo) {
            var cleanCod = codigo.trim().toLowerCase();
            b = lista.find(function (item) { return (item.codigo || "").toLowerCase() === cleanCod; });
          }
          if (!b) return;

          function setVal(idEl, val) {
            var el = document.getElementById(idEl);
            if (el && val !== undefined && val !== null) el.value = val;
          }
          function setText(idEl, val) {
            var el = document.getElementById(idEl);
            if (el && val !== undefined && val !== null) el.textContent = val;
          }
          // Los desplegables necesitan la opcion para poder mostrar el valor.
          // Un dato anterior al catalogo (una estrategia vieja, por ejemplo) se
          // agrega como opcion propia en vez de dejar el campo en blanco.
          function setSelectVal(idEl, val) {
            var el = document.getElementById(idEl);
            if (!el || val === undefined || val === null || val === "") return;
            var existe = false;
            for (var i = 0; i < el.options.length; i++) {
              if (el.options[i].value === val) { existe = true; break; }
            }
            if (!existe) el.add(new Option(val, val));
            el.value = val;
          }

          setText("expPageTitle", "Expediente Integral: " + (b.nombres || "") + " " + (b.apellidos || "") + " (" + (b.codigo || "") + ")");
          var sede = b.sede ? ("Sede " + b.sede) : "Sin sede asignada";
          setText("expPageSubtitle", (b.edad || "") + " - " + (b.sexo === "M" ? "Masculino" : "Femenino") + " - " + sede);

          var indice = lista.findIndex(function (item) { return item.id === b.id; });
          var btnPrev = document.getElementById("expPrevBtn");
          var btnNext = document.getElementById("expNextBtn");
          if (btnPrev && indice > -1) {
            btnPrev.disabled = (indice <= 0);
            if (indice <= 0) btnPrev.classList.add("is-disabled");
            else btnPrev.classList.remove("is-disabled");
          }
          if (btnNext && indice > -1) {
            btnNext.disabled = (indice >= lista.length - 1);
            if (indice >= lista.length - 1) btnNext.classList.add("is-disabled");
            else btnNext.classList.remove("is-disabled");
          }

          setVal("expCodigo", b.codigo);
          setVal("expDni", b.dni);
          setVal("expNombres", b.nombres);
          setVal("expApellidos", b.apellidos);
          setVal("expFechaNac", b.fechaNacimiento);
          setVal("expEdad", b.edad);
          var selSexoFlash = document.getElementById("expSexo");
          if (selSexoFlash) selSexoFlash.value = b.sexo === "F" ? "Femenino (F)" : "Masculino (M)";
          setVal("expDireccion", b.direccion);
          setVal("expReferencia", b.referencia);
          var selDSFlash = document.getElementById("expDistritoSede");
          if (selDSFlash) selDSFlash.value = (b.distrito || "") + " - " + (b.sede || "");
          var selExonFlash = document.getElementById("expExoneracion");
          if (selExonFlash) {
            var txtExonFlash = String(b.exoneracionAporte || "");
            if (txtExonFlash.indexOf("100%") > -1) selExonFlash.value = "100% (Exonerado Vulnerabilidad Extrema)";
            else if (txtExonFlash.indexOf("50%") > -1) selExonFlash.value = "50% (Semi-exonerado)";
            else if (txtExonFlash.indexOf("0%") > -1) selExonFlash.value = "0% (Aporte Ordinario)";
          }
          setSelectVal("expSeguro", b.seguro);
          setVal("expCentroSalud", b.centroSalud);
          setVal("expAlergiaDescripcion", b.alergiaDescripcion || "Ninguna");
          setSelectVal("expAlergiaTipo", b.alergiaTipo || "Ninguna");
          setSelectVal("expAlergiaSeveridad", b.alergiaSeveridad || "Leve");
          setVal("expPeso", b.peso);
          setVal("expTalla", b.talla);
          setVal("expHb", b.hb);
          setVal("expEstadoHb", b.anemia || "Sin tamizaje");
          setSelectVal("expNivelEducativo", b.nivelEducativo);
          setSelectVal("expGrado", b.grado);
          setVal("expColegio", b.colegio);
          setVal("expApoderadoNombre", b.apoderado);
          setSelectVal("expApoderadoParentesco", b.parentesco);
          var selSexoApoFlash = document.getElementById("expApoderadoSexo");
          if (selSexoApoFlash) selSexoApoFlash.value = b.sexoApoderado === "F" ? "F" : (b.sexoApoderado === "M" ? "M" : "");
          setVal("expApoderadoDni", b.apoderadoDni);
          setVal("expApoderadoTel", b.telefono);
          setVal("expTelefonoAlt", b.telefonoAlt);
          setSelectVal("expModalidad", b.modalidad);
          // La estrategia es una seleccion multiple y su control vive en otro
          // archivo: aqui solo se dejan las estrategias listas para que las
          // pinte el control cuando cargue.
          var estr = b.estrategias;
          if (!Array.isArray(estr) || !estr.length) {
            estr = String(b.estrategia || "").indexOf("Mixto") >= 0
              ? ["Desayuno Infantil", "Casita del Saber"]
              : (b.estrategia ? [b.estrategia] : []);
          }
          window.__pdiEstrategias = window.__pdiEstrategias || {};
          window.__pdiEstrategias["expEstrategia"] = estr;
        } catch (e) {}
      }

      prehidratarExpediente();
      document.addEventListener("astro:after-swap", prehidratarExpediente);
    })();
  </script>

  <header class="expediente-page-header">
    <div class="expediente-title-wrap">
      <div class="expediente-icon-box">
        <Icon name="archivo.documento" size={22} />
      </div>
      <div class="expediente-title-text-group">
        <h3 id="expPageTitle">Expediente Integral del Usuario</h3>
        <span class="expediente-page-sub" id="expPageSubtitle"></span>
      </div>
    </div>

    <div class="expediente-page-nav">
      <!-- Navegación secuencial entre usuarios (agrupada para móvil y desktop) -->
      <div class="expediente-nav-group-paging">
        <button type="button" class="btn-action btn-secondary btn-icon-mobile" id="expPrevBtn"
          onclick="window.desplazarExpediente ? window.desplazarExpediente(-1) : null"
          title="Expediente anterior" aria-label="Expediente anterior">
          <Icon name="accion.volver" size={15} />
          <span class="btn-text-responsive">Anterior</span>
        </button>
        <button type="button" class="btn-action btn-secondary btn-icon-mobile" id="expNextBtn"
          onclick="window.desplazarExpediente ? window.desplazarExpediente(1) : null"
          title="Expediente siguiente" aria-label="Expediente siguiente">
          <span class="btn-text-responsive">Siguiente</span>
          <Icon name="accion.abrir" size={15} />
        </button>
      </div>

      <!-- Acciones del expediente (imprimir y retorno al padrón) -->
      <div class="expediente-nav-group-actions">
        <button type="button" class="btn-action btn-secondary btn-icon-mobile" id="expPrintBtn"
          onclick="window.print()" title="Imprimir el expediente completo" aria-label="Imprimir expediente">
          <Icon name="accion.imprimir" size={15} />
          <span class="btn-text-responsive">Imprimir</span>
        </button>
        <a class="btn-action btn-secondary" id="expBackToPadron" href="/padron" title="Volver al Padrón de Usuarios" data-astro-prefetch>
          <Icon name="accion.volver" size={15} />
          <span class="btn-back-text"><span class="desktop-only">Volver al Padrón</span><span class="mobile-only">Volver</span></span>
        </a>
      </div>
    </div>
  </header>

  <!-- Estado sin expediente. Se muestra cuando la URL no trae id, o el id no
       existe, en vez de dejar en pantalla un expediente vacio sin explicacion. -->
  <div class="expediente-sin-expediente" id="expSinExpediente" style="display:none;">
    <h4 id="expSinExpedienteTitulo">No se indicó qué expediente abrir</h4>
    <p id="expSinExpedienteDetalle">
      Esta página necesita saber a qué usuario corresponde. Se llega a ella desde el
      Padrón de Usuarios, con el enlace "Expediente" de cada fila.
    </p>
    <a class="btn-action primary" href="/padron">Ir al Padrón de Usuarios</a>
  </div>

<div class="modal-body-split expediente-page-body">
    <!-- Sidebar de Navegación Lateral con Iconos -->
    <aside class="expediente-sidebar">
      <div class="expediente-sidebar-label">Secciones del Expediente</div>

      <button type="button" class="modal-tab-btn expediente-nav-item active" data-tab="tab-identidad">
        <Icon name="archivo.documento" size={2} />
        <span>1. Identidad</span>
      </button>

      <button type="button" class="modal-tab-btn expediente-nav-item" data-tab="tab-salud">
        <Icon name="salud.corazon" size={2} />
        <span>2. Salud CRED</span>
      </button>

      <button type="button" class="modal-tab-btn expediente-nav-item" data-tab="tab-escolar">
        <Icon name="educacion.grado" size={2} />
        <span>3. Escolaridad</span>
      </button>

      <button type="button" class="modal-tab-btn expediente-nav-item" data-tab="tab-apoderado">
        <Icon name="persona.grupo" size={2} />
        <span>4. Familia y Retiro</span>
      </button>

      <button type="button" class="modal-tab-btn expediente-nav-item" data-tab="tab-consentimiento">
        <Icon name="archivo.documento" size={2} />
        <span>5. Ley N.° 29733</span>
      </button>

      <button type="button" class="modal-tab-btn expediente-nav-item" data-tab="tab-asp">
        <Icon name="salud.escudo" size={2} />
        <span>6. Social ASP</span>
      </button>
    </aside>

    <!-- Contenedor de Contenido de la Sección Activa -->
    <div class="expediente-content-area">

      <!-- SECCIÓN 1: IDENTIDAD CON FOTO DEL USUARIO / ADOLESCENTE -->
      <div class="modal-tab-pane" id="tab-identidad">
        <div class="child-identity-layout">

          <!-- Carnet Fotográfico del Usuario -->
          <div class="child-photo-card">
            <div class="child-photo-frame" id="expChildPhotoFrame">
              <!-- SVG Avatar o Foto Dinámica -->
            </div>
            <div style="width:100%;">
              <span class="badge badge-green"
                style="font-size:11px; display:inline-block; margin-bottom:4px;">Usuario Activo</span>
              <div id="expPhotoName"
                style="font-size:13.5px; font-weight:700; color:var(--text-main); line-height:1.3;"></div>
              <div id="expPhotoCode"
                style="font-size:11.5px; font-family:var(--mono-font); color:var(--text-brand); font-weight:700; margin-top:2px;">
              </div>
              <div id="expPhotoMeta" style="font-size:11.5px; color:var(--text-dim); margin-top:3px;"></div>
            </div>
            <div style="border-top:1px dashed var(--border-subtle); width:100%; padding-top:8px; margin-top:4px;">
              <div class="exp-foto-acciones">
                <button type="button" class="btn-action"
                  onclick="window.verFotoExpediente ? window.verFotoExpediente() : null"
                  style="font-size:11px; padding:5px 8px; width:100%; justify-content:center; cursor:pointer;"
                  title="Ver la fotografia del usuario en una ventana grande">
                  <Icon name="accion.ver" size={13} />
                  <span>Ver Foto</span>
                </button>
                <label for="childPhotoInput" class="btn-action"
                  style="font-size:11px; padding:5px 8px; width:100%; justify-content:center; cursor:pointer;"
                  title="Cambiar la fotografia actual del usuario">
                  <Icon name="accion.foto" size={13} />
                  <span>Actualizar Foto</span>
                </label>
                <button type="button" class="btn-action"
                  onclick="window.eliminarFotoExpediente ? window.eliminarFotoExpediente() : null"
                  style="font-size:11px; padding:5px 8px; width:100%; justify-content:center; cursor:pointer; color:var(--text-danger);"
                  title="Eliminar la fotografia registrada de este usuario">
                  <Icon name="accion.eliminar" size={13} />
                  <span>Eliminar Foto</span>
                </button>
              </div>
              <input type="file" id="childPhotoInput" accept="image/*" style="display:none;">
            </div>
          </div>

          <!-- Formulario de Datos Normativos -->
          <div style="flex:1;">
            <div class="form-grid" style="grid-template-columns: repeat(2, 1fr); gap:12px;">
              <div class="form-group">
                <label>Código Correlativo:</label>
                <input type="text" class="form-control" id="expCodigo" readonly
                  style="font-family: var(--mono-font); font-weight: bold; color: var(--text-brand);">
              </div>
              <div class="form-group">
                <label>DNI:</label>
                <input type="text" class="form-control" id="expDni" data-tipo="dni" readonly maxlength="8" inputmode="numeric" pattern="[0-9]{8}">
              </div>
              <div class="form-group">
                <label>Nombres Completos:</label>
                <input type="text" class="form-control" id="expNombres" data-tipo="nombre" readonly maxlength="60">
              </div>
              <div class="form-group">
                <label>Apellidos:</label>
                <input type="text" class="form-control" id="expApellidos" data-tipo="nombre" readonly maxlength="60">
              </div>
              <div class="form-group">
                <label>Fecha de Nacimiento:</label>
                <input type="date" class="form-control" id="expFechaNac" readonly>
              </div>
              <div class="form-group">
                <label>Edad (calculada):</label>
                <input type="text" class="form-control" id="expEdad" readonly
                  title="La edad la calcula el sistema a partir de la fecha de nacimiento">
              </div>
              <div class="form-group">
                <label>Sexo:</label>
                <input type="text" class="form-control" id="expSexo" readonly
                  style="color:var(--text-main); opacity:1; cursor:default;"
                  title="Sexo registrado en la ficha de inscripción">
              </div>
              <div class="form-group" style="grid-column: span 2;">
                <label>Dirección Actual Domiciliaria:</label>
                <input type="text" class="form-control" id="expDireccion" readonly maxlength="180"
                  oninput="window.handleAddressInputDebounce ? window.handleAddressInputDebounce('exp') : null">
              </div>
              <div class="form-group">
                <label>Referencia de Ubicación:</label>
                <input type="text" class="form-control" id="expReferencia" readonly maxlength="120"
                  placeholder="Sin referencia adicional">
              </div>
              <div class="form-group">
                <label>Distrito y Sede:</label>
                <select class="form-control" id="expDistritoSede" disabled style="opacity:1;"
                  title="Las sedes son las mismas de la ficha de inscripcion">
                  {SEDES.map((opcion) => (
                    <option value={opcion.valor}>{opcion.etiqueta}</option>
                  ))}
                </select>
              </div>
              <div class="form-group">
                <div style="display:flex; align-items:center; justify-content:space-between; margin-bottom:4px;">
                  <label style="margin-bottom:0;">Exoneración de Aporte:</label>
                  <div class="exoneracion-info-wrap">
                    <button type="button" class="btn-exoneracion-info"
                      title="Información sobre los porcentajes de exoneración">
                      <Icon name="estado.info" size={13} />
                    </button>
                    <div class="exoneracion-tooltip">
                      <div class="tooltip-title">Escalas de Exoneración de Aporte:</div>
                      <div class="tooltip-item">
                        <span class="tooltip-pct pct-100">100%</span>
                        <span><strong>Exonerado Total:</strong> Casos de extrema pobreza, orfandad o alto riesgo
                          social evaluado por ASP.</span>
                      </div>
                      <div class="tooltip-item">
                        <span class="tooltip-pct pct-50">50%</span>
                        <span><strong>Semi-exonerado:</strong> Familias con vulnerabilidad intermedia o carga
                          familiar múltiple.</span>
                      </div>
                      <div class="tooltip-item">
                        <span class="tooltip-pct pct-0">0%</span>
                        <span><strong>Aporte Ordinario:</strong> Contribución simbólica regular según normativa
                          interna PDI.</span>
                      </div>
                    </div>
                  </div>
                </div>
                <select class="form-control" id="expExoneracion" disabled style="opacity:1;"
                  title="Escalas identicas a la ficha de inscripcion">
                  {EXONERACIONES.map((opcion) => (
                    <option value={opcion.valor}>{opcion.etiqueta}</option>
                  ))}
                </select>
              </div>
              <div class="form-group">
                <label>Modalidad de Intervención:</label>
                <select class="form-control" id="expModalidad" disabled style="opacity:1;"
                  title="Las mismas modalidades de la ficha de inscripcion">
                  {MODALIDADES.map((opcion) => (
                    <option value={opcion.valor}>{opcion.etiqueta}</option>
                  ))}
                </select>
              </div>
              <div class="form-group" style="grid-column: 1 / -1; min-width: 0;">
                <EstrategiaMultiSelect id="expEstrategia" label="Estrategia Asignada" disabled />
              </div>

              <!-- Bloque de Croquis Georreferenciado y Fachada en el Expediente -->
              <div class="form-group" style="grid-column: span 2; margin-top: 4px;">
                <div class="croquis-box-header">
                  <div class="croquis-box-title">
                    <Icon name="lugar.ubicacion" size={15} />
                    <span>Croquis y Acceso al Hogar (Google Maps)</span>
                  </div>
                  <div class="croquis-box-actions">
                    <a id="expLinkGoogleMapsNav" href="javascript:void(0)" target="_blank"
                      class="btn-action btn-maps-nav" title="Abrir ruta de navegación en la app de Google Maps">
                      <Icon name="lugar.ruta" size={14} />
                      <span>Ruta en Google Maps</span>
                    </a>
                  </div>
                </div>

                <div class="croquis-embed-grid">
                  <!-- Visor Google Maps Embed -->
                  <div class="croquis-map-wrap">
                    <iframe id="expGoogleMapIframe" class="croquis-map-iframe"
                      src="about:blank"
                      loading="lazy" allowfullscreen></iframe>
                  </div>

                  <!-- Visualizador / Subida de Fachada en Expediente -->
                  <div class="croquis-fachada-card">
                    <div class="croquis-fachada-header">
                      <span>Fachada y Entorno Real</span>
                    </div>
                    <div class="croquis-fachada-preview-box" id="expFachadaPreview"
                      title="Fotografía de la vivienda del usuario">
                      <div class="croquis-fachada-placeholder">
                        <Icon name="nav.inicio" size={24} />
                        <span>Sin foto de fachada</span>
                      </div>
                    </div>
                    <div id="expFachadaUploadControls" style="display:none; margin-top:6px;">
                      <label for="expFotoFachadaInput" class="btn-action"
                        style="font-size:11px; padding:4px 8px; width:100%; justify-content:center; cursor:pointer;">
                        <Icon name="accion.foto" size={13} />
                        <span>Actualizar Fachada</span>
                      </label>
                      <input type="file" id="expFotoFachadaInput" accept="image/*" style="display:none;">
                    </div>
                  </div>
                </div>
              </div>
            </div>
          </div>

        </div>
      </div>

      <!-- SECCIÓN 2: SALUD CRED -->
      <div class="modal-tab-pane" id="tab-salud" style="display: none;">
        <div class="form-grid" style="grid-template-columns: repeat(3, 1fr); gap:12px;">
          <div class="form-group">
            <label>Tipo de Seguro:</label>
            <select class="form-control" id="expSeguro" disabled style="opacity:1;"
              title="Los mismos seguros de la ficha de inscripcion">
              {SEGUROS.map((opcion) => (
                <option value={opcion.valor}>{opcion.etiqueta}</option>
              ))}
            </select>
          </div>
          <div class="form-group">
            <label>Centro de Salud de Referencia:</label>
            <input type="text" class="form-control" id="expCentroSalud" readonly maxlength="80">
          </div>
          <div class="form-group">
            <label>Alergia:</label>
            <input type="text" class="form-control" id="expAlergiaDescripcion" readonly maxlength="120">
          </div>
          <div class="form-group">
            <label>Tipo de alergia:</label>
            <select class="form-control" id="expAlergiaTipo" disabled style="opacity:1;">
              {TIPOS_ALERGIA.map((opcion) => (
                <option value={opcion.valor}>{opcion.etiqueta}</option>
              ))}
            </select>
          </div>
          <div class="form-group">
            <label>Gravedad:</label>
            <select class="form-control" id="expAlergiaSeveridad" disabled style="opacity:1;">
              {SEVERIDADES_ALERGIA.map((opcion) => (
                <option value={opcion.valor}>{opcion.etiqueta}</option>
              ))}
            </select>
          </div>
          <div class="form-group">
            <label>Peso (kg):</label>
            <input type="number" class="form-control" id="expPeso" readonly min="1" max="150" step="0.1"
              inputmode="decimal">
          </div>
          <div class="form-group">
            <label>Talla (cm):</label>
            <input type="number" class="form-control" id="expTalla" readonly min="30" max="220" step="0.1"
              inputmode="decimal">
          </div>
          <div class="form-group">
            <label>Hemoglobina (g/dL):</label>
            <input type="number" class="form-control" id="expHb" readonly min="1" max="25" step="0.1"
              inputmode="decimal" style="color:var(--text-brand); font-weight:700;">
          </div>
          <div class="form-group">
            <label>Estado de Hemoglobina:</label>
            <input type="text" class="form-control" id="expEstadoHb" readonly>
          </div>
          <div class="form-group">
            <label>Canasta Alimentaria:</label>
            <input type="text" class="form-control" id="expCanasta" readonly>
          </div>
          <div class="form-group" style="grid-column: span 3;">
            <label>Orientación Familiar en Nutrición:</label>
            <input type="text" class="form-control" id="expOrientacion" readonly>
          </div>
        </div>
      </div>

      <!-- SECCIÓN 3: ESCOLARIDAD -->
      <div class="modal-tab-pane" id="tab-escolar" style="display: none;">
        <div class="form-grid" style="grid-template-columns: repeat(2, 1fr); gap:12px;">
          <div class="form-group">
            <label>Nivel Educativo:</label>
            <select class="form-control" id="expNivelEducativo" disabled style="opacity:1;"
              title="Los mismos niveles de la ficha de inscripcion">
              {NIVELES_EDUCATIVOS.map((opcion) => (
                <option value={opcion.valor}>{opcion.etiqueta}</option>
              ))}
            </select>
          </div>
          <div class="form-group">
            <label>Grado Escolar:</label>
            <select class="form-control" id="expGrado" disabled style="opacity:1;"
              title="Se elige de la lista del nivel educativo">
              <option value="">Seleccione…</option>
              {gradosDeNivel(NIVELES_EDUCATIVOS[0].valor).map((grado) => (
                <option value={grado.valor}>{grado.etiqueta}</option>
              ))}
            </select>
          </div>
          <div class="form-group">
            <label>Institución Educativa (I.E.):</label>
            <input type="text" class="form-control" id="expColegio" readonly maxlength="80">
          </div>
          <div class="form-group">
            <label>Monitoreo de Asistencia (Casitas):</label>
            <input type="text" class="form-control" id="expAsistencia" readonly>
          </div>
          <div class="form-group">
            <label>Entrega de Materiales y Kits:</label>
            <input type="text" class="form-control" id="expKits" readonly>
          </div>
        </div>
      </div>

      <!-- SECCIÓN 4: ENTORNO FAMILIAR Y RETIRO SEGURO CON FOTOS (ANEXO 2) -->
      <div class="modal-tab-pane" id="tab-apoderado" style="display: none;">
        <!-- Datos del Apoderado Principal -->
        <div
          style="background:var(--surface-1); border:1px solid var(--border-subtle); border-radius:10px; padding:16px; margin-bottom:18px;">
          <div
            style="display:flex; align-items:center; gap:8px; margin-bottom:12px; border-bottom:1px solid var(--border-subtle); padding-bottom:8px;">
            <Icon name="persona.usuario" size={18} />
            <h4 style="margin:0; font-size:13.5px; font-weight:700; color:var(--text-main);">Apoderado(a) Principal
              Titular</h4>
          </div>
          <div class="form-grid" style="grid-template-columns: repeat(3, 1fr); gap:12px;">
            <div class="form-group">
              <label>Nombres y Apellidos:</label>
              <input type="text" class="form-control" id="expApoderadoNombre" data-tipo="nombre" readonly maxlength="80">
            </div>
            <div class="form-group">
              <label>Parentesco:</label>
              <select class="form-control" id="expApoderadoParentesco" disabled style="opacity:1;"
                title="Los mismos parentescos de la ficha de inscripcion">
                {PARENTESCOS.map((parentesco) => (
                  <option value={parentesco}>{parentesco}</option>
                ))}
              </select>
            </div>
            <div class="form-group">
              <label>Sexo del Apoderado:</label>
              <select class="form-control" id="expApoderadoSexo" disabled style="opacity:1;">
                <option value="">Sin dato</option>
                <option value="F">Femenino (F)</option>
                <option value="M">Masculino (M)</option>
              </select>
            </div>
            <div class="form-group">
              <label>DNI del Apoderado:</label>
              <input type="text" class="form-control" id="expApoderadoDni" data-tipo="dni" readonly maxlength="8" inputmode="numeric">
            </div>
            <div class="form-group">
              <label>Celular Principal del Apoderado:</label>
              <input type="text" class="form-control" id="expApoderadoTel" data-tipo="celular" readonly maxlength="9" pattern="9[0-9]{8}" inputmode="numeric" placeholder="987654321">
            </div>
            <div class="form-group" style="grid-column: span 2;">
              <label>Teléfono Alternativo / Emergencia:</label>
              <input type="text" class="form-control" id="expTelefonoAlt" data-tipo="celular" readonly maxlength="9" pattern="9[0-9]{8}" inputmode="numeric" placeholder="912345678">
            </div>
          </div>
        </div>

        <!-- Padrón de Personas Autorizadas para Retiro con Fotografía -->
        <div style="border-top:1px solid var(--border-subtle); padding-top:14px;">
          <div style="margin-bottom:10px;">
            <label
              style="font-size:13px; font-weight:800; color:var(--text-main); display:flex; align-items:center; gap:8px;">
              <Icon name="accion.confirmar" size={18} />
              <span>Padrón de Personas Autorizadas para el Retiro del Usuario</span>
            </label>
            <span style="font-size:11.5px; color:var(--text-dim); display:block; margin-top:2px;">
              Control biométrico visual y cotejo de DNI obligatorio para la entrega segura del usuario al término de
              actividades.
            </span>
          </div>

          <div id="expRetiroPadronContainer" class="retiro-padron-grid">
            <!-- Tarjetas con foto de cada persona autorizada generadas dinámicamente -->
          </div>
        </div>
      </div>

      <!-- SECCIÓN 5: CONSENTIMIENTO LEY 29733 -->
      <div class="modal-tab-pane" id="tab-consentimiento" style="display: none;">
        <div style="font-size: 12.5px; color: var(--text-muted); line-height: 1.5; margin-bottom: 12px;">
          Conforme a la <strong>Ley N.° 29733 (Ley de Protección de Datos Personales)</strong> y su Reglamento D.S.
          N.° 016-2024-JUS, el apoderado otorgó las autorizaciones expresas para la atención integral y
          sostenibilidad institucional:
        </div>
        <div id="expConsentimientoChecksContainer"></div>
      </div>

      <!-- SECCIÓN 6: SOCIAL PASTORAL ASP -->
      <div class="modal-tab-pane" id="tab-asp" style="display: none;">
        <div class="form-grid" style="grid-template-columns: 1fr 1fr; gap:12px; margin-bottom:14px;">
          <div class="form-group">
            <label>Puntaje de Vulnerabilidad Socioeconómica (0-100):</label>
            <input type="text" class="form-control" id="expVulnerabilidad" readonly
              style="font-weight:700; color:var(--text-warning);">
          </div>
          <div class="form-group">
            <label>Intervención Social Pastoral:</label>
            <input type="text" class="form-control" value="Seguimiento Domiciliario y Soporte Integral" readonly>
          </div>
        </div>
        <label style="font-size:12px; font-weight:700; color:var(--text-main); display:block; margin-bottom:6px;">
          Ficha de Derivación de Caso Social (ASP):
        </label>
        <div id="expCasoSocialDetail"></div>
      </div>

    </div>
  </div>

  <div class="expediente-page-actions">
<div class="modal-footer modal-footer-pinned"
    style="padding: 12px 22px; border-top: 1px solid var(--border-subtle); display: flex; justify-content: space-between; align-items: center; background: var(--surface-1);">
    <div>
      <!-- Botón Eliminar: solo visible y permitido para Coordinador General o Admin TI -->
      <button type="button" class="btn-action danger" id="btnDeleteBeneficiario"
        onclick="deleteBeneficiarioExpediente()" title="Dar de baja definitiva al usuario (Solo Dirección / Admin)">
        <Icon name="accion.eliminar" size={15} />
        <span>Dar de Baja</span>
      </button>
    </div>

    <div style="display: flex; gap: 10px; align-items: center;">
      <!-- Botón Editar Datos -->
      <button type="button" class="btn-action" id="btnToggleEditExp" onclick="toggleEditExpediente()">
        <Icon name="accion.editar" size={15} />
        <span>Editar Datos</span>
      </button>

      <!-- Botón Guardar Cambios -->
      <button type="button" class="btn-action primary" id="btnSaveExpChanges" style="display: none;"
        onclick="saveExpedienteChanges()">
        <Icon name="accion.confirmar" size={15} />
        <span>Guardar Cambios</span>
      </button>
    </div>
  </div>
  </div>

</section>

  <script>
    import '../scripts/pages/expediente.js';
  </script>
</AppLayout>